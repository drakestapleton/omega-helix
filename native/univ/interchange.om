note ======== small helpers ========

fn ix_arg_eq ai ulong s view uchar * to bool
r = argread ai uarg 0 4096
if ne r long len s
ret false
end
for i ulong len s
if ne get uarg i get s i
ret false
end
end
ret true
end

fn ix_bad v f64 to bool
ret ne sub v v 0.0
end

fn ix_p10 k ulong to f64
r = 1.0f64
for i ulong k bound 400
r = mul r 10.0
end
ret r
end

note m * 10^ex: one correctly rounded operation when m < 2^53 and |ex| <= 22 (both operands exact)
fn ix_scale m ulong ex long to f64
if eq m 0
ret 0.0f64
end
v = f64 m
x = ex
if lt m 9007199254740992
if and ge x -22 le x 22
if ge x 0
ret mul v ix_p10 ulong x
end
ret div v ix_p10 ulong neg x
end
end
while gt x 22 bound 100000
v = mul v 1.0e22
x = sub x 22
end
while lt x -22 bound 100000
v = div v 1.0e22
x = add x 22
end
if ge x 0
ret mul v ix_p10 ulong x
end
ret div v ix_p10 ulong neg x
end

fn ix_nexp src view uchar * p ulong e ulong to long
q = p
ng = false
if lt q e
c = get src q
if eq c 45
ng = true
q = add q 1
else
if eq c 43
q = add q 1
end
end
end
x = long 0
while lt q e bound 1000000
d = long sub get src q 48
if lt x 100000
x = add mul x 10 d
end
q = add q 1
end
if ng
ret neg x
end
ret x
end

note a JSON number lexeme src[off .. off + n) as f64 (19 significant digits, then ix_scale)
fn ix_numf src view uchar * off ulong n ulong to f64
e = add off n
p = off
ng = false
if eq get src p 45
ng = true
p = add p 1
end
m = ulong 0
nd = ulong 0
ex = long 0
fr = false
while lt p e bound 1000000
c = get src p
if or eq c 101 eq c 69
ex = add ex ix_nexp src add p 1 e
break
end
if eq c 46
fr = true
else
if lt nd 19
m = add mul m 10 ulong sub c 48
if gt m 0
nd = add nd 1
end
if fr
ex = sub ex 1
end
else
if not fr
ex = add ex 1
end
end
end
p = add p 1
end
v = ix_scale m ex
if ng
ret neg v
end
ret v
end

fn ix_e10 a f64 to long
k = long 0
x = a
while ge x 10.0 bound 400
x = div x 10.0
k = add k 1
end
while lt x 1.0 bound 400
x = mul x 10.0
k = sub k 1
end
ret k
end

fn ix_cand a f64 sc long to ulong
x = a
if ge sc 0
x = mul a ix_p10 ulong sc
else
x = div a ix_p10 ulong neg sc
end
ret ulong add x 0.5
end

fn ix_lexu lex edit uchar * w ulong v ulong to ulong
tmp = new uchar 24 0
k = ulong 0
x = v
while true bound 21
put tmp k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
q = w
while gt k 0 bound 21
k = sub k 1
put lex q get tmp k
q = add q 1
end
ret q
end

note shortest decimal (<= 17 digits) that ix_numf reads back to the same f64 bits
fn ix_fmt lex edit uchar * v f64 to ulong
if eq v 0.0
put lex 0 48
ret 1
end
a = fabs v
k = ix_e10 a
want = bitcast ulong a
mm = ulong 0
sc = long 0
for p ulong 17
sc = sub long p k
mm = ix_cand a sc
if eq bitcast ulong ix_scale mm neg sc want
break
end
end
w = ulong 0
if lt v 0.0
put lex 0 45
w = 1
end
w = ix_lexu lex w mm
if ne sc 0
put lex w 101
w = add w 1
if gt sc 0
put lex w 45
w = add w 1
w = ix_lexu lex w ulong sc
else
w = ix_lexu lex w ulong neg sc
end
end
ret w
end

fn ix_wf64 ob edit uchar * v f64 to void
lex = new uchar 64 0
n = ix_fmt lex v
js_wnumb ob lex 0 n
end

note f64 -> bf16 bits, one round-to-nearest-even of the f64 value (no double rounding through f32)
fn ix_bf16 v f64 to ulong
f = f32 v
b = ulong bitcast uint f
hi = shr b 16
lo = and b 65535
if and eq lo 32768 ne f64 f v
if gt fabs f64 f fabs v
ret hi
end
ret and add hi 1 65535
end
ret and shr add b add 32767 and hi 1 16 65535
end

note ======== name buffer ========

fn ixn_reset to void
put ixs 5 0
end

fn ixn_c c ulong to void
n = get ixs 5
if ge n 1024
exit 70
end
put ixnm n uchar and c 255
put ixs 5 add n 1
end

fn ixn_t t view uchar * to void
for i ulong len t
ixn_c ulong get t i
end
end

fn ixn_dec v ulong to void
tmp = new uchar 24 0
k = ulong 0
x = v
while true bound 21
put tmp k uchar add rem x 10 48
k = add k 1
x = div x 10
if eq x 0
break
end
end
while gt k 0 bound 21
k = sub k 1
ixn_c ulong get tmp k
end
end

fn ixn_at off ulong t view uchar * to bool
if ne get ixs 5 add off len t
ret false
end
for i ulong len t
if ne get ixnm add off i get t i
ret false
end
end
ret true
end

fn ixn_eq t view uchar * to bool
ret ixn_at 0 t
end

fn ixn_pre t view uchar * to bool
if gt len t get ixs 5
ret false
end
for i ulong len t
if ne get ixnm i get t i
ret false
end
end
ret true
end

fn ixn_suf t view uchar * to bool
n = get ixs 5
if gt len t n
ret false
end
ret ixn_at sub n len t t
end

fn ixn_arch to void
a = get ixm 0
if eq a 1
ixn_t ixv_llama
ret
end
if eq a 3
ixn_t ixv_qwen3
ret
end
if eq a 5
ixn_t ixv_gemma
ret
end
ixn_t ixv_helix
end

note ======== buffered writer (ixob -> ixs 8 fd) and paths ========

fn ix_path_arg ai ulong to void
n = uargp ai
for i ulong n
put ixpath i get uarg i
end
put ixs 9 n
end

fn ix_path_t t view uchar * to void
n = get ixs 9
if gt add n len t 4300
exit 2
end
for i ulong len t
put ixpath add n i get t i
end
put ixs 9 add n len t
end

fn ixw_open to void
fd = int fopen ixpath 0 get ixs 9 577 420
if lt fd 0
exit 70
end
put ixs 8 ulong fd
put ixs 6 0
put ixs 7 0
end

fn ixw_flush to void
n = get ixs 6
fd = int get ixs 8
pos = get ixs 7
p = ulong 0
while lt p n bound 1000000
w = pwrite fd ixob p sub n p long add pos p
if le w 0
exit 70
end
p = add p ulong w
end
put ixs 7 add pos n
put ixs 6 0
end

fn ixw_b c ulong to void
n = get ixs 6
if ge n IXOB
ixw_flush
n = 0
end
put ixob n uchar and c 255
put ixs 6 add n 1
end

fn ixw_u16 v ulong to void
ixw_b and v 255
ixw_b and shr v 8 255
end

fn ixw_u32 v ulong to void
for k ulong 4
ixw_b and shr v mul k 8 255
end
end

fn ixw_u64 v ulong to void
for k ulong 8
ixw_b and shr v mul k 8 255
end
end

fn ixw_pos to ulong
ret add get ixs 7 get ixs 6
end

fn ixw_nm to void
n = get ixs 5
ixw_u64 n
for i ulong n
ixw_b ulong get ixnm i
end
end

fn ixw_close to ulong
ixw_flush
fd = int get ixs 8
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
ret get ixs 7
end

note ======== OLLMCK04 load without activation buffers ========

fn ix_geom to bool
if not ugeom_check
ret false
end
ret ugeom_params
end

fn ix_alloc3 to void
p = get ug 10
r = enlarge up p
if ne r 0
exit 70
end
r = enlarge um p
if ne r 0
exit 70
end
r = enlarge uv p
if ne r 0
exit 70
end
end

fn ix_zero_mv to void
p = get ug 10
i = ulong 0
while lt i p bound IXBIG
put um i 0.0
put uv i 0.0
i = add i 1
end
end

fn ix_ck_hdr ai ulong to ulong
sz = uofsz ai
if lt sz UCKHDR
exit 10
end
if ne uoprd ai 0 0 UCKHDR UCKHDR
exit 10
end
if ne uopw_get8 0 UMAGIC_CK4
exit 11
end
for i ulong 8
put ug i uopw_get8 add 8 mul i 8
end
put ug 20 uopw_get8 72
put ug 21 uopw_get8 80
put ug 22 uopw_get8 88
put ug 23 uopw_get8 96
for j ulong 8
put ug add 12 j uopw_get8 add 112 mul j 8
end
pf = uopw_get8 104
fnv = uopw_get8 200
if not ix_geom
exit 12
end
p = get ug 10
if ne p pf
exit 13
end
want = add UCKHDR mul 24 p
if lt sz want
exit 10
end
if gt sz want
exit 15
end
ret fnv
end

fn ix_ck_load ai ulong to void
fnv = ix_ck_hdr ai
ix_alloc3
put uck_st 0 14695981039346656037
put uck_st 1 UCKHDR
for k ulong 3
uck_load_pool ai k
end
if ne get uck_st 0 fnv
exit 14
end
end

fn ix_finite to void
p = get ug 10
i = ulong 0
while lt i p bound IXBIG
if ix_bad get up i
exit 86
end
i = add i 1
end
end

note ======== config.json reader ========

fn ix_slurp ai ulong src edit uchar * code ulong to ulong
pl = uargp ai
fd = int fopen uarg 0 pl 0 0
if lt fd 0
exit 70
end
sz = fseek fd 0 2
if lt sz 0
exit 70
end
n = ulong sz
if or eq n 0 gt n len src
c = fclose fd
exit int code
end
got = ulong 0
while lt got n bound 1000000
r = pread fd src got sub n got long got
if le r 0
exit 70
end
got = add got ulong r
end
if ne fclose fd 0
exit 70
end
ret n
end

fn ixj_u src view uchar * tape view uint * v ulong to ulong
if ne js_type tape v jsnum
exit 81
end
o = js_off tape v
if not js_isu src o
exit 81
end
ret js_tou src o
end

fn ix_stu src view uchar * tape view uint * v ulong to ulong
if ne js_type tape v jsnum
exit 83
end
o = js_off tape v
if not js_isu src o
exit 83
end
ret js_tou src o
end

fn ixj_f src view uchar * tape view uint * v ulong to f64
if ne js_type tape v jsnum
exit 81
end
ret ix_numf src js_off tape v js_span tape v
end

fn ixj_b src view uchar * tape view uint * v ulong to ulong
t = js_type tape v
if eq t jstrue
ret 2
end
if eq t jsfalse
ret 1
end
exit 81
end

fn ix_cfg_mt src view uchar * tape view uint * v ulong to ulong
if ne js_type tape v jsstr
exit 81
end
o = js_off tape v
if js_streq src o ixv_llama
ret 1
end
if js_streq src o ixv_qwen2
ret 2
end
if js_streq src o ixv_qwen3
ret 3
end
if js_streq src o ixv_mistral
ret 4
end
if js_streq src o ixv_gemma
ret 5
end
if js_streq src o ixv_helix
ret 6
end
ret 99
end

fn ix_cfg_act src view uchar * tape view uint * v ulong to ulong
t = js_type tape v
if eq t jsnull
ret 0
end
if ne t jsstr
exit 81
end
o = js_off tape v
if js_streq src o ixv_silu
ret 1
end
if or js_streq src o ixv_gtanh js_streq src o ixv_gnew
ret 2
end
if js_streq src o ixv_gelu
ret 4
end
if js_streq src o ixv_relu
ret 5
end
ret 3
end

fn ix_cfg_m1 src view uchar * tape view uint * ko ulong v ulong to bool
if js_streq src ko ixk_mt
put ixc 0 ix_cfg_mt src tape v
ret true
end
if js_streq src ko ixk_vs
put ixc 1 ixj_u src tape v
ret true
end
if js_streq src ko ixk_hs
put ixc 2 ixj_u src tape v
ret true
end
if js_streq src ko ixk_nh
put ixc 3 ixj_u src tape v
ret true
end
if js_streq src ko ixk_kv
put ixc 4 ixj_u src tape v
ret true
end
if js_streq src ko ixk_is
put ixc 5 ixj_u src tape v
ret true
end
if js_streq src ko ixk_nl
put ixc 6 ixj_u src tape v
ret true
end
if js_streq src ko ixk_mp
put ixc 7 ixj_u src tape v
ret true
end
if js_streq src ko ixk_hd
put ixc 8 ixj_u src tape v
ret true
end
ret false
end

fn ix_cfg_m2 src view uchar * tape view uint * ko ulong v ulong to bool
if js_streq src ko ixk_eps
put ixc 9 bitcast ulong ixj_f src tape v
put ixc 10 1
ret true
end
if js_streq src ko ixk_th
put ixc 11 bitcast ulong ixj_f src tape v
put ixc 12 1
ret true
end
if js_streq src ko ixk_tie
put ixc 13 ixj_b src tape v
ret true
end
if js_streq src ko ixk_rs
if ne js_type tape v jsnull
put ixc 14 1
end
ret true
end
if js_streq src ko ixk_sw
if ne js_type tape v jsnull
put ixc 15 ixj_u src tape v
end
ret true
end
if js_streq src ko ixk_usw
put ixc 16 sub ixj_b src tape v 1
ret true
end
if js_streq src ko ixk_act
put ixc 17 ix_cfg_act src tape v
ret true
end
if js_streq src ko ixk_acn
put ixc 18 ix_cfg_act src tape v
ret true
end
ret false
end

fn ix_cfg_m3 src view uchar * tape view uint * ko ulong v ulong to void
if js_streq src ko ixk_hf
put ixc 19 ixj_u src tape v
put ixc 20 1
ret
end
if js_streq src ko ixk_lp
put ixc 21 ixj_u src tape v
ret
end
