js_wulong ob get ixq 3
if eq get ixq 2 2
js_wulong ob get ixq 4
end
js_warre ob
nb = mul mul get ixq 3 get ixq 4 ix_esz
js_wsbuf ob ixs_doff 0 len ixs_doff
js_warr ob
js_wulong ob off
js_wulong ob add off nb
js_warre ob
