fn ix_sth to void
ob = new uchar 2097152 0
if lt js_winit ob 0
exit 70
end
js_wobj ob
js_wsbuf ob ixs_meta 0 len ixs_meta
js_wobj ob
ixj_ks ob ixs_fmt ixs_pt
js_wobje ob
off = ulong 0
for k ulong get ixs 10 bound IXBIG
off = ix_sth_one ob k off
end
js_wobje ob
r = js_wdone ob
if le r 0
exit 70
end
n = ulong r
pad = rem sub 8 rem add 8 n 8 8
ixw_u64 add n pad
ix_wobuf ob n
for i ulong pad
ixw_b 32
end
end

fn ix_cmd_exh to void
na = ulong argcnt
if and ne na 4 ne na 5
exit 2
end
put ixm 1 0
if eq na 5
if ix_arg_eq 4 ix_s_bf16
put ixm 1 1
else
if not ix_arg_eq 4 ix_s_f32
exit 2
end
end
end
ix_ck_load 2
ix_finite
put ixm 0 ix_arch
put ixm 2 0
put ixm 3 0
ix_list
ix_cfgw
ix_path_arg 3
ix_path_t ixp_st
ixw_open
ix_sth
for k ulong get ixs 10 bound IXBIG
ix_ti k
ix_wtensor
end
tot = ixw_close
uputc 88
uputc 72
uputc 32
uputu get ixs 10
uputc 32
uputu tot
uputc 10
uflush
end

