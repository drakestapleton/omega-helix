else
ix_wf64 ob div f64 mi 1000.0
end
js_wsbuf ob ixk_tie 0 len ixk_tie
js_wbool ob or eq get ixm 0 5 eq and get ug 12 4 0
end

fn ix_cfgw to void
ob = new uchar 65536 0
