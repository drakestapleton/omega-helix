if ne get ixm 1 0
ixj_ks ob ixk_td ixv_bf16
else
ixj_ks ob ixk_td ixv_fp32
end
ixj_ku ob ixk_hf get ug 12
ixj_ku ob ixk_lp get ug 17
ixj_ku ob ixk_lc get ug 18
ixj_ku ob ixk_np get ug 19
js_wobje ob
n = js_wdone ob
if le n 0
exit 70
end
ix_path_arg 3
ix_path_t ixp_cfg
ixw_open
ix_wobuf ob ulong n
c = ixw_close
end

fn ix_sth_key ob edit uchar * to void
js_wsbeg ob
n = get ixs 5
for i ulong n
js_wsb ob get ixnm i
end
