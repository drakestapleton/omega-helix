note SPDX-License-Identifier: Apache-2.0
note native/univ/interchange.om: Pure-Omega Universal Weight Interchange (ollm-interchange), Phase 3.
note Built by `TARGET=interchange sh scripts/build.sh` after net/json.om, net/jsonw.om, univ/umath.om,
note univ/uarena.om and univ/uckpt.om. No float library, no C, no Python: every byte is read and written here.
note
note Commands (argv[1]):
note  import-hf CONFIG.json MODEL.safetensors OUT.ck [T B TOTAL LRMICRO]
note    model_type llama | mistral | qwen2 | qwen3 | gemma | helix; dtypes F32 BF16 F16 F64.
note    HF linear weights [out][in] are transposed into Helix [in][out] row-major (y = x . W).
note    Flags: llama/mistral/qwen2 1|2|16, qwen3 1|2|8|16 (each +4 when untied), gemma 1|4|16|64 with
note    wte = embed * sqrt(D), lmh = embed and every gemma RMSNorm gain stored as 1 + w; helix from
note    helix_arch_flags + helix_loop_lp/lc/np. Defaults T = min(max_position_embeddings, 256) (WPE models:
note    T = rows of model.embed_positions.weight), B 1, TOTAL 1000, LRMICRO 100, seed 0, step 0, m = v = 0.
note    stdout `I V T D H HKV F L P FLAGS`.
note  export-hf IN.ck OUT_DIR [f32|bf16]  -> OUT_DIR/config.json (jsonw.om) + OUT_DIR/model.safetensors.
note    OUT_DIR must exist (the a64macos target has no makedir host word; exit 70 otherwise).
note    stdout `XH NTENSORS SAFETENSORS_BYTES`.
note  export-gguf IN.ck OUT.gguf          -> GGUF v3 (magic 1179993927), 20 KV pairs, F32 tensors, 32-byte
note    aligned data; llama arch Q/K rows permuted as convert_hf_to_gguf. stdout `XG NTENSORS FILE_BYTES`.
note  upgrade LEGACY.ck OUT.ck            -> OLLMCK01/02/03 to OLLMCK04 (gpt flags 0, HKV = H, eps 1e-5,
note    loop from CK03, p/m/v bit-exact). stdout `U VER P`.
note Architecture rule for both exports (loop NP <= 1 for every named family): RoPE+SwiGLU+QKnorm = qwen3,
note RoPE+SwiGLU = llama, RoPE+GeGLU+untied with wte == lmh*sqrt(D) bit for bit = gemma, else helix.
note Exit codes: 2 usage, 70 I/O, 80 config JSON malformed, 81 config field missing/invalid or model_type
note unsupported, 82 unsupported feature (rope_scaling, head_dim != D/H, activation, nonzero bias, sliding
note window < T), 83 safetensors header malformed (size, JSON, entry, byte size, overlap, hole, trailing,
note duplicate), 84 tensor missing/unknown or dtype unsupported, 85 shape mismatch, 86 NaN/Inf weight,
note 87 truncated safetensors, 88 geometry refused; CK loads 10..15 exactly as uckpt.om.

const IXOB ulong 1048576
const IXBIG ulong 9223372036854775807

note ixc config slots: 0 model_type (1 llama 2 qwen2 3 qwen3 4 mistral 5 gemma 6 helix 99 other)
note  1 V 2 D 3 H 4 HKV 5 F 6 L 7 max_pos 8 head_dim 9 eps bits 10 eps set 11 theta bits 12 theta set
note  13 tie (0 absent 1 false 2 true) 14 rope_scaling set 15 sliding_window 16 use_sliding_window
note  17 hidden_act 18 hidden_activation (0 none 1 silu 2 gelu-tanh 3 other 4 gelu-erf 5 relu)
note  19 helix flags 20 helix flags set 21 LP 22 LC 23 NP
global ixc ulong 64
note ixs state: 0 extents 1 safetensors fd 2 data base 3 data bytes 4 table slots 5 name length
note  6 out fill 7 out file pos 8 out fd 9 path length 10 export tensors 11 T given 12 T arg
note  13 extent capacity 14 suffix pos 15 B 16 TOTAL 17 LRMICRO
global ixs ulong 32
global ixt ulong *
global ixe ulong *
global ixl ulong *
note ixq one export tensor: 0 code 1 layer 2 ndims 3 rows 4 cols 5 helix base 6 kind 7 heads
global ixq ulong 8
note ixent one safetensors entry: 0 dtype 1 ndims 2 d0 3 d1 4 begin 5 end 6 numel 7 seen mask
global ixent ulong 8
note ixld tensor load: 0 dtype 1 base 2 mode 3 rows 4 cols
global ixld ulong 8
note ixm export mode: 0 arch (1 llama 3 qwen3 5 gemma 6 helix) 1 bf16 2 permute q/k 3 gguf
global ixm ulong 4
global ixf f64 4
global ixnm uchar 1100
global ixpath uchar 4400
global ixob uchar 1048576

text ix_c_imp "import-hf"
text ix_c_exh "export-hf"
text ix_c_exg "export-gguf"
