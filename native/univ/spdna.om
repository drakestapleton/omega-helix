fn dn_base_run_all n ulong to ulong
ls = 0.0f64
hits = ulong 0
pos = ulong 0
while lt pos n bound 9223372036854775807
  wct = sub n pos
  if gt wct 128
    wct = 128
  end
  dn_fill_win false pos wct
  dn_be_win_run false
  for t ulong wct
    ls = add ls get dn_bl t
    hits = add hits get dn_bh t
  end
  pos = add pos wct
end
put dn_c_par 8 div ls f64 n
ret hits
end

fn dn_cmd_base_eval to void
na = ulong argcnt
if and ne na 4 ne na 5
  exit 2
end
dn_open_trunk 2 false true
t0 = monons
n = dn_load_u32 3 6
hits = dn_base_run_all n
ms = div f64 sub monons t0 1000000.0f64
mean_ls = get dn_c_par 8
dn_put_cstr dn_l_bas
uputu n
dn_put_cstr dn_l_los
dn_putf mean_ls 6
dn_put_cstr dn_l_ppl
dn_putf ufexp mean_ls 4
dn_put_cstr dn_l_acc
dn_putf div f64 hits f64 n 6
dn_put_cstr dn_l_ms
dn_putf ms 2
dn_put_cstr dn_l_th
dn_puth16 get dn_st 16
uputc 10
uflush
if eq na 5
  put dn_jpos 0 0
  dn_jb 123
  dn_jb 10
  dn_jhex_kv dn_k_th get dn_st 16 true
  dn_ju_kv dn_k_nt n true
  dn_jf_kv dn_k_ls mean_ls 6 true
  dn_jf_kv dn_k_pp ufexp mean_ls 6 true
  dn_jf_kv dn_k_ac div f64 hits f64 n 6 true
  dn_jf_kv dn_k_ms ms 2 true
  dn_jhex_kv dn_k_lb bitcast ulong mean_ls false
  dn_jb 125
  dn_jb 10
  dn_jwrite 4
end
dn_be_close
end

fn dn_cryst_parse_args na ulong to void
put dn_st 24 512
put dn_st 25 64
put dn_st 26 16
put dn_st 27 1
put dn_st 28 0
put dn_c_par 0 0.003f64
put dn_c_par 1 1.0f64
put dn_c_par 2 0.02f64
i = ulong 5
while lt i na bound 64
  if dn_arg_eq i dn_s_f_fexp
    i = add i 1
    put dn_st 24 dn_paru i
  else
    if dn_arg_eq i dn_s_f_nproto
      i = add i 1
      put dn_st 25 dn_paru i
    else
      if dn_arg_eq i dn_s_f_epochs
        i = add i 1
        put dn_st 26 dn_paru i
      else
        if dn_arg_eq i dn_s_f_lr
          i = add i 1
          put dn_c_par 0 dn_parf i
        else
          if dn_arg_eq i dn_s_f_lam
            i = add i 1
            put dn_c_par 1 dn_parf i
          else
            if dn_arg_eq i dn_s_f_wd
              i = add i 1
              put dn_c_par 2 dn_parf i
            else
              if dn_arg_eq i dn_s_f_caldom
                i = add i 1
                put dn_st 28 i
              else
                if dn_arg_eq i dn_s_f_f64
                  put dn_st 27 0
                else
                  if dn_arg_eq i dn_s_f_w4
                    put dn_st 27 1
                  else
                    exit 2
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  i = add i 1
end
end

