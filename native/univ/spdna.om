dn_putf tb 6
dn_put_cstr dn_l_cb
dn_putf cb 6
dn_put_cstr dn_l_bst
dn_putf bv 6
dn_put_cstr dn_l_by
uputu get dn_sp_st 9
dn_put_cstr dn_l_ms
dn_putf dt_ms 2
dn_put_cstr dn_l_fnv
dn_puth16 get dn_sp_st 8
uputc 10
uflush
end

fn dn_cmd_cryst to void
if lt ulong argcnt 5
  exit 2
end
dn_cryst_parse_args ulong argcnt
dn_open_trunk 2 false true
t0 = monons
d = get dn_st 1
ntr = dn_load_u32 3 6
tr_base = dn_collect_split false ntr d
has_cal = ne get dn_st 28 0
ncal = ulong 0
cal_base = tr_base
if has_cal
  ncal = dn_load_u32 get dn_st 28 7
  cal_base = dn_collect_split true ncal d
end
fe = get dn_st 24
np = get dn_st 25
dn_build_protos ntr np d
dn_init_win_sm fe d
dn_ridge_init ntr fe d get dn_c_par 1
dn_zero_opt mul fe d
bv = dn_cryst_loop ntr ncal fe get dn_st 26 has_cal ne get dn_st 27 0
sp_fnv = dn_sp_write 4 get dn_st 27 fe np 1.0f64
dn_cryst_print ntr tr_base cal_base bv div f64 sub monons t0 1000000.0f64
dn_be_close
end

fn dn_collect_cos is_cal bool n ulong d ulong np ulong dst_id ulong to void
if eq dst_id 0
  dn_enlarge_opt 17 n
else
  dn_enlarge_opt 18 n
end
pos = ulong 0
while lt pos n bound 9223372036854775807
  wct = sub n pos
  if gt wct 128
    wct = 128
  end
  dn_fill_win is_cal pos wct
  dn_be_win_run false
  for t ulong wct
    dn_win_ema_vec t d
    sc = dn_max_proto_cos d np
    if eq dst_id 0
      put dn_cos_d add pos t sc
    else
      put dn_cos_g add pos t sc
    end
  end
  pos = add pos wct
end
end

fn dn_count_above is_g bool n ulong tau f64 to ulong
c = ulong 0
for i ulong n
  v = 0.0f64
  if is_g
    v = get dn_cos_g i
  else
    v = get dn_cos_d i
  end
  if ge v tau
    c = add c 1
  end
end
ret c
end

fn dn_max_gcos ng ulong to f64
gmax = -1.0f64
for i ulong ng
  if gt get dn_cos_g i gmax
    gmax = get dn_cos_g i
  end
end
ret gmax
end

fn dn_tau_score nd ulong ng ulong tau f64 to f64
da = dn_count_above false nd tau
ga = dn_count_above true ng tau
ret sub div f64 da f64 nd mul 20.0f64 div f64 ga f64 ng
end

fn dn_choose_tau nd ulong ng ulong margin f64 gmax f64 to f64
cand = add gmax margin
if lt cand 0.999f64
  if gt mul dn_count_above false nd cand 4 nd
    ret cand
  end
end
best_tau = cand
best_sc = -1.0e18f64
for t ulong 400
  tau = add -0.2f64 mul f64 t 0.003f64
  sc = dn_tau_score nd ng tau
  if gt sc best_sc
    best_sc = sc
    best_tau = tau
  end
end
if lt best_tau 0.0f64
  ret 0.0f64
end
ret best_tau
end

fn dn_cmd_cal_cos to void
na = ulong argcnt
if and ne na 6 ne na 7
  exit 2
end
margin = 0.005f64
if eq na 7
  margin = dn_parf 6
end
dn_open_trunk 2 false true
dn_sp_load_fast 3
nd = dn_load_u32 4 6
ng = dn_load_u32 5 7
dn_collect_cos false nd get dn_sp_st 2 get dn_sp_st 4 0
dn_collect_cos true ng get dn_sp_st 2 get dn_sp_st 4 1
gmax = dn_max_gcos ng
tau = dn_choose_tau nd ng margin gmax
sp_fnv = dn_sp_write 3 get dn_sp_st 1 get dn_sp_st 3 get dn_sp_st 4 tau
dn_put_cstr dn_l_cal
dn_putf tau 6
dn_put_cstr dn_l_gmx
dn_putf gmax 6
dn_put_cstr dn_l_da
dn_putf div f64 dn_count_above false nd tau f64 nd 6
dn_put_cstr dn_l_ga
dn_putf div f64 dn_count_above true ng tau f64 ng 6
dn_put_cstr dn_l_fnv
dn_puth16 sp_fnv
uputc 10
uflush
dn_be_close
end

fn dn_sp_win_prep_a wct ulong d ulong to void
dn_enlarge_f 9 mul wct d
for t ulong wct
  zb = mul t d
  if eq get dn_active t 0
    for j ulong d
      put dn_mm_a add zb j 0.0f64
    end
  else
    inv = dn_vec_norm_zbuf zb d
    for j3 ulong d
      val = mul get dn_zbuf add zb j3 inv
      put dn_mm_a add zb j3 val
    end
  end
end
end

fn dn_sp_win_apply_delta wct ulong d ulong to void
for t ulong wct
  if ne get dn_active t 0
    zb = mul t d
    for j ulong d
      val = add get dn_zbuf add zb j get dn_mm_c add zb j
      put dn_zbuf add zb j val
    end
  end
end
end

fn dn_prep_wup_b fe ulong d ulong to void
dn_enlarge_tr 9 mul fe d
dn_enlarge_tr 10 mul d fe
for i ulong mul fe d
  put dn_qwup i get dn_wup i
end
dn_transpose_wup fe d
dn_enlarge_f 10 mul d fe
for i2 ulong mul d fe
  put dn_mm_b i2 get dn_qwup_t i2
end
end

fn dn_apply_sp_win wct ulong fe ulong d ulong any_act bool to void
if not any_act
  ret
end
dn_sp_win_prep_a wct d
dn_enlarge_f 10 mul fe d
for i ulong mul fe d
  put dn_mm_b i get dn_win i
end
dn_enlarge_f 11 mul wct fe
dn_be_gemm_abT wct fe d
dn_enlarge_f 9 mul wct fe
for p ulong mul wct fe
  xv = get dn_mm_c p
  put dn_mm_a p mul xv ufsig xv
end
dn_prep_wup_b fe d
dn_enlarge_f 11 mul wct d
dn_be_gemm_abT wct d fe
dn_sp_win_apply_delta wct d
end

fn dn_eval_guard_win wct ulong d ulong np ulong tau f64 to bool
any_act = false
for t ulong wct
  dn_win_ema_vec t d
  if ge dn_max_proto_cos d np tau
    put dn_active t 1
    put dn_st 20 add get dn_st 20 1
    any_act = true
  else
    put dn_active t 0
  end
end
ret any_act
end

fn dn_accum_guard_win wct ulong to void
sb = 0.0f64
sg = 0.0f64
sj = 0.0f64
hb = ulong 0
hg = ulong 0
for t ulong wct
  sb = add sb get dn_bl t
  sg = add sg get dn_gl t
  sj = add sj get dn_jsd t
  hb = add hb get dn_bh t
  hg = add hg get dn_gh t
end
put dn_c_par 3 add get dn_c_par 3 sb
put dn_c_par 4 add get dn_c_par 4 sg
put dn_c_par 7 add get dn_c_par 7 sj
put dn_st 21 add get dn_st 21 hb
put dn_st 22 add get dn_st 22 hg
end

fn dn_eval_guard_split n ulong fe ulong d ulong np ulong tau f64 to void
put dn_c_par 3 0.0f64
put dn_c_par 4 0.0f64
put dn_c_par 5 0.0f64
put dn_c_par 6 0.0f64
put dn_c_par 7 0.0f64
put dn_st 20 0
put dn_st 21 0
put dn_st 22 0
pos = ulong 0
while lt pos n bound 9223372036854775807
  wct = sub n pos
  if gt wct 128
    wct = 128
  end
  dn_fill_win false pos wct
  dn_be_win_run false
  any_act = dn_eval_guard_win wct d np tau
  dn_apply_sp_win wct fe d any_act
  dn_be_guard_eval_win wct any_act
  dn_accum_guard_win wct
  pos = add pos wct
end
put dn_c_par 3 div get dn_c_par 3 f64 n
put dn_c_par 4 div get dn_c_par 4 f64 n
put dn_c_par 5 div f64 get dn_st 21 f64 n
put dn_c_par 6 div f64 get dn_st 22 f64 n
put dn_c_par 7 div get dn_c_par 7 f64 n
end

fn dn_rcp_b b ulong to void
p = get dn_rpos 0
if lt p 4090
  put dn_rcp p uchar and b 255
  put dn_rpos 0 add p 1
end
end

fn dn_rcp_hex v ulong to void
dn_rcp_b 48
dn_rcp_b 120
for i ulong 16
  sh = mul sub 15 i 4
  nib = and shr v sh 15
  if lt nib 10
    dn_rcp_b add 48 nib
  else
    dn_rcp_b add 87 nib
  end
end
end

fn dn_rcp_u v ulong to void
if eq v 0
  dn_rcp_b 48
  ret
end
buf = new uchar 32 0
n = ulong 0
x = v
while gt x 0 bound 64
  put buf n uchar add 48 rem x 10
  x = div x 10
  n = add n 1
end
for i ulong n
  dn_rcp_b ulong get buf sub sub n 1 i
end
end

fn dn_fnv_rcp to ulong
h = DN_FNV_OFF
n = get dn_rpos 0
for i ulong n
  h = mul xor h ulong get dn_rcp i DN_FNV_PRM
end
ret h
end

fn dn_build_guard_rcp nd ulong ng ulong tau f64 to ulong
put dn_rpos 0 0
dn_rcp_hex get dn_st 16
dn_rcp_b 124
dn_rcp_hex get dn_sp_st 8
dn_rcp_b 124
dn_rcp_hex bitcast ulong tau
dn_rcp_b 124
dn_rcp_u nd
dn_rcp_b 124
dn_rcp_hex bitcast ulong get dn_c_par 9
dn_rcp_b 124
dn_rcp_hex bitcast ulong get dn_c_par 10
dn_rcp_b 124
dn_rcp_u get dn_st 29
dn_rcp_b 124
dn_rcp_u ng
dn_rcp_b 124
dn_rcp_hex bitcast ulong get dn_c_par 3
dn_rcp_b 124
dn_rcp_hex bitcast ulong get dn_c_par 4
dn_rcp_b 124
dn_rcp_u get dn_st 20
dn_rcp_b 124
dn_rcp_hex bitcast ulong get dn_c_par 7
ret dn_fnv_rcp
end

fn dn_print_guard nd ulong ng ulong tau f64 rcp_h ulong dt_ms f64 to void
dn_put_cstr dn_l_spg
dn_putf tau 6
dn_put_cstr dn_l_db
dn_putf get dn_c_par 9 6
dn_put_cstr dn_l_ds
dn_putf get dn_c_par 10 6
dn_put_cstr dn_l_dd
dn_putf sub get dn_c_par 10 get dn_c_par 9 6
dn_put_cstr dn_l_da
dn_putf div f64 get dn_st 29 f64 nd 6
dn_put_cstr dn_l_gb
dn_putf get dn_c_par 3 6
dn_put_cstr dn_l_gs
dn_putf get dn_c_par 4 6
dn_put_cstr dn_l_gd
dn_putf sub get dn_c_par 4 get dn_c_par 3 6
dn_put_cstr dn_l_ga
dn_putf div f64 get dn_st 20 f64 ng 6
dn_put_cstr dn_l_gjsd
dn_putf get dn_c_par 7 6
dn_put_cstr dn_l_rcp
dn_puth16 rcp_h
dn_put_cstr dn_l_ms
dn_putf dt_ms 2
uputc 10
uflush
end

fn dn_write_guard_json nd ulong ng ulong tau f64 rcp_h ulong dt_ms f64 to void
put dn_jpos 0 0
dn_jb 123
dn_jb 10
dn_jhex_kv dn_k_th get dn_st 16 true
dn_jhex_kv dn_k_sf get dn_sp_st 8 true
dn_ju_kv dn_k_sb get dn_sp_st 9 true
dn_jf_kv dn_k_ta tau 6 true
dn_jhex_kv dn_k_tb bitcast ulong tau true
dn_ju_kv dn_k_dn nd true
dn_jf_kv dn_k_dbl get dn_c_par 9 6 true
dn_jf_kv dn_k_dsl get dn_c_par 10 6 true
dn_jf_kv dn_k_ddl sub get dn_c_par 10 get dn_c_par 9 6 true
dn_jf_kv dn_k_dbp ufexp get dn_c_par 9 6 true
dn_jf_kv dn_k_dsp ufexp get dn_c_par 10 6 true
dn_jf_kv dn_k_dba get dn_c_par 11 6 true
dn_jf_kv dn_k_dsa get dn_c_par 12 6 true
dn_ju_kv dn_k_da get dn_st 29 true
dn_jf_kv dn_k_dar div f64 get dn_st 29 f64 nd 6 true
dn_jf_kv dn_k_dj get dn_c_par 13 6 true
dn_jhex_kv dn_k_dbb bitcast ulong get dn_c_par 9 true
dn_jhex_kv dn_k_dsb bitcast ulong get dn_c_par 10 true
dn_ju_kv dn_k_gn ng true
dn_jf_kv dn_k_gbl get dn_c_par 3 6 true
dn_jf_kv dn_k_gsl get dn_c_par 4 6 true
dn_jf_kv dn_k_gdl sub get dn_c_par 4 get dn_c_par 3 6 true
dn_jf_kv dn_k_gbp ufexp get dn_c_par 3 6 true
dn_jf_kv dn_k_gsp ufexp get dn_c_par 4 6 true
dn_jf_kv dn_k_gba get dn_c_par 5 6 true
dn_jf_kv dn_k_gsa get dn_c_par 6 6 true
dn_ju_kv dn_k_ga get dn_st 20 true
dn_jf_kv dn_k_gar div f64 get dn_st 20 f64 ng 6 true
dn_jf_kv dn_k_gj get dn_c_par 7 6 true
dn_jhex_kv dn_k_gbb bitcast ulong get dn_c_par 3 true
dn_jhex_kv dn_k_gsb bitcast ulong get dn_c_par 4 true
dn_jhex_kv dn_k_gjb bitcast ulong get dn_c_par 7 true
dn_jhex_kv dn_k_rh rcp_h true
dn_jf_kv dn_k_em dt_ms 2 false
dn_jb 125
dn_jb 10
dn_jwrite 6
end

fn dn_cmd_spguard_eval to void
na = ulong argcnt
if and ne na 6 and ne na 7 ne na 8
  exit 2
end
dn_open_trunk 2 false true
dn_sp_load_fast 3
tau = bitcast f64 get dn_sp_st 5
if eq na 8
  tau = dn_parf 7
end
t0 = monons
nd = dn_load_u32 4 6
dn_eval_guard_split nd get dn_sp_st 3 get dn_sp_st 2 get dn_sp_st 4 tau
put dn_c_par 9 get dn_c_par 3
put dn_c_par 10 get dn_c_par 4
put dn_c_par 11 get dn_c_par 5
put dn_c_par 12 get dn_c_par 6
put dn_c_par 13 get dn_c_par 7
put dn_st 29 get dn_st 20
ng = dn_load_u32 5 6
dn_eval_guard_split ng get dn_sp_st 3 get dn_sp_st 2 get dn_sp_st 4 tau
dt_ms = div f64 sub monons t0 1000000.0f64
rcp_h = dn_build_guard_rcp nd ng tau
dn_print_guard nd ng tau rcp_h dt_ms
if ge na 7
  dn_write_guard_json nd ng tau rcp_h dt_ms
end
dn_be_close
end

fn dn_cmd_swap_bench to void
na = ulong argcnt
if and ne na 5 ne na 6
  exit 2
end
iters = ulong 20
if eq na 6
  iters = dn_paru 5
end
if eq iters 0
  exit 2
end
dn_open_trunk 2 false false
ba = ulong 0
bb = ulong 0
tot_ns = ulong 0
max_ns = ulong 0
for it ulong iters
  ai = ulong 3
  if ne rem it 2 0
    ai = 4
  end
  t0 = ulong monons
  dn_sp_load_fast ai
  dt = sub ulong monons t0
  tot_ns = add tot_ns dt
  if gt dt max_ns
    max_ns = dt
  end
  if eq it 0
    ba = get dn_sp_st 9
  else
    if eq it 1
      bb = get dn_sp_st 9
    end
  end
end
dn_put_cstr dn_l_swp
uputu iters
dn_put_cstr dn_l_ba
uputu ba
dn_put_cstr dn_l_bb
uputu bb
dn_put_cstr dn_l_mm
dn_putf div f64 tot_ns mul f64 iters 1000000.0f64 3
dn_put_cstr dn_l_mx
dn_putf div f64 max_ns 1000000.0f64 3
uputc 10
uflush
end

fn dn_cmd_dumpk to void
if ne ulong argcnt 3
  exit 2
end
pl = dn_path_arg 2
if not dn_be_dump_kernels pl
  exit 2
end
end

fn main to int
if lt ulong argcnt 2
  exit 2
end
if dn_arg_eq 1 dn_s_info
  dn_cmd_info
  ret 0
end
if dn_arg_eq 1 dn_s_base
  dn_cmd_base_eval
  ret 0
end
if dn_arg_eq 1 dn_s_cryst
  dn_cmd_cryst
  ret 0
end
if dn_arg_eq 1 dn_s_spinfo
  dn_cmd_spinfo
  ret 0
end
if dn_arg_eq 1 dn_s_calcos
  dn_cmd_cal_cos
  ret 0
end
if dn_arg_eq 1 dn_s_guard
  dn_cmd_spguard_eval
  ret 0
end
if dn_arg_eq 1 dn_s_swap
  dn_cmd_swap_bench
  ret 0
end
if dn_arg_eq 1 dn_s_dumpk
  dn_cmd_dumpk
  ret 0
end
exit 2
end
