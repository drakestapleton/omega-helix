fn dn_enlarge_f arr_id ulong n ulong to void
r = long 0
if eq arr_id 0
  r = enlarge dn_act n
end
if eq arr_id 1
  r = enlarge dn_tmp n
end
if eq arr_id 2
  r = enlarge dn_rcos n
end
if eq arr_id 3
  r = enlarge dn_rsin n
end
if eq arr_id 4
  r = enlarge dn_zbuf n
end
if eq arr_id 5
  r = enlarge dn_rbuf n
end
if eq arr_id 6
  r = enlarge dn_bl n
end
if eq arr_id 7
  r = enlarge dn_gl n
end
if eq arr_id 8
  r = enlarge dn_jsd n
end
if eq arr_id 9
  r = enlarge dn_mm_a n
end
if eq arr_id 10
  r = enlarge dn_mm_b n
end
if eq arr_id 11
  r = enlarge dn_mm_c n
end
if ne r 0
  exit 70
end
end

