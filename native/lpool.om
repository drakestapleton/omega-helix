note SPDX-License-Identifier: AGPL-3.0-only
note omegallm lpool.om: dynamic om2 bank-B pools for hosted targets (gb10, aarch64, macos, x86linux).
note Grows on demand via `enlarge` up to 150M+ parameters (e.g. 120M single-trunk + multi-strand DNA).
const OWWN ulong 150000000
global oww f64 *
const OGBN ulong 150000000
global ogb f64 *
const OABN ulong 120000000
global oab f64 *
global olp_sz ulong 3

fn olp_grow w ulong g ulong a ulong to bool
if gt w get olp_sz 0
r = enlarge oww w
if ne r 0
ret false
end
put olp_sz 0 w
end
if gt g get olp_sz 1
r = enlarge ogb g
if ne r 0
ret false
end
put olp_sz 1 g
end
if gt a get olp_sz 2
r = enlarge oab a
if ne r 0
ret false
end
put olp_sz 2 a
end
ret true
end
