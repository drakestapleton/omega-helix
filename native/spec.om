note spclip run RECIPE.spclip PROMPT N TEMPMILLI SEED MERGES [--weights ...] [--mode M] [--tau T] [--splice ...]
fn cmdspclip_run to void
if lt oargc 9
exit 2
end
rec_ai = ovp_from_arg 36 3
osp_rec_load rec_ai
nn = oargu 5
if gt nn 999999
exit 2
end
tm = oargu 6
sd = oargu 7
osp_parse_dyn_flags 9 0
osp_clip_validate_knobs
osp_clip_init
v = get og 0
if gt v 256
obload 8 v
end
osp_prompt 4 v
osp_clip_loop nn sd tm
end

note Evaluate one full window of T positions under clipped + spliced strands (exact per-row log-prob fusion)
fn osp_clip_eval_br s ulong tt ulong hfin_off ulong to void
tl = get ocl_st 3
sl = get ocl_sl s
wo = get ocl_wo s
wn = get ocl_wn s
if gt wn 0
osp_c2wb get ocl_st 4 wo wn
end
osp_hrest osp_hout tl get ocl_st 7 mul tt get og 2
put og 9 tt
put okv 0 0
put ogkm 1 0
ta = osp_app tl
for k ulong sub sl tl
olayf add ta k
end
td = mul tt get og 2
osp_hsnap add hfin_off mul s td osp_hout sl td
end

fn osp_clip_row_proj s ulong t ulong r ulong to void
hf = add get og 15 r
z = add get og 17 r
s0 = add get og 16 t
frms hf get og 33 z s0
klogit z get og 27 get og 0 get og 2
osp_clip_lsm s
end

fn osp_clip_eval_row_s s ulong t ulong tt ulong hfin_off ulong to void
d = get og 2
r = mul t d
osp_c2wb get og 33 add get ocl_wo s get ocl_wn s d
osp_hrest add get og 15 r add add hfin_off mul s mul tt d r d
osp_clip_row_proj s t r
end

fn osp_clip_eval_row t ulong tt ulong hfin_off ulong to f64
for s ulong get ocl_st 1
osp_clip_eval_row_s s t tt hfin_off
end
osp_clip_fuse
ret olossrow get og 27 get og 0 get oby t
end

fn osp_clip_eval_win w ulong hfin_off ulong to f64
tt = get og 1
tl = get ocl_st 3
obrow 0 mul w tt
put og 9 tt
put okv 0 0
put ogkm 1 0
oemb 0
ta = osp_app tl
for l ulong ta
olayf l
end
osp_hsnap get ocl_st 7 osp_hout tl mul tt get og 2
for s ulong get ocl_st 1
osp_clip_eval_br s tt hfin_off
end
ls = 0.0f64
for t ulong tt
ls = add ls osp_clip_eval_row t tt hfin_off
end
ret div ls f64 tt
end

note spclip eval RECIPE.spclip HELD W MERGES [--weights ...] [--mode M] [--tau T] [--splice ...]
fn cmdspclip_eval to void
if lt oargc 7
exit 2
end
rec_ai = ovp_from_arg 36 3
osp_rec_load rec_ai
ww = oargu 5
osp_parse_dyn_flags 7 0
osp_clip_validate_knobs
osp_clip_init
v = get og 0
if gt v 256
obload 6 v
end
odopen 4
tt = get og 1
m = get odn 0
if eq ww 0
exit 23
end
if gt ww div sub m 1 tt
exit 23
end
hfin_off = get ocl_st 8
td = mul tt get og 2
if gt add hfin_off mul get ocl_st 1 td ocsinit
exit 12
end
ls = 0.0f64
nb = ulong 0
for w ulong ww
ls = add ls osp_clip_eval_win w hfin_off
if gt v 256
nb = add nb oevnb tt
end
end
lo = div ls f64 ww
bp = div lo 0.6931471805599453
if gt v 256
bp = div mul bp f64 mul ww tt f64 nb
end
oputc 83
oputc 80
oputc 67
oputc 76
oputc 73
oputc 80
oputc 95
oputc 69
oputc 86
oputc 65
oputc 76
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 32
oputu get ocl_st 1
oputc 32
oputu get ocl_st 0
oputc 32
oputu get ocl_cfg 0
oputc 10
oflush
end

note ---- 14. spclip tune (Materialize + Frozen-Trunk Fine-Tune -> Verified OLLMSP01 + OLLMSPLIN01) ----

fn osp_tune_cal_s s2 ulong hfin_off ulong to void
tt = get og 1
eh = 0.0f64
for t ulong tt
osp_clip_eval_row_s s2 t tt hfin_off
eh = add eh get ocl_ent s2
end
put ocl_ent s2 div eh f64 tt
end

note Calibrate effective strand weights ocl_tun_al[0..S) (for MODE=1 measures mean entropy on window 0 of DATA)
fn osp_tune_cal_al to void
ss = get ocl_st 1
if eq get ocl_st 0 0
osp_clip_calc_al
for s ulong ss
put ocl_tun_al s get ocl_al s
end
ret
end
tt = get og 1
tl = get ocl_st 3
hfin_off = get ocl_st 8
td = mul tt get og 2
if gt add hfin_off mul ss td ocsinit
exit 12
end
obrow 0 0
put og 9 tt
put okv 0 0
put ogkm 1 0
oemb 0
for l ulong osp_app tl
olayf l
end
osp_hsnap get ocl_st 7 osp_hout tl td
for s ulong ss
osp_clip_eval_br s tt hfin_off
end
for s2 ulong ss
osp_tune_cal_s s2 hfin_off
end
osp_clip_calc_al
for s3 ulong ss
put ocl_tun_al s3 get ocl_al s3
end
end

fn osp_is_res_off i ulong to bool
d = get og 2
wo_lo = add d mul 3 mul d d
wo_hi = add wo_lo mul d d
if and ge i wo_lo lt i wo_hi
ret true
end
w2_lo = add add wo_hi d mul d get og 4
ret ge i w2_lo
end

fn osp_tune_blend_1 k ulong i ulong psum f64 use_w bool to f64
ss = get ocl_st 1
tl = get ocl_st 3
koff = mul k get og 32
is_res = osp_is_res_off i
acc = 0.0f64
for s ulong ss
if gt sub get ocl_sl s tl k
al = get ocl_tun_al s
if use_w
al = get ocl_w s
end
if or is_res gt al 0.0
acc = add acc mul al ocsg add add get ocl_wo s koff i
end
end
end
ret div acc psum
end

note Blend one materialized branch layer k into ow[fzt + k*lstr ..) using ocl_tun_al[0..S)
fn osp_tune_blend_lay k ulong to void
ss = get ocl_st 1
tl = get ocl_st 3
psum = 0.0f64
for s0 ulong ss
if and gt get ocl_w s0 0.0 gt sub get ocl_sl s0 tl k
psum = add psum get ocl_tun_al s0
end
end
use_w = false
if le psum 0.0
use_w = true
for s1 ulong ss
if and gt get ocl_w s1 0.0 gt sub get ocl_sl s1 tl k
psum = add psum get ocl_w s1
end
end
if le psum 0.0
exit 2
end
end
lstr = get og 32
dst = add get ocl_st 4 mul k lstr
i = ulong 0
while lt i lstr bound 9223372036854775807
owp add dst i osp_tune_blend_1 k i psum use_w
i = add i 1
end
end

fn osp_tune_blend_gf to void
ss = get ocl_st 1
d = get og 2
psum_g = 0.0f64
for s0 ulong ss
if gt get ocl_w s0 0.0
psum_g = add psum_g get ocl_tun_al s0
end
end
for g ulong d
acc = 0.0f64
for s2 ulong ss
if gt get ocl_w s2 0.0
goff = add get ocl_wo s2 get ocl_wn s2
acc = add acc mul get ocl_tun_al s2 ocsg add goff g
end
end
put odl2 g div acc psum_g
end
end

fn osp_tune_add_lays maxd ulong addl ulong to void
tl = get ocl_st 3
fzt = get ocl_st 4
lstr = get og 32
src_off = add get og 31 mul sub add tl maxd 1 lstr
for a ulong addl
dst_off = add fzt mul add maxd a lstr
i = ulong 0
while lt i lstr bound 9223372036854775807
owp add dst_off i owg add src_off i
i = add i 1
end
end
ogrowsilent add tl maxd
end

fn osp_tune_finish_ow child_l ulong need_p ulong to void
if ne child_l get og 5
if gt need_p ocsinit
exit 12
end
osp_w2c 0 0 need_p
put og 5 child_l
if not ogeom
exit 12
end
osp_c2wb 0 0 need_p
end
for g2 ulong get og 2
owp add get og 33 g2 get odl2 g2
end
end

note Materialize clipped + spliced mix (+ optional add_layers) into ow with target depth child_L
fn osp_tune_materialize to ulong
ss = get ocl_st 1
tl = get ocl_st 3
maxd = ulong 0
for s ulong ss
if gt get ocl_w s 0.0
ds = sub get ocl_sl s tl
if gt ds maxd
maxd = ds
end
end
end
addl = get ocl_cfg 5
child_l = add add tl maxd addl
if eq get ocl_cfg 4 0
put ocl_exp 11 get ocl_st 2
put ocl_exp 13 get ocl_st 11
else
put ocl_exp 11 tl
put ocl_exp 12 get ocl_st 4
put ocl_exp 13 get ocl_exp 14
end
if or le child_l get ocl_exp 11 gt child_l 24
exit 2
end
for k ulong maxd
osp_tune_blend_lay k
end
osp_tune_blend_gf
if gt addl 0
osp_tune_add_lays maxd addl
end
osp_tune_finish_ow child_l add get ocl_st 4 mul add maxd addl get og 32
ret child_l
end

note Write canonical OLLMSPLIN01 Merkle lineage certificate to dst_ai; stores lineage_sha256 in ocl_tsha
fn osp_lin_write dst_ai ulong steps ulong lrm ulong bat ulong child_l ulong nspec ulong to void
osr_reset
osr_putkw 1
osr_putkw 16
osr_putslot 33
osr_putc 10
osr_putkw 17
for i ulong 32
put osha_d i get ocl_csha i
end
osr_putsha_d
osr_putc 10
osr_putkw 18
osr_putu get ocl_exp 11
osr_putc 10
osr_putkw 19
osr_putu child_l
osr_putc 10
osr_putkw 20
osr_putx64 get ocl_exp 13
osr_putc 10
osr_putkw 21
osr_putx64 get ocl_exp 15
osr_putc 10
osr_putkw 22
osr_putu nspec
osr_putc 10
osr_putkw 2
osr_putslot 0
osr_putc 10
osr_putkw 3
for i2 ulong 32
put osha_d i2 get ocl_bsha i2
end
osr_putsha_d
osr_putc 10
osr_putkw 4
osr_putu get ocl_st 2
osr_putc 10
osr_putkw 5
osr_putx64 get ocl_st 11
osr_putc 10
osr_putkw 23
osr_putu get ocl_st 3
osr_putc 10
osr_putkw 24
for i3 ulong 32
put osha_d i3 get ocl_rsha i3
end
osr_putsha_d
osr_putc 10
osr_putkw 6
osr_putu get ocl_st 0
osr_putc 10
osr_putkw 7
osr_putu get ocl_cfg 0
osr_putc 10
osr_putkw 25
for i4 ulong 32
put osha_d i4 get ocl_dsha i4
end
osr_putsha_d
osr_putc 10
osr_putkw 26
osr_putu steps
osr_putc 10
osr_putkw 27
osr_putu lrm
osr_putc 10
osr_putkw 28
osr_putu bat
osr_putc 10
osr_putkw 29
osr_putl rmic get ocl_tun_ls 0
osr_putc 10
osr_putkw 30
osr_putl rmic get ocl_tun_ls 1
osr_putc 10
osr_putkw 8
osr_putu get ocl_st 1
osr_putc 10
osp_lin_wr_strands
osha_buf_ocl get ocl_rlen 0
osha_save_tsha
osr_putkw 31
osr_putsha_d
osr_putc 10
osr_flush_file dst_ai
end

fn osp_lin_wr_strands to void
ss = get ocl_st 1
for s ulong ss
osr_putkw 9
osr_putu s
osr_putc 32
osr_putkw 10
osr_putl get ocl_wm s
osr_putc 32
osr_putkw 15
osr_putl rmic get ocl_tun_al s
osr_putc 32
osr_putkw 11
osr_putu get ocl_sp_s s
osr_putc 58
osr_putu get ocl_sp_e s
osr_putc 58
osr_putu get ocl_sp_g s
osr_putc 32
osr_putkw 12
osr_putu get ocl_k s
osr_putc 10
for j ulong get ocl_k s
idx = add mul s 8 j
osr_putkw 13
osr_putu s
osr_putc 32
osr_putu j
osr_putc 32
osr_putslot add 1 idx
osr_putc 32
bo = mul idx 32
for b ulong 32
put osha_d b get ocl_lsha add bo b
end
osr_putsha_d
osr_putc 32
osr_putx64 get ocl_lph idx
osr_putc 10
end
end
end

fn osp_tune_run_opt steps ulong lrm ulong to void
tl = get ocl_st 3
fzt = get ocl_st 4
ozerom mul 2 get og 8
put ofreeze 0 fzt
put ofzlay 0 osp_app tl
put og 41 0
tot = steps
if eq tot 0
tot = ulong 1
end
put og 42 tot
put og 43 bitcast ulong div f64 lrm 1000000.0
put og 44 1
put og 45 1
if ne get ocl_cfg 6 0
put og 6 get ocl_cfg 6
end
obrow 0 0
put og 9 get og 1
put ocl_tun_ls 0 ofwd 0
s = ulong 0
while lt s steps bound 999999
ls = ostep
s = add s 1
end
obrow 0 0
put og 9 get og 1
put ocl_tun_ls 1 ofwd 0
put ofreeze 0 0
put ofzlay 0 0
end

note spclip tune RECIPE.spclip DATA OUT.sp STEPS LRMICRO [--batch B] [--weights ...] [--mode M] [--tau T] [--splice ...] [--add-layers K] [--trunk-link] [--lineage PATH | --no-lineage]
fn cmdspclip_tune to void
if lt oargc 8
exit 2
end
rec_ai = ovp_from_arg 36 3
osp_rec_load rec_ai
data_ai = ovp_from_arg 34 4
out_ai = ovp_from_arg 33 5
steps = oargu 6
if gt steps 999999
exit 2
end
lrm = oargu 7
if and gt steps 0 eq lrm 0
exit 2
end
osp_parse_dyn_flags 8 2
osp_clip_validate_knobs
lin_ai = get ocl_cfg 7
if eq lin_ai 0
lin_ai = ovp_set_lin 35 5
put ocl_cfg 7 lin_ai
end
osha_file data_ai
osha_save_dsha
osp_clip_init
odopen data_ai
osp_tune_cal_al
child_l = osp_tune_materialize
osp_tune_run_opt steps lrm
ex_bl = get ocl_exp 11
ex_fz = get ocl_exp 12
ex_bh = get ocl_exp 13
if ne osp_basehash ex_bl ex_fz ex_bh
exit 62
end
if ne osp_basehash get ocl_st 3 get ocl_st 4 get ocl_exp 14
exit 62
end
nspec = sub get og 8 ex_fz
osp_wrpack out_ai ex_bl child_l ex_bh ex_fz nspec
if ne oprd out_ai 0 0 48 48
exit 60
end
put ocl_exp 15 opw8 40
osha_file out_ai
osha_save_csha
lin_ai = get ocl_cfg 7
if ne lin_ai 999999
osp_lin_write lin_ai steps lrm get og 6 child_l nspec
else
for z ulong 32
put ocl_tsha z 0
end
end
oputc 83
oputc 80
oputc 67
oputc 76
oputc 73
oputc 80
oputc 95
oputc 84
oputc 85
oputc 78
oputc 69
oputc 32
oputu ex_bl
oputc 32
oputu child_l
oputc 32
oputu nspec
oputc 32
oputu steps
oputc 32
oputl rmic get ocl_tun_ls 0
oputc 32
oputl rmic get ocl_tun_ls 1
oputc 32
oput_sha_csha
oputc 32
oput_sha_tsha
oputc 10
oflush
end

fn osp_lin_rd_strand s ulong to void
osr_eat_kw 9
if ne osr_rd_u 32 s
exit 60
end
osr_eat_kw 10
put ocl_wm s osr_rd_l 32
osr_eat_kw 15
am = osr_rd_l 32
osr_eat_kw 11
sps = osr_rd_u 58
spe = osr_rd_u 58
spg = osr_rd_u 32
if or gt sps 24 gt spe 24
exit 60
end
if or and eq sps 0 ne spe 0 and ne sps 0 eq spe 0
exit 60
end
put ocl_sp_s s sps
put ocl_sp_e s spe
put ocl_sp_g s spg
osr_eat_kw 12
ks = osr_rd_u 10
if or eq ks 0 gt ks 8
exit 60
end
put ocl_k s ks
for j ulong ks
osr_eat_kw 13
if ne osr_rd_u 32 s
exit 60
end
if ne osr_rd_u 32 j
exit 60
end
idx = add mul s 8 j
ai = osr_rd_path add 1 idx 32
put ocl_link idx ai
osr_rd_sha_d 32
osha_save_lsha idx
put ocl_lph idx osr_rd_x64 10
end
end

fn osp_lin_parse_hdr to ulong
osr_eat_kw 1
osr_eat_kw 16
child_ai = osr_rd_path 33 10
osr_eat_kw 17
osr_rd_sha_d 10
osha_save_csha
osr_eat_kw 18
put ocl_exp 2 osr_rd_u 10
osr_eat_kw 19
put ocl_exp 3 osr_rd_u 10
osr_eat_kw 20
put ocl_exp 4 osr_rd_x64 10
osr_eat_kw 21
put ocl_exp 5 osr_rd_x64 10
osr_eat_kw 22
put ocl_exp 6 osr_rd_u 10
osr_eat_kw 2
put ocl_cfg 1 osr_rd_path 0 10
osr_eat_kw 3
osr_rd_sha_d 10
osha_save_bsha
osr_eat_kw 4
put ocl_exp 0 osr_rd_u 10
osr_eat_kw 5
put ocl_exp 1 osr_rd_x64 10
osr_eat_kw 23
put ocl_exp 7 osr_rd_u 10
osr_eat_kw 24
osr_rd_sha_d 10
osha_save_rsha
osr_eat_kw 6
put ocl_st 0 osr_rd_u 10
osr_eat_kw 7
put ocl_cfg 0 osr_rd_u 10
osr_eat_kw 25
osr_rd_sha_d 10
osha_save_dsha
osr_eat_kw 26
put ocl_exp 8 osr_rd_u 10
osr_eat_kw 27
put ocl_exp 9 osr_rd_u 10
osr_eat_kw 28
put ocl_exp 10 osr_rd_u 10
osr_eat_kw 29
z0 = osr_rd_l 10
osr_eat_kw 30
z1 = osr_rd_l 10
ret child_ai
end

note spclip verify-lineage FILE.lineage: fail-closed Merkle verification of lineage seal + child + base + all parents
fn cmdspclip_vlin to void
if ne oargc 4
exit 2
end
osp_clip_defaults
lin_ai = ovp_from_arg 35 3
osr_read_file lin_ai
child_ai = osp_lin_parse_hdr
osr_eat_kw 8
ss = osr_rd_u 10
if or lt ss 2 gt ss 4
exit 60
end
put ocl_st 1 ss
for s ulong ss
osp_lin_rd_strand s
end
seal_end = get ocl_rcur 0
osr_eat_kw 31
osr_rd_sha_d 10
osha_save_tsha
if ne get ocl_rcur 0 get ocl_rlen 0
exit 60
end
osha_buf_ocl seal_end
if not osha_eq_tsha
exit 61
end
put ocl_cfg 2 1
put ocl_cfg 3 1
osp_clip_validate_knobs
osp_clip_init
if ne get ocl_st 3 get ocl_exp 7
exit 62
end
osha_file child_ai
if not osha_eq_csha
exit 61
end
c_bl = get ocl_exp 2
c_bh = get ocl_exp 4
if eq c_bl get ocl_st 2
if ne c_bh get ocl_st 11
exit 62
end
else
if or ne c_bl get ocl_st 3 ne c_bh get ocl_exp 14
exit 62
end
end
osp_rdhdr child_ai c_bl c_bh
if ne get ottt_st 1 get ocl_exp 3
exit 61
end
if ne get ottt_st 3 get ocl_exp 6
exit 61
end
if ne get ottt_st 4 get ocl_exp 5
exit 61
end
osp_chkpay child_ai get ottt_st 3 get ottt_st 4
oputc 83
oputc 80
oputc 67
oputc 76
oputc 73
oputc 80
oputc 95
oputc 76
oputc 73
oputc 78
oputc 69
oputc 65
oputc 71
oputc 69
oputc 95
oputc 86
oputc 69
oputc 82
oputc 73
oputc 70
oputc 89
oputc 32
oputc 79
oputc 75
oputc 32
oput_sha_csha
oputc 32
oputu get ocl_st 1
oputc 32
oputu get ocl_exp 3
oputc 32
oput_sha_tsha
oputc 10
oflush
end

fn cmdspclip_legacy to void
osp_clip_defaults
osp_clip_parse
nn = oargu 5
if gt nn 999999
exit 2
end
tm = oargu 6
st = oargu 7
osp_clip_init
v = get og 0
if gt v 256
obload 8 v
end
osp_prompt 4 v
osp_clip_loop nn st tm
end

fn cmdspclip to void
if lt oargc 3
exit 2
end
if osp_arg_eq_sub 2 0
cmdspclip_create
ret
end
if osp_arg_eq_sub 2 1
cmdspclip_edit
ret
end
if osp_arg_eq_sub 2 2
cmdspclip_verify
ret
end
if osp_arg_eq_sub 2 3
cmdspclip_inspect
ret
end
if osp_arg_eq_sub 2 4
cmdspclip_run
ret
end
if osp_arg_eq_sub 2 5
cmdspclip_eval
ret
end
if osp_arg_eq_sub 2 6
cmdspclip_tune
ret
end
if osp_arg_eq_sub 2 7
cmdspclip_vlin
ret
end
cmdspclip_legacy
end
