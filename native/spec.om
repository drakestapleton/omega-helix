end
if eq kind 2
if ne n len ot_fl_sw
ret false
end
for i ulong n
if ne get oarg i get ot_fl_sw i
ret false
end
end
ret true
end
if eq kind 3
if ne n len ot_fl_mod
ret false
end
for i ulong n
if ne get oarg i get ot_fl_mod i
ret false
end
end
ret true
end
if eq kind 4
if ne n len ot_fl_tau
ret false
end
for i ulong n
if ne get oarg i get ot_fl_tau i
ret false
end
end
ret true
end
if eq kind 5
if ne n len ot_fl_spl
ret false
end
for i ulong n
if ne get oarg i get ot_fl_spl i
ret false
end
end
ret true
end
if eq kind 6
if ne n len ot_fl_ss
ret false
end
for i ulong n
if ne get oarg i get ot_fl_ss i
ret false
end
end
ret true
end
if eq kind 7
if ne n len ot_fl_out
ret false
end
for i ulong n
if ne get oarg i get ot_fl_out i
ret false
end
end
ret true
end
if eq kind 8
if ne n len ot_fl_bat
ret false
end
for i ulong n
if ne get oarg i get ot_fl_bat i
ret false
end
end
ret true
