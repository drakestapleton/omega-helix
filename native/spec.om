note ---- 1. Frozen-Core Residual Specialist Training ----
note trainf CK TOKS UNTIL EVERY FREEZE_LAYERS [BATCH]
note Freezes embeddings + layers 0..FREEZE_LAYERS-1 bit-identically while training newer layers.
fn cmdtrainf to void
na = oargc
if and ne na 7 ne na 8
exit 2
end
ockload 2
odopen 3
until = oargu 4
every = oargu 5
flay = oargu 6
if or eq every 0 gt flay get og 5
exit 2
end
if lt get odn 0 add get og 1 1
exit 23
end
put ottt_st 0 get og 6
put ottt_st 1 get og 44
if eq na 8
nb = oargu 7
if or eq nb 0 gt nb 64
exit 2
end
put og 6 nb
put og 44 1
end
fz = add get og 31 mul flay get og 32
put ofreeze 0 fz
put ofzlay 0 flay
put og 45 1
st = get og 41
while lt st until bound 999999
ls = ostep
st = get og 41
if or eq rem st every 0 eq st until
put og 6 get ottt_st 0
put og 44 get ottt_st 1
ocksave 2
if eq na 8
put og 6 oargu 7
put og 44 1
end
oputc 70
oputc 32
oputu st
oputc 32
oputu flay
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
put og 6 get ottt_st 0
put og 44 get ottt_st 1
put ofreeze 0 0
put ofzlay 0 0
end

note ---- 2. Test-Time Fast-Weights (TTT-Omega) ----
note Loops over parameters carry the largest bound the language takes: their pass count is P or a
note pack size, which ogeom and cmdspmerge have already held to the cold store, not a constant here.
note Snapshot ow[fz..P) into cold store ocs[P + i]
fn ottt_snap fz ulong to void
c = ocsinit
p = get og 8
i = fz
while lt i p bound 9223372036854775807
ocsp add p i owg i
i = add i 1
end
end

note Restore ow[fz..P) from cold store ocs[P + i]
fn ottt_rest fz ulong to void
p = get og 8
i = fz
while lt i p bound 9223372036854775807
owp i ocsg add p i
i = add i 1
end
end

note Zero cold-store gradients ocs[0..P)
fn ottt_zg to void
p = get og 8
i = ulong 0
while lt i p bound 9223372036854775807
ocsp i 0.0f64
i = add i 1
end
end

note One clipped SGD fast-weight step on ow[fz..P) using ocs[0..P)
fn ottt_sgd fz ulong lr f64 to void
p = get og 8
ss = 0.0f64
i = fz
while lt i p bound 9223372036854775807
g = ocsg i
ss = add ss mul g g
i = add i 1
end
nr = fsqrt ss
sc = lr
if gt nr 1.0
sc = div lr nr
end
i = fz
while lt i p bound 9223372036854775807
w = owg i
owp i sub w mul sc ocsg i
i = add i 1
end
end

note Evaluate suffix loss on sequence 0 over positions [pref..tt) after ofwd 0
fn ottt_suf pref ulong tt ulong to f64
ls = 0.0f64
t = pref
while lt t tt bound 1024
ls = add ls oheadr 0 t
t = add t 1
end
ret div ls f64 sub tt pref
end

note Run `steps` strictly-causal online gradient steps on prefix [0..pref)
fn ottt_adapt pref ulong steps ulong lr f64 fz ulong to void
put og 9 pref
put og 10 0
sc = div 1.0f64 f64 pref
s = ulong 0
while lt s steps bound 9223372036854775807
ottt_zg
l0 = ofwd 0
obwd 0 sc
ottt_sgd fz lr
s = add s 1
end
end

note ttteval CK HELD W PREFIX STEPS LRMICRO LAYER_FROM
fn cmdttteval to void
if ne oargc 9
exit 2
end
ockload 2
odopen 3
ww = oargu 4
pref = oargu 5
steps = oargu 6
lrm = oargu 7
lfrom = oargu 8
tt = get og 1
if or eq ww 0 or eq pref 0 ge pref tt
exit 2
end
if gt lfrom get og 5
exit 2
end
if gt ww div sub get odn 0 1 tt
exit 23
end
fz = add get og 31 mul lfrom get og 32
lr = div f64 lrm 1000000.0
b_sum = 0.0f64
t_sum = 0.0f64
for w ulong ww
obrow 0 mul w tt
put og 9 tt
l0 = ofwd 0
b_sum = add b_sum ottt_suf pref tt
ottt_snap fz
ottt_adapt pref steps lr fz
put og 9 tt
l1 = ofwd 0
t_sum = add t_sum ottt_suf pref tt
ottt_rest fz
end
put og 9 tt
b_lo = div b_sum f64 ww
t_lo = div t_sum f64 ww
oputc 84
oputc 84
oputc 84
oputc 32
oputu ww
oputc 32
oputu pref
oputc 32
oputu steps
oputc 32
oputu lrm
oputc 32
oputu lfrom
oputc 32
oputl rmic b_lo
oputc 32
oputl rmic t_lo
oputc 32
oputl rmic sub t_lo b_lo
oputc 10
oflush
end

fn ottt_prompt v ulong to void
put og 9 0
ocpush 0
if gt v 256
np = obprompt 6
for i ulong np
ocpush get obtk i
end
else
pl = oargr 6
if lt pl 0
exit 2
end
for i ulong ulong pl
ocpush ulong get oarg i
end
end
end

note tttsamp CK SEED N TEMPMILLI PROMPT MERGES STEPS LRMICRO LAYER_FROM
fn cmdtttsamp to void
if ne oargc 11
exit 2
end
ockload 2
v = get og 0
if gt v 256
obload 7 v
end
ottt_prompt v
nc = get og 9
fz = add get og 31 mul oargu 10 get og 32
lr = div f64 oargu 9 1000000.0
steps = oargu 8
ottt_snap fz
if and gt steps 0 gt nc 1
pref = sub nc 1
for j ulong pref
put oby j get obx add j 1
end
ottt_adapt pref steps lr fz
end
osampleloaded oargu 3 oargu 4 oargu 5
ottt_rest fz
end

note ---- 3. Layer-Contrastive Decoding (DoLa in pure Omega) ----
note Compute log_softmax of oa[pr..pr+v) into odl1 (which=1) or odl2 (which=2)
note Note: osoft overwrites oa[pr..pr+v) with exp(x - m), so save raw logits first.
fn odl_lsm pr ulong v ulong which ulong to void
m = bitcast f64 ulong 18442240474082181120
for j ulong v
x = get oa add pr j
m = fmax m x
if eq which 1
put odl1 j x
else
put odl2 j x
end
end
sm = osoft pr v m
lsm = flog sm
for j ulong v
if eq which 1
put odl1 j sub sub get odl1 j m lsm
else
put odl2 j sub sub get odl2 j m lsm
end
end
end

fn odl_mix pr ulong v ulong beta f64 to void
for j ulong v
put oa add pr j sub get odl1 j mul beta get odl2 j
end
end

fn odl_proj h ulong t ulong z ulong pr ulong which ulong to void
frms h get og 33 z add get og 16 t
klogit z pr get og 0 get og 2
odl_lsm pr get og 0 which
end

note Evaluate one row t with both baseline and DoLa (early layer el, contrast beta)
fn odl_row t ulong el ulong beta f64 to void
r = mul t get og 2
z = add get og 17 r
pr = add get og 18 mul t get og 0
odl_proj add get og 15 r t z pr 1
odl_proj add oahin el r t z pr 2
odl_mix pr get og 0 beta
y = get oby t
put odl1 0 sub 0.0f64 get odl1 y
put odl2 0 olossrow pr get og 0 y
end

fn odl_print ww ulong el ulong bm ulong b_lo f64 d_lo f64 to void
oputc 68
oputc 79
oputc 76
oputc 65
oputc 32
oputu ww
oputc 32
oputu el
oputc 32
oputu bm
oputc 32
oputl rmic b_lo
oputc 32
oputl rmic d_lo
oputc 32
oputl rmic sub d_lo b_lo
oputc 10
oflush
end

note dolaeval CK HELD W EARLY_LAYER BETA_MILLI
fn cmddolaeval to void
if ne oargc 7
exit 2
end
ockload 2
odopen 3
ww = oargu 4
el = oargu 5
bm = oargu 6
tt = get og 1
if or eq ww 0 or eq el 0 ge el get og 5
exit 2
end
if gt ww div sub get odn 0 1 tt
exit 23
end
beta = div f64 bm 1000.0
b_sum = 0.0f64
d_sum = 0.0f64
for w ulong ww
obrow 0 mul w tt
put og 9 tt
l0 = ofwd 0
for t ulong tt
odl_row t el beta
b_sum = add b_sum get odl1 0
d_sum = add d_sum get odl2 0
end
end
tot = f64 mul ww tt
odl_print ww el bm div b_sum tot div d_sum tot
end


note ---- 4. Swappable Specialist Layer Packs (OLLMSP01) ----
const OSPMAG ulong 3544421225449933903

note FNV-1a 64 over shapes (V,T,D,H,F,base_L) + frozen base weights ow[0..fz)
fn osp_fnvu h ulong v ulong to ulong
x = h
for k ulong 8
b = and shr v mul k 8 255
x = mul xor x b 1099511628211
end
ret x
end

fn osp_app l ulong to ulong
if gt get og 59 1
ret add l mul get og 58 sub get og 59 1
end
ret l
end

fn osp_basehash bl ulong fz ulong to ulong
h = ulong 14695981039346656037
h = osp_fnvu h get og 0
h = osp_fnvu h get og 1
h = osp_fnvu h get og 2
h = osp_fnvu h get og 3
h = osp_fnvu h get og 4
h = osp_fnvu h bl
if gt get og 59 1
h = osp_fnvu h get og 57
h = osp_fnvu h get og 58
h = osp_fnvu h get og 59
end
i = ulong 0
while lt i fz bound 9223372036854775807
h = osp_fnvu h bitcast ulong owg i
i = add i 1
end
ret h
end

note Stream ow[fz..fz+nspec) to open pack file starting at offset 48; returns payload FNV-1a 64
fn osp_wrpay fz ulong nspec ulong to ulong
h = ulong 14695981039346656037
pos = ulong 48
done = ulong 0
while lt done nspec bound 65536
cnt = sub nspec done
if gt cnt OCKC
cnt = OCKC
end
for j ulong cnt
ocput8 mul j 8 bitcast ulong owg add fz add done j
end
nb = mul cnt 8
h = ocfnvk h nb
ocwput pos nb
pos = add pos nb
done = add done cnt
end
ret h
end

note Stream nspec f64s from arg ai at offset 48 into ow[fz..fz+nspec); returns payload FNV-1a 64
fn osp_rdpay ai ulong fz ulong nspec ulong to ulong
h = ulong 14695981039346656037
pos = ulong 48
done = ulong 0
while lt done nspec bound 65536
cnt = sub nspec done
if gt cnt OCKC
cnt = OCKC
end
nb = mul cnt 8
if ne oprd ai pos 0 nb nb
exit 60
end
h = ocfnvw h nb
for j ulong cnt
owp add fz add done j bitcast f64 opw8 mul j 8
end
pos = add pos nb
done = add done cnt
end
ret h
end

note spext BASE.ck SPEC.ck PACK.sp: verify frozen base bit-identical, write OLLMSP01 specialist pack
fn cmdspext to void
if ne oargc 5
exit 2
end
ockloop 2
bl = get og 5
fz = get og 33
bh = osp_basehash bl fz
put ottt_st 0 get og 0
put ottt_st 1 get og 1
put ottt_st 2 get og 2
put ottt_st 3 get og 3
put ottt_st 4 get og 4
put ottt_st 5 bl
put ottt_st 6 fz
put ottt_st 7 bh
ockloop 3
for k ulong 5
if ne get og k get ottt_st k
exit 62
end
end
if le get og 5 get ottt_st 5
exit 62
end
if ne osp_basehash get ottt_st 5 get ottt_st 6 get ottt_st 7
exit 62
end
nspec = sub get og 8 get ottt_st 6
ocwopen 4
ph = osp_wrpay get ottt_st 6 nspec
ocput8 0 OSPMAG
ocput8 8 get ottt_st 5
ocput8 16 get og 5
ocput8 24 get ottt_st 7
ocput8 32 nspec
ocput8 40 ph
ocwput 0 48
ocwend 4
oputc 83
oputc 80
oputc 69
oputc 88
oputc 84
oputc 32
oputu get ottt_st 5
oputc 32
oputu get og 5
oputc 32
oputu nspec
oputc 10
oflush
end

fn osp_rdhdr ai ulong bl ulong bh ulong to void
sz = ofsz ai
if lt sz 48
exit 60
end
if ne oprd ai 0 0 48 48
exit 60
end
if ne opw8 0 OSPMAG
exit 60
end
if ne opw8 8 bl
exit 62
end
if le opw8 16 bl
exit 62
end
if ne opw8 24 bh
exit 62
end
nspec = opw8 32
if ne sz add 48 mul nspec 8
exit 60
end
put ottt_st 1 opw8 16
put ottt_st 3 nspec
put ottt_st 4 opw8 40
end

note Shared helper: verify base & pack hashes, attach specialist layers onto base in memory
fn osp_attach bkai ulong pkai ulong to void
ockloop bkai
put ottt_st 0 get og 5
put ottt_st 2 get og 33
osp_rdhdr pkai get ottt_st 0 osp_basehash get ottt_st 0 get ottt_st 2
ogrowsnap get og 8
put og 5 get ottt_st 1
if not ogeom
exit 12
end
if ne sub get og 8 get ottt_st 2 get ottt_st 3
exit 62
end
ozerom mul 2 get og 8
ogrowcopy get ottt_st 2
if ne osp_rdpay pkai get ottt_st 2 get ottt_st 3 get ottt_st 4
exit 61
end
end

note spapp BASE.ck PACK.sp OUT.ck: verify base & pack hashes, attach specialist layers onto base
fn cmdspapp to void
if ne oargc 5
exit 2
end
osp_attach 2 3
ocksave 4
oputc 83
oputc 80
oputc 65
oputc 80
oputc 80
oputc 32
oputu get ottt_st 0
oputc 32
oputu get ottt_st 1
oputc 32
oputu get ottt_st 3
oputc 10
oflush
end

note spsamp BASE.ck PACK.sp N TEMPMILLI PROMPT SEED [MERGES]
note Attach specialist pack in memory (no 403 MB temp checkpoint) and sample from PROMPT (argv[6])
fn cmdspsamp to void
na = oargc
if and ne na 8 ne na 9
exit 2
end
osp_attach 2 3
nn = oargu 4
if gt nn 999999
exit 2
end
tm = oargu 5
st = oargu 7
v = get og 0
if gt v 256
if eq na 8
exit 2
end
obload 8 v
end
ochipup
osampleloaded st nn tm
end

note speval BASE.ck PACK.sp HELD W [MERGES]
note Attach specialist pack in memory and evaluate W windows on HELD
fn cmdspeval to void
na = oargc
if and ne na 6 ne na 7
exit 2
end
osp_attach 2 3
ww = oargu 5
v = get og 0
if gt v 256
if eq na 6
exit 2
end
obload 6 v
end
odopen 4
tt = get og 1
m = get odn 0
if eq ww 0
exit 23
end
if gt ww div sub m 1 tt
exit 23
end
ls = 0.0f64
nb = ulong 0
for w ulong ww
obrow 0 mul w tt
ls = add ls ofwd 0
if gt v 256
nb = add nb oevnb tt
end
end
lo = div ls f64 ww
bp = div lo 0.6931471805599453
if gt v 256
bp = div mul bp f64 mul ww tt f64 nb
end
oputc 69
oputc 32
oputu get og 41
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 10
oflush
end

note ---- 5. Frozen-Base Hidden-State Cache (OLLMFH01: fcache, trainfc) ----
const OFHMAG ulong 3544412373522336847

note Write oa[src .. src + n) as little-endian f64s starting at file offset pos; returns new pos
fn ofh_wroa pos ulong src ulong n ulong to ulong
done = ulong 0
while lt done n bound 65536
cnt = sub n done
if gt cnt OCKC
cnt = OCKC
end
for j ulong cnt
ocput8 mul j 8 bitcast ulong get oa add src add done j
end
nb = mul cnt 8
ocwput pos nb
pos = add pos nb
done = add done cnt
end
ret pos
end

note Run frozen base on window starting at token offset o, apply optional mask mkai, write to cache
fn ofh_win mkai ulong o ulong pos ulong to ulong
tt = get og 1
bl = get og 5
obrow 0 o
if ne mkai 0
if ne oprd mkai add o 1 0 tt tt
exit 70
end
for tm ulong tt
if eq get opw tm 0
put oby tm or get oby tm 65536
end
end
end
put okv 0 0
put ogkm 1 0
oemb 0
for l ulong get og 56
olayf l
end
for t ulong tt
ocput8 mul t 8 get oby t
end
ocwput pos mul tt 8
pos = add pos mul tt 8
ret ofh_wroa pos get og 15 mul tt get og 2
end

note fcache / fcachem shared driver
fn ofh_run bkai ulong tkai ulong mkai ulong ww ulong outai ulong to void
ockloop bkai
odopen tkai
tt = get og 1
bl = get og 5
if or eq ww 0 gt ww div sub get odn 0 1 tt
exit 23
end
if gt add tt mul tt get og 2 262144
exit 12
end
if ne mkai 0
if ne ofsz mkai get odn 0
exit 21
end
end
bh = osp_basehash bl get og 33
ocwopen outai
ocput8 0 OFHMAG
ocput8 8 ww
ocput8 16 tt
ocput8 24 get og 2
ocput8 32 bl
ocput8 40 bh
ocwput 0 48
pos = ulong 48
put og 9 tt
for w ulong ww
pos = ofh_win mkai mul w tt pos
end
ocwend outai
oputc 70
oputc 67
oputc 65
oputc 67
oputc 72
oputc 69
oputc 32
oputu ww
oputc 32
oputu tt
oputc 32
oputu get og 2
oputc 32
oputu bl
oputc 10
oflush
end

fn cmdfcache to void
if ne oargc 6
exit 2
end
ofh_run 2 3 0 oargu 4 5
end

note fcachem BASE.ck TOKS MASK W OUT.hc (MASK: 1 byte per token; 0 masks loss at target y[t])
fn cmdfcachem to void
if ne oargc 7
exit 2
end
ofh_run 2 3 4 oargu 5 6
end

note Read and verify OLLMFH01 header at arg ai; stores W in ottt_st[2], rec_bytes in ottt_st[3]
fn ofh_rdhdr ai ulong flay ulong bh ulong to void
sz = ofsz ai
if lt sz 48
exit 60
end
if ne oprd ai 0 0 48 48
exit 60
end
if ne opw8 0 OFHMAG
exit 60
end
ww = opw8 8
if eq ww 0
exit 60
end
tt = get og 1
dd = get og 2
if ne opw8 16 tt
exit 62
end
if ne opw8 24 dd
exit 62
end
if ne opw8 32 flay
exit 62
end
if ne opw8 40 bh
exit 62
end
rec = mul add tt mul tt dd 8
if gt rec 2097152
exit 12
end
if ne sz add 48 mul ww rec
exit 60
end
put ottt_st 2 ww
put ottt_st 3 rec
end

note Load cached window w from arg ai into oby[0..T) and oa[oahin(flay)..+T*D)
fn ofh_load ai ulong w ulong flay ulong to void
tt = get og 1
td = mul tt get og 2
rec = get ottt_st 3
pos = add 48 mul w rec
if ne oprd ai pos 0 rec rec
exit 60
end
for t ulong tt
put oby t opw8 mul t 8
end
dst = oahin osp_app flay
off = mul tt 8
for i ulong td
put oa add dst i bitcast f64 opw8 add off mul i 8
end
end

note Masked head forward + backward over unmasked positions (oby[t] < 65536).
note When all T positions are unmasked, matches ohead 0 + obwd 0 sc bit-for-bit.
fn ofh_hb flay ulong b ulong bb ulong to void
ct = get og 9
mc = ulong 0
ls = 0.0f64
for t ulong ct
if lt get oby t 65536
ls = add ls oheadr 0 t
mc = add mc 1
end
end
if eq mc 0
put olos b 0.0f64
ret
end
put olos b div ls f64 mc
sc = div 1.0f64 f64 mul mc bb
ozero get og 19 mul ct get og 2
for t2 ulong ct
if lt get oby t2 65536
ohbwd 0 t2 sc
end
end
la = get og 56
nl = sub get og 5 flay
for i ulong nl
olayb sub sub la 1 i
end
end

note Forward+backward of one cached window w for batch slot b
fn ofh_one ai ulong w ulong flay ulong b ulong bb ulong to void
ofh_load ai w flay
put okv 0 0
put ogkm 1 0
fa = osp_app flay
nl = sub get og 5 flay
for j ulong nl
olayf add fa j
end
ofh_hb flay b bb
end

note One cached frozen-core step: skips embeddings + layers 0..flay-1 completely
fn ofh_step ai ulong flay ulong to f64
s = get og 41
bb = get og 6
p = get og 8
put og 9 get og 1
put og 10 p
ozerog p p
for b ulong bb
idx = add mul s bb b
w = rem smx xor get og 40 mul idx 11400714819323198485 get ottt_st 2
ofh_one ai w flay b bb
end
put og 10 0
ogfold true
ls = olsum
oadam
put og 41 add s 1
ret ls
end

note trainfc CK CACHE.hc UNTIL EVERY FREEZE_LAYERS [BATCH]
fn cmdtrainfc to void
na = oargc
if and ne na 7 ne na 8
exit 2
end
ockloop 2
until = oargu 4
every = oargu 5
flay = oargu 6
if or eq every 0 ge flay get og 5
exit 2
end
if gt get og 59 1
if lt flay add get og 57 get og 58
exit 2
end
end
fz = add get og 31 mul flay get og 32
ofh_rdhdr 3 flay osp_basehash flay fz
put ottt_st 0 get og 6
put ottt_st 1 get og 44
if eq na 8
nb = oargu 7
if or eq nb 0 gt nb 64
exit 2
end
put og 6 nb
put og 44 1
end
put ofreeze 0 fz
put ofzlay 0 flay
put og 45 1
st = get og 41
while lt st until bound 999999
ls = ofh_step 3 flay
st = get og 41
if or eq rem st every 0 eq st until
put og 6 get ottt_st 0
put og 44 get ottt_st 1
ocksave 2
if eq na 8
put og 6 oargu 7
put og 44 1
end
oputc 70
oputc 67
oputc 32
oputu st
oputc 32
oputu flay
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
put og 6 get ottt_st 0
put og 44 get ottt_st 1
put ofreeze 0 0
put ofzlay 0 0
end

note ---- 6. Pure-Omega Specialist Fusion (spmerge, spstack) ----

note Stream ns f64s from arg ai at offset 48 into ocs[dst .. dst + ns); returns payload FNV-1a 64
fn osp_rd2c ai ulong dst ulong ns ulong to ulong
h = ulong 14695981039346656037
pos = ulong 48
done = ulong 0
while lt done ns bound 65536
cnt = sub ns done
if gt cnt OCKC
cnt = OCKC
end
nb = mul cnt 8
if ne oprd ai pos 0 nb nb
exit 60
end
h = ocfnvw h nb
for j ulong cnt
ocsp add dst add done j bitcast f64 opw8 mul j 8
end
pos = add pos nb
done = add done cnt
end
ret h
end

note Load and verify pack payload from arg ai into ocs[dst .. dst + nspec); exits 60/61/62 on error
fn osp_rd2ocs ai ulong dst ulong bl ulong bh ulong wantl ulong to ulong
osp_rdhdr ai bl bh
sl = get ottt_st 1
if and ne wantl 0 ne sl wantl
exit 62
end
if ne osp_rd2c ai dst get ottt_st 3 get ottt_st 4
exit 61
end
ret sl
end

note Write OLLMSP01 pack at arg outai from ow[fz .. fz + ns) with header (bl, sl, bh, ns)
fn osp_wrpack outai ulong bl ulong sl ulong bh ulong fz ulong ns ulong to void
ocwopen outai
ph = osp_wrpay fz ns
ocput8 0 OSPMAG
ocput8 8 bl
ocput8 16 sl
ocput8 24 bh
ocput8 32 ns
ocput8 40 ph
ocwput 0 48
ocwend outai
end

note Compute exact grow initial weights W_0 for L=sl into ocs[0 .. ns)
fn osp_init0 bl ulong sl ulong fz ulong ns ulong to void
c = ocsinit
ogrowsnap get og 8
put og 5 sl
if not ogeom
exit 12
end
oinit
ogrowcopy fz
for j ulong get og 2
owp add get og 33 j ocsg add fz j
end
ogrowsilent bl
i = ulong 0
while lt i ns bound 9223372036854775807
ocsp i owg add fz i
i = add i 1
end
end

note Mode 0: weighted linear soup
fn osp_m0 kk ulong fz ulong ns ulong to void
sw = 0.0f64
for k ulong kk
sw = add sw get odl1 k
end
if le sw 0.0
exit 2
end
i = ulong 0
while lt i ns bound 9223372036854775807
acc = 0.0f64
for k2 ulong kk
acc = add acc mul get odl1 k2 ocsg add mul add k2 1 ns i
end
owp add fz i div acc sw
i = add i 1
end
end

note Mode 1: task-arithmetic sum over exact grow init W_0
fn osp_m1 kk ulong fz ulong ns ulong to void
i = ulong 0
while lt i ns bound 9223372036854775807
w0 = ocsg i
acc = w0
for k ulong kk
d = sub ocsg add mul add k 1 ns i w0
acc = add acc mul get odl1 k d
end
owp add fz i acc
i = add i 1
end
end

note Compute TIES RMS threshold 0.5*rms(W_k - W_0) into odl2[k]
fn osp_ties_tau kk ulong ns ulong to void
for k ulong kk
ss = 0.0f64
off = mul add k 1 ns
i = ulong 0
while lt i ns bound 9223372036854775807
d = sub ocsg add off i ocsg i
ss = add ss mul d d
i = add i 1
end
put odl2 k mul 0.5 fsqrt div ss f64 ns
end
end

note Elect TIES sign at i: 0=none, 1=pos, 2=neg
fn osp_m2_sg kk ulong ns ulong i ulong to ulong
w0 = ocsg i
ps = 0.0f64
ng = 0.0f64
for k ulong kk
d = sub ocsg add mul add k 1 ns i w0
if ge fabs d get odl2 k
if gt d 0.0
ps = add ps mul get odl1 k d
else
ng = add ng mul get odl1 k sub 0.0f64 d
end
end
end
if and eq ps 0.0 eq ng 0.0
ret 0
end
if ge ps ng
ret 1
end
ret 2
end

note Mode 2: TIES trimmed sign-consensus merge at parameter index i
fn osp_m2_i kk ulong ns ulong i ulong to f64
sg = osp_m2_sg kk ns i
w0 = ocsg i
if eq sg 0
ret w0
end
num = 0.0f64
den = 0.0f64
for k ulong kk
d = sub ocsg add mul add k 1 ns i w0
if ge fabs d get odl2 k
ag = false
if and eq sg 1 gt d 0.0
ag = true
end
if and eq sg 2 lt d 0.0
ag = true
end
if ag
wk = get odl1 k
num = add num mul wk d
den = add den wk
end
end
end
if eq den 0.0
ret w0
end
ret add w0 div num den
end

fn osp_m2 kk ulong fz ulong ns ulong to void
osp_ties_tau kk ns
i = ulong 0
while lt i ns bound 9223372036854775807
owp add fz i osp_m2_i kk ns i
i = add i 1
end
end

fn osp_mgrun mode ulong kk ulong fz ulong ns ulong to void
if eq mode 0
osp_m0 kk fz ns
ret
end
if eq mode 1
osp_m1 kk fz ns
ret
end
osp_m2 kk fz ns
end

note spmerge BASE.ck MODE OUT.sp W1 P1.sp W2 P2.sp [W3 P3.sp [W4 P4.sp]]
fn cmdspmerge to void
na = oargc
if or lt na 9 or gt na 13 ne rem sub na 5 2 0
exit 2
end
kk = div sub na 5 2
if gt oargu 3 2
exit 2
end
ockload 2
bl = get og 5
fz = get og 33
bh = osp_basehash bl fz
osp_rdhdr 6 bl bh
sl = get ottt_st 1
ns = get ottt_st 3
note W_0 and the kk pack blocks fill ocs[0 .. (kk + 1) ns): past the cold store is exit 12, as
note ogeom refuses a shape whose 3 P pass it
if gt mul add kk 1 ns ocsinit
exit 12
end
osp_init0 bl sl fz ns
for k ulong kk
put odl1 k div f64 oargu add 5 mul k 2 1000.0
z = osp_rd2ocs add 6 mul k 2 mul add k 1 ns bl bh sl
end
osp_mgrun oargu 3 kk fz ns
osp_wrpack 4 bl sl bh fz ns
oputc 83
oputc 80
oputc 77
oputc 82
oputc 71
oputc 32
oputu oargu 3
oputc 32
oputu kk
oputc 32
oputu sl
oputc 32
oputu ns
oputc 10
oflush
end

note Copy n f64s from ocs[src..) into ow[dst..)
fn osp_c2w dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 9223372036854775807
owp add dst i ocsg add src i
i = add i 1
end
end

note Scale Wo and W2 of layers [l0 .. l0+cnt) in ow by sc
fn osp_sclays l0 ulong cnt ulong sc f64 to void
d = get og 2
for k ulong cnt
l = add l0 k
oiscale opwo l mul d d sc
oiscale opw2 l mul d get og 4 sc
end
end

fn osp_stkgf dst ulong o1 ulong o2 ulong to void
for g ulong get og 2
v = mul 0.5 add ocsg add o1 g ocsg add o2 g
owp add dst g v
end
end

note Finish vertical stack copy + scaling + gf average + pack write; ottt_st[5..7] = bl, fz, bh
fn osp_stkfin d1 ulong n1 ulong d2 ulong to void
bl = get ottt_st 5
fz = get ottt_st 6
b1 = mul d1 get og 32
b2 = mul d2 get og 32
osp_c2w fz 0 b1
osp_c2w add fz b1 n1 b2
osp_sclays bl d1 div f64 oargu 5 1000.0
osp_sclays add bl d1 d2 div f64 oargu 6 1000.0
osp_stkgf add fz add b1 b2 b1 add n1 b2
ns = add add b1 b2 get og 2
osp_wrpack 7 bl get og 5 get ottt_st 7 fz ns
oputc 83
oputc 80
oputc 83
oputc 84
oputc 75
oputc 32
oputu bl
oputc 32
oputu get og 5
oputc 32
oputu ns
oputc 10
oflush
end

note spstack BASE.ck P1.sp P2.sp S1_MILLI S2_MILLI OUT.sp
note Vertically stack P1 layers then P2 layers on top of frozen BASE.ck
fn cmdspstack to void
if ne oargc 8
exit 2
end
c = ocsinit
ockload 2
bl = get og 5
fz = get og 33
bh = osp_basehash bl fz
put ottt_st 5 bl
put ottt_st 6 fz
put ottt_st 7 bh
d1 = sub osp_rd2ocs 3 0 bl bh 0 bl
n1 = get ottt_st 3
d2 = sub osp_rd2ocs 4 n1 bl bh 0 bl
put og 5 add bl add d1 d2
if not ogeom
exit 12
end
osp_stkfin d1 n1 d2
end

note ---- 7. LLaMA-Pro Block-Expansion Growth (growpro) ----
note Clones the last base layer's trained (g1, Wq, Wk, Wv, g2, W1) into each added layer
note and zeroes only (Wo, W2) so step-0 output is bit-identical to base while starting at
note the base layer's exact weight scale (44x sharper Q*K logits than random oinit).
fn osp_clone oldl ulong ll ulong to void
lstr = get og 32
src = add get og 31 mul sub oldl 1 lstr
for k ulong sub ll oldl
dst = add get og 31 mul add oldl k lstr
osp_c2w dst src lstr
end
end

fn cmdgrowpro to void
if ne oargc 7
exit 2
end
ockloop 2
ll = oargu 4
tt = oargu 5
lr = oargu 6
if or le ll get og 5 or eq tt 0 gt tt 999999
exit 12
end
if eq lr 0
exit 12
end
oldl = get og 5
oldg = get og 33
ogrowsnap get og 8
put og 5 ll
if not ogeom
exit 12
end
put og 41 0
put og 42 tt
put og 43 bitcast ulong div f64 lr 1000000.0
ozerom mul 2 get og 8
ogrowcopy oldg
for j ulong get og 2
owp add get og 33 j ocsg add oldg j
end
osp_clone oldl ll
ogrowsilent oldl
ocksave 3
oputc 71
oputc 80
oputc 32
oputu oldl
oputc 32
oputu ll
oputc 32
oputu get og 8
oputc 10
oflush
end

note ---- 8. Shared-Base Product-of-Experts Parallel Ensemble (spens) ----
note spens BASE.ck P1.sp P2.sp W1_MILLI N PROMPT TEMPMILLI SEED [MERGES]
note Runs frozen base layers 0..bl-1 ONCE per token, then runs P1 and P2 specialist layers
note in parallel over the shared H_base and fuses log_softmax(z1) & log_softmax(z2).
note Works across DIFFERENT init basins (grow + growpro) with zero weight-averaging interference!

fn osp_hsnap dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 9223372036854775807
ocsp add dst i get oa add src i
i = add i 1
end
end

fn osp_hrest dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 9223372036854775807
put oa add dst i ocsg add src i
i = add i 1
end
end

note Run final norm + klogit + log_softmax on row nc-1 into odl1 (which=1) or odl2 (which=2)
fn osp_ens_head which ulong nc ulong to void
d = get og 2
nc1 = sub nc 1
r = mul nc1 d
z = add get og 17 r
hf = add get og 15 r
s0 = add get og 16 nc1
frms hf get og 33 z s0
klogit z get og 27 get og 0 d
odl_lsm get og 27 get og 0 which
end

note Run one specialist branch (P1 if which=1 else P2) from cached H_base -> log_softmax in odl1/odl2
fn osp_ens_br which ulong nc ulong to void
bl = get oens 0
sl = get oens 2
if eq which 1
osp_c2w get oens 1 get oens 3 get oens 4
else
sl = get oens 5
osp_c2w get oens 1 get oens 6 get oens 7
end
ho = oahin bl
hs = add get oens 6 get oens 7
osp_hrest ho hs mul nc get og 2
put og 9 nc
put okv 0 0
put ogkm 1 0
for k ulong sub sl bl
olayf add bl k
end
osp_ens_head which nc
end

fn osp_ens_fuse w1 f64 to void
pr = get og 27
w2 = sub 1.0f64 w1
for j ulong get og 0
a = mul w1 get odl1 j
b = mul w2 get odl2 j
put oa add pr j add a b
end
end

note One PoE decode step: shared base 0..bl-1 once, then P1 + P2 branches, fused into TMP (og[27])
fn osp_ens_step w1 f64 st ulong tm ulong to ulong
nc = get og 9
bl = get oens 0
put okv 0 0
put ogkm 1 0
oemb 0
for l ulong bl
olayf l
end
hs = add get oens 6 get oens 7
ho = oahin bl
osp_hsnap hs ho mul nc get og 2
osp_ens_br 1 nc
osp_ens_br 2 nc
osp_ens_fuse w1
if eq tm 0
ret oargmax
end
ret odraw st div f64 tm 1000.0
end

fn osp_ens_loop nn ulong w1 f64 st ulong tm ulong to void
v = get og 0
for g ulong nn
c = osp_ens_step w1 st tm
if ne tm 0
st = add st 11400714819323198485
end
if eq c 0
break
end
if gt v 256
obtput c
else
oputc c
end
oflush
ocpush c
end
oflush
end

fn osp_ens_init to void
c = ocsinit
ockload 2
bl = get og 5
fz = get og 33
p0 = get og 8
bh = osp_basehash bl fz
ogrowsnap p0
l1 = osp_rd2ocs 3 p0 bl bh 0
n1 = get ottt_st 3
l2 = osp_rd2ocs 4 add p0 n1 bl bh l1
put oens 0 bl
put oens 1 fz
put oens 2 l1
put oens 3 p0
put oens 4 n1
put oens 5 l2
put oens 6 add p0 n1
put oens 7 get ottt_st 3
put og 5 l1
if not ogeom
exit 12
end
ogrowcopy fz
end

note spens BASE.ck P1.sp P2.sp W1_MILLI PROMPT N TEMPMILLI SEED [MERGES]
fn cmdspens to void
na = oargc
if and ne na 10 ne na 11
exit 2
end
osp_ens_init
v = get og 0
if gt v 256
if eq na 10
exit 2
end
obload 10 v
end
ottt_prompt v
osp_ens_loop oargu 7 div f64 oargu 5 1000.0 oargu 9 oargu 8
end

note ---- 9. Multi-Link Merkle Specialist Chains (spchainapp, spchaineval, spchainsamp) ----

note Chunked copy: ocs[dst..dst+n) = ow[src..src+n)
fn osp_w2c dst ulong src ulong n ulong to void
for q ulong ocn n
i = mul q OCH
ie = oce q n
while lt i ie bound 999999
ocsp add dst i owg add src i
i = add i 1
end
end
end

note Chunked copy: ow[dst..dst+n) = ocs[src..src+n)
fn osp_c2wb dst ulong src ulong n ulong to void
for q ulong ocn n
i = mul q OCH
ie = oce q n
while lt i ie bound 999999
owp add dst i ocsg add src i
i = add i 1
end
end
end

note Verify payload FNV-1a 64 of pack at argv[ai] without writing ow (exits 60/61 on error)
fn osp_chkpay ai ulong ns ulong wantph ulong to void
h = ulong 14695981039346656037
pos = ulong 48
done = ulong 0
while lt done ns bound 65536
cnt = sub ns done
if gt cnt OCKC
cnt = OCKC
end
nb = mul cnt 8
if ne oprd ai pos 0 nb nb
exit 60
end
h = ocfnvw h nb
pos = add pos nb
done = add done cnt
end
if ne h wantph
exit 61
end
end

note Verify and attach one OLLMSP01 pack at argv[ai] onto the running model in ow
fn osp_chain_link ai ulong to void
cur_l = get og 5
cur_fz = get og 33
osp_rdhdr ai cur_l osp_basehash cur_l cur_fz
ogrowsnap get og 8
put og 5 get ottt_st 1
if not ogeom
exit 12
end
if ne sub get og 8 cur_fz get ottt_st 3
exit 62
end
ozerom mul 2 get og 8
ogrowcopy cur_fz
if ne osp_rdpay ai cur_fz get ottt_st 3 get ottt_st 4
exit 61
end
end

note Load BASE.ck at argv[bkai] and sequentially attach K (1..8) Merkle-chained packs at argv[p0ai..]
fn ospchainload bkai ulong k ulong p0ai ulong to void
if or eq k 0 gt k 8
exit 2
end
ockloop bkai
put ottt_st 0 get og 5
for j ulong k
osp_chain_link add p0ai j
end
end

note Load prompt from argv[pai] into obx with leading token 0
fn osp_prompt pai ulong v ulong to void
put og 9 0
ocpush 0
if gt v 256
r = oargr pai
if or lt r 0 gt r 4000
exit 2
end
np = obprompt pai
for i ulong np
ocpush get obtk i
end
else
r = oargr pai
if or lt r 0 gt r 4096
exit 2
end
for i ulong ulong r
ocpush ulong get oarg i
end
end
end

note Sample nn tokens from the currently loaded model + context
fn osp_samploop seed ulong nn ulong tm ulong to void
if gt nn 999999
exit 2
end
st = seed
v = get og 0
for g ulong nn
c = osstep st tm
if ne tm 0
st = add st 11400714819323198485
end
if eq c 0
break
end
if gt v 256
obtput c
else
oputc c
end
oflush
ocpush c
end
oflush
end

note spchainapp BASE.ck OUT.ck K P1.sp ... PK.sp
fn cmdspchainapp to void
na = oargc
if lt na 6
exit 2
end
k = oargu 4
if or eq k 0 or gt k 8 ne na add 5 k
exit 2
end
ospchainload 2 k 5
ocksave 3
oputc 83
oputc 80
oputc 67
oputc 72
oputc 65
oputc 80
oputc 80
oputc 32
oputu get ottt_st 0
oputc 32
oputu get og 5
oputc 32
oputu k
oputc 32
oputu get og 8
oputc 10
oflush
end

note spchaineval BASE.ck HELD W MERGES K P1.sp ... PK.sp
fn cmdspchaineval to void
na = oargc
if lt na 8
exit 2
end
k = oargu 6
if or eq k 0 or gt k 8 ne na add 7 k
exit 2
end
ospchainload 2 k 7
ww = oargu 4
v = get og 0
if gt v 256
obload 5 v
end
odopen 3
tt = get og 1
m = get odn 0
if eq ww 0
exit 23
end
if gt ww div sub m 1 tt
exit 23
end
ls = 0.0f64
nb = ulong 0
for w ulong ww
obrow 0 mul w tt
ls = add ls ofwd 0
if gt v 256
nb = add nb oevnb tt
end
end
lo = div ls f64 ww
bp = div lo 0.6931471805599453
if gt v 256
bp = div mul bp f64 mul ww tt f64 nb
end
oputc 69
oputc 32
oputu get og 41
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 10
oflush
end

note spchainsamp BASE.ck N TEMPMILLI PROMPT SEED MERGES K P1.sp ... PK.sp
fn cmdspchainsamp to void
na = oargc
if lt na 10
exit 2
end
k = oargu 8
if or eq k 0 or gt k 8 ne na add 9 k
exit 2
end
ospchainload 2 k 9
nn = oargu 3
if gt nn 999999
exit 2
end
tm = oargu 4
st = oargu 6
v = get og 0
if gt v 256
obload 7 v
end
ochipup
osp_prompt 5 v
osp_samploop st nn tm
end

note ---- 10. DNA-Style Multi-Helix Chain Clipping (spclip, S = 2..4 strands) ----
note spclip BASE.ck MODE PROMPT N TEMPMILLI SEED MERGES S W1 K1 A1..AK1 W2 K2 B1..BK2 [W3 K3 C1..CK3 [W4 K4 D1..DK4]]
note MODE=0: normalized prior PoE (w_s / sum(w)); MODE=1: entropy-gated multi-helix (u_s = w_s / (H_s + 0.001)).

note Hidden-state output offset in oa after running layers 0..l-1 (l >= 1)
fn osp_hout l ulong to ulong
a = osp_app l
if lt a get og 56
ret oahin a
end
ret get og 15
end

note Reset dynamic spclip config defaults (called before legacy spclip, spguard, and subcommands)
fn osp_clip_defaults to void
for i ulong 16
put ocl_cfg i 0
end
put ocl_cfg 0 1000
put ocl_cfg 1 2
for s ulong 4
put ocl_sp_s s 0
put ocl_sp_e s 0
put ocl_sp_g s 1000
put ocl_raw_sl s 0
put ocl_wm s 1000
put ocl_w s 1.0f64
end
end

fn osp_link_ai s ulong j ulong to ulong
if ne get ocl_cfg 2 0
ret get ocl_link add mul s 8 j
end
ret add get ocl_a0 s j
end

fn osp_clip_validate_knobs to void
md = get ocl_st 0
ss = get ocl_st 1
tm = get ocl_cfg 0
if or gt md 1 or lt ss 2 gt ss 4
exit 2
end
if or eq tm 0 gt tm 100000
exit 2
end
sw = 0.0f64
ac = ulong 0
for s ulong ss
wi = get ocl_wm s
if or lt wi -5000 gt wi 5000
exit 2
end
if and eq md 1 lt wi 0
exit 2
end
if gt get ocl_sp_g s 2000
exit 2
end
ws = div f64 wi 1000.0
put ocl_w s ws
if gt ws 0.0
sw = add sw ws
end
if lt wi 0
ac = add ac 1
end
end
if le sw 0.0
exit 2
end
put ocl_st 13 ac
end

note ---- 10A. FIPS 180-4 SHA-256 (OM-1 compatible, low register pressure) ----
fn osha_rotr x uint n uint to uint
ret or shr x n shl x sub 32 n
end

fn osha_initk to void
if ne get osha_ready 0 0
ret
end
put osha_k 0 1116352408
put osha_k 1 1899447441
put osha_k 2 3049323471
put osha_k 3 3921009573
put osha_k 4 961987163
put osha_k 5 1508970993
put osha_k 6 2453635748
put osha_k 7 2870763221
put osha_k 8 3624381080
put osha_k 9 310598401
put osha_k 10 607225278
put osha_k 11 1426881987
put osha_k 12 1925078388
put osha_k 13 2162078206
put osha_k 14 2614888103
put osha_k 15 3248222580
put osha_k 16 3835390401
put osha_k 17 4022224774
put osha_k 18 264347078
put osha_k 19 604807628
put osha_k 20 770255983
put osha_k 21 1249150122
put osha_k 22 1555081692
put osha_k 23 1996064986
put osha_k 24 2554220882
put osha_k 25 2821834349
put osha_k 26 2952996808
put osha_k 27 3210313671
put osha_k 28 3336571891
put osha_k 29 3584528711
put osha_k 30 113926993
put osha_k 31 338241895
put osha_k 32 666307205
put osha_k 33 773529912
put osha_k 34 1294757372
put osha_k 35 1396182291
put osha_k 36 1695183700
put osha_k 37 1986661051
put osha_k 38 2177026350
put osha_k 39 2456956037
put osha_k 40 2730485921
put osha_k 41 2820302411
put osha_k 42 3259730800
put osha_k 43 3345764771
put osha_k 44 3516065817
put osha_k 45 3600352804
put osha_k 46 4094571909
put osha_k 47 275423344
put osha_k 48 430227734
put osha_k 49 506948616
put osha_k 50 659060556
put osha_k 51 883997877
put osha_k 52 958139571
put osha_k 53 1322822218
put osha_k 54 1537002063
put osha_k 55 1747873779
put osha_k 56 1955562222
put osha_k 57 2024104815
put osha_k 58 2227730452
put osha_k 59 2361852424
put osha_k 60 2428436474
put osha_k 61 2756734187
put osha_k 62 3204031479
put osha_k 63 3329325298
put osha_ready 0 1
end

fn osha_init to void
osha_initk
put osha_h 0 1779033703
put osha_h 1 3144134277
put osha_h 2 1013904242
put osha_h 3 2773480762
put osha_h 4 1359893119
put osha_h 5 2600822924
put osha_h 6 528734635
put osha_h 7 1541459225
put osha_n 0 0
end

fn osha_sched to void
for i ulong 16
q = mul i 4
x = uint get osha_b q
x = or shl x 8 uint get osha_b add q 1
x = or shl x 8 uint get osha_b add q 2
put osha_w i or shl x 8 uint get osha_b add q 3
end
for j ulong 48
x = get osha_w add j 1
s0 = xor xor osha_rotr x 7 osha_rotr x 18 shr x 3
y = get osha_w add j 14
s1 = xor xor osha_rotr y 17 osha_rotr y 19 shr y 10
put osha_w add j 16 add add add get osha_w j s0 get osha_w add j 9 s1
end
end

fn osha_t1 i ulong to uint
e = get osha_v 4
s1 = xor xor osha_rotr e 6 osha_rotr e 11 osha_rotr e 25
ch = xor get osha_v 6 and e xor get osha_v 5 get osha_v 6
t1 = add add get osha_v 7 s1 ch
ret add add t1 get osha_k i get osha_w i
end

fn osha_t2 to uint
a = get osha_v 0
b = get osha_v 1
c = get osha_v 2
s0 = xor xor osha_rotr a 2 osha_rotr a 13 osha_rotr a 22
mj = or and a b and c or a b
ret add s0 mj
end

fn osha_round i ulong to void
t1 = osha_t1 i
t2 = osha_t2
put osha_v 7 get osha_v 6
put osha_v 6 get osha_v 5
put osha_v 5 get osha_v 4
put osha_v 4 add get osha_v 3 t1
put osha_v 3 get osha_v 2
put osha_v 2 get osha_v 1
put osha_v 1 get osha_v 0
put osha_v 0 add t1 t2
end

fn osha_comp to void
osha_sched
for i ulong 8
put osha_v i get osha_h i
end
for r ulong 64
osha_round r
end
for j ulong 8
put osha_h j add get osha_h j get osha_v j
end
end

fn osha_byte c uchar to void
n = get osha_n 0
put osha_b and n 63 c
n = add n 1
put osha_n 0 n
if eq and n 63 0
osha_comp
end
end

fn osha_fin to void
nb = get osha_n 0
bits = shl nb 3
osha_byte uchar 128
while ne and get osha_n 0 63 56 bound 64
osha_byte uchar 0
end
for k ulong 8
b = and shr bits mul sub 7 k 8 255
osha_byte uchar b
end
for i ulong 8
w = get osha_h i
q = mul i 4
put osha_d q uchar and shr w 24 255
put osha_d add q 1 uchar and shr w 16 255
put osha_d add q 2 uchar and shr w 8 255
put osha_d add q 3 uchar and w 255
end
end

fn osha_file ai ulong to void
osha_init
sz = ofsz ai
pos = ulong 0
while lt pos sz bound 9223372036854775807
cnt = sub sz pos
if gt cnt 524288
cnt = ulong 524288
end
if ne oprd ai pos 0 cnt cnt
exit 60
end
j = ulong 0
while lt j cnt bound 524288
osha_byte get opw j
j = add j 1
end
pos = add pos cnt
end
osha_fin
end

fn osha_buf_ocl n ulong to void
osha_init
i = ulong 0
while lt i n bound 65536
osha_byte get ocl_rec i
i = add i 1
end
osha_fin
end

fn osha_save_bsha to void
for i ulong 32
put ocl_bsha i get osha_d i
end
end

fn osha_eq_bsha to bool
for i ulong 32
if ne get ocl_bsha i get osha_d i
ret false
end
end
ret true
end

fn osha_save_lsha idx ulong to void
bo = mul idx 32
for i ulong 32
put ocl_lsha add bo i get osha_d i
end
end

fn osha_eq_lsha idx ulong to bool
bo = mul idx 32
for i ulong 32
if ne get ocl_lsha add bo i get osha_d i
ret false
end
end
ret true
end

fn osha_save_rsha to void
for i ulong 32
put ocl_rsha i get osha_d i
end
end

fn osha_eq_rsha to bool
for i ulong 32
if ne get ocl_rsha i get osha_d i
ret false
end
end
ret true
end

fn osha_save_csha to void
for i ulong 32
put ocl_csha i get osha_d i
end
end

fn osha_eq_csha to bool
for i ulong 32
if ne get ocl_csha i get osha_d i
ret false
end
end
ret true
end

fn osha_save_dsha to void
for i ulong 32
put ocl_dsha i get osha_d i
end
end

fn osha_save_tsha to void
for i ulong 32
put ocl_tsha i get osha_d i
end
end

fn osha_eq_tsha to bool
for i ulong 32
if ne get ocl_tsha i get osha_d i
ret false
end
end
ret true
end

fn oput_sha_d to void
for i ulong 32
b = ulong get osha_d i
hi = shr b 4
lo = and b 15
if lt hi 10
oputc add hi 48
else
oputc add hi 87
end
if lt lo 10
oputc add lo 48
else
oputc add lo 87
end
end
end

fn oput_sha_rsha to void
for i ulong 32
put osha_d i get ocl_rsha i
end
oput_sha_d
end

fn oput_sha_csha to void
for i ulong 32
put osha_d i get ocl_csha i
end
oput_sha_d
end

fn oput_sha_tsha to void
for i ulong 32
put osha_d i get ocl_tsha i
end
oput_sha_d
end

fn oput_sha_bsha to void
for i ulong 32
put osha_d i get ocl_bsha i
end
oput_sha_d
end

fn oput_sha_lsha idx ulong to void
bo = mul idx 32
for i ulong 32
put osha_d i get ocl_lsha add bo i
end
oput_sha_d
end

note Verify or capture base + all link SHA-256 digests according to ocl_cfg[3] (0=skip, 1=verify, 2=capture)
fn osp_clip_hash_pass to void
hm = get ocl_cfg 3
if eq hm 0
ret
end
bai = get ocl_cfg 1
osha_file bai
if eq hm 1
if not osha_eq_bsha
exit 62
end
else
osha_save_bsha
end
ss = get ocl_st 1
for s ulong ss
ks = get ocl_k s
for j ulong ks
idx = add mul s 8 j
ai = osp_link_ai s j
osha_file ai
if eq hm 1
if not osha_eq_lsha idx
exit 61
end
else
osha_save_lsha idx
end
if lt ofsz ai 48
exit 60
end
if ne oprd ai 0 0 48 48
exit 60
end
if ne opw8 0 OSPMAG
exit 60
end
ph = opw8 40
if eq hm 1
if ne ph get ocl_lph idx
exit 61
end
else
put ocl_lph idx ph
end
end
end
end

note Parse spclip or spguard CLI strand arguments starting at ss_arg
fn osp_clip_parse_at md ulong ss_arg ulong to void
na = oargc
if lt na add ss_arg 7
exit 2
end
ss = oargu ss_arg
if or lt ss 2 gt ss 4
exit 2
end
put ocl_st 0 md
put ocl_st 1 ss
idx = add ss_arg 1
sw = 0.0f64
ac = ulong 0
for s ulong ss
if gt add idx 2 na
exit 2
end
wi = oargs idx
if and eq md 1 lt wi 0
exit 2
end
if or lt wi -5000 gt wi 5000
exit 2
end
put ocl_wm s wi
ws = div f64 wi 1000.0
if lt wi 0
ac = add ac 1
end
ks = oargu add idx 1
if or eq ks 0 gt ks 8
exit 2
end
if gt add add idx 2 ks na
exit 2
end
put ocl_w s ws
if gt ws 0.0
sw = add sw ws
end
put ocl_k s ks
put ocl_a0 s add idx 2
idx = add add idx 2 ks
end
if or ne idx na le sw 0.0
exit 2
end
put ocl_st 13 ac
end

note Parse spclip CLI arguments into ocl_st, ocl_w, ocl_k, ocl_a0
fn osp_clip_parse to void
na = oargc
if lt na 16
exit 2
end
md = oargu 3
if gt md 1
exit 2
end
osp_clip_parse_at md 9
end

note Mix 64-bit little-endian integer x into running FNV-1a-64 digest h
fn osp_mix64 h ulong x ulong to ulong
z = h
for k ulong 8
b = and shr x mul k 8 255
z = mul xor z b 1099511628211
end
ret z
end

note True iff all ss strands share an identical valid pack at link index j on top of current ow
fn osp_clip_same j ulong ss ulong to bool
bh = osp_basehash get og 5 get og 33
osp_rdhdr osp_link_ai 0 j get og 5 bh
sl0 = get ottt_st 1
ns0 = get ottt_st 3
ph0 = get ottt_st 4
s = ulong 1
while lt s ss bound 4
osp_rdhdr osp_link_ai s j get og 5 bh
if ne get ottt_st 1 sl0
ret false
end
if ne get ottt_st 3 ns0
ret false
end
if ne get ottt_st 4 ph0
ret false
end
s = add s 1
end
s = ulong 1
while lt s ss bound 4
osp_chkpay osp_link_ai s j ns0 ph0
s = add s 1
end
ret true
end

note Load longest common prefix of packs across all S strands into ow; save trunk_gf in odl2
fn osp_clip_trunk to void
ss = get ocl_st 1
mink = get ocl_k 0
for s ulong ss
if lt get ocl_k s mink
mink = get ocl_k s
end
end
comm = ulong 0
phc = ulong 14695981039346656037
for j ulong mink
if not osp_clip_same j ss
break
end
osp_chain_link osp_link_ai 0 j
phc = osp_mix64 phc get ottt_st 4
comm = add comm 1
end
put ocl_st 3 get og 5
put ocl_st 4 get og 33
put ocl_st 6 comm
put ocl_exp 14 osp_basehash get og 5 get og 33
for s2 ulong ss
put ocl_ph s2 phc
end
for g ulong get og 2
put odl2 g owg add get og 33 g
end
end

note Peek final spec_L of each strand's last pack to find max_L across all S strands
fn osp_clip_maxl to ulong
ss = get ocl_st 1
comm = get ocl_st 6
ml = get ocl_st 3
for s ulong ss
ks = get ocl_k s
if gt ks comm
ai = osp_link_ai s sub ks 1
if lt ofsz ai 48
exit 60
end
if ne oprd ai 0 0 48 48
exit 60
end
if ne opw8 0 OSPMAG
exit 60
end
sl = opw8 16
if gt sl ml
ml = sl
end
end
end
if gt ml 24
exit 12
end
ret ml
end

note Load one non-shared link ai onto (cur_l, cur_fz); returns new spec_L
fn osp_clip_1link ai ulong cur_l ulong cur_fz ulong to ulong
osp_rdhdr ai cur_l osp_basehash cur_l cur_fz
sl = get ottt_st 1
ns = get ottt_st 3
if gt sl get og 5
exit 62
end
wn = mul sub sl cur_l get og 32
if ne ns add wn get og 2
exit 62
end
if ne osp_rdpay ai cur_fz ns get ottt_st 4
exit 61
end
ret sl
end

note Load remaining links comm..ks-1 of strand s into ow[fzt..); returns final depth cur_l
fn osp_clip_slinks s ulong to ulong
cur_l = get ocl_st 3
cur_fz = get ocl_st 4
j = get ocl_st 6
ks = get ocl_k s
ph = get ocl_ph s
while lt j ks bound 16
sl = osp_clip_1link osp_link_ai s j cur_l cur_fz
ph = osp_mix64 ph get ottt_st 4
cur_l = sl
cur_fz = add get og 31 mul sl get og 32
j = add j 1
end
put ocl_ph s ph
ret cur_l
end

note Shift active spliced layers down in ow when eff_s > tl
fn osp_clip_shift dst ulong src ulong n ulong to void
i = ulong 0
while lt i n bound 9223372036854775807
owp add dst i owg add src i
i = add i 1
end
end

note Load strand s raw unspliced layers into ow[fzt..) and save gf_s into odl1[0..d); returns raw depth cl
fn osp_clip_load_raw s ulong to ulong
tl = get ocl_st 3
d = get og 2
if eq get ocl_k s get ocl_st 6
for g ulong d
put odl1 g get odl2 g
end
ret tl
end
cl = osp_clip_slinks s
gf_off = add get ocl_st 4 mul sub cl tl get og 32
for g2 ulong d
put odl1 g2 owg add gf_off g2
end
ret cl
end

fn osp_clip_chk_sp tl ulong cl ulong es ulong ee ulong gn ulong to void
if lt es tl
exit 2
end
if gt es cl
exit 2
end
if lt ee tl
exit 2
end
if gt ee cl
exit 2
end
if gt es ee
exit 2
end
if gt gn 2000
exit 2
end
end

fn osp_clip_store_br s ulong es ulong nact ulong gn ulong to void
tl = get ocl_st 3
wn = mul nact get og 32
oc = get ocl_st 8
d = get og 2
if gt add oc add wn d ocsinit
exit 12
end
if gt nact 0
fzt = get ocl_st 4
if gt es tl
osp_clip_shift fzt add fzt mul sub es tl get og 32 wn
end
if ne gn 1000
osp_sclays tl nact div f64 gn 1000.0
end
osp_w2c oc fzt wn
end
for g3 ulong d
ocsp add add oc wn g3 get odl1 g3
end
put ocl_sl s add tl nact
put ocl_wo s oc
put ocl_wn s wn
put ocl_st 8 add oc add wn d
end

note Verify & store strand s's spliced active layer weights + gf into ocs
fn osp_clip_strand s ulong to void
tl = get ocl_st 3
cl = osp_clip_load_raw s
put ocl_raw_sl s cl
es = get ocl_sp_s s
ee = get ocl_sp_e s
if and eq es 0 eq ee 0
es = tl
ee = cl
else
if eq es OSP_SP_AUTO
es = tl
put ocl_sp_s s tl
end
if or eq es 0 eq ee 0
exit 2
end
end
gn = get ocl_sp_g s
osp_clip_chk_sp tl cl es ee gn
osp_clip_store_br s es sub ee es gn
end

note Initialize spclip: verify/capture hashes, load BASE.ck, common trunk, grow to max_L, store all S strand suffixes in ocs
fn osp_clip_init to void
c = ocsinit
osp_clip_hash_pass
ockloop get ocl_cfg 1
bh = osp_basehash get og 5 get og 33
put ocl_st 2 get og 5
put ocl_st 11 bh
put ocl_exp 12 get og 33
if eq get ocl_cfg 3 1
if or ne get og 5 get ocl_exp 0 ne bh get ocl_exp 1
exit 62
end
end
osp_clip_trunk
ml = osp_clip_maxl
addl = get ocl_cfg 5
ml_alloc = add ml addl
if gt ml_alloc 24
exit 12
end
put ocl_st 5 ml
if gt ml_alloc get ocl_st 3
ogrowsnap get og 8
put og 5 ml_alloc
if not ogeom
exit 12
end
ogrowcopy get ocl_st 4
end
td = mul get og 1 get og 2
put ocl_st 7 0
put ocl_st 9 td
put ocl_st 8 add td mul get ocl_st 1 get og 0
for s ulong get ocl_st 1
osp_clip_strand s
end
end

note Compute log_softmax of TMP[0..V) into ocs[logp_off + s*V .. +V) and Shannon entropy into ocl_ent[s]
fn osp_clip_lsm s ulong to void
pr = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for j ulong v
x = get oa add pr j
m = fmax m x
put odl1 j x
end
sm = osoft pr v m
lsm = flog sm
dst = add get ocl_st 9 mul s v
ent = 0.0f64
for j2 ulong v
lp = sub sub get odl1 j2 m lsm
ocsp add dst j2 lp
pj = get oa add pr j2
if gt pj 0.0
ent = sub ent mul pj lp
end
end
if lt ent 0.0
ent = 0.0f64
end
put ocl_ent s ent
end

note Final norm + klogit on row nc-1 of osp_hout(ocl_sl[s]), then log_softmax + entropy
fn osp_clip_head s ulong nc ulong to void
d = get og 2
nc1 = sub nc 1
r = mul nc1 d
z = add get og 17 r
hf = add osp_hout get ocl_sl s r
s0 = add get og 16 nc1
frms hf get og 33 z s0
klogit z get og 27 get og 0 d
osp_clip_lsm s
end

note Run strand s from cached H_trunk through layers trunk_L..L_s-1 and head
fn osp_clip_br s ulong nc ulong to void
tl = get ocl_st 3
sl = get ocl_sl s
wo = get ocl_wo s
wn = get ocl_wn s
if gt wn 0
osp_c2wb get ocl_st 4 wo wn
end
osp_c2wb get og 33 add wo wn get og 2
osp_hrest osp_hout tl get ocl_st 7 mul nc get og 2
put og 9 nc
put okv 0 0
put ogkm 1 0
ta = osp_app tl
for k ulong sub sl tl
olayf add ta k
end
osp_clip_head s nc
end

note Compute stabilized entropy-gated unnormalized weights for MODE=1 with tau != 1.0
fn osp_clip_wt_tau ss ulong tau f64 to f64
lmin = bitcast f64 ulong 9218868437227405312
for s0 ulong ss
if gt get ocl_w s0 0.0
ls0 = flog add get ocl_ent s0 0.001
if lt ls0 lmin
lmin = ls0
end
end
end
su = 0.0f64
for s ulong ss
u = get ocl_w s
if gt u 0.0
ls = flog add get ocl_ent s 0.001
u = mul u fexp div sub lmin ls tau
end
put ocl_al s u
if gt u 0.0
su = add su u
end
end
ret su
end

note Compute normalized fusion weights ocl_al[0..S) using MODE=0/1 and tau_milli
fn osp_clip_calc_al to void
md = get ocl_st 0
ss = get ocl_st 1
tm = get ocl_cfg 0
if eq tm 0
tm = ulong 1000
end
su = 0.0f64
if and eq md 1 ne tm 1000
su = osp_clip_wt_tau ss div f64 tm 1000.0
else
for s ulong ss
u = get ocl_w s
if and eq md 1 gt u 0.0
u = div u add get ocl_ent s 0.001
end
put ocl_al s u
if gt u 0.0
su = add su u
end
end
end
for s2 ulong ss
put ocl_al s2 div get ocl_al s2 su
end
end

fn osp_clip_fuse_v j ulong ss ulong v ulong lo ulong to f64
acc = 0.0f64
for s3 ulong ss
acc = add acc mul get ocl_al s3 ocsg add lo add mul s3 v j
end
ret acc
end

note Fuse S strands' log-probs in ocs into TMP[0..V) using MODE=0 (signed PoE) or MODE=1 (entropy-gated) + tau
fn osp_clip_fuse to void
osp_clip_calc_al
sc_on = and eq get ocl_st 0 0 and ne get ocl_cfg 0 0 ne get ocl_cfg 0 1000
tau = div f64 get ocl_cfg 0 1000.0
pr = get og 27
v = get og 0
for j ulong v
acc = osp_clip_fuse_v j get ocl_st 1 v get ocl_st 9
if sc_on
acc = div acc tau
end
put oa add pr j acc
end
end

note Jensen-Shannon Disagreement H(pbar) - mean(H(ps)) across positive-weight strands (ocl_w[s] > 0)
fn osp_jsd_pbar j ulong np ulong lo ulong v ulong to f64
sm = 0.0f64
for s ulong get ocl_st 1
if gt get ocl_w s 0.0
sm = add sm fexp ocsg add lo add mul s v j
end
end
ret div sm f64 np
end

fn osp_clip_jsd to f64
ss = get ocl_st 1
np = ulong 0
hmean = 0.0f64
for s ulong ss
if gt get ocl_w s 0.0
np = add np 1
hmean = add hmean get ocl_ent s
end
end
if lt np 2
put ocl_st 10 0
ret 0.0f64
end
hmean = div hmean f64 np
lo = get ocl_st 9
v = get og 0
hbar = 0.0f64
for j ulong v
pb = osp_jsd_pbar j np lo v
if gt pb 1.0e-15f64
hbar = sub hbar mul pb flog pb
end
end
jsd = sub hbar hmean
if lt jsd 0.0
jsd = 0.0f64
end
jm = ulong add mul jsd 1000.0 0.5
put ocl_st 10 jm
ret jsd
end

note Run one extra refinement pass over trunk layers [c0 .. ta-1] on row nc-1 when strands disagree
fn osp_guard_c0 ta ulong tl ulong to ulong
np = get og 59
lc = add get og 57 get og 58
if and gt np 1 le lc tl
ret get og 57
end
ret sub ta 1
end

fn osp_guard_pass nc ulong tl ulong to void
d = get og 2
r = mul sub nc 1 d
ta = osp_app tl
last_a = sub ta 1
c0 = osp_guard_c0 ta tl
onlcopy_oa add oahin c0 r add oaout last_a r d
for k ulong sub ta c0
l = add c0 k
okvlay l sub nc 1 1
if lt add l 1 ta
onlcopy_oa add oahin add l 1 r add oaout l r d
end
end
onlcopy_oa add osp_hout tl r add oaout last_a r d
end

fn osp_guard_rcpt_init to void
h = ulong 14695981039346656037
h = osp_mix64 h get ocl_st 11
for s ulong get ocl_st 1
h = osp_mix64 h bitcast ulong get ocl_wm s
h = osp_mix64 h get ocl_ph s
end
put ocl_st 12 h
end

fn osp_guard_rcpt_step g ulong c ulong to ulong
h = get ocl_st 12
h = osp_mix64 h g
h = osp_mix64 h c
h = osp_mix64 h get ocl_st 10
h = osp_mix64 h get ocl_st 16
h = osp_mix64 h get ocl_st 17
h = osp_mix64 h get ocl_st 13
put ocl_st 12 h
ret h
end

fn osp_guard_emit step ulong tok ulong to void
oputc 71
oputc 32
oputu step
oputc 32
oputu tok
oputc 32
oputu get ocl_st 10
oputc 32
oputu get ocl_st 16
oputc 32
oputu get ocl_st 17
oputc 32
oputu get ocl_st 13
oputc 32
oputx get ocl_st 12
oputc 10
oflush
end

fn osp_guard_eval nc ulong tl ulong to f64
osp_hsnap get ocl_st 7 osp_hout tl mul nc get og 2
for s ulong get ocl_st 1
osp_clip_br s nc
end
ret osp_clip_jsd
end

fn osp_guard_refine nc ulong tl ulong to void
ex = ulong 0
mxex = get ocl_st 15
thresh = div f64 get ocl_st 14 1000.0
while lt ex mxex bound 8
ex = add ex 1
osp_guard_pass nc tl
if lt osp_guard_eval nc tl thresh
break
end
end
put ocl_st 16 ex
end

fn osp_guard_step st ulong tm ulong to ulong
nc = get og 9
tl = get ocl_st 3
put okv 0 0
put ogkm 1 0
oemb 0
for l ulong osp_app tl
olayf l
end
put ocl_st 16 0
put ocl_st 17 0
thresh = div f64 get ocl_st 14 1000.0
if ge osp_guard_eval nc tl thresh
put ocl_st 17 1
osp_guard_refine nc tl
end
osp_clip_fuse
if eq tm 0
ret oargmax
end
ret odraw st div f64 tm 1000.0
end

fn osp_guard_run nn ulong st ulong tm ulong to void
con_tot = ulong 0
ex_tot = ulong 0
drawn = ulong 0
for g ulong nn
c = osp_guard_step st tm
if ne tm 0
st = add st 11400714819323198485
end
if eq c 0
break
end
con_tot = add con_tot get ocl_st 17
ex_tot = add ex_tot get ocl_st 16
rcpt = osp_guard_rcpt_step g c
osp_guard_emit g c
drawn = add drawn 1
ocpush c
end
oputc 71
oputc 82
oputc 32
oputu drawn
oputc 32
oputu con_tot
oputc 32
oputu ex_tot
oputc 32
oputu get ocl_st 13
oputc 32
oputx get ocl_st 11
oputc 32
oputx get ocl_st 12
oputc 10
oflush
end

note spguard BASE.ck DISAGREE_MILLI MAX_EXTRA PROMPT N TEMPMILLI SEED MERGES S W1 K1 A1..AK1 ...
fn cmdspguard to void
osp_clip_defaults
dm = oargu 3
mx = oargu 4
if gt mx 4
exit 2
end
nn = oargu 6
if or eq nn 0 gt nn 999999
exit 2
end
tm = oargu 7
sd = oargu 8
osp_clip_parse_at 0 10
put ocl_st 14 dm
put ocl_st 15 mx
osp_clip_init
v = get og 0
if gt v 256
obload 9 v
end
osp_prompt 5 v
osp_guard_rcpt_init
osp_guard_run nn sd tm
end

note One DNA-clipped decode step: shared trunk ONCE, then S strands over H_trunk, fused into TMP
fn osp_clip_step st ulong tm ulong to ulong
nc = get og 9
tl = get ocl_st 3
put okv 0 0
put ogkm 1 0
oemb 0
ta = osp_app tl
for l ulong ta
olayf l
end
osp_hsnap get ocl_st 7 osp_hout tl mul nc get og 2
for s ulong get ocl_st 1
osp_clip_br s nc
end
osp_clip_fuse
if eq tm 0
ret oargmax
end
ret odraw st div f64 tm 1000.0
end

fn osp_clip_loop nn ulong st ulong tm ulong to void
v = get og 0
for g ulong nn
c = osp_clip_step st tm
if ne tm 0
st = add st 11400714819323198485
end
if eq c 0
break
end
if gt v 256
obtput c
else
oputc c
end
oflush
ocpush c
end
oflush
end

note ---- 11. Canonical .spclip Recipe & OLLMSPLIN01 Lineage Buffer Helpers ----
fn osr_reset to void
put ocl_rlen 0 0
end

fn osr_putc c ulong to void
p = get ocl_rlen 0
if ge p 65536
exit 60
end
put ocl_rec p uchar and c 255
put ocl_rlen 0 add p 1
end

fn osr_putu v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
while true bound 21
put d n uchar add rem x 10 48
n = add n 1
x = div x 10
if eq x 0
break
end
end
for i ulong n
osr_putc ulong get d sub sub n 1 i
end
end

fn osr_putl v long to void
if lt v 0
osr_putc 45
if eq v -9223372036854775808
osr_putu 9223372036854775808
else
osr_putu ulong neg v
end
else
osr_putu ulong v
end
end

fn osr_putx64 v ulong to void
for i ulong 16
h = and shr v mul sub 15 i 4 15
if lt h 10
osr_putc add h 48
else
osr_putc add h 87
end
end
end

fn osr_putsha_d to void
for i ulong 32
b = ulong get osha_d i
hi = shr b 4
lo = and b 15
if lt hi 10
osr_putc add hi 48
else
osr_putc add hi 87
end
if lt lo 10
osr_putc add lo 48
else
osr_putc add lo 87
end
end
end

