r = oargr ai
if le r 0
ret false
end
n = ulong r
if eq kind 0
if ne n len ot_fl_str
ret false
end
for i ulong n
if ne get oarg i get ot_fl_str i
ret false
end
end
ret true
end
if eq kind 1
if ne n len ot_fl_wts
ret false
end
for i ulong n
if ne get oarg i get ot_fl_wts i
ret false
end
