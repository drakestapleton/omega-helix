fn osr_rd_u delim ulong to ulong
p = get ocl_rcur 0
n = get ocl_rlen 0
v = ulong 0
d = ulong 0
while lt p n bound 32
c = ulong get ocl_rec p
if eq c delim
break
end
if or lt c 48 gt c 57
exit 60
end
if ge d 19
exit 60
end
v = add mul v 10 sub c 48
d = add d 1
p = add p 1
end
if or eq d 0 ge p n
exit 60
end
if ne ulong get ocl_rec p delim
exit 60
end
put ocl_rcur 0 add p 1
ret v
end

fn osr_rd_l delim ulong to long
p = get ocl_rcur 0
n = get ocl_rlen 0
if ge p n
exit 60
end
negf = ulong 0
if eq ulong get ocl_rec p 45
negf = ulong 1
p = add p 1
put ocl_rcur 0 p
end
v = osr_rd_u delim
if eq negf 1
if gt v 9223372036854775807
exit 60
end
ret neg long v
end
if gt v 9223372036854775807
exit 60
end
ret long v
end

fn osr_rd_x64 delim ulong to ulong
p = get ocl_rcur 0
if gt add p 17 get ocl_rlen 0
exit 60
end
v = ulong 0
for i ulong 16
h = osr_hexnib ulong get ocl_rec add p i
if gt h 15
exit 60
end
v = or shl v 4 h
end
if ne ulong get ocl_rec add p 16 delim
exit 60
end
put ocl_rcur 0 add p 17
ret v
end

fn osr_rd_sha_d delim ulong to void
p = get ocl_rcur 0
if gt add p 65 get ocl_rlen 0
exit 60
end
for i ulong 32
hi = osr_hexnib ulong get ocl_rec add p mul i 2
lo = osr_hexnib ulong get ocl_rec add p add mul i 2 1
if or gt hi 15 gt lo 15
exit 60
end
put osha_d i uchar or shl hi 4 lo
end
if ne ulong get ocl_rec add p 64 delim
exit 60
end
put ocl_rcur 0 add p 65
end

fn osr_rd_path sl ulong delim ulong to ulong
p = get ocl_rcur 0
n = get ocl_rlen 0
k = ulong 0
while lt p n bound 1025
c = ulong get ocl_rec p
if eq c delim
break
end
if or lt c 33 gt c 126
exit 60
end
if ge k OVARG_STR
exit 60
end
ovp_putb sl k uchar c
k = add k 1
p = add p 1
end
if or eq k 0 ge p n
exit 60
end
if ne ulong get ocl_rec p delim
exit 60
end
ovp_setlen sl k
put ocl_rcur 0 add p 1
ret add OVARG_BASE sl
end

note Write canonical OLLMSPCLIP01 recipe to dst_ai and store recipe_sha256 in ocl_rsha
fn osp_rec_write dst_ai ulong to void
osr_reset
osr_putkw 0
osr_putkw 2
osr_putslot 0
osr_putc 10
osr_putkw 3
for i ulong 32
put osha_d i get ocl_bsha i
end
osr_putsha_d
osr_putc 10
osr_putkw 4
osr_putu get ocl_st 2
osr_putc 10
osr_putkw 5
osr_putx64 get ocl_st 11
osr_putc 10
osr_putkw 6
osr_putu get ocl_st 0
osr_putc 10
osr_putkw 7
osr_putu get ocl_cfg 0
osr_putc 10
osr_putkw 8
osr_putu get ocl_st 1
osr_putc 10
ss = get ocl_st 1
for s ulong ss
osr_putkw 9
osr_putu s
osr_putc 32
osr_putkw 10
osr_putl get ocl_wm s
osr_putc 32
osr_putkw 11
osr_putu get ocl_sp_s s
osr_putc 58
osr_putu get ocl_sp_e s
osr_putc 58
osr_putu get ocl_sp_g s
osr_putc 32
osr_putkw 12
osr_putu get ocl_k s
osr_putc 10
for j ulong get ocl_k s
idx = add mul s 8 j
osr_putkw 13
osr_putu s
osr_putc 32
osr_putu j
osr_putc 32
osr_putslot add 1 idx
osr_putc 32
bo = mul idx 32
for b ulong 32
put osha_d b get ocl_lsha add bo b
end
osr_putsha_d
osr_putc 32
osr_putx64 get ocl_lph idx
osr_putc 10
end
end
osha_buf_ocl get ocl_rlen 0
osha_save_rsha
osr_putkw 14
osr_putsha_d
osr_putc 10
osr_flush_file dst_ai
end

fn osp_rec_rd_strand s ulong to void
osr_eat_kw 9
if ne osr_rd_u 32 s
exit 60
end
osr_eat_kw 10
put ocl_wm s osr_rd_l 32
osr_eat_kw 11
sps = osr_rd_u 58
spe = osr_rd_u 58
spg = osr_rd_u 32
if or gt sps 24 gt spe 24
exit 60
end
if or and eq sps 0 ne spe 0 and ne sps 0 eq spe 0
exit 60
end
put ocl_sp_s s sps
put ocl_sp_e s spe
put ocl_sp_g s spg
osr_eat_kw 12
ks = osr_rd_u 10
if or eq ks 0 gt ks 8
exit 60
end
put ocl_k s ks
for j ulong ks
osr_eat_kw 13
if ne osr_rd_u 32 s
exit 60
end
if ne osr_rd_u 32 j
exit 60
end
idx = add mul s 8 j
ai = osr_rd_path add 1 idx 32
put ocl_link idx ai
osr_rd_sha_d 32
osha_save_lsha idx
put ocl_lph idx osr_rd_x64 10
end
end

note Load and strictly verify OLLMSPCLIP01 recipe from rec_ai (exits 60 malformed, 61 tampered hash, 2 bad knobs)
fn osp_rec_load rec_ai ulong to void
osp_clip_defaults
osr_read_file rec_ai
osr_eat_kw 0
osr_eat_kw 2
put ocl_cfg 1 osr_rd_path 0 10
osr_eat_kw 3
osr_rd_sha_d 10
osha_save_bsha
osr_eat_kw 4
put ocl_exp 0 osr_rd_u 10
osr_eat_kw 5
put ocl_exp 1 osr_rd_x64 10
osr_eat_kw 6
put ocl_st 0 osr_rd_u 10
osr_eat_kw 7
put ocl_cfg 0 osr_rd_u 10
osr_eat_kw 8
ss = osr_rd_u 10
if or lt ss 2 gt ss 4
exit 60
end
put ocl_st 1 ss
for s ulong ss
osp_rec_rd_strand s
end
seal_end = get ocl_rcur 0
osr_eat_kw 14
osr_rd_sha_d 10
osha_save_rsha
if ne get ocl_rcur 0 get ocl_rlen 0
exit 60
end
osha_buf_ocl seal_end
if not osha_eq_rsha
exit 61
end
put ocl_cfg 2 1
put ocl_cfg 3 1
osp_clip_validate_knobs
end

note ---- 12. CLI Subcommand & Dynamic Flag Parsing Helpers ----
fn osp_arg_eq_sub ai ulong kind ulong to bool
r = oargr ai
if le r 0
ret false
end
n = ulong r
if eq kind 0
if ne n len ot_sub_cr
ret false
end
for i ulong n
if ne get oarg i get ot_sub_cr i
ret false
end
end
ret true
end
if eq kind 1
if ne n len ot_sub_ed
ret false
end
for i ulong n
if ne get oarg i get ot_sub_ed i
ret false
end
end
ret true
end
if eq kind 2
if ne n len ot_sub_vr
ret false
end
for i ulong n
if ne get oarg i get ot_sub_vr i
ret false
end
end
ret true
end
if eq kind 3
if ne n len ot_sub_in
ret false
end
for i ulong n
if ne get oarg i get ot_sub_in i
ret false
end
end
ret true
end
if eq kind 4
if ne n len ot_sub_rn
ret false
end
for i ulong n
if ne get oarg i get ot_sub_rn i
ret false
end
end
ret true
end
if eq kind 5
if ne n len ot_sub_ev
ret false
end
for i ulong n
if ne get oarg i get ot_sub_ev i
ret false
end
end
ret true
end
if eq kind 6
if ne n len ot_sub_tn
ret false
end
for i ulong n
if ne get oarg i get ot_sub_tn i
ret false
end
end
ret true
end
if eq kind 7
if ne n len ot_sub_vl
ret false
end
for i ulong n
if ne get oarg i get ot_sub_vl i
ret false
end
end
ret true
end
ret false
end

