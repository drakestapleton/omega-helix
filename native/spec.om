note Parse comma-separated signed weights W1,W2[,W3[,W4]] into ocl_wm[0..S)
fn osp_parse_weights ai ulong to void
n = oargp ai
if gt n 128
exit 2
end
ss = get ocl_st 1
p = ulong 0
cnt = ulong 0
while lt p n bound 128
if ge cnt ss
exit 2
end
negf = ulong 0
if eq ulong get oarg p 45
negf = ulong 1
p = add p 1
end
v = ulong 0
d = ulong 0
while lt p n bound 32
c = ulong get oarg p
if eq c 44
break
end
if or lt c 48 gt c 57
exit 2
end
if ge d 10
exit 2
end
v = add mul v 10 sub c 48
d = add d 1
p = add p 1
end
if eq d 0
exit 2
end
w = long v
if eq negf 1
w = neg long v
end
put ocl_wm cnt w
cnt = add cnt 1
if lt p n
p = add p 1
if eq p n
exit 2
end
end
end
if ne cnt ss
exit 2
end
end

note Parse unsigned decimal from oarg[p..end) stopping at colon or end; returns new p via ocl_rcur[0]
fn osp_oarg_u p ulong lim ulong to ulong
v = ulong 0
d = ulong 0
while lt p lim bound 32
c = ulong get oarg p
if eq c 58
break
end
if or lt c 48 gt c 57
exit 2
end
if ge d 10
exit 2
end
v = add mul v 10 sub c 48
d = add d 1
p = add p 1
end
if eq d 0
exit 2
end
put ocl_rcur 0 p
ret v
end

fn osp_is_kw_all lo ulong to bool
if ne ulong get oarg lo 97
ret false
end
if ne ulong get oarg add lo 1 108
ret false
end
ret eq ulong get oarg add lo 2 108
end

note Parse one splice spec from oarg[lo..hi) into ocl_sp_s/e/g[s]: "all" | END | START:END | START:END:SCALE
fn osp_parse_1splice lo ulong hi ulong s ulong to void
ln = sub hi lo
if eq ln 0
exit 2
end
if eq ln 3
if osp_is_kw_all lo
put ocl_sp_s s 0
put ocl_sp_e s 0
put ocl_sp_g s 1000
ret
end
end
v1 = osp_oarg_u lo hi
if or eq v1 0 gt v1 24
exit 2
end
p = get ocl_rcur 0
if eq p hi
put ocl_sp_s s OSP_SP_AUTO
put ocl_sp_e s v1
put ocl_sp_g s 1000
ret
end
if ne ulong get oarg p 58
exit 2
end
v2 = osp_oarg_u add p 1 hi
if or eq v2 0 gt v2 24
exit 2
end
p = get ocl_rcur 0
if eq p hi
put ocl_sp_s s v1
put ocl_sp_e s v2
put ocl_sp_g s 1000
ret
end
if ne ulong get oarg p 58
exit 2
end
v3 = osp_oarg_u add p 1 hi
if ne get ocl_rcur 0 hi
exit 2
end
put ocl_sp_s s v1
put ocl_sp_e s v2
put ocl_sp_g s v3
end

fn osp_parse_splice_list ai ulong to void
n = oargp ai
if gt n 128
exit 2
end
ss = get ocl_st 1
p = ulong 0
cnt = ulong 0
while lt p n bound 128
if ge cnt ss
exit 2
end
lo = p
while lt p n bound 128
if eq ulong get oarg p 44
break
end
p = add p 1
end
osp_parse_1splice lo p cnt
cnt = add cnt 1
if lt p n
p = add p 1
if eq p n
exit 2
end
end
end
if ne cnt ss
exit 2
end
end

note Parse --strand P1.sp[,P2.sp,...] from argv[ai] into strand s links
fn osp_parse_strand_arg ai ulong s ulong to void
n = oargp ai
p = ulong 0
j = ulong 0
while lt p n bound 16
if ge j 8
exit 2
end
sl = add 1 add mul s 8 j
k = ulong 0
while lt p n bound 1025
c = ulong get oarg p
if eq c 44
break
end
if or lt c 33 gt c 126
exit 2
end
if ge k OVARG_STR
exit 2
end
ovp_putb sl k uchar c
k = add k 1
p = add p 1
end
if eq k 0
exit 2
end
ovp_setlen sl k
put ocl_link add mul s 8 j add OVARG_BASE sl
j = add j 1
if lt p n
p = add p 1
if eq p n
exit 2
end
end
end
if eq j 0
exit 2
end
put ocl_k s j
end

note Parse dynamic clip override flags starting at argv[a0] (allow_edit: 1=edit flags, 2=tune flags, 0=run/eval/create)
fn osp_parse_dyn_flags a0 ulong allow ulong to void
na = oargc
if gt sub na a0 64
exit 2
end
i = a0
while lt i na bound 64
if osp_arg_eq_fl i 1
if ge add i 1 na
exit 2
end
osp_parse_weights add i 1
i = add i 2
continue
end
if osp_arg_eq_fl i 2
if ge add i 2 na
exit 2
end
si = oargu add i 1
if ge si get ocl_st 1
exit 2
end
put ocl_wm si oargs add i 2
i = add i 3
continue
end
if osp_arg_eq_fl i 3
if ge add i 1 na
exit 2
end
put ocl_st 0 oargu add i 1
i = add i 2
continue
end
if osp_arg_eq_fl i 4
if ge add i 1 na
exit 2
end
put ocl_cfg 0 oargu add i 1
i = add i 2
continue
end
if osp_arg_eq_fl i 5
if ge add i 1 na
exit 2
end
osp_parse_splice_list add i 1
i = add i 2
continue
end
if osp_arg_eq_fl i 6
if ge add i 2 na
exit 2
end
si2 = oargu add i 1
if ge si2 get ocl_st 1
exit 2
end
n2 = oargp add i 2
osp_parse_1splice 0 n2 si2
i = add i 3
continue
end
if and eq allow 1 osp_arg_eq_fl i 7
if ge add i 1 na
exit 2
end
put ocl_cfg 8 ovp_from_arg 37 add i 1
i = add i 2
continue
end
if eq allow 2
if osp_arg_eq_fl i 8
if ge add i 1 na
exit 2
end
nb = oargu add i 1
if or eq nb 0 gt nb 64
exit 2
end
put ocl_cfg 6 nb
i = add i 2
continue
end
if osp_arg_eq_fl i 9
if ge add i 1 na
exit 2
end
al = oargu add i 1
if gt al 8
exit 2
end
put ocl_cfg 5 al
i = add i 2
continue
end
if osp_arg_eq_fl i 10
put ocl_cfg 4 1
i = add i 1
continue
end
if osp_arg_eq_fl i 11
if ge add i 1 na
exit 2
end
put ocl_cfg 7 ovp_from_arg 35 add i 1
i = add i 2
continue
end
if osp_arg_eq_fl i 12
put ocl_cfg 7 999999
i = add i 1
continue
end
end
exit 2
end
end

note ---- 13. spclip create / edit / verify / inspect / run / eval ----

note spclip create OUT.spclip BASE.ck (--strand ... | S W1 K1 ...) [--weights ...] [--mode M] [--tau T] [--splice ...]
fn cmdspclip_create to void
na = oargc
if lt na 7
exit 2
end
osp_clip_defaults
out_ai = ovp_from_arg 37 3
put ocl_cfg 1 ovp_from_arg 0 4
put ocl_cfg 2 1
put ocl_cfg 3 2
put ocl_st 0 1
if osp_arg_eq_fl 5 0
ss = ulong 0
i = ulong 5
while lt i na bound 64
if not osp_arg_eq_fl i 0
break
end
if or ge add i 1 na ge ss 4
exit 2
end
osp_parse_strand_arg add i 1 ss
put ocl_wm ss 1000
ss = add ss 1
i = add i 2
end
if lt ss 2
exit 2
end
put ocl_st 1 ss
osp_parse_dyn_flags i 0
else
ss = oargu 5
if or lt ss 2 gt ss 4
exit 2
end
put ocl_st 1 ss
idx = ulong 6
for s ulong ss
if gt add idx 2 na
exit 2
end
put ocl_wm s oargs idx
ks = oargu add idx 1
if or eq ks 0 gt ks 8
exit 2
end
if gt add add idx 2 ks na
exit 2
end
put ocl_k s ks
for j ulong ks
sl = add 1 add mul s 8 j
put ocl_link add mul s 8 j ovp_from_arg sl add add idx 2 j
end
idx = add add idx 2 ks
end
osp_parse_dyn_flags idx 0
end
osp_clip_validate_knobs
osp_clip_init
osp_rec_write out_ai
oputc 83
oputc 80
oputc 67
oputc 76
oputc 73
oputc 80
oputc 95
oputc 67
oputc 82
oputc 69
oputc 65
oputc 84
oputc 69
oputc 32
oputu get ocl_st 1
oputc 32
oputu get ocl_st 0
oputc 32
oputu get ocl_cfg 0
oputc 32
oput_sha_rsha
oputc 10
oflush
end

note spclip edit RECIPE.spclip [--out OUT.spclip] [--weights ...] [--set-weight I W] [--mode M] [--tau T] [--splice ...] [--set-splice I S]
fn cmdspclip_edit to void
na = oargc
if lt na 4
exit 2
end
rec_ai = ovp_from_arg 36 3
osp_rec_load rec_ai
put ocl_cfg 8 rec_ai
osp_parse_dyn_flags 4 1
osp_clip_validate_knobs
osp_clip_init
osp_rec_write get ocl_cfg 8
oputc 83
oputc 80
oputc 67
oputc 76
oputc 73
oputc 80
oputc 95
oputc 69
oputc 68
oputc 73
oputc 84
oputc 32
oputu get ocl_st 1
oputc 32
oputu get ocl_st 0
oputc 32
oputu get ocl_cfg 0
oputc 32
oput_sha_rsha
oputc 10
oflush
end

