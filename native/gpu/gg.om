note SPDX-License-Identifier: AGPL-3.0-only
note gg.om: ollm GPU gradient (aien-train#52, rung 4). The step loss and its gradient for the batch in
note obx/oby, computed on the GB10 by gk.om GEMMs and gr.om row kernels over all R = B T rows at
note once in f32; the gradient lands in ogr[0..P) as f64 and the loss in olos, so oadam and olsum run
note unchanged on the CPU. Arena (gbmem 5) byte offsets in gga: 0 W, 1 G, 2 X, 3 Y, 4 CSR start
note (V + 1), 5 CSR order (R), 6 first layer, 7 layer stride, 8 HF, 9 SF, 10 Z, 11 logits (R V),
note 12 CE stats (R 3), 13 DH, 14 DA, 15 DQ DK DU (contiguous), 16 DO, 17 DF, 18 DP, 19 WS, 20 CS;
note layer fields 24 + f: 0 hin 1 a 2 q 3 k 4 u 5 o 6 hm 7 bn 8 s1 9 s2 10 fp 11 rl 12 P;
note 40 the arena device address, 47 the plan cursor. s1, s2 and SF hold 1/s (the CPU keeps s).
global gga ulong 56
global gknv4 uint 1
global ggw4_ok ulong 1
global ggn4p ulong 3
global ggn4s f64 2
global ggn4q uint 1
global ggn4ep uint 1
global ggenv uchar 64
text ggnv4e "OLLM_NVFP4=1"
global ggcn ulong 65537
note byte strides: 0 D, 1 T D, 2 E, 3 T, 4 T T, 5 H T T, 6 R D, 7 D D (each times 4)
global ggs uint 8
note OMUTG: 1 in the product; 0 in mutant g (DK = -DS^T Q), which the parity check must catch.
const OMUTG ulong 1
note Looped models (docs/LOOP.md): the layer region holds one activation block per layer application
note (og 56 of them), and application l reads the parameters and adds to the gradient of parameter layer
note olp l (model.om ovg1..ovw2). Every weight-gradient launch accumulates into G, which ggbwd zeroes
note once, so a core's gradient is the sum over its passes. Without a loop og 56 = L and olp l = l.
note OMUTLG: 1 in the product; 0 in mutant lg (the w2 gradient of an application that repeats an
note earlier parameter layer is not launched, model.om's mutant lp on the chip), which gcmp and gcmp2 on
note a looped checkpoint must catch. Without a loop the two are the same.
const OMUTLG ulong 1
note Frozen-core training on the chip (spec.om trainf's FREEZE_LAYERS F). ggfz: 0 the frozen
note parameter count fz = og 31 + F og 32 (the embeddings wte and wpe, then layers 0..F-1), 1 F. With
note fz > 0, ggbwd stops after layer F and launches no gradient into [0, fz) (the tied head's wte
note term, the WPE column sums, the embedding scatter), so G[0, fz) stays the zero ggbwd wrote; ggadam
note clips over that G and steps only [fz, P); ggdnst brings back only [fz, P), so the frozen f64
note weights and moments on the host stay bit for bit (spext checks them by hash). A looped
note checkpoint with F > 0 is exit 17, as cmdtrainf (ockload) refuses it on the CPU.
note OMUTFZ: 1 in the product; 0 in mutant fz (the chip ignores the freeze: full backward, Adam and
note download), which gcmp and gacmp with FREEZE_LAYERS and spext after gtrainf must catch.
const OMUTFZ ulong 1
global ggfz ulong 2

note GPU setup failed (ggopen): a clear stage and error on stderr, then exit 75. L1014: a setup
note that failed before buffers 2 and 3 existed used to reach ggdie's mapget of the unmapped slots, which
note trapped BOUNDS (exit 103) with no message. stdout stays free for the program's own output.
note Error 81 is RM status 0x51 NV_ERR_NO_MEMORY (open-gpu-kernel-modules nvstatuscodes.h). Only stage 35
note (the compute object, context.om) waits on it, 50 x 100 ms, because there it means another job holds
note the GPU. At any other stage, such as 21 (a memory allocation), there is no wait and no retry, so
note "try again" is not offered; the cause there is not established by this code, so the text names none.
text ggsa "omega: GPU setup failed at stage "
text ggsb ", error "
text ggsc " (driver status 81, out of memory: seen while another job holds the GPU; it outlasted the bounded wait). Try again.\n"
text ggse " (driver status 81, out of memory, at a step with no wait and no retry; only stage 35 waits for a busy GPU).\n"
text ggsd " (positive is driver status, negative is errno or internal; the stage is the nvstage step in gpu/context.om).\n"

fn ggerr1 n ulong to void
p = ulong 0
while lt p n bound 4097
w = write 2 oout p sub n p
if le w 0
exit 70
end
p = add p ulong w
end
put oon 0 0
end

fn ggsetupfail to void
oflush
r = write 2 ggsa 0 len ggsa
oputu ulong get nvstage 0
ggerr1 get oon 0
r = write 2 ggsb 0 len ggsb
oputl get nverr 0
ggerr1 get oon 0
if eq get nverr 0 81
if eq get nvstage 0 35
r = write 2 ggsc 0 len ggsc
else
r = write 2 ggse 0 len ggse
end
else
r = write 2 ggsd 0 len ggsd
end
exit 75
end

fn ggdie c ulong to void
oputc 71
oputc 88
oputc 32
oputu c
oputc 32
oputl get nverr 0
oputc 32
oputu ulong get nvstage 0
note diagnostics: launches done, mark1, mark2, QMD semaphore; zero while slots 2 and 3 are unmapped
note (a failed ggopen), where mapget of an unmapped slot trapped BOUNDS (exit 103, no message)
oputc 32
oputl get gkt 0
oputc 32
if and ne get gbmem 3 0 ne get gbmem 2 0
oputu mapget get gbmem 3 0 4
oputc 32
oputu mapget get gbmem 3 16 4
oputc 32
oputu mapget get gbmem 2 8192 4
oputc 32
oputu get gbst 4
oputc 32
oputu get gbst 5
else
oputc 48
oputc 32
oputc 48
oputc 32
oputc 48
end
oputc 10
oflush
exit 84
end

fn ggcd n ulong k ulong to ulong
ret div add n sub k 1 k
end

fn ggr to ulong
ret mul get og 6 get og 1
end

note P rounded up to the SQN chunk of 512; the gradient buffer is that long and zeroed to it
fn ggp5 to ulong
ret mul ggcd get og 8 512 512
end

fn ggput i ulong n ulong to void
c = get gga 47
put gga i c
b = mul div add mul n 4 255 256 256
put gga 47 add c b
end

fn ggplan_nv4 r ulong d ulong f ulong to void
if eq get gknv4 0 0
put gga 41 0
put gga 42 0
put gga 43 0
put gga 44 0
put gga 48 0
put gga 49 0
put gga 50 0
put gga 51 0
ret
end
mx = mul 3 mul r d
t = mul r f
if gt t mx
mx = t
end
t = mul d f
if gt t mx
mx = t
end
t = mul r get og 0
if gt t mx
mx = t
end
t = mul d get og 0
if gt t mx
mx = t
end
nnv = ggcd mx 8
nsx = ggcd mx 64
ggput 41 nnv
ggput 42 nsx
ggput 43 nnv
ggput 44 nsx
wlay = add mul 4 mul d d mul 2 mul d f
wtot = mul get og 5 wlay
wnv = ggcd wtot 8
wsx = ggcd wtot 64
ggput 48 wnv
ggput 49 wsx
ggput 50 wnv
ggput 51 wsx
end

note arena plan for the dims in og; returns its size in bytes
fn ggplan to ulong
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
bb = get og 6
r = ggr
rd = mul r d
pp = mul mul bb h mul tt tt
put gga 47 0
for i ulong 8
ggput add 24 i rd
end
ggput 32 r
ggput 33 r
ggput 34 mul r f
ggput 35 mul r f
ggput 36 pp
put gga 7 get gga 47
put gga 47 0
ggput 0 get og 8
ggput 1 ggp5
ggput 2 r
ggput 3 r
ggput 4 add get og 0 1
ggput 5 r
put gga 6 get gga 47
ls = mul get gga 7 get og 56
put gga 47 add get gga 47 ls
ggput 8 rd
ggput 9 r
ggput 10 rd
ggput 11 mul r get og 0
ggput 12 mul r 3
ggput 13 rd
ggput 14 rd
ggput 15 mul rd 3
ggput 16 rd
ggput 17 mul r f
ggput 18 pp
ggput 19 rd
ggput 20 mul bb d
ggput 21 get og 8
ggput 22 get og 8
sn = div ggp5 512
if lt sn 2048
sn = 2048
end
ggput 23 sn
note 37: split-K partials for ggsk, up to 4M floats (16 MB) so 128x128 dW fills 3.0 waves on 48 SMs
ggput 37 4194304
note 38: packed-BF16 weight shadow (P * 2 bytes = ggp5 / 2 u32 words) for native BF16-IO 128x128 GEMMs
ggput 38 div ggp5 2
note 39: packed-BF16 dlogits scratch (R * V * 2 bytes) so F32->BF16 after CE is out-of-place & race-free
ggput 39 div mul r get og 0 2
note 41..44: NVFP4 quantized scratch buffers (A_nv4, Sa_nv4, B_nv4, Sb_nv4) when gknv4 != 0
ggplan_nv4 r d f
ret get gga 47
end

fn gga1 i ulong to ulong
ret add get gga 40 get gga i
end

fn ggl l ulong f ulong to ulong
o = add get gga 6 mul l get gga 7
ret add add get gga 40 o get gga add 24 f
end

note address of the output of layer application l (the next hin, or HF after the last one)
fn ggout l ulong to ulong
if lt add l 1 get og 56
ret ggl add l 1 0
end
ret gga1 8
end

fn ggw o ulong to ulong
ret add gga1 0 mul o 4
end

fn ggwh o ulong to ulong
ret add gga1 38 mul o 2
end

fn ggg o ulong to ulong
ret add gga1 1 mul o 4
end

note GEMM tiles need m, n multiples of 32 and k of 16: V T D F E multiples of 32; R = B T;
note softmax rows keep T/32 values per lane in R32..R47, so T is at most 512
fn ggok to bool
for i ulong 5
v = get og i
if eq i 3
v = get og 7
end
if eq i 1
v = get og 1
end
if or eq v 0 ne rem v 32 0
ret false
end
end
if gt get og 0 65536
ret false
end
if gt get og 1 512
ret false
end
ret le mul get og 6 get og 3 65535
end

note open the chip and emit the kernels for the dims in og
fn ggopen to void
if not ggok
ggdie 1
end
asz = ggplan
v = get og 0
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
bb = get og 6
grset v tt d h f bb
if not gropen asz
ggsetupfail
end
if not gbbopen
ggdie 122
end
put gga 40 gkbase
ggstr
end

note pointer j (1-based) into arg slots 2j, 2j + 1
fn ggpt j uint a ulong to void
put gkarg mul j 2 gblo a
put gkarg add mul j 2 1 gbhi a
end

fn ggu s uint v ulong to void
put gkarg s uint v
end

fn ggrun id uint na uint gx ulong gy ulong gz ulong to void
put gkna 0 na
x = uint gx
y = uint gy
z = uint gz
if not gklaunch id x y z
ggdie add 100 ulong id
end
end

fn ggmm m ulong n ulong k ulong nz ulong h2 ulong bt bool to void
a = uint m
b = uint n
c = uint k
e = uint nz
g = uint h2
if not gkmm a b c e g bt
ggdie 99
end
end

note Packed-BF16 Native-IO GEMM & conversion helpers (slots 67..74, 82..83)
fn ggmmh m ulong n ulong k ulong nz ulong h2 ulong fl uint to void
a = uint m
b = uint n
c = uint k
e = uint nz
g = uint h2
if not gkmmh a b c e g fl
ggdie 99
end
end

note NVFP4 (OMMA.SF.16864) mode state, env check, quantizer (slots 88/89), and 128x128 GEMM (slots 90..95)
fn ggsnv4 v uint to void
put gknv4 0 v
end

fn ggnv4_eq n long to bool
if ne n long len ggnv4e
ret false
end
for j ulong len ggnv4e
if ne get ggenv j get ggnv4e j
ret false
end
end
ret true
end

fn ggnv4_env to bool
ec = ulong envcnt
for i ulong ec bound 4096
n = envread i ggenv 0 64
if ggnv4_eq n
ret true
end
end
ret false
end

fn ggnv4_shape m ulong n ulong k ulong to bool
if or eq m 0 or eq n 0 eq k 0
ret false
end
if or ne rem m 128 0 ne rem n 128 0
ret false
end
ret eq rem k 64 0
end

fn ggnv4_ok to bool
if not ggbf_ok
ret false
end
if eq get gknv4 0 0
ret false
end
ret eq rem get og 2 128 0
end

fn ggdw_nv4_ok m ulong n ulong to bool
if not ggnv4_ok
ret false
end
if not ggnv4_shape m n ggr
ret false
end
ret ge mul m n 786432
end

fn ggqnv4_p ps f64 to void
put ggn4q 0 bitcast uint f32 ps
end

fn ggmm4_sc sa f64 sb f64 to void
put ggn4s 0 sa
put ggn4s 1 sb
end

note Quantize BF16 operand to NVFP4 E2M1 + UE4M3 block-16 scales:
note tr=false -> slot 88 (row-major [m,k], stride=k*2, grid=(m,1,1))
note tr=true  -> slot 89 (transposed [k,m]->[m,k], stride=m*2, grid=(m/32,k/64,1))
note gkarg[9] holds f32 pre_scale bits (defaults to 1.0f = 0x3f800000 when ggn4q[0] == 0)
fn ggqnv4 src ulong dst ulong sc ulong m ulong k ulong tr bool to void
ggpt 0 src
ggpt 1 dst
ggpt 2 sc
ggu 6 m
ggu 7 k
ps = get ggn4q 0
if eq ps 0
ps = 1065353216
end
ggu 9 ulong ps
if tr
ggu 8 mul m 2
ggrun 89 10 div m 32 div k 64 1
ret
end
ggu 8 mul k 2
ggrun 88 10 div m 8 div k 64 1
end

fn ggmm4_id fl uint ep uint to uint
if eq ep 1
ret 94
end
if eq ep 2
ret 95
end
bt = ne and fl 1 0
obf = ne and fl 2 0
if obf
if bt
ret 91
end
ret 90
end
if bt
ret 93
end
ret 92
end

fn ggmm4_ab anv ulong asx ulong bnv ulong bsx ulong m ulong n ulong to void
ggpt 0 anv
ggpt 1 asx
ggu 4 mul m 32
ggu 5 mul m 4
ggu 6 0
ggu 7 0
ggpt 4 bnv
ggpt 5 bsx
ggu 12 mul n 32
ggu 13 mul n 4
ggu 14 0
ggu 15 0
end

fn gggrad_sc to f64
s = mul 2.0f64 f64 ggr
if lt s 4096.0f64
ret 4096.0f64
end
ret s
end

fn ggw4_el lp ulong wi ulong to ulong
d = get og 2
f = get og 4
dd = mul d d
df = mul d f
wlay = add mul 4 dd mul 2 df
base = mul lp wlay
if lt wi 4
ret add base mul wi dd
end
if eq wi 4
ret add base mul 4 dd
end
ret add base add mul 4 dd df
end

fn ggw4_dt lp ulong wi ulong tr bool to ulong
el = ggw4_el lp wi
if tr
ret add gga1 48 div el 2
end
ret add gga1 50 div el 2
end

fn ggw4_sc lp ulong wi ulong tr bool to ulong
el = ggw4_el lp wi
if tr
ret add gga1 49 div el 16
end
ret add gga1 51 div el 16
end

fn ggmm4_ab_z m ulong n ulong ks ulong to void
ggpt 0 gga1 41
ggpt 1 gga1 42
ggu 4 mul m 32
ggu 5 mul m 4
ggu 6 div mul ks m 2
ggu 7 div mul ks m 16
ggpt 4 gga1 43
ggpt 5 gga1 44
ggu 12 mul n 32
ggu 13 mul n 4
ggu 14 div mul ks n 2
ggu 15 div mul ks n 16
end

fn ggmm4_lch_z m ulong n ulong k ulong nz ulong fl uint to void
ep = get gkep 0
put gkep 0 0
put nverr 0 0
put gkarg 23 gkmagic uint nz uint nz
if ne get nverr 0 0
put gkfl 0 0
ggdie 99
end
put gkarg 24 neg uint nz
put gkarg 22 uint div k 64
put gkarg 26 0
put gkarg 27 0
put gkarg 28 1073741824
put gkbp 7 0
put gkps 0 uint m
put gkps 1 uint n
put gkps 2 uint k
if ne ep 0
ep_sc = get ggn4ep 0
put ggn4ep 0 0
put gkarg 6 gblo gga1 43
put gkarg 7 gbhi gga1 43
put gkarg 14 gblo gga1 44
put gkarg 15 gbhi gga1 44
put gkarg 26 uint m
put gkarg 27 ep_sc
put gkna 0 32
else
put gkna 0 29
end
id = ggmm4_id fl ep
if not gkmmsw id uint div n 128 uint div m 128 uint nz 2
ggdie 99
end
end

fn ggmm4_lch m ulong n ulong k ulong fl uint to void
ggmm4_lch_z m n k 1 fl
end

fn ggks_nv4 m ulong n ulong to ulong
r = ggr
b128 = mul div m 128 div n 128
mn = mul m n
s = ulong 1
while lt mul b128 s 144 bound 8
s2 = mul s 2
if gt s2 16
ret s
end
if ne rem r mul s2 64 0
ret s
end
if gt mul mn s2 4194304
ret s
end
s = s2
end
ret s
end

fn ggmm4_pt a ulong b ulong c ulong to void
put ggn4p 0 a
put ggn4p 1 b
put ggn4p 2 c
end

note Cached-weight NVFP4 GEMM: ggn4p[0]=x, ggn4p[2]=c, ggn4s[0]=sa
fn ggmm4_cwp lp ulong wi ulong tr bool n ulong k ulong fl uint to void
sa = get ggn4s 0
if eq sa 0.0f64
sa = 1.0f64
end
put ggn4s 0 1.0f64
ggmm4_ab gga1 41 gga1 42 ggw4_dt lp wi tr ggw4_sc lp wi tr ggr n
al = div 1.0f64 mul sa 16.0f64
gkopc get ggn4p 2 uint mul n 2 2 0 0 f32 al
ggmm4_lch ggr n k fl
end

fn ggmm4_cwp2 lp ulong wi ulong tr bool n ulong k ulong fl uint to void
sa = get ggn4s 0
if eq sa 0.0f64
sa = 1.0f64
end
put ggn4s 0 1.0f64
ggmm4_ab gga1 43 gga1 44 ggw4_dt lp wi tr ggw4_sc lp wi tr ggr n
al = div 1.0f64 mul sa 16.0f64
gkopc get ggn4p 2 uint mul n 2 2 0 0 f32 al
ggmm4_lch ggr n k fl
end

fn ggmm4_cw lp ulong wi ulong tr bool n ulong k ulong fl uint to void
sa = get ggn4s 0
if eq sa 0.0f64
sa = 1.0f64
end
ggqnv4_p sa
ggqnv4 get ggn4p 0 gga1 41 gga1 42 ggr k false
ggqnv4_p 1.0f64
ggmm4_cwp lp wi tr n k fl
end

note On-chip BF16->NVFP4 quantize (with 2-level tensor pre-scale ggn4s[0..1]) + K-looped 128x128 GEMM (slots 88/89 + 90..95)
fn ggmm4 m ulong n ulong k ulong fl uint ta bool tb bool to void
sa = get ggn4s 0
sb = get ggn4s 1
if eq sa 0.0f64
sa = 1.0f64
end
if eq sb 0.0f64
sb = 1.0f64
end
put ggn4s 0 1.0f64
put ggn4s 1 1.0f64
ggqnv4_p sa
ggqnv4 get ggn4p 0 gga1 41 gga1 42 m k ta
ggqnv4_p sb
ggqnv4 get ggn4p 1 gga1 43 gga1 44 n k tb
ggqnv4_p 1.0f64
ggmm4_ab gga1 41 gga1 42 gga1 43 gga1 44 m n
al = div 1.0f64 mul sa sb
if ne and fl 2 0
gkopc get ggn4p 2 uint mul n 2 2 0 0 f32 al
else
gkopc get ggn4p 2 uint mul n 4 4 0 0 f32 al
end
ggmm4_lch m n k fl
end

fn ggxwh_bf x ulong w ulong c ulong n ulong k ulong bt bool to void
fl = uint 2
if bt
fl = 3
end
k2 = uint mul k 2
n2 = uint mul n 2
gkoph 0 x k2 2 0 0
gkoph 1 w 2 n2 0 0
gkopc c n2 2 0 0 f32 1.0f64
ggmmh ggr n k 1 1 fl
end

fn ggxwh x ulong w ulong c ulong n ulong k ulong bt bool to void
fl = uint 2
if bt
fl = 3
end
if and ggnv4_ok ggnv4_shape ggr n k
ggmm4_pt x w c
ggmm4 ggr n k fl false true
ret
end
ggmm4_sc 1.0f64 1.0f64
ggxwh_bf x w c n k bt
end

fn ggxwth x ulong w ulong c ulong n ulong k ulong bt bool to void
fl = uint 2
if bt
fl = 3
end
if and ggnv4_ok ggnv4_shape ggr n k
ggmm4_pt x w c
ggmm4 ggr n k fl false false
ret
end
ggmm4_sc 1.0f64 1.0f64
k2 = uint mul k 2
n2 = uint mul n 2
gkoph 0 x k2 2 0 0
gkoph 1 w k2 2 0 0
gkopc c n2 2 0 0 f32 1.0f64
ggmmh ggr n k 1 1 fl
end

fn ggskh m ulong n ulong nz ulong s ulong g ulong gz uint to void
mn = mul m n
p = gga1 37
n4 = uint mul n 4
c1 = uint mul mul mn s 4
c2 = uint mul mn 4
gkopc p n4 4 c1 c2 f32 1.0f64
k = div ggr s
z = mul nz s
ggmmh m n k z s 0
ggskr mn nz s g gz
end

fn ggf2b n ulong src ulong dst ulong to void
n8 = div n 8
ggu 0 n8
ggpt 1 src
ggpt 2 dst
ggrun 82 6 ggcd n8 256 1 1
end

fn ggb2f n ulong src ulong dst ulong to void
n8 = div n 8
ggu 0 n8
ggpt 1 src
ggpt 2 dst
ggrun 83 6 ggcd n8 256 1 1
end

note C[R][n] (+)= X[R][k] W[k][n]
fn ggxw x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w 4 n4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm ggr n k 1 1 bt
end

note C[R][n] (+)= X[R][k] W[n][k]^T
fn ggxwt x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w k4 4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm ggr n k 1 1 bt
end

note G[kk][n] += X[R][kk]^T DY[R][n], split over R when the grid is small (ggks)
fn ggwg x ulong dy ulong g ulong kk ulong n ulong to void
k4 = uint mul kk 4
n4 = uint mul n 4
s = ggks kk n 1
if eq s 1
gkopa 0 x 4 k4 0 0
gkopa 1 dy 4 n4 0 0
gkopc g n4 4 0 0 f32 1.0f64
ggmm kk n ggr 1 1 true
ret
end
sl = div ggr s
gkopa 0 x 4 k4 0 uint mul mul sl kk 4
gkopa 1 dy 4 n4 0 uint mul mul sl n 4
ggsk kk n 1 s g 0
end

note Split-K for the weight gradients, whose depth is R = B T. A grid of (m/32)(n/32)nz blocks
note leaves most SMs idle (rung-6 gprof: id 4 at 1.7-6 TFLOP/s on 64-256 blocks), so ggks doubles
note the split s (up to 16, R/s a multiple of 16) until the grid reaches 1024 blocks: then
note blocks s < 2048, so the m n nz s partials fit the 2^21 floats of slot 37.
note Under gkbf 1 a slice depth R/s must also be a multiple of the BF16 K tile 32 (gk.om gkbfok):
note with R = 128 (the small shape B 4, T 32) the f32 rule took s = 8, depth 16, which gkmm refuses
note with nverr -22, so gbcmp, gbcmp2 and gtrainb ended in ggdie (exit 84). At R = 16384 (B 64, T 256)
note every s <= 16 leaves a depth that is a multiple of 32: the split there is unchanged.
fn ggks m ulong n ulong nz ulong to ulong
r = ggr
if ggbf_ok
b128 = mul mul div m 128 div n 128 nz
if ge b128 96
ret 1
end
mnz = mul mul m n nz
s = ulong 1
while lt mul b128 s 288 bound 8
s2 = mul s 2
if gt s2 16
ret s
end
if ne rem r mul s2 32 0
ret s
end
if gt mul mnz s2 4194304
ret s
end
s = s2
end
ret s
end
b = mul mul div m 32 div n 32 nz
kq = ulong 16
if eq get gkbf 0 1
kq = 32
end
s = ulong 1
while lt mul b s 1024 bound 8
s2 = mul s 2
if or gt s2 16 ne rem r mul s2 kq 0
ret s
end
s = s2
end
ret s
end

note Operands A and B are set (gkopa) with the slice stride as s2. Batch z = z1 s + z2 (z1 < nz the
note caller's batch, z2 < s the slice) writes partial P[z1][z2] = A[z1 z2]^T B[z1 z2] into slot 37,
note then COLSUM 14 adds G[z1] (byte stride gz) += sum over z2 of P[z1][z2], in slice order.
note Mutant p (OMUTP 0) adds one slice fewer, which gcmp2 must catch.
const OMUTP ulong 1
fn ggsk m ulong n ulong nz ulong s ulong g ulong gz uint to void
mn = mul m n
p = gga1 37
n4 = uint mul n 4
c1 = uint mul mul mn s 4
c2 = uint mul mn 4
gkopc p n4 4 c1 c2 f32 1.0f64
k = div ggr s
z = mul nz s
ggmm m n k z s false
ggskr mn nz s g gz
end

note COLSUM 14 over slot 37: G[c gz + i] += sum over z2 < s of P[c][z2][i], vectorized 256 thr x 4 floats
fn ggskr mn ulong nz ulong s ulong g ulong gz uint to void
kc = s
if eq OMUTP 0
kc = sub s 1
end
mn4 = div mn 4
ggu 0 mn4
ggu 1 kc
ggpt 1 gga1 37
ggu 4 mul mn 4
ggu 5 mul mul mn s 4
ggpt 3 g
ggu 8 ulong gz
cid = uint 14
if ggow_ok
cid = 13
end
ggrun cid 9 ggcd mn4 256 nz 1
end

note 19 COPY (x into y), 20 ZERO (x) over n elements (256 threads x 4 floats via LDG.E.128/STG.E.128)
fn ggew id uint n ulong x ulong y ulong to void
n4 = div n 4
ggu 0 n4
ggpt 1 x
ggpt 2 y
ggrun id 6 ggcd n4 256 1 1
end

fn ggrmsf_h v ulong g ulong y ulong s ulong to void
r = mul ggr 32
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 y
ggpt 4 s
ggpt 5 0
ggpt 6 0
ggu 14 ggr
ggu 15 0
ggrun 75 16 ggcd r 256 1 1
end

fn ggrmsf_h_nv4 v ulong g ulong y ulong s ulong to void
r = mul ggr 32
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 y
ggpt 4 s
ggpt 5 gga1 41
ggpt 6 gga1 42
ggu 14 ggr
ggu 15 1
ggrun 75 16 ggcd r 256 1 1
end

global ggdgb ulong 2
fn ggrms_g to ulong
g = div ggr 8
if and le get og 2 512 gt g 144
g = 144
end
ret g
end
fn ggow_ok to bool
if not ggbf_ok
ret false
end
if ne get og 59 1
ret false
end
ret eq ggfzn 0
end

fn ggsk_nv4 dy ulong g ulong kk ulong n ulong sb f64 sa f64 to void
s = ggks_nv4 kk n
ggqnv4_p sb
ggqnv4 dy gga1 43 gga1 44 n ggr true
ggqnv4_p 1.0f64
al = div 1.0f64 mul sa sb
n4 = uint mul n 4
if eq s 1
fl = uint 1
if ggow_ok
fl = 0
end
ggmm4_ab gga1 41 gga1 42 gga1 43 gga1 44 kk n
gkopc g n4 4 0 0 f32 al
ggmm4_lch kk n ggr fl
ret
end
ks = div ggr s
mn = mul kk n
ggmm4_ab_z kk n ks
gkopc gga1 37 n4 4 0 uint mul mn 4 f32 al
ggmm4_lch_z kk n ks s 0
ggskr mn 1 s g 0
end

fn ggwgh_bf x ulong dy ulong g ulong kk ulong n ulong to void
k2 = uint mul kk 2
n2 = uint mul n 2
n4 = uint mul n 4
s = ggks kk n 1
if eq s 1
fl = uint 1
if ggow_ok
fl = 0
end
gkoph 0 x 2 k2 0 0
gkoph 1 dy 2 n2 0 0
gkopc g n4 4 0 0 f32 1.0f64
ggmmh kk n ggr 1 1 fl
ret
end
sl = div ggr s
gkoph 0 x 2 k2 0 uint mul mul sl kk 2
gkoph 1 dy 2 n2 0 uint mul mul sl n 2
ggskh kk n 1 s g 0
end

fn ggwgh x ulong dy ulong g ulong kk ulong n ulong to void
sa = get ggn4s 0
sb = get ggn4s 1
if eq sa 0.0f64
sa = 1.0f64
end
if eq sb 0.0f64
sb = 1.0f64
end
put ggn4s 0 1.0f64
put ggn4s 1 1.0f64
if ggdw_nv4_ok kk n
ggqnv4_p sa
ggqnv4 x gga1 41 gga1 42 kk ggr true
ggsk_nv4 dy g kk n sb sa
ret
end
ggwgh_bf x dy g kk n
end
fn ggain_cnt to ulong
if and ggbf_ok le ggrms_g 256
ret 1
end
ret 2
end
fn ggdef_gain to bool
if not ggbf_ok
ret false
end
if ne get og 59 1
ret false
end
gx = ggrms_g
if gt gx 256
ret false
end
nl = sub get og 56 ggfzl
if or eq nl 0 gt nl 16
ret false
end
ret le mul mul 2 nl gx ggr
end
fn ggrmsb_h_ex v ulong g ulong s ulong ws ulong owdh ulong to void
r = mul ggr 32
gx = ggrms_g
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 s
ggpt 4 gga1 14
ggpt 5 gga1 13
ggpt 6 ws
ggu 14 owdh
ggu 15 mul gx 256
ggrun 76 16 gx 1 1
end
fn ggrmsb_h v ulong g ulong s ulong to void
ggrmsb_h_ex v g s gga1 19 0
end
fn ggws_off idx ulong to ulong
if eq get ggdgb 1 0
ret gga1 19
end
ret add gga1 19 mul mul idx ggrms_g mul get og 2 4
end
fn ggrmsb_gain l ulong ffn bool to void
idx = sub l get ggdgb 0
if not ffn
idx = add get ggdgb 1 idx
end
ws = ggws_off idx
v = ggl l 0
go = ovg1 l
s = ggl l 8
if ffn
v = ggl l 6
go = ovg2 l
s = ggl l 9
end
g = ggw go
ggrmsb_h_ex v g s ws 0
if eq get ggdgb 1 0
ggain_h go
end
end

note RMSF/RMSB run one warp per row: arg 0 and the thread count are R*32
fn ggrmsf v ulong g ulong y ulong s ulong to void
r = mul ggr 32
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 y
ggpt 4 s
ggrun 10 10 ggcd r 64 1 1
end

note dh += RMS backward of da; the gain terms go to WS
fn ggrmsb v ulong g ulong s ulong to void
r = mul ggr 32
ggu 0 r
ggpt 1 v
ggpt 2 g
ggpt 3 s
ggpt 4 gga1 14
ggpt 5 gga1 13
ggpt 6 gga1 19
ggrun 11 14 ggcd r 64 1 1
end

note gain gradient at parameter offset go += column sums of WS (grid-stride <=144xD or 8-warp CTA-reduced R/8)
fn ggain_h go ulong to void
d = get og 2
d4 = div d 4
gx = ggrms_g
cid = uint 14
if ggow_ok
cid = 13
end
if le gx 256
ggu 0 d4
ggu 1 gx
ggpt 1 gga1 19
ggu 4 mul d 4
ggu 5 0
ggpt 3 ggg go
ggu 8 0
ggrun cid 9 ggcd d4 256 1 1
ret
end
tt8 = div get og 1 8
bb = get og 6
ggu 0 d4
ggu 1 tt8
ggpt 1 gga1 19
ggu 4 mul d 4
ggu 5 mul mul tt8 d 4
ggpt 3 gga1 20
ggu 8 mul d 4
ggrun 13 9 ggcd d4 256 bb 1
ggu 0 d4
ggu 1 bb
ggpt 1 gga1 20
ggu 4 mul d 4
ggu 5 0
ggpt 3 ggg go
ggu 8 0
ggrun cid 9 ggcd d4 256 1 1
end
fn ggain_def lo ulong nl ulong to void
d = get og 2
d4 = div d 4
gx = ggrms_g
cid = uint 14
if ggow_ok
cid = 13
end
gd4 = mul mul gx d 4
l4 = mul get og 32 4
ggu 0 d4
ggu 1 gx
ggpt 1 gga1 19
ggu 4 mul d 4
ggu 5 gd4
ggpt 3 ggg ovg2 lo
ggu 8 l4
ggrun cid 9 ggcd d4 256 nl 1
ggu 0 d4
ggu 1 gx
ggpt 1 add gga1 19 mul nl gd4
ggu 4 mul d 4
ggu 5 gd4
ggpt 3 ggg ovg1 lo
ggu 8 l4
ggrun cid 9 ggcd d4 256 nl 1
end

note gain gradient at parameter offset go += column sums of WS: vectorized 256 thr x 4 floats
fn ggain go ulong to void
d = get og 2
d4 = div d 4
tt = get og 1
bb = get og 6
ggu 0 d4
ggu 1 tt
ggpt 1 gga1 19
ggu 4 mul d 4
ggu 5 mul mul tt d 4
ggpt 3 gga1 20
ggu 8 mul d 4
ggrun 13 9 ggcd d4 256 bb 1
ggu 0 d4
ggu 1 bb
ggpt 1 gga1 20
ggu 4 mul d 4
ggu 5 0
ggpt 3 ggg go
ggu 8 0
ggrun 14 9 ggcd d4 256 1 1
end

note softmax rows: one warp per row, T 32 threads per score block, grid (T/2, B H)
fn ggsoft id uint p ulong dp ulong to void
tt = get og 1
ggu 0 mul tt 32
ggpt 1 p
ggpt 2 dp
ggrun id 6 div tt 2 mul get og 6 get og 3 1
end

note attention GEMM over the B H (sequence, head) batch; operands set by gghd/ggpl/ggch/ggcp first;
note cz: gkopz causal mode (1 A = P or DS, 2 A = P^T or DS^T, 3 C = S or DP)
fn ggbh m ulong n ulong k ulong bt bool cz uint to void
gkopz cz
ggmm m n k mul get og 6 get og 3 get og 3 bt
end

note head-layout operand (rows of E inside D-wide rows, batch b then head); tr: k runs along rows
fn gghd ab uint p ulong tr bool to void
s0 = get ggs 0
s1 = get ggs 1
s2 = get ggs 2
if tr
gkopa ab p 4 s0 s1 s2
else
gkopa ab p s0 4 s1 s2
end
end

note T x T score operand (batch b then head); tr: transposed
fn ggpl ab uint p ulong tr bool to void
s3 = get ggs 3
s4 = get ggs 4
s5 = get ggs 5
if tr
gkopa ab p 4 s3 s5 s4
else
gkopa ab p s3 4 s5 s4
end
end

fn ggch c ulong al f64 to void
s0 = get ggs 0
s1 = get ggs 1
s2 = get ggs 2
gkopc c s0 4 s1 s2 f32 al
end

fn ggcp c ulong al f64 to void
s3 = get ggs 3
s4 = get ggs 4
s5 = get ggs 5
gkopc c s3 4 s5 s4 f32 al
end

note stride table for the dims in og (bytes)
fn ggstr to void
d = get og 2
tt = get og 1
put ggs 0 uint mul d 4
put ggs 1 uint mul tt mul d 4
put ggs 2 uint mul get og 7 4
put ggs 3 uint mul tt 4
put ggs 4 uint mul tt mul tt 4
put ggs 5 uint mul get og 3 mul tt mul tt 4
put ggs 6 uint mul ggr mul d 4
put ggs 7 uint mul d mul d 4
end

fn ggqkv_nv4 l ulong to void
d = get og 2
lp = olp l
if ne get ggw4_ok 0 0
for p ulong 3
ggmm4_ab gga1 41 gga1 42 ggw4_dt lp p true ggw4_sc lp p true ggr d
gkopc add ggl l 2 mul p ulong get ggs 6 uint mul d 2 2 0 0 f32 0.0625f64
ggmm4_lch ggr d d 2
end
ret
end
ggqnv4_p 1.0f64
ggqnv4 ggl l 1 gga1 41 gga1 42 ggr d false
dd2 = mul mul d d 2
w0 = ggwh ovwq l
ggqnv4_p 16.0f64
for p ulong 3
ggqnv4 add w0 mul p dd2 gga1 43 gga1 44 d d true
ggmm4_ab gga1 41 gga1 42 gga1 43 gga1 44 ggr d
gkopc add ggl l 2 mul p ulong get ggs 6 uint mul d 2 2 0 0 f32 0.0625f64
ggmm4_lch ggr d d 2
end
ggqnv4_p 1.0f64
end

note q, k, u = a wq, a wk, a wv as one batched GEMM (wq wk wv and q k u are contiguous)
fn ggqkv l ulong to void
d = get og 2
a = ggl l 1
c = ggl l 2
if and ggnv4_ok ggnv4_shape ggr d d
ggqkv_nv4 l
ret
end
if ggbf_ok
d2 = uint mul d 2
s6 = get ggs 6
w2 = ggwh ovwq l
gkoph 0 a d2 2 0 0
gkoph 1 w2 2 d2 0 uint mul mul d d 2
gkopc c d2 2 0 s6 f32 1.0f64
ggmmh ggr d d 3 3 2
ret
end
w = ggw ovwq l
s0 = get ggs 0
s6 = get ggs 6
s7 = get ggs 7
gkopa 0 a s0 4 0 0
gkopa 1 w 4 s0 0 s7
gkopc c s0 4 0 s6 f32 1.0f64
ggmm ggr d d 3 3 false
end

note true when SM121 HMMA.16816 Fused Flash-Attention-2 (slots 63..66) is active for this shape
fn ggfa_ok to bool
if or eq get gkbf 0 0 ne get gkbck 0 0
ret false
end
if eq OMUTG 0
ret false
end
tt = get og 1
if or lt tt 64 ne rem tt 64 0
ret false
end
e = get og 7
ret or eq e 32 eq e 64
end
note true when 128x128 fast epilogues (residual-fused beta + single-store ReLU) are active in ggffn/ggbffn
note ggnofp[0] = 1 during gtrainf/gtrainb/gprof (skips duplicate FP store; gcmp2/gbcmp2 keeps FP for ogmask rho check)
global ggnofp uint 1
fn ggsnofp v uint to void
put ggnofp 0 v
end
fn ggfast_ffn to bool
if or eq get gkbf 0 0 ne get gkbck 0 0
ret false
end
if or ne rem ggr 128 0 ne rem get og 2 128 0
ret false
end
ret eq rem get og 4 128 0
end
fn ggskip_fp to bool
ret and ggfast_ffn ne get ggnofp 0 0
end
note true when full Packed-BF16 Native-IO training mode (slots 67..83, 2 B/elem activations + W_bf16) is active
fn ggbf_ok to bool
if not ggskip_fp
ret false
end
ret ggfa_ok
end
note P = softmax(q k^T / sqrt(E)), o = P u; uses SM121 HMMA.16816 Flash-Attention-2 (FA2F slot 63) when ggfa_ok
fn ggatt l ulong to void
tt = get og 1
e = get og 7
pp = ggl l 12
q = ggl l 2
k = ggl l 3
u = ggl l 4
o = ggl l 5
if ggfa_ok
ggpt 0 q
ggpt 1 k
ggpt 2 u
ggpt 3 o
ggpt 4 pp
fid = uint 63
if ggbf_ok
fid = 77
end
ggrun fid 10 div tt 64 get og 3 get og 6
ret
end
gghd 0 q false
gghd 1 k false
isq = div 1.0f64 fsqrt f64 e
ggcp pp isq
ggbh tt tt e false 3
ggsoft 15 pp pp
ggpl 0 pp false
gghd 1 u true
ggch o 1.0f64
ggbh tt e tt false 1
end

note hm = hin + o wo; bn = rms(hm) g2; out = hm + relu(bn w1) w2
fn ggffn_h l ulong to void
d = get og 2
f = get og 4
hm = ggl l 6
lp = olp l
cw = and ne get ggw4_ok 0 0 and ggnv4_ok and ggnv4_shape ggr d d ggnv4_shape ggr f d
gkopfl 8 ggl l 0
if and cw ge d 512
ggmm4_pt ggl l 5 0 hm
ggmm4_sc 1.0f64 1.0f64
ggmm4_cw lp 3 true d d 3
else
ggxwh_bf ggl l 5 ggwh ovwo l hm d d true
end
if cw
ggrmsf_h_nv4 hm ggw ovg2 l ggl l 7 ggl l 9
gkope 1 ggl l 11
put ggn4ep 0 1065353216
ggmm4_pt ggl l 7 0 ggl l 10
ggmm4_sc 1.0f64 1.0f64
ggmm4_cwp lp 4 true f d 2
else
ggrmsf_h hm ggw ovg2 l ggl l 7 ggl l 9
gkope 1 ggl l 11
ggmm4_sc 1.0f64 16.0f64
ggxwh ggl l 7 ggwh ovw1 l ggl l 10 f d false
end
gkopfl 8 hm
if cw
ggmm4_pt ggl l 11 0 ggout l
ggmm4_sc 1.0f64 1.0f64
ggmm4_cwp2 lp 5 true d f 3
else
ggmm4_sc 1.0f64 16.0f64
ggxwh ggl l 11 ggwh ovw2 l ggout l d f true
end
end

fn ggffn l ulong to void
if ggbf_ok
ggffn_h l
ret
end
d = get og 2
f = get og 4
rd = mul ggr d
hm = ggl l 6
x = ggl l 0
ff = ggfast_ffn
if not ff
ggew 19 rd x hm
end
x5 = ggl l 5
w = ggw ovwo l
if ff
gkopfl 8 x
end
ggxw x5 w hm d d true
x7 = ggl l 7
w = ggw ovg2 l
s = ggl l 9
ggrmsf hm w x7 s
fp = ggl l 10
w = ggw ovw1 l
y = ggl l 11
gkope 1 y
if ggskip_fp
gkopfl 4 0
end
ggxw x7 w fp f d false
o = ggout l
if not ff
ggew 19 rd hm o
end
w = ggw ovw2 l
if ff
gkopfl 8 hm
end
ggxw y w o d f true
end

fn ggfl l ulong to void
x = ggl l 0
w = ggw ovg1 l
a = ggl l 1
s = ggl l 8
if ggbf_ok
if and ne get ggw4_ok 0 0 and ggnv4_ok ggnv4_shape ggr get og 2 get og 2
ggrmsf_h_nv4 x w a s
else
ggrmsf_h x w a s
end
else
ggrmsf x w a s
end
ggqkv l
ggatt l
ggffn l
end

note ggnoce 1 (oglast): stop after logits GEMM. ggnoce 2 (gfcache): stop right after the LV layers
note (leaving final hidden state HF in gga1 8, skipping final RMS, logits and CE).
global ggnoce uint 1
fn ggb_ok to bool
ret and and eq get gkbck 0 0 eq get gkpf 0 0 and eq get gkbat 0 0 gt get gbpkt 0 0
end

fn ggquant_w1 lp ulong to void
d = get og 2
f = get og 4
w0 = ggwh opwq lp
dd2 = mul mul d d 2
for p ulong 3
w = add w0 mul p dd2
ggqnv4 w ggw4_dt lp p true ggw4_sc lp p true d d true
end
if ge d 512
wo = add w0 mul 3 dd2
ggqnv4 wo ggw4_dt lp 3 true ggw4_sc lp 3 true d d true
ggqnv4 wo ggw4_dt lp 3 false ggw4_sc lp 3 false d d false
end
w1 = ggwh opw1 lp
ggqnv4 w1 ggw4_dt lp 4 true ggw4_sc lp 4 true f d true
ggqnv4 w1 ggw4_dt lp 4 false ggw4_sc lp 4 false d f false
w2 = ggwh opw2 lp
ggqnv4 w2 ggw4_dt lp 5 true ggw4_sc lp 5 true d f true
ggqnv4 w2 ggw4_dt lp 5 false ggw4_sc lp 5 false f d false
end

fn ggquant_w to void
put ggw4_ok 0 0
if not ggnv4_ok
ret
end
d = get og 2
f = get og 4
if or not ggnv4_shape d d d not ggnv4_shape f d d
ret
end
ggqnv4_p 16.0f64
nl = get og 5
per = ulong 7
if ge d 512
per = 9
end
if and ggb_ok le mul nl per 512
if not gbbegin mul nl per
ggdie 120
end
put gkbat 0 1
for lp ulong nl bound 64
ggquant_w1 lp
end
put gkbat 0 0
if not gkbsub
ggdie 121
end
else
for lp ulong nl bound 64
ggquant_w1 lp
end
end
ggqnv4_p 1.0f64
put ggw4_ok 0 1
end
fn ggfwd_emb to void
d = get og 2
x = ggl 0 0
if ggbf_ok
x = gga1 13
end
ggu 0 d
ggpt 1 x
x = ggw 0
ggpt 2 x
x = ggw get og 30
ggpt 3 x
x = gga1 2
ggpt 4 x
tt = get og 1
bb = get og 6
ggrun 9 10 ggcd d 64 tt bb
if ggbf_ok
ggf2b mul ggr d gga1 13 ggl 0 0
end
end
fn ggfwd_head to void
if eq get ggnoce 0 2
ret
end
d = get og 2
v = get og 0
if ggbf_ok
ggrmsf_h gga1 8 ggw get og 33 gga1 10 gga1 9
d2 = uint mul d 2
v2 = uint mul v 2
gkoph 0 gga1 10 d2 2 0 0
gkoph 1 ggwh 0 d2 2 0 0
gkopc gga1 11 v2 2 0 0 f32 1.0f64
ggmmh ggr v d 1 1 2
if ne get ggnoce 0 0
ret
end
r = mul ggr 32
ggu 0 r
ggpt 1 gga1 11
ggpt 2 gga1 3
ggpt 3 gga1 12
ggpt 4 gga1 39
ggrun 87 10 ggcd r 256 1 1
ret
end
x = gga1 8
w = ggw get og 33
z = gga1 10
s = gga1 9
ggrmsf x w z s
x = gga1 11
w = ggw 0
ggxwt z w x v d false
if ne get ggnoce 0 0
ret
end
r = mul ggr 32
ggu 0 r
ggpt 1 x
x = gga1 3
ggpt 2 x
x = gga1 12
ggpt 3 x
ggrun 21 8 ggcd r 64 1 1
end
fn ggfwd_hcnt to ulong
nc = get ggnoce 0
if eq nc 2
ret 0
end
if eq nc 1
ret 2
end
ret 3
end
fn ggfwd_ecnt to ulong
if ggbf_ok
ret 2
end
ret 1
end
fn ggfwd_lcnt to ulong
c = ulong 11
if ggfa_ok
c = sub c 2
end
if ggfast_ffn
c = sub c 2
end
if ggnv4_ok
d = get og 2
f = get og 4
r = ggr
cw = and ne get ggw4_ok 0 0 and ggnv4_shape r d d ggnv4_shape r f d
if cw
note QKV: 3 GEMMs vs 1 BF16 (+2, 0 quant!); W1: 0 quant; W2: 0 quant (fused into slot 94!); O: +1 quant iff d>=512
c = add c 2
if ge d 512
c = add c 1
end
else
if ggnv4_shape r d d
c = add c 6
end
if ggnv4_shape r f d
c = add c 2
end
if ggnv4_shape r d f
c = add c 2
end
end
end
ret c
end
fn ggfwd_bat to void
lv = get og 56
lc = ggfwd_lcnt
l0 = ulong 0
while lt l0 lv bound 1024
l1 = add l0 16
if gt l1 lv
l1 = lv
end
cnt = mul sub l1 l0 lc
if eq l0 0
cnt = add cnt ggfwd_ecnt
end
if eq l1 lv
cnt = add cnt ggfwd_hcnt
end
if not gbbegin cnt
ggdie 120
end
put gkbat 0 1
if eq l0 0
ggfwd_emb
end
l = l0
while lt l l1 bound 32
ggfl l
l = add l 1
end
if eq l1 lv
ggfwd_head
end
put gkbat 0 0
if not gkbsub
ggdie 121
end
l0 = l1
end
end
fn ggfwd to void
if ggb_ok
ggfwd_bat
ret
end
ggfwd_emb
for l ulong get og 56 bound 9223372036854775807
ggfl l
end
ggfwd_head
end

fn ggbffn_h l ulong to void
d = get og 2
f = get og 4
lp = olp l
gs = gggrad_sc
cw = and ne get ggw4_ok 0 0 and ggnv4_ok and ggnv4_shape ggr f d ggnv4_shape ggr d f
gkope 2 ggl l 11
if cw
put ggn4ep 0 bitcast uint f32 gs
ggmm4_pt gga1 13 0 gga1 17
ggmm4_sc gs 1.0f64
ggmm4_cw lp 5 false f d 2
ggmm4_pt gga1 17 0 gga1 14
ggmm4_sc gs 1.0f64
ggmm4_cwp2 lp 4 false d f 2
else
ggmm4_sc gs 16.0f64
ggxwth gga1 13 ggwh ovw2 l gga1 17 f d false
end
if or eq OMUTLG 1 eq lp l
ggmm4_sc 1.0f64 gs
ggwgh ggl l 11 gga1 13 ggg ovw2 l f d
end
ggmm4_sc 1.0f64 gs
ggwgh ggl l 7 gga1 17 ggg ovw1 l d f
if not cw
ggmm4_sc gs 16.0f64
ggxwth gga1 17 ggwh ovw1 l gga1 14 d f false
end
ggrmsb_gain l true
end

note layer l FFN backward: DH holds d out on entry, d hm on exit. The dF GEMM's fused epilogue (gkope 2)
note applies the ReLU mask FP > 0; the forward W1 GEMM (ggffn, gkope 1) stores both FP and Y.
fn ggbffn l ulong to void
if ggbf_ok
ggbffn_h l
ret
end
d = get og 2
f = get og 4
dh = gga1 13
df = gga1 17
da = gga1 14
w = ggw ovw2 l
x = ggl l 10
if ggskip_fp
x = ggl l 11
end
gkope 2 x
ggxwt dh w df f d false
x = ggl l 11
w = ggg ovw2 l
if or eq OMUTLG 1 eq olp l l
ggwg x dh w f d
end
x = ggl l 7
w = ggg ovw1 l
ggwg x df w d f
w = ggw ovw1 l
ggxwt df w da d f false
x = ggl l 6
w = ggw ovg2 l
s = ggl l 9
ggrmsb x w s
ggain ovg2 l
end

fn ggfa_bwd l ulong to void
tt = get og 1
h = get og 3
bb = get og 6
dn = gga1 16
pp = ggl l 12
dp = gga1 18
dq = gga1 15
dk = add dq ulong get ggs 6
du = add dk ulong get ggs 6
id_d = uint 64
id_q = uint 65
id_kv = uint 66
if ggbf_ok
id_d = 78
id_q = 79
id_kv = 80
end
ggpt 0 ggl l 5
ggpt 1 dn
ggpt 2 dp
ggrun id_d 6 div tt 2 h bb
ggpt 0 ggl l 2
ggpt 1 ggl l 3
ggpt 2 ggl l 4
ggpt 3 dn
ggpt 4 pp
ggpt 5 dp
ggpt 6 dq
ggrun id_q 14 div tt 64 h bb
ggpt 0 ggl l 2
ggpt 1 ggl l 3
ggpt 2 ggl l 4
ggpt 3 dn
ggpt 4 pp
ggpt 5 dp
ggpt 6 dk
ggpt 7 du
ggrun id_kv 16 div tt 64 h bb
end

note layer l attention backward: DO, DP, DU, DS (in DP), DQ, DK, then DA. Causal as in ggatt: DP
note on and below the diagonal (cz 3, SOFTB reads dp above it as 0), DU and DK start at the diagonal
note (cz 2), DQ stops there (cz 1).
fn ggbatt l ulong to void
d = get og 2
tt = get og 1
e = get og 7
dh = gga1 13
dn = gga1 16
if ggbf_ok
gs = gggrad_sc
if and ge d 512 and ne get ggw4_ok 0 0 and ggnv4_ok ggnv4_shape ggr d d
ggmm4_pt dh 0 dn
ggmm4_sc gs 1.0f64
ggmm4_cw olp l 3 false d d 2
else
k2 = uint mul d 2
gkoph 0 dh k2 2 0 0
gkoph 1 ggwh ovwo l k2 2 0 0
gkopc dn k2 2 0 0 f32 1.0f64
ggmmh ggr d d 1 1 2
end
ggmm4_sc 1.0f64 gs
ggwgh ggl l 5 dh ggg ovwo l d d
ggfa_bwd l
ret
end
w = ggw ovwo l
ggxwt dh w dn d d false
x = ggl l 5
w = ggg ovwo l
ggwg x dh w d d
if ggfa_ok
ggfa_bwd l
ret
end
dp = gga1 18
pp = ggl l 12
dq = gga1 15
dk = add dq ulong get ggs 6
du = add dk ulong get ggs 6
x = ggl l 4
gghd 0 dn false
gghd 1 x false
ggcp dp 1.0f64
ggbh tt tt e false 3
ggpl 0 pp true
gghd 1 dn true
ggch du 1.0f64
ggbh tt e tt false 2
ggsoft 16 pp dp
x = ggl l 3
ggpl 0 dp false
gghd 1 x true
ggch dq 1.0f64
ggbh tt e tt false 1
al = 1.0f64
if eq OMUTG 0
al = neg 1.0f64
end
x = ggl l 2
ggpl 0 dp true
gghd 1 x true
ggch dk al
ggbh tt e tt false 2
end

fn ggbqkv_h l ulong to void
d = get og 2
da = gga1 14
dq = gga1 15
d2 = uint mul d 2
s6 = get ggs 6
s7 = get ggs 7
dd2 = uint mul mul d d 2
note Fused 3-way GEMM (slot 85): dA = dQ Wq^T + dK Wk^T + dV Wv^T in ONE launch!
gkoph 0 dq d2 2 sub s6 d2 0
gkoph 1 ggwh ovwq l d2 2 sub dd2 d2 0
gkopc da d2 2 0 0 f32 1.0f64
ggmmh ggr d d 1 1 8
a = ggl l 1
w = ggg ovwq l
if ggdw_nv4_ok d d
ggqnv4_p 1.0f64
ggqnv4 a gga1 41 gga1 42 d ggr true
for p ulong 3
ggsk_nv4 add dq mul p ulong s6 add w mul p ulong s7 d d gggrad_sc 1.0f64
end
else
k = ggks d d 3
if eq k 1
gkoph 0 a 2 d2 0 0
gkoph 1 dq 2 d2 0 s6
gkopc w get ggs 0 4 0 s7 f32 1.0f64
ggmmh d d ggr 3 3 1
else
sl = uint div ggr k
gkoph 0 a 2 d2 0 mul sl d2
gkoph 1 dq 2 d2 s6 mul sl d2
ggskh d d 3 k w s7
end
end
ggrmsb_gain l false
end

note DA = DQ wq^T + DK wk^T + DU wv^T; G wq wk wv += a^T (DQ DK DU) batched; then the rms backward
fn ggbqkv l ulong to void
if ggbf_ok
ggbqkv_h l
ret
end
d = get og 2
da = gga1 14
dq = gga1 15
dk = add dq ulong get ggs 6
du = add dk ulong get ggs 6
w = ggw ovwq l
ggxwt dq w da d d false
w = ggw ovwk l
ggxwt dk w da d d true
w = ggw ovwv l
ggxwt du w da d d true
a = ggl l 1
w = ggg ovwq l
s0 = get ggs 0
s6 = get ggs 6
s7 = get ggs 7
k = ggks d d 3
if eq k 1
gkopa 0 a 4 s0 0 0
gkopa 1 dq 4 s0 0 s6
gkopc w s0 4 0 s7 f32 1.0f64
ggmm d d ggr 3 3 true
else
sl = uint div ggr k
gkopa 0 a 4 s0 0 mul sl s0
gkopa 1 dq 4 s0 s6 mul sl s0
ggsk d d 3 k w s7
end
x = ggl l 0
w = ggw ovg1 l
s = ggl l 8
ggrmsb x w s
ggain ovg1 l
end

fn ggbl l ulong to void
ggbffn l
ggbatt l
ggbqkv l
end

fn ggks_ex m ulong n ulong nz ulong to ulong
if gt ggks m n nz 1
ret 1
end
ret 0
end

fn ggbwd_head to void
d = get og 2
v = get og 0
r = ggr
owdh = ggow_ok
if not owdh
ggew 20 ggp5 gga1 1 gga1 1
ggew 20 mul r d gga1 13 gga1 13
end
if ggbf_ok
ggxwh_bf gga1 39 ggwh 0 gga1 14 d v false
if eq ggfzn 0
ggwgh_bf gga1 39 gga1 10 ggg 0 v d
end
owf = ulong 0
if owdh
owf = 1
end
ggrmsb_h_ex gga1 8 ggw get og 33 gga1 9 gga1 19 owf
ggain_h get og 33
ret
end
ggxw gga1 11 ggw 0 gga1 14 d v false
if eq ggfzn 0
ggwg gga1 11 gga1 10 ggg 0 v d
end
ggrmsb gga1 8 ggw get og 33 gga1 9
ggain get og 33
end

fn ggbwd_emb to void
if ne ggfzn 0
ret
end
d = get og 2
v = get og 0
tt = get og 1
td = mul tt d
td4 = div td 4
dh = gga1 13
if ggbf_ok
ggb2f mul ggr d gga1 13 gga1 16
dh = gga1 16
end
ggu 0 td4
ggu 1 get og 6
ggpt 1 dh
ggu 4 mul td 4
ggu 5 0
ggpt 3 ggg get og 30
ggu 8 0
cid = uint 14
if ggow_ok
cid = 13
end
ggrun cid 9 ggcd td4 256 1 1
ggu 0 d
ggpt 1 dh
ggpt 2 gga1 4
ggpt 3 gga1 5
ggpt 4 ggg 0
ggrun 22 10 ggcd d 64 v 1
end

fn ggbwd_hcnt to ulong
c = add 4 ggain_cnt
if ggow_ok
c = sub c 2
end
if eq ggfzn 0
c = add c add 1 ggks_ex get og 0 get og 2 1
end
note LM-head backward stays in BF16 for NVFP4 convergence parity
ret c
end

fn ggbwd_lcnt l ulong to ulong
d = get og 2
f = get og 4
c = ulong 20
if ggfa_ok
c = sub c 2
end
if ggbf_ok
c = sub c 2
end
c = add c ggks_ex d f 1
c = add c ggks_ex d d 1
c = add c ggks_ex d d 3
if or eq OMUTLG 1 eq olp l l
c = add c add 1 ggks_ex f d 1
end
if ggbf_ok
if ggdef_gain
c = sub c 4
else
c = sub c mul 2 sub 2 ggain_cnt
end
end
if ggnv4_ok
r = ggr
cw = and ne get ggw4_ok 0 0 and ggnv4_shape r f d ggnv4_shape r d f
if ggnv4_shape r f d
if cw
c = add c 1
else
c = add c 2
end
end
if and or eq OMUTLG 1 eq olp l l ggdw_nv4_ok f d
c = add c 2
if gt ggks_nv4 f d 1
c = add c 1
end
c = sub c ggks_ex f d 1
end
if ggdw_nv4_ok d f
c = add c 2
if gt ggks_nv4 d f 1
c = add c 1
end
c = sub c ggks_ex d f 1
end
if ggnv4_shape r d f
if not cw
c = add c 2
end
end
if and ge d 512 and ne get ggw4_ok 0 0 ggnv4_shape r d d
c = add c 1
end
if ggdw_nv4_ok d d
c = add c 2
if gt ggks_nv4 d d 1
c = add c 1
end
c = sub c ggks_ex d d 1
q4 = ulong 6
if gt ggks_nv4 d d 1
q4 = 9
end
c = sub add c add 1 q4 add 1 ggks_ex d d 3
end
end
ret c
end

fn ggbwd_ecnt to ulong
if eq ggfzn 0
if ggbf_ok
ret 3
end
ret 2
end
ret 0
end

fn ggbwd_bat to void
lv = get og 56
fzl = ggfzl
if le lv fzl
cnt = add ggbwd_hcnt ggbwd_ecnt
if not gbbegin cnt
ggdie 120
end
put gkbat 0 1
ggbwd_head
ggbwd_emb
put gkbat 0 0
if not gkbsub
ggdie 121
end
ret
end
hi = lv
first = true
while gt hi fzl bound 1024
lo = fzl
if gt sub hi fzl 8
lo = sub hi 8
end
nl = sub hi lo
defg = and ggdef_gain gt nl 0
cnt = ulong 0
if first
cnt = add cnt ggbwd_hcnt
end
l = hi
while gt l lo bound 16
l = sub l 1
cnt = add cnt ggbwd_lcnt l
end
if defg
cnt = add cnt 2
end
if eq lo fzl
cnt = add cnt ggbwd_ecnt
end
if not gbbegin cnt
ggdie 120
end
put gkbat 0 1
if first
ggbwd_head
end
if defg
put ggdgb 0 lo
put ggdgb 1 nl
end
l2 = hi
while gt l2 lo bound 16
l2 = sub l2 1
ggbl l2
end
if defg
ggain_def lo nl
put ggdgb 1 0
end
if eq lo fzl
ggbwd_emb
end
put gkbat 0 0
if not gkbsub
ggdie 121
end
first = false
hi = lo
end
end

fn ggbwd to void
if ggb_ok
ggbwd_bat
ret
end
ggbwd_head
lv = get og 56
fzl = ggfzl
defg = and ggdef_gain gt lv fzl
if defg
put ggdgb 0 fzl
put ggdgb 1 sub lv fzl
end
l = lv
while gt l fzl bound 9223372036854775807
l = sub l 1
ggbl l
end
if defg
ggain_def fzl sub lv fzl
put ggdgb 1 0
end
ggbwd_emb
end

note Mutant f: 1 in the product, 0 in the mutant, which uploads layer 0's W1 times 1 + 2^-10 (a
note forward error on the chip that gcmp2's FP check must name).
const OMUTF ulong 1

note W[i] as f32 for i in chunk q of P (a loop runs at most 999999 passes)
fn ggupc q ulong p ulong to void
h = get gbmem 5
wo = get gga 0
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = bitcast uint f32 ggupv i
m = mapset h add wo mul i 4 4 ulong x
end
end

note the uploaded value of W[i]: the parameter at virtual index i in the product
fn ggupv i ulong to f64
w = owg i
if eq OMUTF 0
a = opw1 0
if and ge i a lt i add a mul get og 2 get og 4
w = mul w 1.0009765625f64
end
end
ret w
end

note upload the f32 parameters
fn ggupw to void
p = get og 8
for q ulong ocn p
ggupc q p
end
put gkinv 0 1
end

note upload the batch tokens and the CSR of x (rows sorted by token)
fn ggupb to void
ggupt
ggcsr
put gkinv 0 1
end

note n values of the Adam pool from s as f32 to arena byte offset o + 4 j, and back (one chunk of an
note Adam moment)
fn ggupmc s ulong o ulong n ulong to void
h = get gbmem 5
for j ulong n
x = bitcast uint f32 omvg add s j
m = mapset h add o mul j 4 4 ulong x
end
end

fn ggdnmc s ulong o ulong n ulong to void
h = get gbmem 5
for j ulong n
x = uint mapget h add o mul j 4 4
omvp add s j f64 bitcast f32 x
end
end

note direct OLLMCK05 mmap -> GPU arena load and GPU arena -> OLLMCK05 atomic save
fn ggck5_rd off ulong nb ulong to void
if ne get ock5_has 0 0
ommap_read get ock5_mh 0 off nb
ret
end
if ne oprd get ock5_ai 0 off 0 nb nb
exit 70
end
end

fn ggck5_copy_to_gpu src_off ulong dst_off ulong nb ulong to void
h = get gbmem 5
done = ulong 0
while lt done nb bound 999999
chunk = sub nb done
if gt chunk OPWCAP
chunk = OPWCAP
end
ggck5_rd add src_off done chunk
w = mapwrite h add dst_off done opw 0 chunk
if ne w long chunk
ggdie 85
end
done = add done chunk
end
end

fn ggck5_bf16_expand cnt ulong to void
j = cnt
while gt j 0 bound 200000
j = sub j 1
w16 = ock5_opw2 mul j 2
opwput4 mul j 4 shl w16 16
end
end

fn ggck5_bf16_to_gpu src_off ulong dst_off ulong p ulong to void
h = get gbmem 5
i0 = ulong 0
while lt i0 p bound 999999
cnt = sub p i0
if gt cnt OCK5C
cnt = OCK5C
end
ggck5_rd add src_off mul i0 2 mul cnt 2
ggck5_bf16_expand cnt
nb4 = mul cnt 4
w = mapwrite h add dst_off mul i0 4 opw 0 nb4
if ne w long nb4
ggdie 85
end
i0 = add i0 cnt
end
end

fn ggload_ck5_bf fl ulong p ulong to void
h = get gbmem 5
ggew 20 ggp5 gga1 1 gga1 1
has_bf = ne and fl OCK5F_BF16 0
if and has_bf ne get ock5_st 7 0
ggck5_copy_to_gpu get ock5_st 6 get gga 38 mul p 2
z = mul p 2
ze = mul ggp5 2
if lt z ze
if eq rem z 4 2
w0 = uint mapget h add get gga 38 sub z 2 4
m0 = mapset h add get gga 38 sub z 2 4 ulong and w0 65535
z = add z 2
end
while lt z ze bound 512
m1 = mapset h add get gga 38 z 4 0
z = add z 4
end
end
else
ggf2b ggp5 gga1 0 gga1 38
end
if ggnv4_ok
exp_wnv = sub get gga 47 get gga 48
has_nv = ne and fl OCK5F_NV4 0
ok_nv = and has_nv eq get ock5_st 9 exp_wnv
if ok_nv
d = get og 2
if and ggnv4_shape d d d ggnv4_shape get og 4 d d
ggck5_copy_to_gpu get ock5_st 8 get gga 48 exp_wnv
put ggw4_ok 0 1
ret
end
end
ggquant_w
end
end

fn ggload_ck5 load_mv bool to void
p = get og 8
fl = get ock5_st 0
if ne and fl OCK5F_F32 0
ggck5_copy_to_gpu get ock5_st 2 get gga 0 mul p 4
else
ggck5_bf16_to_gpu get ock5_st 2 get gga 0 p
end
if load_mv
if ne and fl OCK5F_ZMV 0
ggew 20 p gga1 21 gga1 21
ggew 20 p gga1 22 gga1 22
else
mv_off = get ock5_st 4
ggck5_copy_to_gpu mv_off get gga 21 mul p 4
ggck5_copy_to_gpu add mv_off mul p 4 get gga 22 mul p 4
end
end
if ggbf_ok
ggload_ck5_bf fl p
end
put gkinv 0 1
ock5_drop_mh
end

fn ggsave_ck5_sec src_off ulong slen ulong pad ulong h ulong pos ulong to ulong
gb = get gbmem 5
done = ulong 0
curh = h
curp = pos
while lt done slen bound 999999
chunk = sub slen done
if gt chunk 1048576
chunk = 1048576
end
r = mapread gb add src_off done opw 0 chunk
if ne r long chunk
exit 70
end
p2 = ulong 0
if eq add done chunk slen
p2 = pad
ock5_pad0 chunk p2
end
tb = add chunk p2
curh = ocfnvw64 curh div tb 8
ocwput_opw curp tb
curp = add curp tb
done = add done chunk
end
ret curh
end

fn ggck5_plan to void
p = get og 8
fl = OCK5F_F32
if ggbf_ok
fl = or fl OCK5F_BF16
end
if ne get ggw4_ok 0 0
fl = or fl OCK5F_NV4
end
if gt get og 59 1
fl = or fl OCK5F_LOOP
end
orig = get ock5_st 1
if or eq orig 0 gt orig 3
orig = 2
if gt get og 59 1
orig = 3
end
end
w_off = OCK5HDR
w_len = mul p 4
mv_off = ock5_align64 add w_off w_len
mv_len = mul p 8
cur = ock5_align64 add mv_off mv_len
wbf_off = ulong 0
wbf_len = ulong 0
if ne and fl OCK5F_BF16 0
wbf_off = cur
wbf_len = mul p 2
cur = ock5_align64 add wbf_off wbf_len
end
wnv_off = ulong 0
wnv_len = ulong 0
if ne and fl OCK5F_NV4 0
wnv_off = cur
wnv_len = sub get gga 47 get gga 48
cur = ock5_align64 add wnv_off wnv_len
end
put ock5_st 0 fl
put ock5_st 1 orig
put ock5_st 2 w_off
put ock5_st 3 w_len
put ock5_st 4 mv_off
put ock5_st 5 mv_len
put ock5_st 6 wbf_off
put ock5_st 7 wbf_len
put ock5_st 8 wnv_off
put ock5_st 9 wnv_len
put ock5_st 10 cur
end

fn ggsave_ck5_st gga_i ulong off_i ulong len_i ulong nxt ulong h ulong to ulong
so = get ock5_st off_i
sl = get ock5_st len_i
pad = sub nxt add so sl
ret ggsave_ck5_sec get gga gga_i sl pad h so
end

fn ggsave_ck5 ai ulong to void
ggck5_plan
ocwopen ai
h = ulong 14695981039346656037
h = ggsave_ck5_st 0 2 3 get ock5_st 4 h
m_len = mul get og 8 4
mv_off = get ock5_st 4
h = ggsave_ck5_sec get gga 21 m_len 0 h mv_off
nxt = get ock5_st 10
if ne get ock5_st 6 0
nxt = get ock5_st 6
else
if ne get ock5_st 8 0
nxt = get ock5_st 8
end
end
pad_v = sub nxt add mv_off get ock5_st 5
h = ggsave_ck5_sec get gga 22 m_len pad_v h add mv_off m_len
if ne get ock5_st 6 0
nxt2 = get ock5_st 10
if ne get ock5_st 8 0
nxt2 = get ock5_st 8
end
h = ggsave_ck5_st 38 6 7 nxt2 h
end
if ne get ock5_st 8 0
h = ggsave_ck5_st 48 8 9 get ock5_st 10 h
end
put ock5_st 11 h
ock5_wr_hdr
ocwend ai
end

note optimizer state (parameters, Adam pool) to the chip as f32 (m in gga 21, v in gga 22), and back
fn ggupst to void
ggupw
p = get og 8
for q ulong ocn p
i0 = mul q OCH
n = sub oce q p i0
ggupmc add get og 11 i0 add get gga 21 mul i0 4 n
ggupmc add get og 12 i0 add get gga 22 mul i0 4 n
end
put gkinv 0 1
end

note only [fz, P) comes back (ggfz): the frozen f64 weights and moments stay as loaded
fn ggdnst to void
p = get og 8
fz = ggfzn
for q ulong ocn p
ggdnq q p fz
end
end

note chunk q of P from its first index at or above fz: parameters, then both moments
fn ggdnq q ulong p ulong fz ulong to void
a = mul q OCH
e = oce q p
if le e fz
ret
end
if lt a fz
a = fz
end
n = sub e a
ggdnwr a n
ggdnmc add get og 11 a add get gga 21 mul a 4 n
ggdnmc add get og 12 a add get gga 22 mul a 4 n
end

note chip parameters [a, a + n) back into the parameter banks as f64 (n at most OCH)
fn ggdnwr a ulong n ulong to void
h = get gbmem 5
o = get gga 0
for j ulong n
i = add a j
x = uint mapget h add o mul i 4 4
owp i f64 bitcast f32 x
end
end

global ggub uchar 262144
fn ggub_u32 i ulong v ulong to void
o = mul i 4
put ggub o uchar and v 255
put ggub add o 1 uchar and shr v 8 255
put ggub add o 2 uchar and shr v 16 255
put ggub add o 3 uchar and shr v 24 255
end

fn ggupt to void
h = get gbmem 5
xo = get gga 2
yo = get gga 3
r = ggr
if le r 65536
for i ulong r
ggub_u32 i get obx i
end
m = mapwrite h xo ggub 0 mul r 4
for i ulong r
ggub_u32 i get oby i
end
m = mapwrite h yo ggub 0 mul r 4
ret
end
for i ulong r
tk = get obx i
m = mapset h add xo mul i 4 4 tk
ty = get oby i
m = mapset h add yo mul i 4 4 ty
end
end

note counting sort of the R rows by input token: start (V + 1) and order (R) arrays
fn ggcsr to void
h = get gbmem 5
v = get og 0
r = ggr
for c ulong add v 1
put ggcn c 0
end
for i ulong r
c1 = add get obx i 1
n = add get ggcn c1 1
put ggcn c1 n
end
for c ulong v
c1 = add c 1
n = add get ggcn c1 get ggcn c
put ggcn c1 n
end
so = get gga 4
v1 = add v 1
if le v1 65536
for c ulong v1
ggub_u32 c get ggcn c
end
m = mapwrite h so ggub 0 mul v1 4
else
for c ulong v1
n = get ggcn c
m = mapset h add so mul c 4 4 n
end
end
so = get gga 5
if le r 65536
for i ulong r
c = get obx i
p = get ggcn c
ggub_u32 p i
put ggcn c add p 1
end
m = mapwrite h so ggub 0 mul r 4
else
for i ulong r
c = get obx i
p = get ggcn c
m = mapset h add so mul p 4 4 i
put ggcn c add p 1
end
end
end

note GRD[i] = G[i] for i in chunk q of P
fn ggdnc q ulong p ulong to void
h = get gbmem 5
go = get gga 1
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = uint mapget h add go mul i 4 4
ocsp i f64 bitcast f32 x
end
end

fn ggdown to void
p = get og 8
for q ulong ocn p
ggdnc q p
end
end

note one f32 at arena byte offset o, as f64
fn ggf o ulong to f64
x = uint mapget get gbmem 5 o 4
ret f64 bitcast f32 x
end

note row loss from the CE stats (m, sum, l_y) of row r: log(sum) + m - l_y
fn ggrl r ulong to f64
o = add get gga 12 mul r 12
m = ggf o
sm = ggf add o 4
ly = ggf add o 8
ret sub add flog sm m ly
end

fn ggloss to f64
tt = get og 1
for b ulong get og 6
s = 0.0f64
for t ulong tt
s = add s ggrl add mul b tt t
end
put olos b div s f64 tt
end
ret olsum
end

note the step loss and gradient for the batch in obx/oby; ggopen first. full: upload the f32
note parameters first and download the gradient into ogr[0..P) after; otherwise both stay on chip.
note phase wall times (ns): 0 upload, 1 forward, 2 backward, 3 download, 4 loss, 5 on-chip Adam
global ggtm long 6
note Skip CPU ggloss on non-save/non-log training steps (saves ~1.04 ms/step of f64 flog on R=16384!)
global ggnoloss uint 1
global ggsqn_req uint 1
global ggsqn_done uint 1
fn ggsqn_run to void
n4 = div ggp5 4
ggu 0 n4
ggpt 1 gga1 1
ggpt 2 gga1 23
ggrun 23 6 256 1 1
end
fn ggstep_bat_cnt to ulong
lv = get og 56
fzl = ggfzl
cnt = add add ggfwd_ecnt mul lv ggfwd_lcnt ggfwd_hcnt
cnt = add cnt ggbwd_hcnt
l = fzl
while lt l lv bound 32
cnt = add cnt ggbwd_lcnt l
l = add l 1
end
if and ggdef_gain gt lv fzl
cnt = add cnt 2
end
cnt = add cnt ggbwd_ecnt
ret add cnt 1
end
fn ggstep_bat_ok to bool
if or not ggb_ok not ggbf_ok
ret false
end
if or ne get ggnoce 0 0 gt get og 56 16
ret false
end
if gt sub get og 56 ggfzl 8
ret false
end
ret le ggstep_bat_cnt 512
end
fn ggpass_bat to void
lv = get og 56
fzl = ggfzl
if not gbbegin ggstep_bat_cnt
ggdie 120
end
put gkbat 0 1
ggfwd_emb
for l ulong lv bound 32
ggfl l
end
ggfwd_head
ggbwd_head
defg = and ggdef_gain gt lv fzl
if defg
put ggdgb 0 fzl
put ggdgb 1 sub lv fzl
end
l2 = lv
while gt l2 fzl bound 32
l2 = sub l2 1
ggbl l2
end
if defg
ggain_def fzl sub lv fzl
put ggdgb 1 0
end
ggbwd_emb
ggsqn_run
put gkbat 0 0
end
fn ggpass full bool to f64
t = monons
if full
ggupw
end
ggupb
u = monons
put ggtm 0 sub u t
if and not full and eq get ggsqn_req 0 1 ggstep_bat_ok
ggpass_bat
t_mid = monons
put ggtm 1 sub t_mid u
if not gkbsub
ggdie 121
end
u = monons
put ggtm 2 sub u t_mid
put ggsqn_done 0 1
else
ggfwd
t = monons
put ggtm 1 sub t u
ggbwd
u = monons
put ggtm 2 sub u t
end
if full
ggdown
end
t = monons
put ggtm 3 sub t u
l = 0.0f64
if eq get ggnoloss 0 0
l = ggloss
end
u = monons
put ggtm 4 sub u t
ret l
end

fn gggrad to f64
ret ggpass true
end

note clip and Adam on chip at step og[41], the f32 image of oadam: SQN partial sums of g^2, the
note norm, clip factor, schedule and bias corrections on the host in f64, then ADAM over P
fn ggadam to void
p = get og 8
if eq get ggsqn_done 0 0
ggsqn_run
else
put ggsqn_done 0 0
end
h = get gbmem 5
so = get gga 23
ss = 0.0f64
for c ulong 2048
x = uint mapget h add so mul c 4 4
ss = add ss f64 bitcast f32 x
end
nr = fsqrt ss
cl = 1.0f64
if gt nr 1.0
cl = div 1.0 nr
end
s = get og 41
lrs = olrs s bitcast f64 get og 43
bc1 = sub 1.0 opowb 0.9 s
bc2 = sub 1.0 opowb 0.99 s
if eq OMUTC 0
bc1 = 1.0f64
bc2 = 1.0f64
end
ggad24 p cl div lrs bc1 div 1.0f64 bc2
end

note ADAM over [fz, P) (ggfz; all of P without a freeze): the frozen weights and moments are not
note touched on the chip. Clip factor cl, lr / bc1 and 1 / bc2 from ggadam.
fn ggad24 p ulong cl f64 lb f64 ib f64 to void
fz = ggfzn
n = sub p fz
n4 = div n 4
o = mul fz 4
ggu 0 n4
ggpt 1 add gga1 0 o
ggpt 2 add gga1 21 o
ggpt 3 add gga1 22 o
ggpt 4 add gga1 1 o
ggu 10 ulong grf cl
ggu 11 ulong grf lb
ggu 12 ulong grf ib
if ggbf_ok
ggpt 7 add gga1 38 mul fz 2
ggrun 81 16 ggcd n4 256 1 1
ggquant_w
ret
end
ggrun 24 13 ggcd n4 256 1 1
end

fn ggtms to void
oputc 71
oputc 84
for i ulong 6
oputc 32
oputl get ggtm i
end
for i ulong 4
oputc 32
oputl get gkt i
end
oputc 10
end

note keep the CPU gradient: BLK[i] = GRD[i] (chunked: a loop runs at most 999999 passes)
fn ggkeep p ulong to void
for q ulong ocn p
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
ogrp add p i ocsg i
end
end
end

note ggcm[0] = max |GRD[i] - BLK[i]|, ggcm[1] = max |BLK[i]| over i < P
global ggcm f64 2
fn ggmaxd p ulong to void
put ggcm 0 0.0f64
put ggcm 1 0.0f64
for q ulong ocn p
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
rf = ogrg add p i
dd = sub ocsg i rf
if lt dd 0.0f64
dd = neg dd
end
if lt rf 0.0f64
rf = neg rf
end
if gt dd get ggcm 0
put ggcm 0 dd
end
if gt rf get ggcm 1
put ggcm 1 rf
end
end
end
end

note the chip's frozen count and layer (ggfz; 0 in mutant fz)
fn ggfzn to ulong
if eq OMUTFZ 0
ret 0
end
ret get ggfz 0
end

fn ggfzl to ulong
if eq OMUTFZ 0
ret 0
end
ret get ggfz 1
end

note FREEZE_LAYERS f for the loaded checkpoint, checked as cmdtrainf: f > L is exit 2, f > 0 on a
note looped checkpoint exit 17 (ockload's refusal); fz = og 31 + f og 32
fn ggfzset f ulong to void
if gt f get og 5
exit 2
end
if and gt f 0 gt get og 59 1
exit 17
end
put ggfz 0 0
put ggfz 1 f
if gt f 0
put ggfz 0 add get og 31 mul f get og 32
end
end

note `GFZ F fz`
fn ggfzpr to void
oputc 71
oputc 70
oputc 90
oputc 32
oputu get ggfz 1
oputc 32
oputu get ggfz 0
oputc 10
oflush
end

note gcmp and gacmp arguments CK DATA S [FREEZE_LAYERS]: load CK, open DATA, batch S; FREEZE_LAYERS
note sets ggfz for the chip and ofreeze / ofzlay (cmdtrainf's freeze) for the CPU reference
fn ggcarg to void
na = oargc
if and ne na 5 ne na 6
exit 2
end
ockloop 2
odopen 3
obatch oargu 4
if eq na 6
ggfzset oargu 5
ggfzpr
put ofreeze 0 get ggfz 0
put ofzlay 0 get ggfz 1
end
end

note GRD[i] = 0 for i < fz: oadam's mask on the CPU reference gradient (the tied head still writes
note the frozen wte's gradient on the CPU)
fn ggfzz to void
fz = get ggfz 0
i = ulong 0
while lt i fz bound 9223372036854775807
ocsp i 0.0f64
i = add i 1
end
end

note after gggrad: true without a freeze; else `GCF F fz nonzero` over the chip's GRD[0, fz), which must
note all be 0 (no frozen gradient launched)
fn ggfzok to bool
fz = get ggfz 0
if eq fz 0
ret true
end
n = ulong 0
i = ulong 0
while lt i fz bound 9223372036854775807
if ne ocsg i 0.0f64
n = add n 1
end
i = add i 1
end
oputc 71
oputc 67
oputc 70
ggfzln n
ret eq n 0
end

note ` F fz n` and a newline
fn ggfzln n ulong to void
oputc 32
oputu get ggfz 1
oputc 32
oputu get ggfz 0
oputc 32
oputu n
oputc 10
end

note after gacmp's step: true without a freeze; else `GAF F fz changed`, the frozen parameters whose CPU
note value is not BLK (the loaded f64) or whose chip value (GRD, ggdw) is not f32 of it
fn ggfzad p ulong to bool
fz = get ggfz 0
if eq fz 0
ret true
end
n = ulong 0
i = ulong 0
while lt i fz bound 9223372036854775807
n = add n ggfzd1 i p
i = add i 1
end
oputc 71
oputc 65
oputc 70
ggfzln n
ret eq n 0
end

fn ggfzd1 i ulong p ulong to ulong
w0 = ogrg add p i
if ne bitcast ulong owg i bitcast ulong w0
ret 1
end
if ne bitcast ulong ocsg i bitcast ulong f64 f32 w0
ret 1
end
ret 0
end

note gcmp CK DATA S [FREEZE_LAYERS]: CPU ograd and GPU gradient for batch S; prints
note `GC P maxabs_e12 maxref_e12 rel_e9 cpu_loss_micro gpu_loss_micro gpu_ns tol_e9` and GCMP PASS
note (rel < tol, |loss difference| < 1e-5) or GCMP FAIL (exit 45). tol = R 2^-24 is the first-order
note bound gamma_R on the f32 error of a sum of R = B T rows, the longest reduction of the weight
note gradients, relative to the sum of magnitudes; the CPU reference is f64. ReLU units whose f64
note pre-activation lies within f32 resolution of zero can take the other side on the GPU (receipt:
note evidence/OMEGALLM/gpu/README.md), and both sides are valid subgradients. With FREEZE_LAYERS F
note (ggcarg) both sides freeze as trainf: the CPU reference is ograd with ofzlay F and GRD[0, fz)
note zeroed (oadam's mask), the chip's G[0, fz) must be exactly 0 (`GCF F fz nonzero`, ggfzok).
fn ggcmp to void
ggcarg
put og 10 0
lc = ograd
p = get og 8
ggfzz
ggkeep p
ggopen
t0 = monons
lg = gggrad
t1 = monons
ggmaxd p
mx = get ggcm 0
mr = get ggcm 1
rel = div mx mr
dl = sub lg lc
if lt dl 0.0f64
dl = neg dl
end
oputc 71
oputc 67
oputc 32
oputu p
oputc 32
oputl rmic mul mx 1000000.0f64
oputc 32
oputl rmic mul mr 1000000.0f64
oputc 32
oputl rmic mul rel 1000.0f64
oputc 32
oputl rmic lc
oputc 32
oputl rmic lg
oputc 32
oputl sub t1 t0
oputc 32
tol = div f64 ggr 16777216.0f64
oputl rmic mul tol 1000.0f64
oputc 10
ggtms
ok = and and lt rel tol lt dl 0.00001f64 ggfzok
r = nvstop
oputc 71
oputc 67
oputc 77
oputc 80
oputc 32
if ok
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
exit 45
end

note true when x is finite (every comparison with NaN is false)
fn ggfin x f64 to bool
a = x
if lt a 0.0f64
a = neg a
end
ret le a bitcast f64 ulong 9218868437227405311
end

note x for printing: 1e6 when x is not finite or above 1e6 (rmic traps past the long range)
fn ggclp x f64 to f64
if ggfin x
if lt x 1000000.0f64
ret x
end
end
ret 1000000.0f64
end

note gcmp2 state. ggfs[j] = s_j for the row in flight (F <= 8192). ggk2: [0] ReLU
note flips (sign of FP_chip differs from FP_ref), [1] non-finite FP values (chip or reference),
note [2] layer of the largest rho, [3] non-finite gradient values (chip, K0 or K1).
note ggk3: [0] rho max, [1] max |FP_ref| at a flip, [2] max |FP_chip - FP_ref|.
global ggfs f64 8192
global ggk2 ulong 4
global ggk3 f64 3
fn ggk2z to void
for k ulong 4
put ggk2 k 0
end
for k ulong 3
put ggk3 k 0.0f64
end
end

note s_j = sum_k |bn_k| |W1[k F + j]| for row t of layer l (k < D ascending), the magnitude sum of
note the FP dot product the chip rounds (layer l is staged: ogmask runs inside olayb)
fn ggsj l ulong t ulong to void
d = get og 2
f = get og 4
bn = add oabn l mul t d
wv = ovw1 l
inb = owinb wv
w = ulong 0
if inb
w = sub wv get og 34
else
w = opx wv
end
for j ulong f
put ggfs j 0.0f64
end
for k ulong d
a = get oa add bn k
if lt a 0.0f64
a = neg a
end
if inb
ggsjk_b a add w mul k f f
else
ggsjk a add w mul k f f
end
end
end

fn ggsjk a f64 wo ulong f ulong to void
for j ulong f
x = get ow add wo j
if lt x 0.0f64
x = neg x
end
put ggfs j add get ggfs j mul a x
end
end

fn ggsjk_b a f64 wo ulong f ulong to void
for j ulong f
x = get oww add wo j
if lt x 0.0f64
x = neg x
end
put ggfs j add get ggfs j mul a x
end
end

note model.om's ReLU mask hook (ogkm[0] = 1, gcmp2 only): for row t of layer l of the sequence in
note flight, check every unit's reference FP against the chip's FP (left in the arena by gggrad),
note then zero dF where the chip's FP is not > 0, the chip's fused dF mask (gkope 2; NaN included).
fn ogmask yo ulong l ulong t ulong to void
f = get og 4
xo = add oafp l mul t f
ggsj l t
row = add mul get ogkm 1 get og 1 t
c0 = add sub ggl l 10 get gga 40 mul mul row f 4
for j ulong f
c = ggf add c0 mul j 4
ggk1 get oa add xo j c j l
if not gt c 0.0f64
put oa add yo j 0.0f64
end
end
end

note one unit: non-finite count, |FP_chip - FP_ref|, rho = that over s_j (inf when s_j = 0 and the
note values differ), and the flip count
fn ggk1 v f64 c f64 j ulong l ulong to void
if not and ggfin v ggfin c
put ggk2 1 add get ggk2 1 1
ret
end
dd = sub c v
if lt dd 0.0f64
dd = neg dd
end
if gt dd get ggk3 2
put ggk3 2 dd
end
ggkr dd get ggfs j l
ggkfl v c
end

fn ggkr dd f64 s f64 l ulong to void
if not gt dd 0.0f64
ret
end
rho = bitcast f64 ulong 9218868437227405312
if gt s 0.0f64
rho = div dd s
end
if gt rho get ggk3 0
put ggk3 0 rho
put ggk2 2 l
end
end

fn ggkfl v f64 c f64 to void
a = gt v 0.0f64
b = gt c 0.0f64
if eq a b
ret
end
put ggk2 0 add get ggk2 0 1
if lt v 0.0f64
v = neg v
end
if gt v get ggk3 1
put ggk3 1 v
end
end

note Adam pool [o + i] = GRD[i] for i < P (the chip gradient at o = 0, K0 at o = P; gcmp2 has no
note Adam step)
fn ggstash p ulong o ulong to void
for q ulong ocn p
ggstq q p o
end
end

fn ggstq q ulong p ulong o ulong to void
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
omvp add o i ocsg i
end
end

note ggc2: [0] max |G_chip - K0|, [1] max |K0|, [2] max |G_chip - K1| over i < P, with the chip
note gradient in the Adam pool [0, P), K0 in [P, 2P) and K1 in GRD; non-finite values count in ggk2[3]
global ggc2 f64 3
fn gg2cmp p ulong to void
for k ulong 3
put ggc2 k 0.0f64
end
for q ulong ocn p
i0 = mul q OCH
for j ulong sub oce q p i0
gg2c1 add i0 j p
end
end
end

fn gg2c1 i ulong p ulong to void
c = omvg i
r0 = omvg add p i
r1 = ocsg i
if not and and ggfin c ggfin r0 ggfin r1
put ggk2 3 add get ggk2 3 1
ret
end
gg2mx 0 sub c r0
gg2mx 1 r0
gg2mx 2 sub c r1
end

fn gg2mx k ulong x f64 to void
if lt x 0.0f64
x = neg x
end
if gt x get ggc2 k
put ggc2 k x
end
end

note gcmp2 CK DATA S: branch-conditioned parity (evidence/OMEGALLM/gpu-max/README.md). The chip
note gradient runs first and stays in the Adam pool; K0 is the CPU ograd with its own ReLU mask (gcmp's
note reference), K1 the CPU ograd with the chip's FP sign as the ReLU mask (ogmask), which also checks
note every FFN pre-activation. Prints `GC2 P rel0_e9 rel1_e9 tolr_e9 rho_e9 tolf_e9 rho_layer flips
note vflip_e12 fpdiff_e12 nonfinite cpu_loss_micro gpu_loss_micro gpu_ns fails` and GCMP2 PASS, or
note GCMP2 FAIL (exit 47). rel0 = max|G_chip - K0| / max|K0| (gcmp's rel), rel1 = max|G_chip - K1| /
note max|K0|; rho = max |FP_chip - FP_ref| / s_j. fails is a bit set: 1 a non-finite FP or gradient
note value, 2 rho >= tolf = max(D, F, T) 2^-24, 4 rel1 >= tolr = R 2^-24 (gcmp's gamma_R), 8 |chip
note loss - K0 loss| >= 1e-5.
fn ggcmp2 to void
if ne oargc 5
exit 2
end
ockloop 2
odopen 3
obatch oargu 4
p = get og 8
ggopen
t0 = monons
lg = gggrad
t1 = monons
ggstash p 0
put og 10 0
put ogkm 0 0
l0 = ograd
ggstash p p
for k ulong 4
put ggk2 k 0
end
for k ulong 3
put ggk3 k 0.0f64
end
put ogkm 0 1
put og 10 0
l1 = ograd
put ogkm 0 0
gg2cmp p
ggc2pr lg l0 sub t1 t0
end

note the GC2 line and verdict of gcmp2 (lg chip loss, l0 K0 loss, ns chip gradient time); gbcmp2
note (gkbf 1) takes gb.om's verdict
fn ggc2pr lg f64 l0 f64 ns long to void
fl = ggc2fl lg l0
ggc2ln lg l0 ns fl
ggtms
r = nvstop
if eq get gkbf 0 1
gbc2vd lg l0 fl
ret
end
ggc2vd eq fl 0
end

note ggc2[k] / max |K0|, clamped for printing
fn gg2rl k ulong to f64
ret ggclp div get ggc2 k get ggc2 1
end

note tolf = max(D, F, T) 2^-24
fn gg2tf to f64
n = fmax f64 get og 2 fmax f64 get og 4 f64 get og 1
ret div n 16777216.0f64
end

note tolr = R 2^-24 (gcmp's gamma_R)
fn gg2tr to f64
ret div f64 ggr 16777216.0f64
end

note the gcmp2 fail bits (see ggcmp2); gb.om's BF16 bits under gkbf 1
fn ggc2fl lg f64 l0 f64 to ulong
if eq get gkbf 0 1
ret gbc2fl lg l0 get ggk3 0 add get ggk2 1 get ggk2 3
end
dl = sub lg l0
if lt dl 0.0f64
dl = neg dl
end
fl = ulong 0
if ne add get ggk2 1 get ggk2 3 0
fl = or fl 1
end
if not lt ggclp get ggk3 0 gg2tf
fl = or fl 2
end
if not lt gg2rl 2 gg2tr
fl = or fl 4
end
if not lt dl 0.00001f64
fl = or fl 8
end
ret fl
end

fn ggc2ln lg f64 l0 f64 ns long fl ulong to void
oputc 71
oputc 67
oputc 50
oputc 32
oputu get og 8
gg2pe gg2rl 0
gg2pe gg2rl 2
gg2pe gg2tr
gg2pe ggclp get ggk3 0
gg2pe gg2tf
oputc 32
oputu get ggk2 2
oputc 32
oputu get ggk2 0
oputc 32
oputl rmic mul ggclp get ggk3 1 1000000.0f64
oputc 32
oputl rmic mul ggclp get ggk3 2 1000000.0f64
oputc 32
oputu add get ggk2 1 get ggk2 3
oputc 32
oputl rmic ggclp l0
oputc 32
oputl rmic ggclp lg
oputc 32
oputl ns
oputc 32
oputu fl
oputc 10
end

note " x_e9"
fn gg2pe x f64 to void
oputc 32
oputl rmic mul x 1000.0f64
end

fn ggc2vd ok bool to void
oputc 71
oputc 67
oputc 77
oputc 80
oputc 50
oputc 32
if ok
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
exit 47
end

note gtrain CK TRAIN UNTIL EVERY: cmdtrain with the gradient from the GPU (K = 1, no workers); prints
note `T s+1 loss_micro` at save points like train
fn ggtrain to void
if ne oargc 6
exit 2
end
ockloop 2
odopen 3
un = oargu 4
ev = oargu 5
if eq ev 0
exit 2
end
en = get og 42
if lt un en
en = un
end
ggopen
while lt get og 41 en bound 999999
s = get og 41
obatch s
put og 10 0
ls = gggrad
oadam
s1 = add s 1
put og 41 s1
if or eq rem s1 ev 0 eq s1 en
ocksave 2
oputc 84
oputc 32
oputu s1
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
r = nvstop
end

note BLK[i] = the f64 parameter i before the step
fn ggkw q ulong p ulong to void
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
ogrp add p i owg i
end
end

note GRD[i] = chip parameter i as f64
fn ggdw q ulong p ulong to void
h = get gbmem 5
wo = get gga 0
i0 = mul q OCH
for j ulong sub oce q p i0
i = add i0 j
x = uint mapget h add wo mul i 4 4
ocsp i f64 bitcast f32 x
end
end

note over i < P with w0 = BLK[i], c = parameter i (CPU f64 result), g = GRD[i] (chip f32 result):
note u = c - w0, d = (g - f32(w0)) - u; ggam 0 max |d|, 1 max |u|, 2 max (|d| - 2^-24 |c|), the part
note of d above the half-ulp rounding of the f32 master weight
global ggam f64 3
fn ggad1 i ulong p ulong to void
w0 = ogrg add p i
c = owg i
u = sub c w0
g = sub ocsg i f64 f32 w0
d = fabs sub g u
u = fabs u
e = sub d mul fabs c 0.000000059604644775390625f64
if gt d get ggam 0
put ggam 0 d
end
if gt u get ggam 1
put ggam 1 u
end
if gt e get ggam 2
put ggam 2 e
end
end

fn ggadc q ulong p ulong to void
i0 = mul q OCH
for j ulong sub oce q p i0
ggad1 add i0 j p
end
end

note gacmp CK DATA S [FREEZE_LAYERS]: one step from CK on batch S with the chip gradient, Adam on the
note CPU (oadam, f64) and on the chip (ggadam, f32); prints `GA P maxd_e12 maxu_e12 rel_e9 resid_e9
note tol_e9 adam_ns loss_micro` and GACMP PASS (resid = max(|d| - 2^-24 |c|) / max |u| < tol = 2^-16)
note or GACMP FAIL (exit 46). With FREEZE_LAYERS (ggcarg) oadam runs with ofreeze fz and the chip
note with ggfz; every frozen chip weight must still be its uploaded f32 and every frozen CPU weight
note its loaded f64 (`GAF F fz changed`, ggfzad).
fn ggacmp to void
ggcarg
put og 10 0
p = get og 8
ggopen
ggupst
lg = ggpass true
for q ulong ocn p
ggkw q p
end
oadam
t0 = monons
ggadam
t1 = monons
for q2 ulong ocn p
ggdw q2 p
end
for k ulong 3
put ggam k 0.0f64
end
for q3 ulong ocn p
ggadc q3 p
end
mu = get ggam 1
rel = div get ggam 0 mu
res = div get ggam 2 mu
tol = div 1.0f64 65536.0f64
oputc 71
oputc 65
oputc 32
oputu p
oputc 32
oputl rmic mul get ggam 0 1000000.0f64
oputc 32
oputl rmic mul mu 1000000.0f64
oputc 32
oputl rmic mul rel 1000.0f64
oputc 32
oputl rmic mul res 1000.0f64
oputc 32
oputl rmic mul tol 1000.0f64
oputc 32
oputl sub t1 t0
oputc 32
oputl rmic lg
oputc 10
r = nvstop
ok = and lt res tol ggfzad p
oputc 71
oputc 65
oputc 67
oputc 77
oputc 80
oputc 32
if ok
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
exit 46
end

note gtrainf CK TRAIN UNTIL EVERY [FREEZE_LAYERS]: gtrain with the parameters and Adam state resident
note on the chip in f32 (ggadam); only the batch goes up each step. At save points the state comes back
note to f64 for ocksave and `T s+1 loss_micro` is printed; GT at the end has the last step's phase
note times. FREEZE_LAYERS F > 0 is trainf's frozen core on the chip (ggfz): `GFZ F fz` first, then the
note embeddings and layers 0..F-1 are skipped in backward, untouched by ADAM and saved as loaded.
fn ggtrainf to void
na = oargc
if and ne na 6 ne na 7
exit 2
end
put og 61 1
ockloop 2
odopen 3
un = oargu 4
ev = oargu 5
if eq ev 0
exit 2
end
if eq na 7
ggfzset oargu 6
ggfzpr
end
en = get og 42
if lt un en
en = un
end
ggopen
put ggnofp 0 1
if eq get og 46 5
ggload_ck5 true
else
ggupst
if ggbf_ok
ggew 20 ggp5 gga1 1 gga1 1
ggf2b ggp5 gga1 0 gga1 38
ggquant_w
end
end
while lt get og 41 en bound 999999
s = get og 41
s1 = add s 1
need_l = or eq rem s1 ev 0 eq s1 en
if need_l
put ggnoloss 0 0
else
put ggnoloss 0 1
end
obatch s
put og 10 0
put ggsqn_req 0 1
put ggsqn_done 0 0
ls = ggpass false
put ggsqn_req 0 0
put ggnoloss 0 0
t = monons
ggadam
put ggtm 5 sub monons t
put og 41 s1
if need_l
if eq get og 46 5
ggsave_ck5 2
else
ggdnst
ocksave 2
end
oputc 84
oputc 32
oputu s1
oputc 32
oputl rmic ls
oputc 10
oflush
end
end
ggtms
oflush
r = nvstop
end

note gprof CK TRAIN N: N gtrainf steps from CK, nothing saved. The last step runs with the launch
note profile on (gk.om gkpf), then 64 ZERO launches of 64 floats measure the bare launch round trip.
note Prints `T steps loss_micro`, one `GP id gx gy gz m n k wait_ns` per profiled launch, then GT.
fn ggprof to void
if ne oargc 5
exit 2
end
put og 61 1
ockloop 2
odopen 3
nn = oargu 4
if eq nn 0
exit 2
end
ggopen
put ggnofp 0 1
if eq get og 46 5
ggload_ck5 true
else
ggupst
if ggbf_ok
ggew 20 ggp5 gga1 1 gga1 1
ggf2b ggp5 gga1 0 gga1 38
ggquant_w
end
end
ls = 0.0f64
for i ulong nn
s = get og 41
obatch s
put og 10 0
if eq add i 1 nn
put gkpf 0 1
end
ls = ggpass false
t = monons
ggadam
put ggtm 5 sub monons t
put og 41 add s 1
end
for i ulong 64
ggew 20 64 ggg 0 ggg 0
end
put gkpf 0 0
oputc 84
oputc 32
oputu get og 41
oputc 32
oputl rmic ls
oputc 10
for q ulong get gkpc 0
o = mul q 8
oputc 71
oputc 80
for j ulong 8
oputc 32
oputu get gkpl add o j
end
oputc 10
end
ggtms
oflush
r = nvstop
end

note geval CK HELD W [MERGES]: eval (cli.om cmdeval) with the forward pass on the chip in f32. Windows
note w < W at offsets w T, B per forward (og 6); the last set pads its spare rows with window 0 and
note does not count them. Each window adds its mean row loss in window order and, when V > 256, the
note decoded length of its T targets, as cmdeval does. Prints `E step W loss_micro bpb_micro` like
note eval, then `GE gpu_ns` (upload, forwards and loss reads). Exits 2 and 23 as eval.
global ggev f64 1
global ggen ulong 1
fn ggeval to void
ww = ggevw
t = monons
ggopen
if eq get og 46 5
ggload_ck5 false
else
ggupw
end
put ggev 0 0.0f64
put ggen 0 0
bb = get og 6
nc = div add ww sub bb 1 bb
for c ulong nc
ggevc c ww
end
ns = sub monons t
ggevpr ww
oputc 71
oputc 69
oputc 32
oputl ns
oputc 10
oflush
r = nvstop
end

note eval's argument checks; loads CK, MERGES and HELD and returns W
fn ggevw to ulong
na = oargc
if and ne na 5 ne na 6
exit 2
end
put og 61 1
ockloop 2
ww = oargu 4
v = get og 0
if gt v 256
if eq na 5
exit 2
end
obload 5 v
end
odopen 3
tt = get og 1
m = get odn 0
if eq ww 0
exit 23
end
if gt ww div sub m 1 tt
exit 23
end
ret ww
end

note window set c: rows b < B hold window c B + b (window 0 past W), one chip forward, then the sums
fn ggevc c ulong ww ulong to void
bb = get og 6
tt = get og 1
for b ulong bb
w = add mul c bb b
if ge w ww
w = 0
end
obrow b mul w tt
end
ggupb
ggfwd
for b ulong bb
w = add mul c bb b
if lt w ww
ggevr b
end
end
end

note add row b's mean loss (CE stats left by ggfwd) and, when V > 256, its decoded target bytes
fn ggevr b ulong to void
tt = get og 1
o = mul b tt
s = 0.0f64
for t ulong tt
s = add s ggrl add o t
end
put ggev 0 add get ggev 0 div s f64 tt
if gt get og 0 256
n = get ggen 0
for t ulong tt
n = add n obtlen get oby add o t
end
put ggen 0 n
end
end

note the E line of cmdeval from the sums
fn ggevpr ww ulong to void
lo = div get ggev 0 f64 ww
bp = div lo 0.6931471805599453
if gt get og 0 256
tt = get og 1
bp = div mul bp f64 mul ww tt f64 get ggen 0
end
oputc 69
oputc 32
oputu get og 41
oputc 32
oputu ww
oputc 32
oputl rmic lo
oputc 32
oputl rmic bp
oputc 10
end

note gdiag CK DATA S: the CE kernel's per-row stats (max m, sum of exp(l - m), logit l_y) on the chip
note in f32 against the CPU's f64 values for the same forward of batch S. Prints R, then the mean
note over rows times 1e9 of: d m, d l_y, d log sum, d loss, (sum of the chip's p) - 1, d (l_y - m).
note It located the CE sum bias that the Kahan sum in gr.om grce removes.
global gdacc f64 6
global gdcpu f64 3
fn ggdiag to void
if ne oargc 5
exit 2
end
ockloop 2
odopen 3
obatch oargu 4
put og 10 0
ggopen
ggupw
ggupb
ggfwd
for i ulong 6
put gdacc i 0.0f64
end
for b ulong get og 6
x = ofwd b
for t ulong get og 1
ggdrow b t
end
end
n = f64 ggr
oputu ggr
for i ulong 6
oputc 32
oputl rmic mul div get gdacc i n 1000.0f64
end
oputc 10
oflush
r = nvstop
end

fn ggdrow b ulong t ulong to void
r = add mul b get og 1 t
ggdcpu t get oby r
ggdacc r
put gdacc 4 add get gdacc 4 sub ggdps r 1.0f64
end

note CPU f64 stats of row t of the last ofwd: max logit, log sum exp(l - max), logit of y
fn ggdcpu t ulong y ulong to void
d = get og 2
v = get og 0
pr = add get og 18 mul t v
klogit add get og 17 mul t d pr v d
m = bitcast f64 ulong 18442240474082181120
for j ulong v
m = fmax m get oa add pr j
end
s = 0.0f64
for k ulong v
s = add s fexp sub get oa add pr k m
end
put gdcpu 0 m
put gdcpu 1 flog s
put gdcpu 2 get oa add pr y
end

fn ggdacc r ulong to void
o = add get gga 12 mul r 12
mg = sub ggf o get gdcpu 0
ls = sub flog ggf add o 4 get gdcpu 1
lg = sub ggf add o 8 get gdcpu 2
put gdacc 0 add get gdacc 0 mg
put gdacc 1 add get gdacc 1 lg
put gdacc 2 add get gdacc 2 ls
put gdacc 3 add get gdacc 3 sub add ls mg lg
put gdacc 5 add get gdacc 5 sub lg mg
end

note sum of the chip's probabilities of row r, recovered from the CE output L = (p - [j = y]) sc
fn ggdps r ulong to f64
v = get og 0
sc = div 1.0f64 f64 ggr
o = add get gga 11 mul mul r v 4
s = 0.0f64
for j ulong v
s = add s div ggf add o mul j 4 sc
end
ret add s 1.0f64
end

note gserve and gsample (aien-train DRA-292): serve and sample (serve.om, cli.om) with the per-token
note forward on the chip. cli.om's ochipup calls ogchip once the checkpoint loads: B = 1 (one
note context row, R = T), open the chip, upload the f32 parameters. olastf then calls oglast per
note token: upload the T context tokens of obx row 0 (positions past CT hold earlier tokens or 0,
note which the causal forward never reads for position CT - 1), ggdfwd (below: the rows up to the
note context's last 64-row tile, no CE, so the logits stay logits), and the logits of position
note CT - OMUTZ read back as f64 into TMP[0..V) (oa), where
note argmax and draws run as on the CPU.
note OMUTZ: 1 in the product; 0 in mutant z (the row past the context), which gscmp must catch.
const OMUTZ ulong 1
fn ogchip to void
put og 6 1
ggopen
if eq get og 46 5
ggload_ck5 false
else
ggupw
end
end

fn oglast to void
ggupt
put gkinv 0 1
ggdfwd
ogrd
end

note the logits of position CT - OMUTZ (row CT - OMUTZ of slot 11) read back as f64 into TMP[0..V) (oa)
fn ogrd to void
v = get og 0
r = sub get og 9 OMUTZ
o = add get gga 11 mul mul r v 4
tm = get og 27
for c ulong v
put oa add tm c ggf add o mul c 4
end
end

note ggdfwd (ham/ollm-speed-kvdec): per-token GPU forward, including mixed-BF16 variants. ggfwd runs all
note R = T rows every token; a causal forward never lets a row read a later row, so the logits of
note position CT - 1 need rows 0..CT - 1 only. ggdfwd runs rows 0..rr - 1, rr = 64 ceil(CT / 64)
note capped at T (whole 64-row tiles, so every GEMM keeps ggfwd's 64x64 kernels and per-element sums),
note keeps the residual stream in place in layer 0's input hin (hin += o wo, hin += relu(bn w1) w2: the
note same f32 adds as ggffn's COPY then accumulate, without its two COPY launches per layer), and runs
note the final RMS and the logits GEMM on the last 64-row tile only (the one holding row CT - 1).
note Rows at or past rr keep stale arena data that no computed row reads (causal GEMM tiles; softmax
note chunks past a row's own are masked, gr.om k6). No CE launch (ggnoce's logits stay logits).
note OMUTJ: 1 in the product; 0 in mutant j (rr = 64 floor(CT / 64), at least 64: row CT - 1 lies past
note the computed rows once CT > 64 is not a multiple of 64), which gscmp and gdbench mode 2 must catch.
const OMUTJ ulong 1
note ggdm[0]: the rows the ggd* GEMMs run over
global ggdm ulong 1
note bfdec selects BF16 for attention-output and FFN projections only. QKV,
note attention scores/value sums, normalization and final logits retain f32.
global bfdec uint 1

fn ggdrows to ulong
ct = get og 9
rr = mul div add ct 63 64 64
if eq OMUTJ 0
rr = mul div ct 64 64
if eq rr 0
rr = 64
end
end
tt = get og 1
if gt rr tt
rr = tt
end
ret rr
end

note C[m][n] (+)= X[m][k] W[k][n] over the first m = ggdm[0] rows
fn ggdxw x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w 4 n4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm get ggdm 0 n k 1 1 bt
end

note C[m][n] (+)= X[m][k] W[n][k]^T over the first m = ggdm[0] rows
fn ggdxwt x ulong w ulong c ulong n ulong k ulong bt bool to void
k4 = uint mul k 4
n4 = uint mul n 4
gkopa 0 x k4 4 0 0
gkopa 1 w k4 4 0 0
gkopc c n4 4 0 0 f32 1.0f64
ggmm get ggdm 0 n k 1 1 bt
end

note RMSF (kernel 10) over rows [r0, r0 + m) of the D-wide v and y and of s
fn ggdrms v ulong g ulong y ulong s ulong r0 ulong m ulong to void
o = mul r0 mul get og 2 4
r = mul m 32
ggu 0 r
ggpt 1 add v o
ggpt 2 g
ggpt 3 add y o
ggpt 4 add s mul r0 4
ggrun 10 10 ggcd r 64 1 1
end

note q, k, u = a wq, a wk, a wv over the first ggdm[0] rows (ggqkv's batched GEMM)
fn ggdqkv l ulong to void
d = get og 2
a = ggl l 1
w = ggw ovwq l
c = ggl l 2
s0 = get ggs 0
s6 = get ggs 6
s7 = get ggs 7
gkopa 0 a s0 4 0 0
gkopa 1 w 4 s0 0 s7
gkopc c s0 4 0 s6 f32 1.0f64
ggmm get ggdm 0 d d 3 3 false
end

note ggatt over the first rr = ggdm[0] rows: S (causal, rr x rr), SOFTF on rows < rr (grid rr / 2;
note arg 0 stays the thread bound T 32), o = P u (causal, k = rr)
fn ggdatt l ulong to void
rr = get ggdm 0
e = get og 7
pp = ggl l 12
q = ggl l 2
k = ggl l 3
gghd 0 q false
gghd 1 k false
isq = div 1.0f64 fsqrt f64 e
ggcp pp isq
ggbh rr rr e false 3
ggu 0 mul get og 1 32
ggpt 1 pp
ggpt 2 pp
ggrun 15 6 div rr 2 mul get og 6 get og 3 1
u = ggl l 4
o = ggl l 5
ggpl 0 pp false
gghd 1 u true
ggch o 1.0f64
ggbh rr e rr false 1
end

note hin += o wo; bn = rms(hin) g2; hin += relu(bn w1) w2, over the first ggdm[0] rows, hin = layer 0's
fn ggdffn l ulong to void
savedbf = get gkbf 0
d = get og 2
f = get og 4
h = ggl 0 0
x = ggl l 5
w = ggw ovwo l
if ne get bfdec 0 0
put gkbf 0 1
end
ggdxw x w h d d true
put gkbf 0 savedbf
x = ggl l 7
w = ggw ovg2 l
s = ggl l 9
ggdrms h w x s 0 get ggdm 0
fp = ggl l 10
w = ggw ovw1 l
y = ggl l 11
gkope 1 y
if ne get bfdec 0 0
put gkbf 0 1
end
ggdxw x w fp f d false
put gkbf 0 savedbf
w = ggw ovw2 l
if ne get bfdec 0 0
put gkbf 0 1
end
ggdxw y w h d f true
put gkbf 0 savedbf
end

fn ggdfl l ulong to void
h = ggl 0 0
w = ggw ovg1 l
a = ggl l 1
s = ggl l 8
ggdrms h w a s 0 get ggdm 0
ggdqkv l
ggdatt l
ggdffn l
end

fn ggdfwd to void
rr = ggdrows
put ggdm 0 rr
d = get og 2
x = ggl 0 0
ggu 0 d
ggpt 1 x
x = ggw 0
ggpt 2 x
x = ggw get og 30
ggpt 3 x
x = gga1 2
ggpt 4 x
ggrun 9 10 ggcd d 64 rr get og 6
for l ulong get og 56 bound 9223372036854775807
ggdfl l
end
ggdhead rr
end

note final RMS and logits GEMM over the last 64-row tile of the rr rows (all rr when rr < 64)
fn ggdhead rr ulong to void
d = get og 2
tb = ulong 64
if lt rr 64
tb = rr
end
b = sub rr tb
h = ggl 0 0
w = ggw get og 33
z = gga1 10
s = gga1 9
ggdrms h w z s b tb
put ggdm 0 tb
x = add z mul mul b d 4
w = ggw 0
v = get og 0
c = add gga1 11 mul mul b v 4
ggdxwt x w c v d false
put ggdm 0 rr
end

note the forward of gdbench mode md: 0 ggfwd without CE (the gserve forward at edf39b0), 3 ggdfwd with
note every 64x64 GEMM on the BF16 tensor-core kernels (gk.om gkbf 1, docs/omegallm/CONTRACT-BF16.md;
note GEMMs on the 32x32 tile stay f32), 5 ggdfwd as one batch.om submission (ggdbat), 7 selective BF16, else ggdfwd
note in f32
fn ggdfm md ulong to void
if eq md 0
put ggnoce 0 1
ggfwd
put ggnoce 0 0
ret
end
if eq md 3
put gkbf 0 1
ggdfwd
put gkbf 0 0
ret
end
if eq md 7
put bfdec 0 1
ggdfwd
put bfdec 0 0
ret
end
if eq md 5
ggdbat
ret
end
ggdfwd
end

note ggdbat: ggdfwd's launches recorded (gk.om gkbat) into one batch.om batch of exactly 3 + 9 L
note launches (EMB, nine per layer, final RMS, logits; batch.om refuses a different count before the
note doorbell), sent once and waited once (gkbsub). The kernels, their order and arguments are
note ggdfwd's; batch.om ends each body with a WFI release and a shader invalidate, so each grid
note drains before the next starts. gdbench opens the batch packet (gbbopen) once after the chip.
fn ggdbat to void
if not gbbegin add 3 mul 9 get og 56
ggdie 120
end
put gkbat 0 1
ggdfwd
put gkbat 0 0
if not gkbsub
ggdie 121
end
end

note FNV-1a over the f64 bits of the V logits in TMP (equal hashes: the same logits, bit for bit)
fn ggdhash to ulong
tm = get og 27
h = ulong 14695981039346656037
for c ulong get og 0
x = bitcast ulong get oa add tm c
h = mul xor h x 1099511628211
end
ret h
end

note one gdbench step in mode md on the current context: prints `GD step ct tok hash up_ns fwd_ns
note rd_ns launches build_ns wait_ns` (up: the token upload, fwd: the forward's launches, rd: logits
note read back and argmax; launches, build and wait from gk.om's gkt) and returns the token
fn ggdstep s ulong md ulong to ulong
k0 = get gkt 0
b0 = get gkt 1
w0 = get gkt 2
t0 = monons
ggupt
put gkinv 0 1
t1 = monons
ggdfm md
t2 = monons
ogrd
a = oargmax
t3 = monons
h = ggdhash
oputc 71
oputc 68
oputc 32
oputu s
oputc 32
oputu get og 9
oputc 32
oputu a
oputc 32
oputu h
oputc 32
oputl sub t1 t0
oputc 32
oputl sub t2 t1
oputc 32
oputl sub t3 t2
oputc 32
oputl sub get gkt 0 k0
oputc 32
oputl sub get gkt 1 b0
oputc 32
oputl sub get gkt 2 w0
oputc 10
oflush
ret a
end

note gdbench comparison step (2, 4, 6 or 8): ggfwd's logits into ggdcl, then ggdfwd's (f32 in mode 2, BF16 in mode 4,
note mode 6 batched, mode 8 selective BF16) into TMP on the same context; prints `GQ step ct tok0 tok1 ndiff maxdiff_e9 margin_e9`
note (ndiff: logits whose f64 bits differ, read back from f32, so f32 bits; margin: ggfwd's top-1
note logit minus its top-2) and returns tok0. Totals: ggdnd ndiff, ggdmx maxdiff, ggdkd the steps whose
note tokens differ although the margin exceeds 2 BFTOL. The logits slot is zeroed (ZERO 20) between
note the two forwards, so ggdfwd cannot pass on ggfwd's rows.
note BFTOL: the BF16 decode tolerance in nats, declared before its first chip run (ham/ollm-speed
note 2026-11-10): modes 4 and 8 pass when maxdiff <= BFTOL and no high-margin step diverges.
const BFTOL f64 0.25
global ggdcl f64 65536
global ggdmx f64 1
global ggdnd ulong 1
global ggdkd ulong 1
global ggdst f64 1

note ggdcl[a] minus the largest other ggdcl[c], c < V
fn ggdmg a ulong to f64
b = bitcast f64 ulong 18442240474082181120
for c ulong get og 0
if ne c a
b = fmax b get ggdcl c
end
end
ret sub get ggdcl a b
end

fn ggdpar s ulong md ulong to ulong
ggupt
put gkinv 0 1
ggdfm 0
ogrd
ggdkeep
a0 = oargmax
v = get og 0
ggew 20 mul ggr v gga1 11 gga1 11
if eq md 4
ggdfm 3
else
ggdfm sub md 1
end
ogrd
a1 = oargmax
nd = ggdcmp
dm = get ggdst 0
put ggdnd 0 add get ggdnd 0 nd
put ggdmx 0 fmax get ggdmx 0 dm
mg = ggdmg a0
if and ne a0 a1 gt mg mul 2.0f64 BFTOL
put ggdkd 0 add get ggdkd 0 1
end
oputc 71
oputc 81
oputc 32
oputu s
oputc 32
oputu get og 9
oputc 32
oputu a0
oputc 32
oputu a1
oputc 32
oputu nd
oputc 32
oputl long mul dm 1000000000.0f64
oputc 32
oputl long mul mg 1000000000.0f64
oputc 10
oflush
ret a0
end

note ggdcl = the V logits in TMP
fn ggdkeep to void
tm = get og 27
for c ulong get og 0
x = get oa add tm c
put ggdcl c x
end
end

note the logits in TMP whose bits differ from ggdcl; the largest |difference| into ggdst[0]
fn ggdcmp to ulong
tm = get og 27
nd = ulong 0
dm = 0.0f64
for c ulong get og 0
x = get oa add tm c
y = get ggdcl c
if ne bitcast ulong x bitcast ulong y
nd = add nd 1
end
dm = fmax dm fabs sub x y
end
put ggdst 0 dm
ret nd
end

fn ggdsel s ulong md ulong to ulong
if or or or eq md 2 eq md 4 eq md 6 eq md 8
ret ggdpar s md
end
ret ggdstep s md
end

note gdbench CK N PROMPT MERGES MODE (ham/ollm-speed): the per-token chip forward,
note Modes 7 and 8 select the BF16 decode policy and its comparison, respectively.
note They retain QKV, attention and logits in f32; three projection GEMMs per layer use BF16.
note timed, on the contexts of N greedy steps from token 0 then PROMPT's encoding (once the context
note holds T tokens it slides, as ocpush does). MODE 0: ggfwd (all R = T rows, the gserve forward at
note edf39b0); 1: ggdfwd (oglast's forward); 3: ggdfwd with BF16 GEMMs (ggdfm 3); 5: ggdfwd as one
note batched submission (ggdbat); 7: selective BF16. Modes 2, 4, 6 and 8 compare ggfwd and ggdfwd
note (2 f32, 4 BF16, 6 batched, 8 selective BF16) on every
note step, one GQ line each (ggdpar), then `GDQ N ndiff maxdiff_e9 diverged`; modes 2 and 6 exit 41
note when any logit differs in its bits; modes 4 and 8 exit 42 when maxdiff exceeds BFTOL or a high-margin step
note diverged. Modes 0, 1, 3, 5 and 7 print one GD line per step (ggdstep), then run one more forward
note at the last context with the launch profile on (`GP id gx gy gz m n k wait_ns` per launch, gk.om
note gkpf; batched launches log wait 0), 64 ZERO launches of 64 floats (the bare launch round trip,
note GP id 20) and `GDT mode N load_ns open_ns` (checkpoint and merges load; chip open and f32
note parameter upload).
fn ggdbench to void
if ne oargc 7
exit 2
end
t0 = monons
ockloop 2
nn = oargu 3
md = oargu 6
v = get og 0
if or le v 256 gt md 8
exit 2
end
obload 5 v
t1 = monons
ogchip
if or eq md 5 eq md 6
if not gbbopen
ggdie 122
end
end
t2 = monons
put og 9 0
ocpush 0
np = obprompt 4
for i ulong np
ocpush get obtk i
end
put ggdmx 0 0.0f64
put ggdnd 0 0
put ggdkd 0 0
for s ulong nn
a = ggdsel s md
ocpush a
end
if or or or eq md 2 eq md 4 eq md 6 eq md 8
ggdverd nn md
ret
end
ggdprof md
oputc 71
oputc 68
oputc 84
oputc 32
oputu md
oputc 32
oputu nn
oputc 32
oputl sub t1 t0
oputc 32
oputl sub t2 t1
oputc 10
oflush
r = nvstop
end

note the parity modes' last line `GDQ N ndiff maxdiff_e9 diverged`, then their exit codes
fn ggdverd nn ulong md ulong to void
oputc 71
oputc 68
oputc 81
oputc 32
oputu nn
oputc 32
oputu get ggdnd 0
oputc 32
oputl long mul get ggdmx 0 1000000000.0f64
oputc 32
oputu get ggdkd 0
oputc 10
oflush
r = nvstop
if and and ne md 4 ne md 8 gt get ggdnd 0 0
exit 41
end
if and or eq md 4 eq md 8 or gt get ggdmx 0 BFTOL gt get ggdkd 0 0
exit 42
end
end

note one forward in mode md at the current context with the launch profile on, then 64 ZERO launches
note of 64 floats; prints one GP line per profiled launch
fn ggdprof md ulong to void
put gkpc 0 0
put gkpf 0 1
ggupt
put gkinv 0 1
ggdfm md
for i ulong 64
ggew 20 64 ggg 0 ggg 0
end
put gkpf 0 0
for q ulong get gkpc 0
o = mul q 8
oputc 71
oputc 80
for j ulong 8
oputc 32
oputu get gkpl add o j
end
oputc 10
end
end

note gscmp CK N PROMPT MERGES (V > 256): the chip forward against the CPU forward on the contexts of
note N greedy steps from token 0 then PROMPT's encoding. Each step runs ofwd and olast (f64) into
note gscl, then oglast (chip, f32) into TMP, and prints `GS step cpu_tok chip_tok maxdiff_nano
note margin_nano`: maxdiff = max over the V logits of |chip - cpu|, margin = the CPU's top-1 logit
note minus its top-2. The CPU token is pushed. Last line `GSCMP N diverged maxdiff_nano`: a step
note diverges when the tokens differ although the margin exceeds 2 GSTOL. Exit 40 when a step
note diverged or maxdiff exceeds GSTOL.
const GSTOL f64 0.002
global gscl f64 65536
note gscmp totals: gsmd[0] the largest maxdiff, gskd[0] the diverged steps
global gsmd f64 1
global gskd ulong 1
fn ggscmp to void
if ne oargc 6
exit 2
end
ockloop 2
nn = oargu 3
v = get og 0
if le v 256
exit 2
end
obload 5 v
ogchip
put og 9 0
ocpush 0
np = obprompt 4
for i ulong np
ocpush get obtk i
end
put gsmd 0 0.0f64
put gskd 0 0
for s ulong nn
a = ggsst s
ocpush a
end
md = get gsmd 0
kd = get gskd 0
oputc 71
oputc 83
oputc 67
oputc 77
oputc 80
oputc 32
oputu nn
oputc 32
oputu kd
oputc 32
oputl long mul md 1000000000.0f64
oputc 10
oflush
r = nvstop
if or gt kd 0 gt md GSTOL
exit 40
end
end

note one gscmp step s on the current context: prints its GS line, updates the totals, returns the
note CPU token
fn ggsst s ulong to ulong
a1 = ggscpu
mg = ggsmg a1
oglast
a2 = oargmax
dm = ggsdf
put gsmd 0 fmax get gsmd 0 dm
if and ne a1 a2 gt mg mul 2.0f64 GSTOL
put gskd 0 add get gskd 0 1
end
oputc 71
oputc 83
oputc 32
oputu s
oputc 32
oputu a1
oputc 32
oputu a2
oputc 32
oputl long mul dm 1000000000.0f64
oputc 32
oputl long mul mg 1000000000.0f64
oputc 10
oflush
ret a1
end

note the CPU forward's last-position logits into gscl; returns its argmax
fn ggscpu to ulong
v = get og 0
tm = get og 27
lf = ofwd 0
olast
for c ulong v
put gscl c get oa add tm c
end
ret oargmax
end

note max over c < V of |TMP[c] - gscl[c]|
fn ggsdf to f64
tm = get og 27
dm = 0.0f64
for c ulong get og 0
x = fabs sub get oa add tm c get gscl c
dm = fmax dm x
end
ret dm
end

note the CPU's top-1 logit gscl[a] minus its largest other logit
fn ggsmg a ulong to f64
b = bitcast f64 ulong 18442240474082181120
for c ulong get og 0
if ne c a
b = fmax b get gscl c
end
end
ret sub get gscl a b
end

note gfcache BASE.ck TOKS W OUT.hc [BF16]: batched GB10 frozen-trunk hidden-state dumper writing
note the canonical OLLMFH01 format (compatible with trainfc, spforge, and spcryst) at full GPU speed.
note Streams B windows per batched GPU forward (ggnoce = 2 skips logits/CE) and supports NP > 1 looped
note checkpoints and D <= 2048 with chunked OCKC writes. Optional arg 6 selects BF16 (1) or f32 (0);
note default is 1 when T, D, F are multiples of 64, else 0. Prints `GFCACHE W T D L gpu_ns bf16`.
fn ggfch_wry pos ulong b ulong to ulong
tt = get og 1
bo = mul b tt
for t ulong tt
ocput8 mul t 8 get oby add bo t
end
nb = mul tt 8
ocwput pos nb
ret add pos nb
end

fn ggfch_wr1 base ulong cnt ulong to void
h = get gbmem 5
for j ulong cnt
x = uint mapget h add base mul j 4 4
ocput8 mul j 8 bitcast ulong f64 bitcast f32 x
end
end

fn ggfch_wr pos ulong b ulong to ulong
pos = ggfch_wry pos b
td = mul get og 1 get og 2
base = add get gga 8 mul mul b td 4
done = ulong 0
while lt done td bound 65536
cnt = sub td done
if gt cnt OCKC
cnt = OCKC
end
ggfch_wr1 add base mul done 4 cnt
nb = mul cnt 8
ocwput pos nb
pos = add pos nb
done = add done cnt
end
ret pos
end

fn ggfch_defbf to uint
if ne rem get og 1 64 0
ret 0
end
if ne rem get og 2 64 0
ret 0
end
if ne rem get og 4 64 0
ret 0
end
ret 1
end

fn ggfch_step c ulong ww ulong pos ulong to ulong
bb = get og 6
tt = get og 1
for b ulong bb
w = add mul c bb b
if ge w ww
w = 0
end
obrow b mul w tt
end
ggupt
put gkinv 0 1
put ggnoce 0 2
ggfwd
put ggnoce 0 0
for b2 ulong bb
w2 = add mul c bb b2
if lt w2 ww
pos = ggfch_wr pos b2
end
end
ret pos
end

fn ggfch_pr ww ulong ns long bf uint to void
oputc 71
oputc 70
oputc 67
oputc 65
oputc 67
oputc 72
oputc 69
oputc 32
oputu ww
oputc 32
oputu get og 1
oputc 32
oputu get og 2
oputc 32
oputu get og 5
oputc 32
oputl ns
oputc 32
oputu ulong bf
oputc 10
oflush
end

fn ggfcache to void
na = oargc
if and ne na 6 ne na 7
exit 2
end
ockloop 2
odopen 3
ww = oargu 4
if or eq ww 0 gt ww div sub get odn 0 1 get og 1
exit 23
end
bf = ggfch_defbf
if eq na 7
ba = oargu 6
if gt ba 1
exit 2
end
bf = uint ba
end
bh = osp_basehash get og 5 get og 33
ocwopen 5
ocput8 0 OFHMAG
ocput8 8 ww
ocput8 16 get og 1
ocput8 24 get og 2
ocput8 32 get og 5
ocput8 40 bh
ocwput 0 48
pos = ulong 48
t0 = monons
ggopen
ggupw
put gkbf 0 bf
bb = get og 6
nc = div add ww sub bb 1 bb
for c ulong nc
pos = ggfch_step c ww pos
end
put gkbf 0 0
ns = sub monons t0
ocwend 5
r = nvstop
ggfch_pr ww ns bf
end

note ogcmd: the gb10 target's GPU commands. cli.om's ocmd offers every command word here first
note (nogpu.om's ogcmd takes none on the CPU-only targets), so the gb10 unit is the aarch64 source
note with gpu/ in place of nogpu.om and no renamed main. It runs the GPU commands here and the BF16
note training commands in gb.om and returns true; any other word returns false and ocmd goes on to
note the CPU commands. The inference interface is documented in docs/omegallm/CONTRACT-BF16.md;
note command constants encode little-endian word bytes.
note nvfp4 M N K ITERS: live physical GB10 SM121 OMMA.SF.16864.F32.E2M1.E2M1.UE4M3.4X
note in-register instruction-rate microbenchmark (slot 84, 500 TF hardware peak).
note Loads per-thread operands/scales once before the K-loop, repeats 16 independent
note OMMA.SF.16864 ops in registers per ktile, and verifies 64 multi-CTA/warp-0..7
note output lanes + 4 NaN sentinels (checked=68). Not a global-memory GEMM. Prints:
note `NVFP4 M N K ITERS wall_ns tflops_x100 pct_peak_x100 expected got checked bad INREG_OMMA_MICROBENCH PASS/FAIL`.
fn ggnvfp4_lch m ulong n ulong k ulong to void
base = gkbase
ggpt 0 base
ggpt 1 add base 8192
ggpt 2 add base 16384
ggpt 3 add base 24576
ggpt 4 add base 65536
ggu 10 div k 64
ggu 11 n
ggrun 84 12 div n 128 div m 128 1
end

fn ggnvfp4_cpos r ulong c ulong n ulong to ulong
ret add 65536 mul add mul r n c 4
end

fn ggnvfp4_dr k ulong to ulong
if eq k 1
ret 7
end
if eq k 3
ret 99
end
if eq k 4
ret 96
end
if ge k 5
ret 103
end
ret 0
end

fn ggnvfp4_dc k ulong to ulong
if or eq k 1 eq k 3
ret 6
end
if or eq k 2 eq k 4
ret 64
end
if eq k 5
ret 66
end
if eq k 6
ret 68
end
if eq k 7
ret 70
end
ret 0
end

fn ggnvfp4_p1 h long r ulong c ulong n ulong to void
m = mapset h ggnvfp4_cpos r c n 4 2143289344
m = mapset h ggnvfp4_cpos r add c 1 n 4 2143289344
m = mapset h ggnvfp4_cpos add r 8 c n 4 2143289344
m = mapset h ggnvfp4_cpos add r 8 add c 1 n 4 2143289344
end

fn ggnvfp4_c1 h long r ulong c ulong n ulong exp f64 to ulong
bad = ulong 0
if ne f64 bitcast f32 uint mapget h ggnvfp4_cpos r c n 4 exp
bad = add bad 1
end
if ne f64 bitcast f32 uint mapget h ggnvfp4_cpos r add c 1 n 4 exp
bad = add bad 1
end
if ne f64 bitcast f32 uint mapget h ggnvfp4_cpos add r 8 c n 4 exp
bad = add bad 1
end
if ne f64 bitcast f32 uint mapget h ggnvfp4_cpos add r 8 add c 1 n 4 exp
bad = add bad 1
end
ret bad
end

fn ggnvfp4_poison m ulong n ulong to void
h = get gbmem 5
rb1 = sub m 128
cb1 = sub n 128
for k ulong 8
dr = ggnvfp4_dr k
dc = ggnvfp4_dc k
ggnvfp4_p1 h dr dc n
ggnvfp4_p1 h add rb1 dr add cb1 dc n
end
r = mapset h ggnvfp4_cpos 0 8 n 4 2143289344
r = mapset h ggnvfp4_cpos 0 9 n 4 2143289344
r = mapset h ggnvfp4_cpos 96 72 n 4 2143289344
r = mapset h ggnvfp4_cpos 96 73 n 4 2143289344
put gkinv 0 1
end

fn ggnvfp4_chk m ulong n ulong exp f64 to ulong
h = get gbmem 5
rb1 = sub m 128
cb1 = sub n 128
bad = ulong 0
for k ulong 8
dr = ggnvfp4_dr k
dc = ggnvfp4_dc k
bad = add bad ggnvfp4_c1 h dr dc n exp
bad = add bad ggnvfp4_c1 h add rb1 dr add cb1 dc n exp
end
if ne uint mapget h ggnvfp4_cpos 0 8 n 4 2143289344
bad = add bad 1
end
if ne uint mapget h ggnvfp4_cpos 0 9 n 4 2143289344
bad = add bad 1
end
if ne uint mapget h ggnvfp4_cpos 96 72 n 4 2143289344
bad = add bad 1
end
if ne uint mapget h ggnvfp4_cpos 96 73 n 4 2143289344
bad = add bad 1
end
ret bad
end

fn ggnvfp4_pr m ulong n ulong k ulong it ulong ns long to void
got = f64 bitcast f32 uint mapget get gbmem 5 65536 4
exp = f64 k
bad = ggnvfp4_chk m n exp
flops = mul mul 2.0f64 f64 mul m n mul f64 k f64 it
tf = div flops mul f64 ns 1000.0f64
pct = div mul tf 100.0f64 500.0f64
oputc 78
oputc 86
oputc 70
oputc 80
oputc 52
oputc 32
oputu m
oputc 32
oputu n
oputc 32
oputu k
oputc 32
oputu it
oputc 32
oputl ns
oputc 32
oputl long mul tf 100.0f64
oputc 32
oputl long mul pct 100.0f64
oputc 32
oputl long exp
oputc 32
oputl long got
oputc 32
oputu 68
oputc 32
oputu bad
oputc 32
oputc 73
oputc 78
oputc 82
oputc 69
oputc 71
oputc 95
oputc 79
oputc 77
oputc 77
oputc 65
oputc 95
oputc 77
oputc 73
oputc 67
oputc 82
oputc 79
oputc 66
oputc 69
oputc 78
oputc 67
oputc 72
oputc 32
if eq bad 0
oputc 80
oputc 65
oputc 83
oputc 83
oputc 10
oflush
r = nvstop
ret
end
oputc 70
oputc 65
oputc 73
oputc 76
oputc 10
oflush
r = nvstop
exit 51
end

fn ggnvfp4_fill to void
h = get gbmem 5
for i ulong 2048
r = mapset h mul i 4 4 572662306
r = mapset h add 8192 mul i 4 4 572662306
r = mapset h add 16384 mul i 4 4 943208504
r = mapset h add 24576 mul i 4 4 943208504
end
put gkinv 0 1
end

fn ggnvfp4 to void
if ne oargc 6
exit 2
end
m = oargu 2
n = oargu 3
k = oargu 4
it = oargu 5
if or eq m 0 eq n 0
exit 2
end
if or eq k 0 eq it 0
exit 2
end
if or gt m 65536 gt n 65536
exit 2
end
if gt mul m n 1073741824
exit 2
end
if or gt k 16777216 gt it 1000000
exit 2
end
if or ne rem m 128 0 ne rem n 128 0
exit 2
end
if ne rem k 64 0
exit 2
end
grset 256 32 64 2 128 2
if not gropen add mul mul m n 4 1048576
ggsetupfail
end
ggnvfp4_fill
ggnvfp4_lch m n k
ggnvfp4_poison m n
t0 = monons
for q ulong it bound 1000001
ggnvfp4_lch m n k
end
ns = sub monons t0
ggnvfp4_pr m n k it ns
end

