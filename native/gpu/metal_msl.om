note SPDX-License-Identifier: AGPL-3.0-only
note native/gpu/metal_msl.om: Embedded Metal Shading Language (MSL) compute kernels
note compiled at runtime via MTLDevice newLibraryWithSource:options:error:.
note Zero C/ObjC files, zero non-deterministic FP atomics.

global mtl_src uchar 65536
global mtl_srclen ulong 1

text mtl_k0 "#include <metal_stdlib>\nusing namespace metal;\n\nkernel void k_zero(device float *buf [[buffer(0)]], constant uint &n [[buffer(1)]], uint tid [[thread_position_in_grid]]) {\n  if (tid < n) buf[tid] = 0.0f;\n}\n\nkernel void k_embed_fwd(device const float *wte [[buffer(0)]], device const float *wpe [[buffer(1)]], device const uint *x [[buffer(2)]], device float *h0 [[buffer(3)]], constant uint *p [[buffer(4)]], uint2 gid [[thread_position_in_grid]]) {\n  uint B = p[0]; uint T = p[1]; uint D = p[2]; uint R = B * T;\n  if (gid.x < D && gid.y < R) {\n    uint t = gid.y % T;\n    uint tok = x[gid.y];\n    h0[gid.y * D + gid.x] = wte[tok * D + gid.x] + wpe[t * D + gid.x];\n  }\n}\n\nkernel void k_rmsnorm_fwd(device const float *x [[buffer(0)]], device const float *g [[buffer(1)]], device float *y [[buffer(2)]], device float *inv_s [[buffer(3)]], constant uint *p [[buffer(4)]], uint r [[threadgroup_position_in_grid]], uint tid [[thread_position_in_threadgroup]]) {\n  if (r >= p[0]) return;\n  uint D = p[1];\n  threadgroup float sh[256];\n  float ss = 0.0f;\n  for (uint i = tid; i < D; i += 256u) { float v = x[r * D + i]; ss += v * v; }\n  sh[tid] = ss;\n  for (uint s = 128u; s > 0u; s >>= 1u) {\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    if (tid < s) sh[tid] += sh[tid + s];\n  }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float is = 1.0f / sqrt(sh[0] / float(D) + 1e-5f);\n  if (tid == 0u) inv_s[r] = is;\n  for (uint i = tid; i < D; i += 256u) { y[r * D + i] = (x[r * D + i] * is) * g[i]; }\n}\n"

text mtl_k1 "\nkernel void k_gemm(device const float *A [[buffer(0)]], device const float *B [[buffer(1)]], device float *C [[buffer(2)]], constant uint *p [[buffer(3)]], uint2 gp [[threadgroup_position_in_grid]], uint2 lp [[thread_position_in_threadgroup]]) {\n  uint M = p[0]; uint N = p[1]; uint K = p[2]; uint mode = p[3];\n  float beta = as_type<float>(p[4]); uint mut = p[5];\n  uint tx = lp.x; uint ty = lp.y;\n  uint r0 = gp.y * 32u + ty; uint r1 = r0 + 16u;\n  uint c0 = gp.x * 32u + tx; uint c1 = c0 + 16u;\n  threadgroup float As[32][16];\n  threadgroup float Bs[16][32];\n  float a00 = 0.0f, a01 = 0.0f, a10 = 0.0f, a11 = 0.0f;\n  for (uint k0 = 0u; k0 < K; k0 += 16u) {\n    uint ak = k0 + tx; uint bk = k0 + ty;\n    if (mode == 2u) {\n      As[ty][tx] = (r0 < M && ak < K) ? A[ak * M + r0] : 0.0f;\n      As[ty + 16u][tx] = (r1 < M && ak < K) ? A[ak * M + r1] : 0.0f;\n    } else {\n      As[ty][tx] = (r0 < M && ak < K) ? A[r0 * K + ak] : 0.0f;\n      As[ty + 16u][tx] = (r1 < M && ak < K) ? A[r1 * K + ak] : 0.0f;\n    }\n    if (mode == 1u) {\n      Bs[ty][tx] = (bk < K && c0 < N) ? B[c0 * K + bk] : 0.0f;\n      Bs[ty][tx + 16u] = (bk < K && c1 < N) ? B[c1 * K + bk] : 0.0f;\n    } else {\n      Bs[ty][tx] = (bk < K && c0 < N) ? B[bk * N + c0] : 0.0f;\n      Bs[ty][tx + 16u] = (bk < K && c1 < N) ? B[bk * N + c1] : 0.0f;\n    }\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    for (uint kk = 0u; kk < 16u; kk++) {\n      float va0 = As[ty][kk]; float va1 = As[ty + 16u][kk];\n      float vb0 = Bs[kk][tx]; float vb1 = Bs[kk][tx + 16u];\n      a00 = fma(va0, vb0, a00); a01 = fma(va0, vb1, a01);\n      a10 = fma(va1, vb0, a10); a11 = fma(va1, vb1, a11);\n    }\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n  }\n  if (r0 < M && c0 < N) {\n    uint i = r0 * N + c0;\n    float v = (beta != 0.0f) ? fma(beta, C[i], a00) : a00;\n    if (mut == 2u && r0 == 0u && c0 == 0u) v += 1.0f;\n    C[i] = v;\n  }\n  if (r0 < M && c1 < N) { uint i = r0 * N + c1; C[i] = (beta != 0.0f) ? fma(beta, C[i], a01) : a01; }\n  if (r1 < M && c0 < N) { uint i = r1 * N + c0; C[i] = (beta != 0.0f) ? fma(beta, C[i], a10) : a10; }\n  if (r1 < M && c1 < N) { uint i = r1 * N + c1; C[i] = (beta != 0.0f) ? fma(beta, C[i], a11) : a11; }\n}\n"

text mtl_k2 "\nkernel void k_attn_fwd(device const float *Q [[buffer(0)]], device const float *K [[buffer(1)]], device const float *V [[buffer(2)]], device float *PA [[buffer(3)]], device float *O [[buffer(4)]], constant uint *p [[buffer(5)]], uint3 gp [[threadgroup_position_in_grid]], uint3 lp [[thread_position_in_threadgroup]]) {\n  uint tid = lp.x;\n  uint B = p[0]; uint T = p[1]; uint D = p[2]; uint H = p[3]; uint E = p[4];\n  uint t = gp.x; uint h = gp.y; uint b = gp.z;\n  if (t >= T || h >= H || b >= B) return;\n  uint r = b * T + t;\n  uint pa_base = ((b * H + h) * T + t) * T;\n  float inv_sq = rsqrt(float(E));\n  threadgroup float sh[64];\n  for (uint j = 0u; j <= t; j++) {\n    uint kr = b * T + j;\n    float ps = 0.0f;\n    for (uint e = tid; e < E; e += 64u) ps += Q[r * D + h * E + e] * K[kr * D + h * E + e];\n    sh[tid] = ps;\n    for (uint s = 32u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    if (tid == 0u) PA[pa_base + j] = sh[0] * inv_sq;\n  }\n  for (uint j = t + 1u + tid; j < T; j += 64u) PA[pa_base + j] = 0.0f;\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float lm = -INFINITY;\n  for (uint j = tid; j <= t; j += 64u) lm = max(lm, PA[pa_base + j]);\n  sh[tid] = lm;\n  for (uint s = 32u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] = max(sh[tid], sh[tid + s]); }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float mx = sh[0];\n  float ls = 0.0f;\n  for (uint j = tid; j <= t; j += 64u) { float ev = exp(PA[pa_base + j] - mx); PA[pa_base + j] = ev; ls += ev; }\n  sh[tid] = ls;\n  for (uint s = 32u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float sm = sh[0];\n  for (uint j = tid; j <= t; j += 64u) PA[pa_base + j] /= sm;\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  for (uint e = tid; e < E; e += 64u) {\n    float acc = 0.0f;\n    for (uint j = 0u; j <= t; j++) acc += PA[pa_base + j] * V[(b * T + j) * D + h * E + e];\n    O[r * D + h * E + e] = acc;\n  }\n}\n\nkernel void k_add_res(device const float *a [[buffer(0)]], device const float *b [[buffer(1)]], device float *ou [[buffer(2)]], constant uint &n [[buffer(3)]], uint tid [[thread_position_in_grid]]) {\n  if (tid < n) { float va = a[tid]; float vb = b[tid]; ou[tid] = va + vb; }\n}\n\nkernel void k_relu_fwd(device const float *fp [[buffer(0)]], device float *rl [[buffer(1)]], constant uint &n [[buffer(2)]], uint tid [[thread_position_in_grid]]) {\n  if (tid < n) { float v = fp[tid]; rl[tid] = (v > 0.0f) ? v : 0.0f; }\n}\n"

text mtl_k3 "\nkernel void k_ce_fwd_bwd(device float *logits [[buffer(0)]], device const uint *y [[buffer(1)]], device float *loss [[buffer(2)]], constant uint *p [[buffer(3)]], uint r [[threadgroup_position_in_grid]], uint tid [[thread_position_in_threadgroup]]) {\n  uint R = p[0]; uint V = p[1]; uint wg = p[2];\n  if (r >= R) return;\n  threadgroup float sh[256];\n  float lm = -INFINITY;\n  for (uint c = tid; c < V; c += 256u) lm = max(lm, logits[r * V + c]);\n  sh[tid] = lm;\n  for (uint s = 128u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] = max(sh[tid], sh[tid + s]); }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float mx = sh[0];\n  float ls = 0.0f;\n  for (uint c = tid; c < V; c += 256u) ls += exp(logits[r * V + c] - mx);\n  sh[tid] = ls;\n  for (uint s = 128u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float sm = sh[0];\n  uint yi = y[r];\n  if (tid == 0u) loss[r] = log(sm) - (logits[r * V + yi] - mx);\n  if (wg != 0u) {\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    float inv_sm = 1.0f / sm;\n    float inv_r = 1.0f / float(R);\n    for (uint c = tid; c < V; c += 256u) {\n      float pr = exp(logits[r * V + c] - mx) * inv_sm;\n      if (c == yi) pr -= 1.0f;\n      logits[r * V + c] = pr * inv_r;\n    }\n  }\n}\n\nkernel void k_rmsnorm_bwd(device const float *v [[buffer(0)]], device const float *g [[buffer(1)]], device const float *inv_s [[buffer(2)]], device const float *da [[buffer(3)]], device float *dh [[buffer(4)]], device float *dg_part [[buffer(5)]], constant uint *p [[buffer(6)]], uint r [[threadgroup_position_in_grid]], uint tid [[thread_position_in_threadgroup]]) {\n  if (r >= p[0]) return;\n  uint D = p[1];\n  float is = inv_s[r];\n  threadgroup float sh[256];\n  float cs = 0.0f;\n  for (uint i = tid; i < D; i += 256u) {\n    float nv = v[r * D + i] * is;\n    float dn = da[r * D + i] * g[i];\n    cs += dn * nv;\n  }\n  sh[tid] = cs;\n  for (uint s = 128u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float c = sh[0] / float(D);\n  for (uint i = tid; i < D; i += 256u) {\n    float nv = v[r * D + i] * is;\n    float dai = da[r * D + i];\n    float dn = dai * g[i];\n    dh[r * D + i] += (dn - nv * c) * is;\n    dg_part[r * D + i] = dai * nv;\n  }\n}\n\nkernel void k_col_sum(device const float *src [[buffer(0)]], device float *dst [[buffer(1)]], constant uint *p [[buffer(2)]], uint col [[thread_position_in_grid]]) {\n  uint R = p[0]; uint D = p[1];\n  if (col >= D) return;\n  float acc = 0.0f;\n  for (uint r = 0u; r < R; r++) acc += src[r * D + col];\n  dst[col] += acc;\n}\n\nkernel void k_relu_bwd(device float *df [[buffer(0)]], device const float *fp [[buffer(1)]], constant uint &n [[buffer(2)]], uint tid [[thread_position_in_grid]]) {\n  if (tid < n && fp[tid] <= 0.0f) df[tid] = 0.0f;\n}\n"

text mtl_k4 "\nkernel void k_attn_bwd_dq_ds(device const float *Q [[buffer(0)]], device const float *K [[buffer(1)]], device const float *V [[buffer(2)]], device const float *PA [[buffer(3)]], device const float *dO [[buffer(4)]], device float *dS [[buffer(5)]], device float *dQ [[buffer(6)]], constant uint *p [[buffer(7)]], uint3 gp [[threadgroup_position_in_grid]], uint3 lp [[thread_position_in_threadgroup]]) {\n  uint tid = lp.x;\n  uint B = p[0]; uint T = p[1]; uint D = p[2]; uint H = p[3]; uint E = p[4];\n  uint t = gp.x; uint h = gp.y; uint b = gp.z;\n  if (t >= T || h >= H || b >= B) return;\n  uint r = b * T + t;\n  uint pa_base = ((b * H + h) * T + t) * T;\n  float inv_sq = rsqrt(float(E));\n  threadgroup float sh[64];\n  for (uint j = 0u; j <= t; j++) {\n    uint kr = b * T + j;\n    float ps = 0.0f;\n    for (uint e = tid; e < E; e += 64u) ps += dO[r * D + h * E + e] * V[kr * D + h * E + e];\n    sh[tid] = ps;\n    for (uint s = 32u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n    threadgroup_barrier(mem_flags::mem_threadgroup);\n    if (tid == 0u) dS[pa_base + j] = sh[0];\n  }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float dp = 0.0f;\n  for (uint j = tid; j <= t; j += 64u) dp += PA[pa_base + j] * dS[pa_base + j];\n  sh[tid] = dp;\n  for (uint s = 32u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  float dot_p = sh[0];\n  for (uint j = tid; j <= t; j += 64u) dS[pa_base + j] = PA[pa_base + j] * (dS[pa_base + j] - dot_p) * inv_sq;\n  for (uint j = t + 1u + tid; j < T; j += 64u) dS[pa_base + j] = 0.0f;\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  for (uint e = tid; e < E; e += 64u) {\n    float acc = 0.0f;\n    for (uint j = 0u; j <= t; j++) acc += dS[pa_base + j] * K[(b * T + j) * D + h * E + e];\n    dQ[r * D + h * E + e] = acc;\n  }\n}\n\nkernel void k_attn_bwd_dk_dv(device const float *Q [[buffer(0)]], device const float *PA [[buffer(1)]], device const float *dO [[buffer(2)]], device const float *dS [[buffer(3)]], device float *dK [[buffer(4)]], device float *dV [[buffer(5)]], constant uint *p [[buffer(6)]], uint3 gp [[threadgroup_position_in_grid]], uint3 lp [[thread_position_in_threadgroup]]) {\n  uint tid = lp.x;\n  uint B = p[0]; uint T = p[1]; uint D = p[2]; uint H = p[3]; uint E = p[4]; uint mut = p[5];\n  uint j = gp.x; uint h = gp.y; uint b = gp.z;\n  if (j >= T || h >= H || b >= B) return;\n  uint jr = (b * T + j) * D + h * E;\n  for (uint e = tid; e < E; e += 64u) {\n    float dk = 0.0f; float dv = 0.0f;\n    for (uint t = j; t < T; t++) {\n      uint pi = ((b * H + h) * T + t) * T + j;\n      uint rr = (b * T + t) * D + h * E + e;\n      dk += dS[pi] * Q[rr];\n      dv += PA[pi] * dO[rr];\n    }\n    if (mut == 1u) dk = -dk;\n    dK[jr + e] = dk;\n    dV[jr + e] = dv;\n  }\n}\n"

text mtl_k5 "\nkernel void k_embed_bwd(device const float *dh [[buffer(0)]], device const uint *x [[buffer(1)]], device float *dwte [[buffer(2)]], device float *dwpe [[buffer(3)]], constant uint *p [[buffer(4)]], uint d [[thread_position_in_grid]]) {\n  uint B = p[0]; uint T = p[1]; uint D = p[2];\n  if (d >= D) return;\n  for (uint b = 0u; b < B; b++) {\n    for (uint t = 0u; t < T; t++) {\n      uint r = b * T + t;\n      float v = dh[r * D + d];\n      dwte[x[r] * D + d] += v;\n      dwpe[t * D + d] += v;\n    }\n  }\n}\n\nkernel void k_sqnorm_part(device float *g [[buffer(0)]], device float *part [[buffer(1)]], constant uint *p [[buffer(2)]], uint bid [[threadgroup_position_in_grid]], uint tid [[thread_position_in_threadgroup]]) {\n  uint P = p[0]; uint fz = p[1];\n  threadgroup float sh[256];\n  float ss = 0.0f;\n  for (uint i = bid * 256u + tid; i < P; i += 65536u) {\n    if (i < fz) { g[i] = 0.0f; } else { float v = g[i]; ss += v * v; }\n  }\n  sh[tid] = ss;\n  for (uint s = 128u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  if (tid == 0u) part[bid] = sh[0];\n}\n\nkernel void k_sqnorm_finish(device const float *part [[buffer(0)]], device float *clip_out [[buffer(1)]], constant uint &nb [[buffer(2)]], uint tid [[thread_position_in_threadgroup]]) {\n  threadgroup float sh[256];\n  sh[tid] = (tid < nb) ? part[tid] : 0.0f;\n  for (uint s = 128u; s > 0u; s >>= 1u) { threadgroup_barrier(mem_flags::mem_threadgroup); if (tid < s) sh[tid] += sh[tid + s]; }\n  threadgroup_barrier(mem_flags::mem_threadgroup);\n  if (tid == 0u) {\n    float nr = sqrt(sh[0]);\n    clip_out[0] = (nr > 1.0f) ? (1.0f / nr) : 1.0f;\n    clip_out[1] = nr;\n  }\n}\n\nkernel void k_adam_step(device float *w [[buffer(0)]], device const float *g [[buffer(1)]], device float *m [[buffer(2)]], device float *v [[buffer(3)]], device const float *clip_buf [[buffer(4)]], constant uint *p [[buffer(5)]], uint i [[thread_position_in_grid]]) {\n  uint P = p[0]; uint fz = p[1];\n  if (i >= P || i < fz) return;\n  float lr = as_type<float>(p[2]);\n  float bc1 = as_type<float>(p[3]);\n  float bc2 = as_type<float>(p[4]);\n  float gi = g[i] * clip_buf[0];\n  float mi = 0.9f * m[i] + 0.1f * gi;\n  m[i] = mi;\n  float vi = 0.99f * v[i] + 0.01f * gi * gi;\n  v[i] = vi;\n  w[i] -= (lr * (mi / bc1)) / (sqrt(vi / bc2) + 1e-8f);\n}\n"

fn mtl_app pos ulong s view uchar * to ulong
n = len s
if gt add add pos n 1 65536
exit 75
end
for i ulong n bound 8192
put mtl_src add pos i get s i
end
ret add pos n
end

fn mtl_build_msl to ulong
p = ulong 0
p = mtl_app p mtl_k0
p = mtl_app p mtl_k1
p = mtl_app p mtl_k2
p = mtl_app p mtl_k3
p = mtl_app p mtl_k4
p = mtl_app p mtl_k5
put mtl_src p 0
put mtl_srclen 0 p
ret p
end
