mtl_b3 6 hm_off 0 mtl_wbyte opg2 lp 6 bn_off
mtl_bind_buf 3 6 s2_off
mtl_k_rms_fwd_go rr d
mtl_b3 6 bn_off 0 mtl_wbyte opw1 lp 6 fp_off
