end

hf_off = mtl_abyte 0
sf_off = mtl_abyte 1
z_off = mtl_abyte 2
lg_off = mtl_abyte 3
ls_off = mtl_abyte 4
mtl_b3 6 hf_off 0 mtl_wbyte get og 33 6 z_off
mtl_bind_buf 3 6 sf_off
mtl_k_rms_fwd_go rr d
mtl_b3 6 z_off 0 0 6 lg_off
