mtl_bind_bytes 2 4
mtl_disp_tg mtl_cd n 256 1 1 256 1 1
end

fn mtl_k_rms_bwd_go dgbi ulong dgoff ulong ggbi ulong ggoff ulong r ulong d ulong to void
mtl_bind_pso 8
mtl_prm_u 0 r
mtl_prm_u 1 d
mtl_bind_bytes 6 8
mtl_disp_tg r 1 1 256 1 1

mtl_bind_pso 9
mtl_bind_buf 0 dgbi dgoff
mtl_bind_buf 1 ggbi ggoff
mtl_prm_u 0 r
mtl_prm_u 1 d
mtl_bind_bytes 2 8
mtl_disp_tg mtl_cd d 256 1 1 256 1 1
end

fn mtl_encode_fwd need_ce bool wg ulong to void
bb = get og 6
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
e = get og 7
vv = get og 0
lv = get og 56
rr = mul bb tt

mtl_bind_pso 1
mtl_bind_buf 0 0 0
mtl_bind_buf 1 0 mtl_wbyte get og 30
mtl_bind_buf 2 4 0
mtl_bind_buf 3 6 mtl_lbyte 0 0
mtl_prm_u 0 bb
mtl_prm_u 1 tt
mtl_prm_u 2 d
mtl_bind_bytes 4 12
mtl_disp_tg mtl_cd d 16 mtl_cd rr 16 1 16 16 1

for l ulong lv
lp = olp l
hin_off = mtl_lbyte l 0
a_off = mtl_lbyte l 1
q_off = mtl_lbyte l 2
k_off = mtl_lbyte l 3
