text mtl_n_sutf8 "stringWithUTF8String:"
text mtl_n_ldesc "localizedDescription"
text mtl_n_cb "commandBuffer"
text mtl_n_enc "computeCommandEncoder"
text mtl_n_spso "setComputePipelineState:"
text mtl_n_sbuf "setBuffer:offset:atIndex:"
text mtl_n_sbyt "setBytes:length:atIndex:"
text mtl_n_disp "dispatchThreadgroups:threadsPerThreadgroup:"
text mtl_n_end "endEncoding"
text mtl_n_com "commit"
text mtl_n_wait "waitUntilCompleted"
text mtl_n_stat "status"
text mtl_n_mtg "maxTotalThreadsPerThreadgroup"
text mtl_n_simd "threadExecutionWidth"
text mtl_n_rel "release"

text mtl_kn0 "k_zero"
text mtl_kn1 "k_embed_fwd"
text mtl_kn2 "k_rmsnorm_fwd"
text mtl_kn3 "k_gemm"
text mtl_kn4 "k_attn_fwd"
text mtl_kn5 "k_add_res"
text mtl_kn6 "k_relu_fwd"
text mtl_kn7 "k_ce_fwd_bwd"
text mtl_kn8 "k_rmsnorm_bwd"
text mtl_kn9 "k_col_sum"
text mtl_kn10 "k_relu_bwd"
text mtl_kn11 "k_attn_bwd_dq_ds"
text mtl_kn12 "k_attn_bwd_dk_dv"
text mtl_kn13 "k_embed_bwd"
text mtl_kn14 "k_sqnorm_part"
text mtl_kn15 "k_sqnorm_finish"
text mtl_kn16 "k_adam_step"

text mtl_e_nodev "omega-metal: MetalCreateSystemDefaultDevice failed (no Metal GPU)\n"
text mtl_e_lib "omega-metal: MSL compile error: "
text mtl_e_cmd "omega-metal: Metal command buffer failed\n"
text mtl_e_queue "omega-metal: Metal command queue creation failed\n"
text mtl_e_alloc "omega-metal: Metal buffer allocation failed\n"

global mtl_sym ulong 8
global mtl_obj ulong 8
global mtl_sel ulong 32
global mtl_pso ulong 24
global mtl_buf ulong 16
global mtl_ptr ulong 16
global mtl_bcap ulong 16
global mtl_ao ulong 32
global mtl_lo ulong 16
global mtl_szg uchar 32
global mtl_szt uchar 32
global mtl_prm uchar 64
global mtl_stg uchar 65536
global mtl_err uchar 16
global mtl_txt uchar 256
global mtl_open_flag ulong 1
global mtl_fz ulong 2
global mtl_mut ulong 1
global mtl_gflops f64 8
global mtl_ev f64 2
global mtl_evn ulong 1
global mtl_dinfo ulong 4

fn mtl_err_msg msg view uchar * to void
r = write 2 msg 0 len msg
end

fn mtl_err_cstr cstr ulong to void
if eq cstr 0
ret
end
n = mio_strlen cstr
if gt n 255
n = 255
end
mio_memcpy ulong libptr mtl_txt 0 256 cstr n
put mtl_txt n 10
r = write 2 mtl_txt 0 add n 1
end

fn mtl_err_u64 o ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get mtl_err add o i mul i 8
end
ret v
end

fn mtl_sel_reg idx ulong s view uchar * to void
nx = mio_nm_set s
mio_p64 0 ulong libptr mio_nm 0 512
r = libcall get mtl_sym 2 mio_rg 0 128
put mtl_sel idx mio_g64 0
end

fn mtl_msg0 obj ulong si ulong to ulong
mio_p64 0 obj
mio_p64 8 get mtl_sel si
r = libcall get mtl_sym 3 mio_rg 0 128
ret mio_g64 0
end

fn mtl_msg1 obj ulong si ulong a0 ulong to ulong
mio_p64 0 obj
mio_p64 8 get mtl_sel si
mio_p64 16 a0
r = libcall get mtl_sym 3 mio_rg 0 128
ret mio_g64 0
end

fn mtl_msg2 obj ulong si ulong a0 ulong a1 ulong to ulong
mio_p64 0 obj
mio_p64 8 get mtl_sel si
mio_p64 16 a0
mio_p64 24 a1
r = libcall get mtl_sym 3 mio_rg 0 128
ret mio_g64 0
end

fn mtl_msg3 obj ulong si ulong a0 ulong a1 ulong a2 ulong to ulong
mio_p64 0 obj
mio_p64 8 get mtl_sel si
mio_p64 16 a0
mio_p64 24 a1
mio_p64 32 a2
r = libcall get mtl_sym 3 mio_rg 0 128
ret mio_g64 0
end

fn mtl_nsstring_buf buf_ptr ulong to ulong
cls = get mtl_sym 6
ret mtl_msg1 cls 10 buf_ptr
end

fn mtl_nsstring_txt s view uchar * to ulong
nx = mio_nm_set s
ret mtl_nsstring_buf ulong libptr mio_nm 0 512
end

fn mtl_load_pso idx ulong kn view uchar * to void
fn_s = mtl_nsstring_txt kn
mfn = mtl_msg1 get mtl_obj 2 8 fn_s
if eq mfn 0
mtl_err_msg mtl_e_lib
exit 85
end
for i ulong 8
put mtl_err i 0
end
pso = mtl_msg2 get mtl_obj 0 9 mfn ulong libptr mtl_err 0 16
if eq pso 0
ep = mtl_err_u64 0
mtl_err_msg mtl_e_lib
if ne ep 0
ld = mtl_msg0 ep 11
if ne ld 0
mtl_err_cstr mtl_msg0 ld 1
end
end
exit 85
end
put mtl_pso idx pso
mtl_msg0_drop mfn
end

fn mtl_msg0_drop obj ulong to void
if ne obj 0
x = mtl_msg0 obj 24
end
end

fn mtl_pool_push to ulong
r = libcall get mtl_sym 4 mio_rg 0 128
ret mio_g64 0
end

fn mtl_pool_pop p ulong to void
if ne p 0
mio_p64 0 p
r = libcall get mtl_sym 5 mio_rg 0 128
end
end

fn mtl_init to void
if ne get mtl_open_flag 0 0
ret
end
hf = mio_dlopen mtl_f_fnd
hm = mio_dlopen mtl_f_mtl
ho = mio_dlopen mtl_f_obj
if or eq hf 0 or eq hm 0 eq ho 0
mtl_err_msg mtl_e_nodev
exit 75
end
put mtl_sym 0 mio_sym_load mtl_c_dev
put mtl_sym 1 mio_sym_load mtl_c_cls
put mtl_sym 2 mio_sym_load mtl_c_sel
put mtl_sym 3 mio_sym_load mtl_c_msg
put mtl_sym 4 mio_sym_load mtl_c_apush
put mtl_sym 5 mio_sym_load mtl_c_apop
if or eq get mtl_sym 0 0 or eq get mtl_sym 2 0 eq get mtl_sym 3 0
mtl_err_msg mtl_e_nodev
exit 75
end
nx = mio_nm_set mtl_c_nsstr
mio_p64 0 ulong libptr mio_nm 0 512
rc = libcall get mtl_sym 1 mio_rg 0 128
put mtl_sym 6 mio_g64 0

mtl_sel_reg 0 mtl_n_name
mtl_sel_reg 1 mtl_n_utf8
mtl_sel_reg 2 mtl_n_uni
mtl_sel_reg 3 mtl_n_ws
mtl_sel_reg 4 mtl_n_nq
mtl_sel_reg 5 mtl_n_nbuf
mtl_sel_reg 6 mtl_n_cnt
mtl_sel_reg 7 mtl_n_nlib
mtl_sel_reg 8 mtl_n_nfn
mtl_sel_reg 9 mtl_n_npso
mtl_sel_reg 10 mtl_n_sutf8
mtl_sel_reg 11 mtl_n_ldesc
mtl_sel_reg 12 mtl_n_cb
mtl_sel_reg 13 mtl_n_enc
mtl_sel_reg 14 mtl_n_spso
mtl_sel_reg 15 mtl_n_sbuf
mtl_sel_reg 16 mtl_n_sbyt
mtl_sel_reg 17 mtl_n_disp
mtl_sel_reg 18 mtl_n_end
mtl_sel_reg 19 mtl_n_com
mtl_sel_reg 20 mtl_n_wait
mtl_sel_reg 21 mtl_n_stat
mtl_sel_reg 22 mtl_n_mtg
mtl_sel_reg 23 mtl_n_simd
mtl_sel_reg 24 mtl_n_rel

pool = mtl_pool_push
r = libcall get mtl_sym 0 mio_rg 0 128
dev = mio_g64 0
if eq dev 0
mtl_pool_pop pool
mtl_err_msg mtl_e_nodev
exit 75
end
put mtl_obj 0 dev
q = mtl_msg0 dev 4
if eq q 0
mtl_pool_pop pool
mtl_err_msg mtl_e_queue
exit 84
end
put mtl_obj 1 q

sl = mtl_build_msl
nss = mtl_nsstring_buf ulong libptr mtl_src 0 65536
for i ulong 8
put mtl_err i 0
end
lib = mtl_msg3 dev 7 nss 0 ulong libptr mtl_err 0 16
if eq lib 0
ep = mtl_err_u64 0
mtl_err_msg mtl_e_lib
if ne ep 0
ld = mtl_msg0 ep 11
if ne ld 0
mtl_err_cstr mtl_msg0 ld 1
end
end
mtl_pool_pop pool
exit 85
end
put mtl_obj 2 lib

mtl_load_pso 0 mtl_kn0
mtl_load_pso 1 mtl_kn1
mtl_load_pso 2 mtl_kn2
mtl_load_pso 3 mtl_kn3
mtl_load_pso 4 mtl_kn4
mtl_load_pso 5 mtl_kn5
mtl_load_pso 6 mtl_kn6
mtl_load_pso 7 mtl_kn7
mtl_load_pso 8 mtl_kn8
mtl_load_pso 9 mtl_kn9
mtl_load_pso 10 mtl_kn10
mtl_load_pso 11 mtl_kn11
mtl_load_pso 12 mtl_kn12
mtl_load_pso 13 mtl_kn13
mtl_load_pso 14 mtl_kn14
mtl_load_pso 15 mtl_kn15
mtl_load_pso 16 mtl_kn16

put mtl_dinfo 0 and mtl_msg0 dev 2 255
put mtl_dinfo 1 mtl_msg0 dev 3
put mtl_dinfo 2 mtl_msg0 get mtl_pso 3 22
put mtl_dinfo 3 mtl_msg0 get mtl_pso 3 23
put mtl_mut 0 mio_mut_flag
mtl_pool_pop pool
put mtl_open_flag 0 1
end

fn mtl_alloc_buf idx ulong bytes ulong to void
cur = get mtl_buf idx
if ne cur 0
if ge get mtl_bcap idx bytes
ret
end
mtl_msg0_drop cur
put mtl_buf idx 0
put mtl_ptr idx 0
put mtl_bcap idx 0
end
nb = bytes
if lt nb 64
nb = 64
end
b = mtl_msg2 get mtl_obj 0 5 nb 0
if eq b 0
mtl_err_msg mtl_e_alloc
exit 86
end
p = mtl_msg0 b 6
if eq p 0
mtl_err_msg mtl_e_alloc
exit 86
end
put mtl_buf idx b
put mtl_ptr idx p
put mtl_bcap idx nb
end

fn mtl_stop to void
if eq get mtl_open_flag 0 0
ret
end
for i ulong 12
b = get mtl_buf i
if ne b 0
mtl_msg0_drop b
put mtl_buf i 0
put mtl_ptr i 0
put mtl_bcap i 0
end
end
for j ulong 17
p = get mtl_pso j
if ne p 0
mtl_msg0_drop p
put mtl_pso j 0
end
end
mtl_msg0_drop get mtl_obj 2
mtl_msg0_drop get mtl_obj 1
mtl_msg0_drop get mtl_obj 0
put mtl_obj 2 0
put mtl_obj 1 0
put mtl_obj 0 0
put mtl_open_flag 0 0
end

fn mtl_prm_u32 idx ulong v uint to void
o = mul idx 4
put mtl_prm o uchar and v 255
put mtl_prm add o 1 uchar and shr v 8 255
put mtl_prm add o 2 uchar and shr v 16 255
put mtl_prm add o 3 uchar and shr v 24 255
end

fn mtl_prm_u idx ulong v ulong to void
mtl_prm_u32 idx uint v
end

fn mtl_prm_f idx ulong v f64 to void
mtl_prm_u32 idx bitcast uint f32 v
end

fn mtl_stg_p32 o ulong v uint to void
put mtl_stg o uchar and v 255
put mtl_stg add o 1 uchar and shr v 8 255
put mtl_stg add o 2 uchar and shr v 16 255
put mtl_stg add o 3 uchar and shr v 24 255
end

fn mtl_stg_g32 o ulong to uint
v0 = uint get mtl_stg o
v1 = uint get mtl_stg add o 1
v2 = uint get mtl_stg add o 2
v3 = uint get mtl_stg add o 3
ret or or v0 shl v1 8 or shl v2 16 shl v3 24
end

fn mtl_szg_p64 o ulong v ulong to void
for i ulong 8
put mtl_szg add o i uchar and shr v mul i 8 255
end
end

fn mtl_szt_p64 o ulong v ulong to void
for i ulong 8
put mtl_szt add o i uchar and shr v mul i 8 255
end
end

fn mtl_enc_begin to void
pool = mtl_pool_push
put mtl_obj 3 pool
cb = mtl_msg0 get mtl_obj 1 12
enc = mtl_msg0 cb 13
put mtl_obj 4 cb
put mtl_obj 5 enc
end

fn mtl_enc_commit to void
enc = get mtl_obj 5
cb = get mtl_obj 4
x0 = mtl_msg0 enc 18
x1 = mtl_msg0 cb 19
x2 = mtl_msg0 cb 20
st = mtl_msg0 cb 21
mtl_pool_pop get mtl_obj 3
put mtl_obj 3 0
put mtl_obj 4 0
put mtl_obj 5 0
if ne st 4
mtl_err_msg mtl_e_cmd
exit 84
end
end

fn mtl_bind_pso pi ulong to void
x = mtl_msg1 get mtl_obj 5 14 get mtl_pso pi
end

fn mtl_bind_buf idx ulong bi ulong boff ulong to void
x = mtl_msg3 get mtl_obj 5 15 get mtl_buf bi boff idx
end

fn mtl_bind_bytes idx ulong nbytes ulong to void
x = mtl_msg3 get mtl_obj 5 16 ulong libptr mtl_prm 0 64 nbytes idx
end

fn mtl_disp_tg gx ulong gy ulong gz ulong tx ulong ty ulong tz ulong to void
mtl_szg_p64 0 gx
mtl_szg_p64 8 gy
mtl_szg_p64 16 gz
mtl_szt_p64 0 tx
mtl_szt_p64 8 ty
mtl_szt_p64 16 tz
x = mtl_msg2 get mtl_obj 5 17 ulong libptr mtl_szg 0 32 ulong libptr mtl_szt 0 32
end

fn mtl_cd n ulong d ulong to ulong
ret div add n sub d 1 d
end

fn mtl_wr_f32 ptr ulong idx ulong v f64 to void
mtl_stg_p32 0 bitcast uint f32 v
mio_memcpy add ptr mul idx 4 ulong libptr mtl_stg 0 65536 4
end

fn mtl_rd_f32 ptr ulong idx ulong to f64
mio_memcpy ulong libptr mtl_stg 0 65536 add ptr mul idx 4 4
ret f64 bitcast f32 mtl_stg_g32 0
end

fn mtl_wr_u32 ptr ulong idx ulong v uint to void
mtl_stg_p32 0 v
mio_memcpy add ptr mul idx 4 ulong libptr mtl_stg 0 65536 4
end

fn mtl_up_ow p ulong to void
ptr = get mtl_ptr 0
off = ulong 0
while lt off p bound 20000000
cnt = sub p off
if gt cnt 16384
cnt = 16384
end
for j ulong cnt bound 16385
mtl_stg_p32 mul j 4 bitcast uint f32 owg add off j
end
mio_memcpy add ptr mul off 4 ulong libptr mtl_stg 0 65536 mul cnt 4
off = add off cnt
end
end

fn mtl_dn_ow p ulong to void
ptr = get mtl_ptr 0
off = get mtl_fz 0
while lt off p bound 20000000
cnt = sub p off
if gt cnt 16384
cnt = 16384
end
mio_memcpy ulong libptr mtl_stg 0 65536 add ptr mul off 4 mul cnt 4
for j ulong cnt bound 16385
owp add off j f64 bitcast f32 mtl_stg_g32 mul j 4
end
off = add off cnt
end
end

fn mtl_dn_g_to_ocs p ulong to void
ptr = get mtl_ptr 1
off = ulong 0
while lt off p bound 20000000
cnt = sub p off
if gt cnt 16384
cnt = 16384
end
mio_memcpy ulong libptr mtl_stg 0 65536 add ptr mul off 4 mul cnt 4
for j ulong cnt bound 16385
ocsp add off j f64 bitcast f32 mtl_stg_g32 mul j 4
end
off = add off cnt
end
end

fn mtl_up_mv p ulong to void
pm = get mtl_ptr 2
pv = get mtl_ptr 3
mbase = get og 11
vbase = get og 12
off = ulong 0
while lt off p bound 20000000
cnt = sub p off
if gt cnt 16384
cnt = 16384
end
for j ulong cnt bound 16385
mtl_stg_p32 mul j 4 bitcast uint f32 omvg add mbase add off j
end
mio_memcpy add pm mul off 4 ulong libptr mtl_stg 0 65536 mul cnt 4
for j2 ulong cnt bound 16385
mtl_stg_p32 mul j2 4 bitcast uint f32 omvg add vbase add off j2
end
mio_memcpy add pv mul off 4 ulong libptr mtl_stg 0 65536 mul cnt 4
off = add off cnt
end
end

fn mtl_dn_mv p ulong to void
pm = get mtl_ptr 2
pv = get mtl_ptr 3
mbase = get og 11
vbase = get og 12
off = get mtl_fz 0
while lt off p bound 20000000
cnt = sub p off
if gt cnt 16384
cnt = 16384
end
mio_memcpy ulong libptr mtl_stg 0 65536 add pm mul off 4 mul cnt 4
for j ulong cnt bound 16385
omvp add mbase add off j f64 bitcast f32 mtl_stg_g32 mul j 4
end
mio_memcpy ulong libptr mtl_stg 0 65536 add pv mul off 4 mul cnt 4
for j2 ulong cnt bound 16385
omvp add vbase add off j2 f64 bitcast f32 mtl_stg_g32 mul j2 4
end
off = add off cnt
end
end

fn mtl_up_batch to void
r = mul get og 6 get og 1
px = get mtl_ptr 4
py = get mtl_ptr 5
off = ulong 0
while lt off r bound 65537
cnt = sub r off
if gt cnt 16384
cnt = 16384
end
for j ulong cnt bound 16385
mtl_stg_p32 mul j 4 uint get obx add off j
end
mio_memcpy add px mul off 4 ulong libptr mtl_stg 0 65536 mul cnt 4
for j2 ulong cnt bound 16385
mtl_stg_p32 mul j2 4 uint get oby add off j2
end
mio_memcpy add py mul off 4 ulong libptr mtl_stg 0 65536 mul cnt 4
off = add off cnt
end
end

fn mtl_al64 x ulong to ulong
ret mul mtl_cd x 64 64
end

fn mtl_plan to ulong
tt = get og 1
d = get og 2
h = get og 3
f = get og 4
bb = get og 6
vv = get og 0
lv = get og 56
r = mul bb tt
rd = mtl_al64 mul r d
rf = mtl_al64 mul r f
rs = mtl_al64 r
pp = mtl_al64 mul mul bb h mul tt tt
rv = mtl_al64 mul r vv

c = ulong 0
put mtl_lo 0 c
c = add c rd
put mtl_lo 1 c
c = add c rd
put mtl_lo 2 c
c = add c rd
put mtl_lo 3 c
c = add c rd
put mtl_lo 4 c
c = add c rd
put mtl_lo 5 c
c = add c rd
put mtl_lo 6 c
c = add c rd
put mtl_lo 7 c
c = add c rd
put mtl_lo 8 c
c = add c rs
put mtl_lo 9 c
c = add c rs
put mtl_lo 10 c
c = add c rf
put mtl_lo 11 c
c = add c rf
put mtl_lo 12 c
c = add c pp
put mtl_lo 13 c

cur = mul lv c
put mtl_ao 0 cur
cur = add cur rd
put mtl_ao 1 cur
cur = add cur rs
put mtl_ao 2 cur
cur = add cur rd
put mtl_ao 3 cur
cur = add cur rv
put mtl_ao 4 cur
cur = add cur rs
put mtl_ao 5 cur
cur = add cur rd
put mtl_ao 6 cur
cur = add cur rd
put mtl_ao 7 cur
cur = add cur rd
put mtl_ao 8 cur
cur = add cur rd
put mtl_ao 9 cur
cur = add cur rd
put mtl_ao 10 cur
cur = add cur rd
put mtl_ao 11 cur
cur = add cur rf
put mtl_ao 12 cur
cur = add cur pp
put mtl_ao 13 cur
cur = add cur rd
put mtl_ao 14 cur
cur = add cur 256
put mtl_ao 15 cur
cur = add cur 64
ret cur
end

fn mtl_open to void
mtl_init
p = get og 8
mtl_alloc_buf 0 mul p 4
mtl_alloc_buf 1 mul p 4
mtl_alloc_buf 2 mul p 4
mtl_alloc_buf 3 mul p 4
r = mul get og 6 get og 1
mtl_alloc_buf 4 mul r 4
mtl_alloc_buf 5 mul r 4
act_e = mtl_plan
mtl_alloc_buf 6 mul act_e 4
end

fn mtl_lbyte l ulong slot ulong to ulong
base = add mul l get mtl_lo 13 get mtl_lo slot
ret mul base 4
end

fn mtl_abyte slot ulong to ulong
ret mul get mtl_ao slot 4
end

fn mtl_wbyte wo ulong to ulong
ret mul wo 4
end

fn mtl_k_zero bi ulong boff ulong n ulong to void
if eq n 0
ret
end
mtl_bind_pso 0
mtl_bind_buf 0 bi boff
mtl_prm_u 0 n
mtl_bind_bytes 1 4
mtl_disp_tg mtl_cd n 256 1 1 256 1 1
end

fn mtl_b3 b0 ulong o0 ulong b1 ulong o1 ulong b2 ulong o2 ulong to void
mtl_bind_buf 0 b0 o0
mtl_bind_buf 1 b1 o1
mtl_bind_buf 2 b2 o2
end

fn mtl_b3_hi b3 ulong o3 ulong b4 ulong o4 ulong b5 ulong o5 ulong to void
mtl_bind_buf 3 b3 o3
mtl_bind_buf 4 b4 o4
mtl_bind_buf 5 b5 o5
end

fn mtl_k_gemm_go m ulong n ulong k ulong mode ulong beta f64 to void
mtl_bind_pso 3
mtl_prm_u 0 m
mtl_prm_u 1 n
mtl_prm_u 2 k
mtl_prm_u 3 mode
mtl_prm_f 4 beta
mtl_prm_u 5 get mtl_mut 0
mtl_bind_bytes 3 24
mtl_disp_tg mtl_cd n 32 mtl_cd m 32 1 16 16 1
end

fn mtl_k_rms_fwd_go r ulong d ulong to void
mtl_bind_pso 2
mtl_prm_u 0 r
mtl_prm_u 1 d
mtl_bind_bytes 4 8
mtl_disp_tg r 1 1 256 1 1
end

fn mtl_k_add_res_go n ulong to void
mtl_bind_pso 5
mtl_prm_u 0 n
mtl_bind_bytes 3 4
mtl_disp_tg mtl_cd n 256 1 1 256 1 1
end

fn mtl_k_relu_fwd fbi ulong foff ulong rbi ulong roff ulong n ulong to void
mtl_bind_pso 6
mtl_bind_buf 0 fbi foff
mtl_bind_buf 1 rbi roff
mtl_prm_u 0 n
mtl_bind_bytes 2 4
mtl_disp_tg mtl_cd n 256 1 1 256 1 1
end

fn mtl_k_relu_bwd dbi ulong doff ulong fbi ulong foff ulong n ulong to void
