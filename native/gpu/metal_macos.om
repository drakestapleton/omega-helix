if lt add l 1 lv
nxt_off = mtl_lbyte add l 1 0
end
mtl_b3 6 rl_off 0 mtl_wbyte opw2 lp 6 nxt_off
mtl_k_gemm_go rr d f 0 0.0f64
mtl_b3 6 hm_off 6 nxt_off 6 nxt_off
