mtl_bind_pso 4
mtl_bind_buf 0 6 q_off
mtl_bind_buf 1 6 k_off
mtl_bind_buf 2 6 u_off
mtl_bind_buf 3 6 pa_off
mtl_bind_buf 4 6 o_off
mtl_prm_u 0 bb
mtl_prm_u 1 tt
mtl_prm_u 2 d
mtl_prm_u 3 h
mtl_prm_u 4 e
mtl_bind_bytes 5 20
mtl_disp_tg tt h bb 64 1 1

