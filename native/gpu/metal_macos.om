fn cmd_mdev to void
mtl_init
pool = mtl_pool_push
nsname = mtl_msg0 get mtl_obj 0 0
cstr = mtl_msg0 nsname 1
mtl_puts mtl_s_mdev
if ne cstr 0
n = mio_strlen cstr
if gt n 200
n = 200
end
mio_memcpy ulong libptr mtl_txt 0 256 cstr n
for i ulong n bound 201
c = ulong get mtl_txt i
if eq c 32
c = 95
end
oputc c
end
end
mtl_pool_pop pool
mtl_puts mtl_s_uni
oputu get mtl_dinfo 0
mtl_puts mtl_s_ws
oputu get mtl_dinfo 1
mtl_puts mtl_s_pip
oputu get mtl_dinfo 2
mtl_puts mtl_s_simd
oputu get mtl_dinfo 3
mtl_puts mtl_s_pass
oflush
mtl_stop
end

global mtl_nf ulong 1

fn mtl_fin x f64 to bool
a = fabs x
ret le a bitcast f64 ulong 9218868437227405311
end

fn mtl_clp x f64 to f64
if mtl_fin x
if gt x 1000000.0f64
ret 1000000.0f64
end
if lt x -1000000.0f64
ret -1000000.0f64
end
ret x
end
ret 1000000.0f64
end

fn mtl_pat_val i ulong k ulong to f64
x = rem add mul i 17 mul k 31 97
ret mul sub f64 x 48.0 0.02
end

fn cmd_mgemm to void
if ne oargc 6
exit 2
end
m = oargu 2
n = oargu 3
k = oargu 4
it = oargu 5
if or eq m 0 or eq n 0 or eq k 0 eq it 0
exit 2
end
if or gt m 65536 or gt n 65536 or gt k 65536 gt it 10000
exit 2
end
mk = mul m k
kn = mul k n
mn = mul m n
if or gt mk 33554432 or gt kn 33554432 gt mn 33554432
exit 2
end
mtl_init
mtl_alloc_buf 7 mul mk 4
mtl_alloc_buf 8 mul kn 4
mtl_alloc_buf 9 mul mn 4
pa = get mtl_ptr 7
pb = get mtl_ptr 8
pc = get mtl_ptr 9
for i ulong mk bound 33554432
mtl_wr_f32 pa i mtl_pat_val i 3
end
for j ulong kn bound 33554432
mtl_wr_f32 pb j mtl_pat_val j 5
end
mtl_enc_begin
mtl_b3 7 0 8 0 9 0
mtl_k_gemm_go m n k 0 0.0f64
mtl_enc_commit

t0 = onsnow
mtl_enc_begin
for q ulong it bound 10000
mtl_b3 7 0 8 0 9 0
mtl_k_gemm_go m n k 0 0.0f64
end
mtl_enc_commit
ns = sub onsnow t0

mx = 0.0f64
put mtl_nf 0 0
rm = m
if gt rm 16
rm = 16
end
cn = n
if gt cn 16
cn = 16
end
for r ulong rm bound 17
for c ulong cn bound 17
s = 0.0f64
for kk ulong k bound 65536
va = mtl_pat_val add mul r k kk 3
vb = mtl_pat_val add mul kk n c 5
s = add s mul va vb
end
gv = mtl_rd_f32 pc add mul r n c
if not and mtl_fin gv mtl_fin s
put mtl_nf 0 add get mtl_nf 0 1
else
dd = fabs sub gv s
if gt dd mx
mx = dd
end
end
end
end
if ne get mtl_nf 0 0
mx = 1.0e30f64
end

flops = mul mul 2.0f64 f64 mul m n mul f64 k f64 it
gf = div flops f64 ns
mtl_puts mtl_s_mgemm
oputu m
oputc 32
oputu n
oputc 32
oputu k
oputc 32
oputu it
oputc 32
oputl long ns
oputc 32
oputl rmic div mul mtl_clp gf 100.0f64 1000000.0f64
oputc 32
oputl rmic mul mtl_clp mx 1000.0f64
if and eq get mtl_nf 0 0 and mtl_fin mx lt mx 0.0001f64
mtl_puts mtl_s_pass
oflush
mtl_stop
ret
end
mtl_puts mtl_s_fail
oflush
mtl_stop
exit 45
end

fn mtl_mops_pr tag view uchar * mx f64 tol f64 nf ulong to bool
mtl_puts mtl_s_mops
mtl_puts tag
oputl rmic mul mtl_clp mx 1000.0f64
if and eq nf 0 and mtl_fin mx lt mx tol
mtl_puts mtl_s_pass
ret true
end
mtl_puts mtl_s_fail
ret false
end

fn mtl_mops_gemm mode ulong tag view uchar * to bool
m = ulong 17
n = ulong 19
k = ulong 23
mtl_alloc_buf 7 mul mul m k 4
mtl_alloc_buf 8 mul mul k n 4
mtl_alloc_buf 9 mul mul m n 4
pa = get mtl_ptr 7
pb = get mtl_ptr 8
pc = get mtl_ptr 9
for i ulong mul m k
mtl_wr_f32 pa i mtl_pat_val i 7
end
for j ulong mul k n
mtl_wr_f32 pb j mtl_pat_val j 11
end
for c0 ulong mul m n
mtl_wr_f32 pc c0 0.5f64
end
mtl_enc_begin
mtl_b3 7 0 8 0 9 0
mtl_k_gemm_go m n k mode 1.0f64
mtl_enc_commit
mx = 0.0f64
put mtl_nf 0 0
for r ulong m
for c ulong n
s = 0.5f64
for kk ulong k
ai = add mul r k kk
if eq mode 2
ai = add mul kk m r
end
bi = add mul kk n c
if eq mode 1
bi = add mul c k kk
end
s = add s mul mtl_pat_val ai 7 mtl_pat_val bi 11
end
gv = mtl_rd_f32 pc add mul r n c
if not and mtl_fin gv mtl_fin s
put mtl_nf 0 add get mtl_nf 0 1
else
dd = fabs sub gv s
if gt dd mx
mx = dd
end
end
end
end
if ne get mtl_nf 0 0
mx = 1.0e30f64
end
ret mtl_mops_pr tag mx 0.0001f64 get mtl_nf 0
end

fn mtl_mops_rms to bool
r = ulong 4
d = ulong 33
mtl_alloc_buf 7 mul mul r d 4
mtl_alloc_buf 8 mul d 4
mtl_alloc_buf 9 mul mul r d 4
mtl_alloc_buf 10 mul r 4
px = get mtl_ptr 7
pg = get mtl_ptr 8
py = get mtl_ptr 9
ps = get mtl_ptr 10
for i ulong mul r d
mtl_wr_f32 px i mtl_pat_val i 13
end
for j ulong d
mtl_wr_f32 pg j add 1.0f64 mul 0.01f64 f64 j
end
mtl_enc_begin
mtl_b3 7 0 8 0 9 0
mtl_bind_buf 3 10 0
mtl_k_rms_fwd_go r d
mtl_enc_commit
mx = 0.0f64
put mtl_nf 0 0
for row ulong r
ss = 0.0f64
for j ulong d
v = mtl_pat_val add mul row d j 13
ss = add ss mul v v
end
inv_s = div 1.0f64 fsqrt add div ss f64 d 0.00001f64
if not and mtl_fin ss mtl_fin inv_s
put mtl_nf 0 add get mtl_nf 0 1
end
for j2 ulong d
v2 = mtl_pat_val add mul row d j2 13
g2 = add 1.0f64 mul 0.01f64 f64 j2
ref = mul mul v2 inv_s g2
gv = mtl_rd_f32 py add mul row d j2
if not and mtl_fin gv mtl_fin ref
put mtl_nf 0 add get mtl_nf 0 1
else
dd = fabs sub gv ref
if gt dd mx
mx = dd
end
end
end
end
if ne get mtl_nf 0 0
mx = 1.0e30f64
end
ret mtl_mops_pr mtl_s_mop_rms mx 0.0001f64 get mtl_nf 0
end

fn mtl_mops_attn to bool
bb = ulong 1
tt = ulong 6
dd = ulong 16
hh = ulong 2
ee = ulong 8
rr = mul bb tt
mtl_alloc_buf 7 mul mul rr dd 4
mtl_alloc_buf 8 mul mul rr dd 4
mtl_alloc_buf 9 mul mul rr dd 4
mtl_alloc_buf 10 mul mul mul mul bb hh tt tt 4
mtl_alloc_buf 11 mul mul rr dd 4
pq = get mtl_ptr 7
pk = get mtl_ptr 8
pv = get mtl_ptr 9
po = get mtl_ptr 11
for i ulong mul rr dd
mtl_wr_f32 pq i mtl_pat_val i 2
mtl_wr_f32 pk i mtl_pat_val i 3
mtl_wr_f32 pv i mtl_pat_val i 5
end
mtl_enc_begin
mtl_bind_pso 4
mtl_bind_buf 0 7 0
mtl_bind_buf 1 8 0
mtl_bind_buf 2 9 0
mtl_bind_buf 3 10 0
mtl_bind_buf 4 11 0
mtl_prm_u 0 bb
mtl_prm_u 1 tt
mtl_prm_u 2 dd
mtl_prm_u 3 hh
mtl_prm_u 4 ee
mtl_bind_bytes 5 20
mtl_disp_tg tt hh bb 64 1 1
mtl_enc_commit

mx = 0.0f64
put mtl_nf 0 0
isq = fsqrt f64 ee
sc = new f64 8 0.0f64
for n ulong hh
for t ulong tt
mmax = -1.0e30f64
for j ulong add t 1
dot = 0.0f64
for e ulong ee
qi = mtl_pat_val add add mul t dd mul n ee e 2
ki = mtl_pat_val add add mul j dd mul n ee e 3
dot = add dot mul qi ki
end
sv = div dot isq
if not mtl_fin sv
put mtl_nf 0 add get mtl_nf 0 1
end
put sc j sv
mmax = fmax mmax sv
end
ssum = 0.0f64
for j2 ulong add t 1
ev = fexp sub get sc j2 mmax
put sc j2 ev
ssum = add ssum ev
end
if not and mtl_fin ssum gt ssum 0.0f64
put mtl_nf 0 add get mtl_nf 0 1
end
for j3 ulong add t 1
put sc j3 div get sc j3 ssum
end
for e2 ulong ee
acc = 0.0f64
for j4 ulong add t 1
vi = mtl_pat_val add add mul j4 dd mul n ee e2 5
