mtl_bind_buf 3 6 s1_off
mtl_k_rms_fwd_go rr d
mtl_b3 6 a_off 0 mtl_wbyte opwq lp 6 q_off
mtl_k_gemm_go rr d d 0 0.0f64
mtl_b3 6 a_off 0 mtl_wbyte opwk lp 6 k_off
mtl_k_gemm_go rr d d 0 0.0f64
mtl_b3 6 a_off 0 mtl_wbyte opwv lp 6 u_off
