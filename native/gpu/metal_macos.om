mtl_b3 6 bn_off 6 df_off 1 mtl_wbyte opw1 lp
mtl_k_gemm_go d f rr 2 1.0f64
mtl_b3 6 df_off 0 mtl_wbyte opw1 lp 6 da_off
mtl_k_gemm_go rr d f 1 0.0f64
mtl_b3 6 hm_off 0 mtl_wbyte opg2 lp 6 s2_off
mtl_b3_hi 6 da_off 6 dh_off 6 dgp_off
