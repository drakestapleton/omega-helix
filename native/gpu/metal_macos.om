fn mtl_encode_adam s ulong to void
p = get og 8
fz = get mtl_fz 0
sq_off = mtl_abyte 14
cl_off = mtl_abyte 15

mtl_bind_pso 14
mtl_bind_buf 0 1 0
mtl_bind_buf 1 6 sq_off
mtl_prm_u 0 p
mtl_prm_u 1 fz
mtl_bind_bytes 2 8
mtl_disp_tg 256 1 1 256 1 1

mtl_bind_pso 15
mtl_bind_buf 0 6 sq_off
mtl_bind_buf 1 6 cl_off
mtl_prm_u 0 256
mtl_bind_bytes 2 4
mtl_disp_tg 1 1 1 256 1 1

lrs = olrs s bitcast f64 get og 43
bc1 = sub 1.0 opowb 0.9 s
bc2 = sub 1.0 opowb 0.99 s
if eq OMUTC 0
bc1 = 1.0f64
bc2 = 1.0f64
end

mtl_bind_pso 16
mtl_bind_buf 0 0 0
mtl_bind_buf 1 1 0
mtl_bind_buf 2 2 0
mtl_bind_buf 3 3 0
mtl_bind_buf 4 6 cl_off
mtl_prm_u 0 p
mtl_prm_u 1 fz
mtl_prm_f 2 lrs
mtl_prm_f 3 bc1
mtl_prm_f 4 bc2
mtl_prm_u 5 get mtl_mut 0
mtl_bind_bytes 5 24
mtl_disp_tg mtl_cd p 256 1 1 256 1 1
end

fn mtl_read_loss to f64
rr = mul get og 6 get og 1
act_p = get mtl_ptr 6
ls_ptr = add act_p mtl_abyte 4
mio_memcpy ulong libptr mtl_stg 0 65536 ls_ptr mul rr 4
sm = 0.0f64
for r ulong rr bound 65537
sm = add sm f64 bitcast f32 mtl_stg_g32 mul r 4
end
ret div sm f64 rr
end

fn mtl_puts s view uchar * to void
for i ulong len s bound 4096
oputc ulong get s i
end
