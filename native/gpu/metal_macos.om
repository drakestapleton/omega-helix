note SPDX-License-Identifier: AGPL-3.0-only
note native/gpu/metal_macos.om: Pure-Omega Apple Silicon Metal backend (@ng a64 macho).
note Uses libfn/libptr/libcall against Metal.framework, Foundation.framework, and libobjc.A.dylib.
note Implements ogcmd (mdev, mgemm, mops, gforward, gcmp, gacmp, gtrain, geval, gsample) plus
note ogchip, oglast, and ogmask for full CPU-oracle parity on Apple Silicon GPUs.

text mtl_f_fnd "/System/Library/Frameworks/Foundation.framework/Foundation"
text mtl_f_mtl "/System/Library/Frameworks/Metal.framework/Metal"
text mtl_f_obj "/usr/lib/libobjc.A.dylib"

text mtl_c_dev "MTLCreateSystemDefaultDevice"
text mtl_c_cls "objc_getClass"
text mtl_c_sel "sel_registerName"
text mtl_c_msg "objc_msgSend"
text mtl_c_apush "objc_autoreleasePoolPush"
text mtl_c_apop "objc_autoreleasePoolPop"
text mtl_c_nsstr "NSString"

text mtl_n_name "name"
text mtl_n_utf8 "UTF8String"
text mtl_n_uni "hasUnifiedMemory"
text mtl_n_ws "recommendedMaxWorkingSetSize"
text mtl_n_nq "newCommandQueue"
text mtl_n_nbuf "newBufferWithLength:options:"
