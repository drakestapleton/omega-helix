fn grfa_ld_kh ptr uint stsb uint e uint stg uint sm_off uint to void
if eq e 32
gkldgq stg ptr false 7
w = get gkpend 0
put gkpend 0 0
put gkpend 0 w
for q uint 4
off = add sm_off mul q 16
if eq q 3
gksts stsb off add stg q true
else
gksts2 stsb off add stg q ne q 0
end
end
gkimadw ptr 122 1 ptr
ret
end
gkimadi 14 7 16 255
gkimadw1 8 14 0 ptr
gkimadw 10 14 1 ptr
gkldgq1 stg 8 false 7
gkldgq add stg 4 10 true 7
w = get gkpend 0
put gkpend 0 0
put gkpend 0 w
for i uint 2
for q uint 4
off = add add sm_off mul i 512 mul q 16
rg = add add stg mul i 4 q
if and eq i 1 eq q 3
gksts stsb off rg true
else
gksts2 stsb off rg or ne i 0 ne q 0
end
end
end
gkimadw ptr 122 1 ptr
end
fn grfa_ld_vh ptr uint stsb uint e uint stg uint sm_off uint to void
