note 76 RMSB_BF16: packed-bf16 v, da, dh; f32 g, s, ws; chunk c <= 2 (4 floats/chunk -> max R67 <= 72)
fn grrmsb_bf1_p1 u uint to void
u2 = mul u 2
gkimadi add 40 u2 add 32 u 65536 255
gkandi add 41 u2 add 32 u 4294901760
gkimadi add 44 u2 add 36 u 65536 255
gkandi add 45 u2 add 36 u 4294901760
gkfmulf add 40 u2 add 40 u2 add 48 u2
gkffmaf 64 add 40 u2 add 44 u2 64
gkfmulf add 41 u2 add 41 u2 add 49 u2
gkffmaf 64 add 41 u2 add 45 u2 64
end
fn grrmsb_bf1_p2 u uint to void
u2 = mul u 2
gkimadi add 40 u2 add 32 u 65536 255
gkandi add 41 u2 add 32 u 4294901760
gkimadi add 44 u2 add 36 u 65536 255
gkandi add 45 u2 add 36 u 4294901760
gkimadi add 52 u2 add 56 u 65536 255
gkandi add 53 u2 add 56 u 4294901760
for q uint 2
da = add add 40 u2 q
vr = add add 44 u2 q
gr = add add 48 u2 q
dh = add add 52 u2 q
gkfmulf gr da gr
gkfmulf da da vr
gkfmulf da da 67
gkfmulf vr vr 66
grfsub gr gr vr
gkfmulf gr gr 67
grfadd dh dh gr
end
gkf2fp add 56 u add 53 u2 add 52 u2 0
end
fn grrmsb_bf1_ldg c uint to void
for u uint c
gkldg64o add 48 mul u 2 12 mul u 256 true
end
end
fn grrmsb_bf1_red r_lo uint r_hi uint off uint to void
