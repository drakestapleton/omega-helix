gkprmt add stg 5 stg 30258 add stg 2 0
gkprmt add stg 6 add stg 1 21520 add stg 3 0
gkprmt add stg 7 add stg 1 30258 add stg 3 0
for q uint 4
off = add sm_off mul q 64
if eq q 3
gksts stsb off add stg add 4 q true
else
gksts2 stsb off add stg add 4 q ne q 0
end
end
gkimadw ptr 122 1 ptr
ret
end
gkldgq1 stg 8 false 7
gkldgq add stg 4 10 true 7
w = get gkpend 0
put gkpend 0 0
for q uint 4
gkprmt add 8 mul q 2 add stg q 21520 add add stg 4 q w
w = 0
gkprmt add 9 mul q 2 add stg q 30258 add add stg 4 q 0
end
for c uint 8
off = add sm_off mul c 64
if eq c 7
gksts stsb off add 8 c true
else
gksts2 stsb off add 8 c ne c 0
end
end
gkimadw ptr 122 1 ptr
end
