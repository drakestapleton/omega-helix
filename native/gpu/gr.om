gklds32 60 22 mul ww 256 3 0
gklds32 61 22 add mul ww 256 4 3 0
grfaddw r_lo r_lo 60
grfadd r_hi r_hi 61
end
gkstg64o 18 r_lo off false
grbfwd_fx 1 p_rd
gksync
end
fn grrmsb_bf1_stg c uint to void
for u uint c
