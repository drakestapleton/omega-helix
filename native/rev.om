rev_setup_ck4 0 32 4 8 2 2
put rev_cfg 5 16
put rev_cfg 6 2
put rev_cfg 7 2
put rev_cfg 17 0
put rev_cfg 18 0
put rev_cfg 19 0
put rev_cfg 20 42
put rev_cfg 21 0
put rev_cfg 22 50
put rev_cfg 23 bitcast ulong 0.01f64
if not rev_geom
ret 1
end
rev_init_params
rev_perturb_weights 0.25
rev_fill_seq
e1 = rev_check_inv
ok1 = lt e1 1.0e-12
if not ok1
fails = add fails 1
end
rev_print_res ok1 73 49 e1 rev_act_bytes_used
g1 = rev_check_grad 24
ok2 = lt g1 1.0e-8
if not ok2
fails = add fails 1
end
rev_print_res ok2 71 49 g1 rev_pair_bytes
ret fails
end

