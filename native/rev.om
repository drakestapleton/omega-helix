fn rev_popcnt64 x ulong to ulong
c = ulong 0
v = x
while ne v 0 bound 64
c = add c and v 1
v = shr v 1
end
ret c
end

fn rev_q32_pert seed ulong to f64
r = mul f64 shr smx seed 11 1.1102230246251565e-16
v = mul sub mul 2.0 r 1.0 1.5e-4
if lt fabs v 5.0e-5
if ge v 0.0
v = add v 5.0e-5
else
v = sub v 5.0e-5
end
end
ret rev_q32_bf16_sim v
end

fn rev_q32_gen_fg l ulong n ulong f_arr edit f64 256 g_arr edit f64 256 to void
for i ulong n
put f_arr i rev_q32_pert add mul l 1009 add mul i 17 31337
put g_arr i rev_q32_pert add mul l 2029 add mul i 29 91827
end
end

fn rev_q32_init_val seed ulong odd ulong to f64
r = mul f64 shr smx seed 11 1.1102230246251565e-16
mag = add 100000.0 mul r 1000.0
if ne odd 0
ret neg mag
end
ret mag
end

fn rev_q32_init_stream n ulong to void
for i ulong n
odd1 = and i 1
odd2 = and add i 1 1
q1 = rev_q32_quant rev_q32_init_val add 5000 i odd1
q2 = rev_q32_quant rev_q32_init_val add 9000 i odd2
put rev_q32_x1 i q1
put rev_q32_x2 i q2
put rev_q32_hist i q1
put rev_q32_hist add n i q2
end
end

fn rev_q32_save_state n ulong off ulong to void
for i ulong n
put rev_q32_hist add off i get rev_q32_x1 i
put rev_q32_hist add add off n i get rev_q32_x2 i
end
end

fn rev_q32_diff_state n ulong off ulong to ulong
diffs = ulong 0
for i ulong n
d1 = xor bitcast ulong get rev_q32_x1 i bitcast ulong get rev_q32_hist add off i
if ne d1 0
diffs = add diffs rev_popcnt64 d1
end
d2 = xor bitcast ulong get rev_q32_x2 i bitcast ulong get rev_q32_hist add off add n i
if ne d2 0
diffs = add diffs rev_popcnt64 d2
end
end
ret diffs
end

fn rev_q32_selftest to ulong
n = ulong 64
nl = ulong 8
f_arr = new f64 256 0.0
g_arr = new f64 256 0.0
rev_q32_init_stream n
for l ulong nl
rev_q32_gen_fg l n edit f_arr edit g_arr
rev_q32_fwd_layer n view f_arr view g_arr
rev_q32_save_state n mul add l 1 mul 2 n
end
diffs = ulong 0
if eq rev_q32_diff_state n 0 0
diffs = add diffs 1
end
for r ulong nl
l = sub sub nl 1 r
diffs = add diffs rev_q32_diff_state n mul add l 1 mul 2 n
rev_q32_gen_fg l n edit f_arr edit g_arr
rev_q32_inv_layer n view f_arr view g_arr
end
diffs = add diffs rev_q32_diff_state n 0
if ne rev_q32_quant div 1.0 REV_Q32_SCALE 1
diffs = add diffs 1
end
if ne rev_q32_quant neg div 1.0 REV_Q32_SCALE -1
diffs = add diffs 1
end
ret diffs
end

fn rev_det_alloc p ulong to void
if gt p get rev_det_sz 0
r = enlarge rev_det_g p
if ne r 0
exit 70
end
put rev_det_sz 0 p
end
end

fn rev_det_snap_g p ulong to void
for q ulong rev_cn p
i = mul q REV_CH
ie = rev_ce q p
while lt i ie bound 999999
put rev_det_g i bitcast ulong rev_gg i
i = add i 1
end
end
end

fn rev_det_poison p ulong to void
for q ulong rev_cn p
i = mul q REV_CH
ie = rev_ce q p
while lt i ie bound 999999
rev_gp i 0.123456789
i = add i 1
end
end
end

fn rev_det_cmp_g p ulong to ulong
diffs = ulong 0
nz = ulong 0
for q ulong rev_cn p
i = mul q REV_CH
ie = rev_ce q p
while lt i ie bound 999999
b1 = get rev_det_g i
b2 = bitcast ulong rev_gg i
if ne b2 0
nz = add nz 1
end
if ne b1 b2
diffs = add diffs rev_popcnt64 xor b1 b2
end
i = add i 1
end
end
if eq nz 0
diffs = add diffs 1
end
ret diffs
end

fn rev_det_bwd_setup to void
rev_setup_ck4 27 32 4 8 2 1
put rev_cfg 5 16
put rev_cfg 6 3
put rev_cfg 7 2
put rev_cfg 17 1
put rev_cfg 18 1
put rev_cfg 19 3
put rev_cfg 20 99
put rev_cfg 21 0
put rev_cfg 22 50
put rev_cfg 23 bitcast ulong 0.01f64
if not rev_geom
exit 12
end
rev_init_params
rev_perturb_weights 0.2
rev_fill_seq
end

fn rev_det_bwd_selftest to ulong
rev_det_bwd_setup
p = get rev_cfg 10
rev_det_alloc p
ls1 = rev_grad
rev_det_snap_g p
rev_det_bwd_setup
rev_det_poison p
ls2 = rev_grad
diffs = rev_det_cmp_g p
if ne bitcast ulong ls1 bitcast ulong ls2
diffs = add diffs rev_popcnt64 xor bitcast ulong ls1 bitcast ulong ls2
end
ret diffs
end

