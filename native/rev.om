fn rev_cli to int
if lt ulong argcnt 2
exit 2
end
w = rev_cmd_word
note "selftest" = 8391162081330357619
if eq w 8391162081330357619
ret rev_selftest
end
note "mode0" = 207859511149
if eq w 207859511149
ret rev_mode0_test
end
note "ck4load" = 28254628855704419
if eq w 28254628855704419
ret rev_ck4_verify
end
note "oracle" = 111516198204015
