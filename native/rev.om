end
put og 40 77
put og 41 0
put og 42 50
put og 43 bitcast ulong 0.01f64
oinit
rev_sync_from_og
rev_perturb_weights 0.2
rev_fill_seq
e0 = rev_check_inv
g0 = rev_check_grad 24
l0 = rev_grad
rev_adam
for s ulong 4
ld = rev_grad
rev_adam
end
lf = rev_grad
ok = and lt e0 1.0e-12 and lt g0 1.0e-8 and eq rev_act_bytes_used 0 lt lf l0
rev_print_res ok 77 48 e0 rev_act_bytes_used
rev_print_res ok 77 71 g0 get og 8
oflush
if ok
ret 0
end
ret 1
end

