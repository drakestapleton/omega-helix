fn rev_print_q32 diffs ulong nl ulong to void
rev_print_pf eq diffs 0
oputc 81
oputc 51
oputc 50
oputc 32
oputu diffs
oputc 32
oputu nl
oputc 10
end

fn rev_print_detbwd diffs ulong p ulong to void
rev_print_pf eq diffs 0
oputc 68
oputc 69
oputc 84
oputc 66
oputc 87
oputc 68
oputc 32
oputu diffs
oputc 32
oputu p
oputc 10
end

fn rev_selftest to int
f1 = rev_selftest_1
f2 = rev_selftest_2
f3 = rev_q32_selftest
rev_print_q32 f3 8
f4 = rev_det_bwd_selftest
rev_print_detbwd f4 get rev_cfg 10
oflush
if gt add add f1 f2 add f3 f4 0
ret 1
end
ret 0
end

note Write binary f64 buffer helper for oracle cross-checking
fn rev_write_f64_fd fd int vals_kind ulong n ulong to void
c = ulong 0
while lt c n bound 999999
m = sub n c
if gt m REV_CKC
m = REV_CKC
end
for j ulong m
idx = add c j
v = 0.0f64
if eq vals_kind 0
v = rev_wg idx
end
if eq vals_kind 1
v = rev_gg idx
end
if eq vals_kind 2
v = get rev_pair idx
end
if eq vals_kind 3
v = get rev_dpair idx
end
rev_ck_put8 mul j 8 bitcast ulong v
end
nb = mul m 8
p = ulong 0
while lt p nb bound 999999
w = write fd rev_ck p sub nb p
if le w 0
exit 70
end
p = add p ulong w
end
c = add c m
end
end

fn rev_open_out ai ulong to int
pl = rev_argp ai
if gt pl 4000
exit 2
end
for i ulong pl
put rev_path i get rev_arg i
end
fd = int fopen rev_path 0 pl 577 420
if lt fd 0
exit 70
end
ret fd
end

note CLI: selftest | ck4_save PATH ... | oracle_dump FL V T D H HKV F L B LP LC NP SEED STEPS OUTBIN CK4OUT
fn rev_cmd_word to ulong
r = argread 1 rev_arg 0 4096
if or le r 0 gt r 8
ret 0
end
v = ulong 0
for k ulong ulong r
v = or v shl ulong get rev_arg k mul k 8
end
ret v
end

fn rev_oracle_cfg to void
put rev_cfg 0 rev_argu 3
put rev_cfg 1 rev_argu 4
put rev_cfg 2 rev_argu 5
put rev_cfg 3 rev_argu 6
put rev_cfg 4 rev_argu 7
put rev_cfg 5 rev_argu 8
put rev_cfg 6 rev_argu 9
put rev_cfg 7 rev_argu 10
put rev_cfg 17 rev_argu 11
put rev_cfg 18 rev_argu 12
put rev_cfg 19 rev_argu 13
put rev_cfg 20 rev_argu 14
put rev_cfg 12 rev_argu 2
put rev_cfg 13 10000000
put rev_cfg 14 bitcast ulong 0.00001f64
put rev_cfg 15 bitcast ulong 0.05f64
put rev_cfg 16 10
put rev_cfg 21 0
put rev_cfg 22 50
put rev_cfg 23 bitcast ulong 0.01f64
put rev_cfg 25 1
if not rev_geom
exit 12
end
end

fn rev_oracle_hdr fd int inv_err f64 ls f64 to void
rev_ck_put8 0 get rev_cfg 10
rev_ck_put8 8 bitcast ulong inv_err
rev_ck_put8 16 bitcast ulong ls
rev_ck_put8 24 rev_act_bytes_used
rev_ck_put8 32 rev_pair_bytes
wp = ulong 0
while lt wp 40 bound 40
w = write fd rev_ck wp sub 40 wp
if le w 0
exit 70
end
wp = add wp ulong w
end
end

fn rev_oracle_steps fd int steps ulong to void
for s ulong steps
lstep = rev_grad
rev_ck_put8 0 bitcast ulong lstep
w2 = write fd rev_ck 0 8
if ne w2 8
exit 70
end
rev_adam
end
end

fn rev_oracle_dump to int
if ne ulong argcnt 18
exit 2
end
rev_oracle_cfg
rev_init_params
rev_perturb_weights 0.2
rev_fill_seq
inv_err = rev_check_inv
ls = rev_grad
fd = rev_open_out 16
p = get rev_cfg 10
rev_oracle_hdr fd inv_err ls
rev_write_f64_fd fd 0 p
rev_write_f64_fd fd 1 p
rev_oracle_steps fd rev_argu 15
rev_write_f64_fd fd 0 p
if ne fsync fd 0
exit 70
end
if ne fclose fd 0
exit 70
end
rev_ck4_save 17
oputc 79
oputc 75
oputc 32
oputx bitcast ulong inv_err
oputc 32
oputx bitcast ulong ls
oputc 32
oputu rev_act_bytes_used
oputc 10
oflush
ret 0
end

