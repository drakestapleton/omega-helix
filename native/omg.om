note SPDX-License-Identifier: Apache-2.0
note native/omg.om: Canonical Binary OMG Semantic Graph Engine (Pillar 8).
note Pure seeded-OM-2 implementation:
note   1. V=256 Canonical OMG Graph Vocabulary (u16 stream) with De Bruijn REF_0..REF_63,
note      base-16 constant chunks (NIB_0..NIB_15), small literals (LIT_0..LIT_31), and OMG_MACRO.
note   2. De Bruijn canonical .om <-> OMG roundtrip (omg_parse_om, omg_encode_stream, omg_decode_om).
note   3. Deterministic 64-bit FNV-1a & 256-bit SEMANTIC_ID (omg_semantic_id) + OMGC binary corpus
note      packer with semantic deduplication (omg_corpus_add, omg_pack_corpus).
note   4. O(1) Bitmask-Enforced Validity (omg_valid_mask, omg_step, omg_validate) for gsamp.
note   5. Macro dictionary indexed by 64-bit SEMANTIC_ID (omg_macro_register, omg_macro_expand).
note   6. Built-in omg_selftest + V=256 vs V=4096 metrics reporter (omg_report_metrics).

const OMG_VOCAB ulong 256
const OMG_MAX_TOKS ulong 16384
const OMG_MAX_SRC ulong 65536
const OMG_MAX_CORP ulong 524288
const OMG_MAX_LIVE ulong 64
const OMG_MAX_FNS ulong 28
const OMG_MAX_MACS ulong 32
const OMG_MAX_ESTK ulong 128
const OMG_MAX_BSTK ulong 32

note ---- Token Vocabulary (V = 256) ----
const OMG_EOF ulong 0
const OMG_BEGIN ulong 1
const OMG_END_UNIT ulong 2
const OMG_FN ulong 3
const OMG_FN_MAIN ulong 4
const OMG_PARAM ulong 5
const OMG_BODY ulong 6
const OMG_END ulong 7
const OMG_LET ulong 8
const OMG_SET ulong 9
const OMG_RET ulong 10
const OMG_IF ulong 11
const OMG_ELSE ulong 12
const OMG_WHILE ulong 13
const OMG_FOR ulong 14
const OMG_BREAK ulong 15
const OMG_CONTINUE ulong 16
const OMG_NEW ulong 17
const OMG_TRAP ulong 18
const OMG_EXIT ulong 19
const OMG_CALL_VOID ulong 20
const OMG_MACRO ulong 21
const OMG_PUT ulong 22

note Types (24..37)
const OMG_TY_VOID ulong 24
const OMG_TY_BOOL ulong 25
const OMG_TY_U8 ulong 26
const OMG_TY_U16 ulong 27
const OMG_TY_U32 ulong 28
const OMG_TY_U64 ulong 29
const OMG_TY_I8 ulong 30
const OMG_TY_I16 ulong 31
const OMG_TY_I32 ulong 32
const OMG_TY_I64 ulong 33
const OMG_TY_F32 ulong 34
const OMG_TY_F64 ulong 35
const OMG_TY_VIEW ulong 36
const OMG_TY_EDIT ulong 37

note Opcodes (40..71)
const OMG_OP_ADD ulong 40
const OMG_OP_SUB ulong 41
const OMG_OP_MUL ulong 42
const OMG_OP_DIV ulong 43
const OMG_OP_REM ulong 44
const OMG_OP_AND ulong 45
const OMG_OP_OR ulong 46
const OMG_OP_XOR ulong 47
const OMG_OP_SHL ulong 48
const OMG_OP_SHR ulong 49
const OMG_OP_ROTR ulong 50
const OMG_OP_ROTL ulong 51
const OMG_OP_FMIN ulong 52
const OMG_OP_FMAX ulong 53
const OMG_OP_EQ ulong 54
const OMG_OP_NE ulong 55
const OMG_OP_LT ulong 56
const OMG_OP_LE ulong 57
const OMG_OP_GT ulong 58
const OMG_OP_GE ulong 59
const OMG_OP_NEG ulong 60
const OMG_OP_NOT ulong 61
const OMG_OP_FSQRT ulong 62
const OMG_OP_FABS ulong 63
const OMG_OP_LEN ulong 64
const OMG_OP_GET ulong 65
const OMG_OP_FMA ulong 66
const OMG_OP_CAST ulong 67
const OMG_OP_BITCAST ulong 68
const OMG_OP_CALL ulong 69
const OMG_OP_TRUE ulong 70
const OMG_OP_FALSE ulong 71

note Constants (76..99)
const OMG_CONST_U8 ulong 76
const OMG_CONST_U16 ulong 77
const OMG_CONST_U32 ulong 78
const OMG_CONST_U64 ulong 79
const OMG_CONST_NEG8 ulong 80
const OMG_CONST_I64 ulong 81
const OMG_CONST_F32 ulong 82
const OMG_CONST_F64 ulong 83
const OMG_NIB_BASE ulong 84
const OMG_LIT_BASE ulong 100
const OMG_FN_BASE ulong 132
const OMG_REF_BASE ulong 160
const OMG_MAC_BASE ulong 224

note Expectation stack kinds
const OMG_EK_UNIT_HDR ulong 1
const OMG_EK_TOP ulong 2
const OMG_EK_FN_RET ulong 3
const OMG_EK_FN_PARAM ulong 4
const OMG_EK_PARAM_TY ulong 5
const OMG_EK_PARAM_EL ulong 6
const OMG_EK_STMT ulong 7
const OMG_EK_EXPR ulong 8
const OMG_EK_LET_TY ulong 9
const OMG_EK_LET_PUSH ulong 10
const OMG_EK_SET_REF ulong 11
const OMG_EK_CMP_TY ulong 12
const OMG_EK_CAST_SRC ulong 13
const OMG_EK_BITCAST_SRC ulong 14
const OMG_EK_CALL_FN ulong 15
const OMG_EK_CALL_VOID_FN ulong 16
const OMG_EK_ARR_ANY ulong 17
const OMG_EK_ARR_OF ulong 18
const OMG_EK_ARR_WRITE ulong 19
const OMG_EK_ARR_WRITE_OF ulong 20
const OMG_EK_NIB ulong 21
const OMG_EK_FOR_TY ulong 22
const OMG_EK_FOR_PUSH ulong 23
const OMG_EK_NEW_TY ulong 24
const OMG_EK_NEW_LEN ulong 25
const OMG_EK_NEW_PUSH ulong 26
const OMG_EK_BOUND ulong 27
const OMG_EK_TRAP_N ulong 28
const OMG_EK_MAC_SLOT ulong 29
const OMG_EK_EXPR_NZ ulong 30
const OMG_EK_EXPR_SH ulong 31
const OMG_EK_EXPR_IDX ulong 32

note Block kinds
const OMG_BK_FN ulong 1
const OMG_BK_IF ulong 2
const OMG_BK_ELSE ulong 3
const OMG_BK_WHILE ulong 4
const OMG_BK_FOR ulong 5

note ---- Global State ----
global omg_toks ushort 16384
global omg_ntok ulong 1
global omg_exp_buf ushort 16384
global omg_nexp ulong 1
global omg_mask uchar 256
global omg_src uchar 65536
global omg_nsrc ulong 1
global omg_dec uchar 65536
global omg_ndec ulong 1
global omg_corpus uchar 524288
global omg_ncorp ulong 1
global omg_corp_nrec ulong 1
global omg_corp_ntok ulong 1
global omg_corp_ids ulong 4096
global omg_corp_offs ulong 4096
global omg_corp_lens ulong 4096
global omg_corp_toks ushort 262144
global omg_sem_hash ulong 4

note Validator / FSM state
note omg_st: 0 estk_sp, 1 bstk_sp, 2 n_live, 3 n_fns, 4 cur_fn, 5 cur_ret, 6 cur_pslots,
note 7 loop_depth, 8 scope_depth, 9 estk_min, 10 has_main, 11 max_live_cap,
note 12 allow_fwd, 13 err_code, 14 err_pos, 15 cur_new_len, 16 cur_for_ty, 17 unit_done,
note 18 cur_let_ty, 19 cur_fn_is_main, 20 gen_mode
global omg_st ulong 24

global omg_ek ulong 128
global omg_et ulong 128
global omg_ea ulong 128
global omg_bk ulong 32
global omg_be ulong 32
global omg_bt ulong 32
global omg_bs ulong 32

note De Bruijn binding environment
note omg_ev_arr: 0 scalar, 1 view arr, 2 edit/local writable arr
global omg_ev_ty ulong 64
global omg_ev_sc ulong 64
global omg_ev_mut ulong 64
global omg_ev_arr ulong 64
global omg_ev_el ulong 64
global omg_ev_len ulong 64

note Function table (max 32 fns, max 6 params each)
global omg_fn_ret ulong 32
global omg_fn_np ulong 32
global omg_fn_pt ulong 192
global omg_fn_pk ulong 192
global omg_fn_pe ulong 192
global omg_fn_done ulong 32
global omg_fn_main ulong 32
global omg_fn_noff ulong 32
global omg_fn_nlen ulong 32

note Macro dictionary (max 32 macros, 4096 token pool)
global omg_mac_cnt ulong 1
global omg_mac_id ulong 32
global omg_mac_kind ulong 32
global omg_mac_out ulong 32
global omg_mac_nin ulong 32
global omg_mac_in ulong 128
global omg_mac_off ulong 32
global omg_mac_len ulong 32
global omg_mac_pool ushort 4096
global omg_mac_pcur ulong 1
global omg_mac_tmp_in ulong 4
global omg_mac_tmp_tok ushort 256
global omg_mac_tmp_len ulong 1

note Parser symbol table & line scratch
global omg_sym_off ulong 64
global omg_sym_len ulong 64
global omg_ltok_off ulong 64
global omg_ltok_len ulong 64
global omg_nltok ulong 1
global omg_ppos ulong 1
global omg_line_buf uchar 512
global omg_line_n ulong 1
global omg_cst_off ulong 32
global omg_cst_len ulong 32
global omg_cst_ty ulong 32
global omg_cst_val ulong 32
global omg_ncst ulong 1
global omg_dec_vid ulong 64
global omg_dec_nvid ulong 1
global omg_dec_cur ulong 1

note ---- Small Type & Width Predicates ----

fn omg_is_num t ulong to bool
  ret and ge t OMG_TY_U8 le t OMG_TY_F64
end

fn omg_is_int t ulong to bool
  ret and ge t OMG_TY_U8 le t OMG_TY_I64
end

fn omg_is_uint t ulong to bool
  ret and ge t OMG_TY_U8 le t OMG_TY_U64
end

fn omg_is_sint t ulong to bool
  ret and ge t OMG_TY_I8 le t OMG_TY_I64
end

fn omg_is_flt t ulong to bool
  ret or eq t OMG_TY_F32 eq t OMG_TY_F64
end

fn omg_is_scalar t ulong to bool
  ret and ge t OMG_TY_BOOL le t OMG_TY_F64
end

fn omg_type_bits t ulong to ulong
  if or eq t OMG_TY_U8 eq t OMG_TY_I8
    ret 8
  end
  if or eq t OMG_TY_U16 eq t OMG_TY_I16
    ret 16
  end
  if or or eq t OMG_TY_U32 eq t OMG_TY_I32 eq t OMG_TY_F32
    ret 32
  end
  if or or eq t OMG_TY_U64 eq t OMG_TY_I64 eq t OMG_TY_F64
    ret 64
  end
  ret 0
end

note ---- Stack Helpers ----

fn omg_ek_has_tok k ulong to bool
  if or eq k OMG_EK_STMT or eq k OMG_EK_LET_PUSH or eq k OMG_EK_FOR_PUSH eq k OMG_EK_NEW_PUSH
    ret false
  end
  ret true
end

fn omg_epush k ulong t ulong a ulong to void
  sp = get omg_st 0
  if ge sp OMG_MAX_ESTK
    put omg_st 13 101
    ret
  end
  put omg_ek sp k
  put omg_et sp t
  put omg_ea sp a
  put omg_st 0 add sp 1
  if omg_ek_has_tok k
    put omg_st 9 add get omg_st 9 1
  end
end

fn omg_epop to void
  sp = get omg_st 0
  if eq sp 0
    ret
  end
  sp = sub sp 1
  k = get omg_ek sp
  put omg_st 0 sp
  if omg_ek_has_tok k
    if gt get omg_st 9 0
      put omg_st 9 sub get omg_st 9 1
    end
  end
end

fn omg_bpush k ulong to void
  sp = get omg_st 1
  if ge sp OMG_MAX_BSTK
    put omg_st 13 102
    ret
  end
  put omg_bk sp k
  put omg_be sp 0
  put omg_bt sp 0
  put omg_bs sp get omg_st 2
  put omg_st 1 add sp 1
end

fn omg_env_push_len ty ulong mut ulong arr ulong el ulong alen ulong to void
  n = get omg_st 2
  if ge n OMG_MAX_LIVE
    put omg_st 13 103
    ret
  end
  put omg_ev_ty n ty
  put omg_ev_sc n get omg_st 8
  put omg_ev_mut n mut
  put omg_ev_arr n arr
  put omg_ev_el n el
  put omg_ev_len n alen
  put omg_st 2 add n 1
end

fn omg_env_push ty ulong mut ulong arr ulong el ulong to void
  omg_env_push_len ty mut arr el 0
end

fn omg_env_pop_to base ulong to void
  if lt base get omg_st 2
    put omg_st 2 base
  end
end

fn omg_init to void
  for i ulong 24
    put omg_st i 0
  end
  put omg_st 11 OMG_MAX_LIVE
  put omg_st 12 1
  omg_epush OMG_EK_UNIT_HDR 0 0
end

fn omg_init_gen to void
  omg_init
  put omg_st 11 3
  put omg_st 12 0
  put omg_st 20 1
end

fn omg_init_parse to void
  omg_init
end

fn omg_fn_satisfied to bool
  if eq get omg_st 5 OMG_TY_VOID
    ret true
  end
  if eq get omg_be 0 1
    ret true
  end
  bsp = get omg_st 1
  if eq bsp 0
    ret true
  end
  i = sub bsp 1
  if eq get omg_be i 0
    ret false
  end
  while gt i 0 bound 32
    if or ne get omg_bk i OMG_BK_ELSE ne get omg_bt i 1
      ret false
    end
    i = sub i 1
  end
  ret true
end

note Minimum tokens needed to close all currently open blocks + ret + END_UNIT in O(1)
fn omg_close_cost to ulong
  bsp = get omg_st 1
  if eq bsp 0
    if eq get omg_st 17 1
      ret 0
    end
    if and ne get omg_st 20 0 eq get omg_st 10 0
      ret 6
    end
    ret 1
  end
  cost = add bsp 1
  if not omg_fn_satisfied
    cost = add cost 2
  end
  if and ne get omg_st 20 0 eq get omg_st 10 0
    cost = add cost 5
  end
  ret cost
end

fn omg_avail left ulong cc ulong extra ulong to ulong
  need = add cc extra
  if le left need
    ret 0
  end
  ret sub left need
end

note Count if env has at least one variable/array matching criteria
fn omg_has_var t ulong to bool
  n = get omg_st 2
  for i ulong n
    if and eq get omg_ev_arr i 0 eq get omg_ev_ty i t
      ret true
    end
  end
  ret false
end

fn omg_has_mut_var to bool
  n = get omg_st 2
  for i ulong n
    if and eq get omg_ev_arr i 0 eq get omg_ev_mut i 1
      ret true
    end
  end
  ret false
end

fn omg_has_arr_any to bool
  n = get omg_st 2
  for i ulong n
    if ne get omg_ev_arr i 0
      ret true
    end
  end
  ret false
end

fn omg_has_arr_el el ulong wr ulong to bool
  n = get omg_st 2
  for i ulong n
    ak = get omg_ev_arr i
    if ne ak 0
      if or eq wr 0 eq ak 2
        if eq get omg_ev_el i el
          ret true
        end
      end
    end
  end
  ret false
end

fn omg_has_arr_write to bool
  n = get omg_st 2
  for i ulong n
    if eq get omg_ev_arr i 2
      ret true
    end
  end
  ret false
end

fn omg_fn_callable f ulong to bool
  np = get omg_fn_np f
  for p ulong np
    pk = get omg_fn_pk add mul f 6 p
    if ne pk 0
      pe = get omg_fn_pe add mul f 6 p
      wr = ulong 0
      if eq pk 2
        wr = 1
      end
      if not omg_has_arr_el pe wr
        ret false
      end
    end
  end
  ret true
end

fn omg_has_fn_ret t ulong avail ulong to bool
  nf = get omg_st 3
  af = get omg_st 12
  for f ulong nf
    if or ne af 0 eq get omg_fn_done f 1
      if eq get omg_fn_ret f t
        if ge avail add 1 get omg_fn_np f
          if omg_fn_callable f
            ret true
          end
        end
      end
    end
  end
  ret false
end

fn omg_has_macro kind ulong out_t ulong left ulong cc ulong to bool
  mc = get omg_mac_cnt 0
  for m ulong mc
    if and eq get omg_mac_kind m kind eq get omg_mac_out m out_t
      need = add add cc get omg_mac_nin m 2
      if ge left need
        ret true
      end
    end
  end
  ret false
end

note ---- O(1) Bitmask-Enforced Validity ----

fn omg_mask_clear to void
  for i ulong OMG_VOCAB
    put omg_mask i 0
  end
end

fn omg_allow tok ulong to void
  if lt tok OMG_VOCAB
    put omg_mask tok 1
  end
end

fn omg_allow_range lo ulong hi ulong to void
  i = lo
  while le i hi bound 256
    put omg_mask i 1
    i = add i 1
  end
end

fn omg_mask_refs_ty t ulong to void
  n = get omg_st 2
  for k ulong n
    idx = sub sub n 1 k
    if and eq get omg_ev_arr idx 0 eq get omg_ev_ty idx t
      omg_allow add OMG_REF_BASE k
    end
  end
end

fn omg_mask_refs_arr el ulong wr ulong to void
  n = get omg_st 2
  for k ulong n
    idx = sub sub n 1 k
    ak = get omg_ev_arr idx
    if ne ak 0
      if or eq wr 0 eq ak 2
        if or eq el 0 eq get omg_ev_el idx el
          omg_allow add OMG_REF_BASE k
        end
      end
    end
  end
end

fn omg_mask_expr t ulong left ulong cc ulong kind ulong to void
  estk_other = ulong 0
  if gt get omg_st 9 0
    estk_other = sub get omg_st 9 1
  end
  avail = omg_avail left cc estk_other
  if eq kind OMG_EK_EXPR_IDX
    omg_mask_refs_ty OMG_TY_U64
    if gt t 0
      omg_allow_range OMG_LIT_BASE add OMG_LIT_BASE sub t 1
    end
    ret
  end
  if and ne get omg_st 20 0 ge get omg_st 21 3
    avail = 1
  end
  if eq t OMG_TY_BOOL
    omg_allow OMG_OP_TRUE
    omg_allow OMG_OP_FALSE
    omg_mask_refs_ty OMG_TY_BOOL
    if ge avail 2
      omg_allow OMG_OP_NOT
    end
    if ge avail 3
      omg_allow OMG_OP_AND
      omg_allow OMG_OP_OR
      omg_allow OMG_OP_XOR
    end
    if ge avail 4
      omg_allow_range OMG_OP_EQ OMG_OP_GE
    end
    if ge avail 2
      if omg_has_fn_ret OMG_TY_BOOL sub avail 1
        omg_allow OMG_OP_CALL
      end
    end
    if omg_has_macro 0 OMG_TY_BOOL left add cc estk_other
      omg_allow OMG_MACRO
    end
    ret
  end
  note Numeric scalar type t
  omg_mask_refs_ty t
  if eq kind OMG_EK_EXPR_NZ
    omg_allow_range add OMG_LIT_BASE 1 add OMG_LIT_BASE 31
    if ge avail 3
      if or or eq t OMG_TY_U8 eq t OMG_TY_U16 or eq t OMG_TY_U32 eq t OMG_TY_U64
        omg_allow OMG_CONST_U8
      end
      if or or eq t OMG_TY_I16 eq t OMG_TY_I32 eq t OMG_TY_I64
        omg_allow OMG_CONST_U8
        omg_allow OMG_CONST_NEG8
      end
    end
    if ge avail 5
      if or or eq t OMG_TY_U16 eq t OMG_TY_U32 or eq t OMG_TY_U64 or eq t OMG_TY_I32 eq t OMG_TY_I64
        omg_allow OMG_CONST_U16
      end
    end
    if ge avail 9
      if or or eq t OMG_TY_U32 eq t OMG_TY_U64 eq t OMG_TY_I64
        omg_allow OMG_CONST_U32
      end
      if eq t OMG_TY_F32
        omg_allow OMG_CONST_F32
      end
    end
    if ge avail 17
      if eq t OMG_TY_U64
        omg_allow OMG_CONST_U64
      end
      if eq t OMG_TY_I64
        omg_allow OMG_CONST_I64
      end
      if eq t OMG_TY_F64
        omg_allow OMG_CONST_F64
      end
    end
    ret
  end
  if eq kind OMG_EK_EXPR_SH
    bw = omg_type_bits t
    hi = add OMG_LIT_BASE 31
    if lt bw 32
      hi = add OMG_LIT_BASE sub bw 1
    end
    omg_allow_range OMG_LIT_BASE hi
    ret
  end
  omg_allow_range OMG_LIT_BASE add OMG_LIT_BASE 31
  if ge avail 3
    if or or eq t OMG_TY_U8 eq t OMG_TY_U16 or eq t OMG_TY_U32 eq t OMG_TY_U64
      omg_allow OMG_CONST_U8
    end
    if or or eq t OMG_TY_I16 eq t OMG_TY_I32 eq t OMG_TY_I64
      omg_allow OMG_CONST_U8
      omg_allow OMG_CONST_NEG8
    end
  end
  if ge avail 5
    if or or eq t OMG_TY_U16 eq t OMG_TY_U32 or eq t OMG_TY_U64 or eq t OMG_TY_I32 eq t OMG_TY_I64
      omg_allow OMG_CONST_U16
    end
  end
  if ge avail 9
    if or or eq t OMG_TY_U32 eq t OMG_TY_U64 eq t OMG_TY_I64
      omg_allow OMG_CONST_U32
    end
    if eq t OMG_TY_F32
      omg_allow OMG_CONST_F32
    end
  end
  if ge avail 17
    if eq t OMG_TY_U64
      omg_allow OMG_CONST_U64
    end
    if eq t OMG_TY_I64
      omg_allow OMG_CONST_I64
    end
    if eq t OMG_TY_F64
      omg_allow OMG_CONST_F64
    end
  end
  if ge avail 2
    omg_allow OMG_OP_NEG
    if omg_is_flt t
      omg_allow OMG_OP_FSQRT
      omg_allow OMG_OP_FABS
    end
    if and eq t OMG_TY_U64 omg_has_arr_any
      omg_allow OMG_OP_LEN
    end
    if omg_has_fn_ret t sub avail 1
      omg_allow OMG_OP_CALL
    end
  end
  if ge avail 3
    omg_allow OMG_OP_ADD
    omg_allow OMG_OP_SUB
    omg_allow OMG_OP_MUL
    omg_allow OMG_OP_DIV
    omg_allow OMG_OP_CAST
    if ge omg_type_bits t 32
      omg_allow OMG_OP_BITCAST
    end
    if omg_is_int t
      omg_allow OMG_OP_REM
      omg_allow OMG_OP_AND
      omg_allow OMG_OP_OR
      omg_allow OMG_OP_XOR
      omg_allow OMG_OP_SHL
      omg_allow OMG_OP_SHR
      if omg_is_uint t
        omg_allow OMG_OP_ROTR
        omg_allow OMG_OP_ROTL
      end
    end
    if omg_is_flt t
      omg_allow OMG_OP_FMIN
      omg_allow OMG_OP_FMAX
    end
    if omg_has_arr_el t 0
      omg_allow OMG_OP_GET
    end
  end
  if and omg_is_flt t ge avail 4
    omg_allow OMG_OP_FMA
  end
  if omg_has_macro 0 t left add cc estk_other
    if or eq get omg_st 20 0 lt get omg_st 21 2
      omg_allow OMG_MACRO
    end
  end
end

fn omg_ret_closes_fn top ulong to bool
  if eq get omg_st 5 OMG_TY_VOID
    ret false
  end
  i = top
  while gt i 0 bound 32
    if or ne get omg_bk i OMG_BK_ELSE ne get omg_bt i 1
      ret false
    end
    i = sub i 1
  end
  ret eq get omg_be 0 0
end

fn omg_mask_stmt_open left ulong cc ulong bk ulong to void
  if eq bk OMG_BK_FN
    if eq get omg_st 5 OMG_TY_VOID
      omg_allow OMG_END
    end
  else
    omg_allow OMG_END
    if eq bk OMG_BK_IF
      if ge left add cc 1
        omg_allow OMG_ELSE
      end
    end
  end
  rn = ulong 1
  if ne get omg_st 5 OMG_TY_VOID
    rn = 2
  end
  if omg_ret_closes_fn sub get omg_st 1 1
    if ge left cc
      omg_allow OMG_RET
    end
  else
    if ge left add cc rn
      omg_allow OMG_RET
    end
  end
  if gt get omg_st 7 0
    if ge left add cc 1
      omg_allow OMG_BREAK
      omg_allow OMG_CONTINUE
    end
  end
  nl = get omg_st 2
  cap = get omg_st 11
  if lt nl cap
    if ge left add cc 3
      omg_allow OMG_LET
    end
    if eq get omg_st 8 0
      if ge left add cc 4
        omg_allow OMG_NEW
      end
    end
  end
  max_b = sub OMG_MAX_BSTK 1
  if ne get omg_st 20 0
    max_b = 3
  end
  if ge left add cc 3
    if omg_has_mut_var
      omg_allow OMG_SET
    end
    if lt get omg_st 1 max_b
      omg_allow OMG_IF
      if ge left add cc 4
        omg_allow OMG_WHILE
        if lt nl cap
          omg_allow OMG_FOR
        end
      end
    end
  end
  if ge left add cc 4
    if omg_has_arr_write
      omg_allow OMG_PUT
    end
  end
  if gt left add cc 1
    if omg_has_fn_ret OMG_TY_VOID sub sub left cc 1
      omg_allow OMG_CALL_VOID
    end
  end
  if omg_has_macro 1 OMG_TY_VOID left cc
    omg_allow OMG_MACRO
  end
end

fn omg_mask_stmt left ulong cc ulong to void
  bsp = get omg_st 1
  if eq bsp 0
    ret
  end
  top = sub bsp 1
  bk = get omg_bk top
  if eq get omg_be top 1
    if eq bk OMG_BK_IF
      if ge left add cc 1
        omg_allow OMG_ELSE
      end
    end
    omg_allow OMG_END
    ret
  end
  omg_mask_stmt_open left cc bk
end

fn omg_mask_call_fn t ulong left ulong cc ulong to void
  nf = get omg_st 3
  af = get omg_st 12
  eo = ulong 0
  if gt get omg_st 9 0
    eo = sub get omg_st 9 1
  end
  avail = omg_avail left cc eo
  for f ulong nf
    if or ne af 0 eq get omg_fn_done f 1
      if eq get omg_fn_ret f t
        np = get omg_fn_np f
        if ge avail add 1 np
          if omg_fn_callable f
            omg_allow add OMG_FN_BASE f
          end
        end
      end
    end
  end
end

fn omg_mask_mac_slot t ulong left ulong cc ulong to void
  mc = get omg_mac_cnt 0
  eo = ulong 0
  if gt get omg_st 9 0
    eo = sub get omg_st 9 1
  end
  avail = omg_avail left cc eo
  kind = ulong 0
  if eq t OMG_TY_VOID
    kind = 1
  end
  for m ulong mc
    if and eq get omg_mac_kind m kind eq get omg_mac_out m t
      if ge avail add 1 get omg_mac_nin m
        omg_allow add OMG_MAC_BASE m
      end
    end
  end
end

fn omg_mask_set_ref to void
  n = get omg_st 2
  for rk ulong n
    idx = sub sub n 1 rk
    if eq get omg_ev_arr idx 0
      if eq get omg_ev_mut idx 1
        omg_allow add OMG_REF_BASE rk
      end
    end
  end
end

fn omg_mask_cast_src t ulong to void
  for ct ulong 10
    ty = add OMG_TY_U8 ct
    if ne ty t
      omg_allow ty
    end
  end
end

fn omg_mask_bitcast_src t ulong to void
  bw = omg_type_bits t
  for ct ulong 10
    ty = add OMG_TY_U8 ct
    if ne ty t
      if eq omg_type_bits ty bw
        omg_allow ty
      end
    end
  end
end

fn omg_valid_mask_aux k ulong t ulong left ulong cc ulong to void
  if eq k OMG_EK_LET_TY
    omg_allow_range OMG_TY_BOOL OMG_TY_F64
    ret
  end
  if eq k OMG_EK_SET_REF
    omg_mask_set_ref
    ret
  end
  if eq k OMG_EK_CMP_TY
    omg_allow_range OMG_TY_BOOL OMG_TY_F64
    ret
  end
  if eq k OMG_EK_CAST_SRC
    omg_mask_cast_src t
    ret
  end
  if eq k OMG_EK_BITCAST_SRC
    omg_mask_bitcast_src t
    ret
  end
  if or eq k OMG_EK_CALL_FN eq k OMG_EK_CALL_VOID_FN
    omg_mask_call_fn t left cc
    ret
  end
  if eq k OMG_EK_ARR_ANY
    omg_mask_refs_arr 0 0
    ret
  end
  if eq k OMG_EK_ARR_OF
    omg_mask_refs_arr t 0
    ret
  end
  if eq k OMG_EK_ARR_WRITE
    omg_mask_refs_arr 0 1
    ret
  end
  if eq k OMG_EK_ARR_WRITE_OF
    omg_mask_refs_arr t 1
    ret
  end
  if eq k OMG_EK_NIB
    omg_allow_range OMG_NIB_BASE add OMG_NIB_BASE 15
    ret
  end
  if eq k OMG_EK_FOR_TY
    omg_allow_range OMG_TY_U8 OMG_TY_I64
    ret
  end
  if eq k OMG_EK_NEW_TY
    omg_allow_range OMG_TY_U8 OMG_TY_F64
    ret
  end
  if eq k OMG_EK_NEW_LEN
    omg_allow_range add OMG_LIT_BASE 1 add OMG_LIT_BASE 16
    ret
  end
  if eq k OMG_EK_BOUND
    omg_allow_range add OMG_LIT_BASE 1 add OMG_LIT_BASE 31
    eo2 = ulong 0
    if gt get omg_st 9 0
      eo2 = sub get omg_st 9 1
    end
    avail = omg_avail left cc eo2
    if ge avail 3
      omg_allow OMG_CONST_U8
    end
    if ge avail 5
      omg_allow OMG_CONST_U16
    end
    if ge avail 9
      omg_allow OMG_CONST_U32
    end
    ret
  end
  if eq k OMG_EK_TRAP_N
    omg_allow_range add OMG_LIT_BASE 1 add OMG_LIT_BASE 14
    ret
  end
  if eq k OMG_EK_MAC_SLOT
    omg_mask_mac_slot t left cc
  end
end

fn omg_valid_mask left ulong to void
  omg_mask_clear
  sp = get omg_st 0
  if eq sp 0
    omg_allow OMG_EOF
    ret
  end
  top = sub sp 1
  k = get omg_ek top
  t = get omg_et top
  cc = omg_close_cost
  if eq k OMG_EK_UNIT_HDR
    omg_allow OMG_BEGIN
    ret
  end
  if eq k OMG_EK_TOP
    if gt get omg_st 3 0
      if or eq get omg_st 20 0 eq get omg_st 10 1
        omg_allow OMG_END_UNIT
      end
    end
    if and lt get omg_st 3 OMG_MAX_FNS ge left 5
      if or eq get omg_st 20 0 or eq get omg_st 10 1 ge left 12
        omg_allow OMG_FN
      end
      if eq get omg_st 10 0
        omg_allow OMG_FN_MAIN
      end
    end
    ret
  end
  if eq k OMG_EK_FN_RET
    omg_allow OMG_TY_VOID
    need_nv = ulong 6
    if and ne get omg_st 20 0 eq get omg_st 10 0
      need_nv = 11
    end
    if ge left need_nv
      omg_allow_range OMG_TY_BOOL OMG_TY_F64
    end
    ret
  end
  if eq k OMG_EK_FN_PARAM
    omg_allow OMG_BODY
    if and lt get omg_st 6 6 ge left add cc 3
      omg_allow OMG_PARAM
    end
    ret
  end
  if eq k OMG_EK_PARAM_TY
    omg_allow_range OMG_TY_BOOL OMG_TY_F64
    if and le add get omg_st 6 2 6 ge left add cc 3
      omg_allow OMG_TY_VIEW
      omg_allow OMG_TY_EDIT
    end
    ret
  end
  if eq k OMG_EK_PARAM_EL
    omg_allow_range OMG_TY_U8 OMG_TY_F64
    ret
  end
  if eq k OMG_EK_STMT
    omg_mask_stmt left cc
    ret
  end
  if or or eq k OMG_EK_EXPR eq k OMG_EK_EXPR_NZ or eq k OMG_EK_EXPR_SH eq k OMG_EK_EXPR_IDX
    omg_mask_expr t left cc k
    ret
  end
  omg_valid_mask_aux k t left cc
end

note ---- O(1) State Transition (omg_step) ----

fn omg_push_nibs cnt ulong to void
  for i ulong cnt
    omg_epush OMG_EK_NIB 0 0
  end
end

fn omg_step_expr_op tok ulong t ulong to void
  if and ge tok OMG_OP_ADD le tok OMG_OP_CALL
    put omg_st 21 add get omg_st 21 1
  end
  if eq tok OMG_OP_NOT
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if or eq tok OMG_OP_NEG or eq tok OMG_OP_FSQRT eq tok OMG_OP_FABS
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if eq tok OMG_OP_LEN
    omg_epush OMG_EK_ARR_ANY 0 0
    ret
  end
  if eq tok OMG_OP_GET
    omg_epush OMG_EK_EXPR OMG_TY_U64 0
    omg_epush OMG_EK_ARR_OF t 1
    ret
  end
  if eq tok OMG_OP_FMA
    omg_epush OMG_EK_EXPR t 0
    omg_epush OMG_EK_EXPR t 0
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if eq tok OMG_OP_CAST
    omg_epush OMG_EK_CAST_SRC t 0
    ret
  end
  if eq tok OMG_OP_BITCAST
    omg_epush OMG_EK_BITCAST_SRC t 0
    ret
  end
  if eq tok OMG_OP_CALL
    omg_epush OMG_EK_CALL_FN t 0
    ret
  end
  if and ge tok OMG_OP_EQ le tok OMG_OP_GE
    omg_epush OMG_EK_CMP_TY 0 0
    ret
  end
  if or eq tok OMG_OP_DIV eq tok OMG_OP_REM
    omg_epush OMG_EK_EXPR_NZ t 0
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if or or eq tok OMG_OP_SHL eq tok OMG_OP_SHR or eq tok OMG_OP_ROTR eq tok OMG_OP_ROTL
    omg_epush OMG_EK_EXPR_SH t 0
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if and ge tok OMG_OP_ADD le tok OMG_OP_FMAX
    omg_epush OMG_EK_EXPR t 0
    omg_epush OMG_EK_EXPR t 0
    ret
  end
  if or eq tok OMG_CONST_U8 eq tok OMG_CONST_NEG8
    omg_push_nibs 2
    ret
  end
  if eq tok OMG_CONST_U16
    omg_push_nibs 4
    ret
  end
  if or eq tok OMG_CONST_U32 eq tok OMG_CONST_F32
    omg_push_nibs 8
    ret
  end
  if or or eq tok OMG_CONST_U64 eq tok OMG_CONST_I64 eq tok OMG_CONST_F64
    omg_push_nibs 16
    ret
  end
  if eq tok OMG_MACRO
    put omg_st 21 add get omg_st 21 2
    omg_epush OMG_EK_MAC_SLOT t 0
    ret
  end
end

fn omg_close_block to void
  bsp = sub get omg_st 1 1
  bk = get omg_bk bsp
  ended = get omg_be bsp
  then_e = get omg_bt bsp
  base = get omg_bs bsp
  omg_env_pop_to base
  put omg_st 1 bsp
  if eq bk OMG_BK_FN
    cf = get omg_st 4
    put omg_fn_done cf 1
    put omg_st 8 0
    put omg_st 7 0
    omg_epush OMG_EK_TOP 0 0
    ret
  end
  if gt get omg_st 8 0
    put omg_st 8 sub get omg_st 8 1
  end
  if or eq bk OMG_BK_WHILE eq bk OMG_BK_FOR
    if gt get omg_st 7 0
      put omg_st 7 sub get omg_st 7 1
    end
  end
  if eq bk OMG_BK_ELSE
    if and eq then_e 1 eq ended 1
      if gt bsp 0
        put omg_be sub bsp 1 1
      end
    end
  end
end

fn omg_step_stmt tok ulong to void
  put omg_st 21 0
  bsp = sub get omg_st 1 1
  if eq tok OMG_END
    omg_epop
    omg_close_block
    ret
  end
  if eq tok OMG_ELSE
    omg_env_pop_to get omg_bs bsp
    put omg_bt bsp get omg_be bsp
    put omg_be bsp 0
    put omg_bk bsp OMG_BK_ELSE
    ret
  end
  if eq tok OMG_RET
    put omg_be bsp 1
    rt = get omg_st 5
    if ne rt OMG_TY_VOID
      omg_epush OMG_EK_EXPR rt 0
    end
    ret
  end
  if or eq tok OMG_BREAK eq tok OMG_CONTINUE
    put omg_be bsp 1
    ret
  end
  if eq tok OMG_TRAP
    put omg_be bsp 1
    omg_epush OMG_EK_TRAP_N 0 0
    ret
  end
  if eq tok OMG_EXIT
    put omg_be bsp 1
    omg_epush OMG_EK_EXPR OMG_TY_I32 0
    ret
  end
  if eq tok OMG_LET
    omg_epush OMG_EK_LET_TY 0 0
    ret
  end
  if eq tok OMG_SET
    omg_epush OMG_EK_SET_REF 0 0
    ret
  end
  if eq tok OMG_IF
    omg_bpush OMG_BK_IF
    put omg_st 8 add get omg_st 8 1
    omg_epush OMG_EK_STMT 0 0
    omg_epush OMG_EK_EXPR OMG_TY_BOOL 0
    ret
  end
  if eq tok OMG_WHILE
    omg_bpush OMG_BK_WHILE
    put omg_st 8 add get omg_st 8 1
    put omg_st 7 add get omg_st 7 1
    omg_epush OMG_EK_STMT 0 0
    omg_epush OMG_EK_BOUND 0 0
    omg_epush OMG_EK_EXPR OMG_TY_BOOL 0
    ret
  end
  if eq tok OMG_FOR
    omg_bpush OMG_BK_FOR
    put omg_st 8 add get omg_st 8 1
    put omg_st 7 add get omg_st 7 1
    omg_epush OMG_EK_STMT 0 0
    omg_epush OMG_EK_FOR_TY 0 0
    ret
  end
  if eq tok OMG_NEW
    omg_epush OMG_EK_NEW_TY 0 0
    ret
  end
  if eq tok OMG_PUT
    omg_epush OMG_EK_EXPR 0 0
    omg_epush OMG_EK_EXPR OMG_TY_U64 0
    omg_epush OMG_EK_ARR_WRITE 0 0
    ret
  end
  if eq tok OMG_CALL_VOID
    omg_epush OMG_EK_CALL_VOID_FN OMG_TY_VOID 0
    ret
  end
  if eq tok OMG_MACRO
    omg_epush OMG_EK_MAC_SLOT OMG_TY_VOID 0
    ret
  end
end

fn omg_push_call_args f ulong to void
  np = get omg_fn_np f
  for i ulong np
    p = sub sub np 1 i
    pk = get omg_fn_pk add mul f 6 p
    pt = get omg_fn_pt add mul f 6 p
    pe = get omg_fn_pe add mul f 6 p
    if eq pk 0
      omg_epush OMG_EK_EXPR pt 0
    else
      if eq pk 1
        omg_epush OMG_EK_ARR_OF pe 0
      else
        omg_epush OMG_EK_ARR_WRITE_OF pe 0
      end
    end
  end
end

fn omg_drain_hooks to void
  while gt get omg_st 0 0 bound 128
    sp = get omg_st 0
    k = get omg_ek sub sp 1
    if eq k OMG_EK_LET_PUSH
      ty = get omg_et sub sp 1
      omg_epop
      omg_env_push ty 1 0 0
    else
      if eq k OMG_EK_FOR_PUSH
        ty = get omg_et sub sp 1
        omg_epop
        omg_env_push ty 0 0 0
      else
        if eq k OMG_EK_NEW_PUSH
          ty = get omg_et sub sp 1
          omg_epop
          omg_env_push_len ty 0 2 ty get omg_st 15
        else
          break
        end
      end
    end
  end
end

fn omg_step_fn_sig k ulong tok ulong to long
  if eq k OMG_EK_FN_RET
    omg_epop
    cf = get omg_st 4
    put omg_fn_ret cf tok
    put omg_st 5 tok
    omg_epush OMG_EK_FN_PARAM 0 0
    ret 0
  end
  if eq k OMG_EK_FN_PARAM
    if eq tok OMG_BODY
      omg_epop
      omg_epush OMG_EK_STMT 0 0
      ret 0
    end
    omg_epush OMG_EK_PARAM_TY 0 0
    ret 0
  end
  if eq k OMG_EK_PARAM_TY
    omg_epop
    cf = get omg_st 4
    np = get omg_fn_np cf
    if or eq tok OMG_TY_VIEW eq tok OMG_TY_EDIT
      pk = ulong 1
      if eq tok OMG_TY_EDIT
        pk = 2
      end
      put omg_fn_pk add mul cf 6 np pk
      put omg_st 6 add get omg_st 6 2
      omg_epush OMG_EK_PARAM_EL 0 pk
    else
      put omg_fn_pk add mul cf 6 np 0
      put omg_fn_pt add mul cf 6 np tok
      put omg_fn_np cf add np 1
      put omg_st 6 add get omg_st 6 1
      omg_env_push tok 1 0 0
    end
    ret 0
  end
  if eq k OMG_EK_PARAM_EL
    pk = get omg_ea sub get omg_st 0 1
    omg_epop
    cf = get omg_st 4
    np = get omg_fn_np cf
    pt = OMG_TY_VIEW
    if eq pk 2
      pt = OMG_TY_EDIT
    end
    put omg_fn_pt add mul cf 6 np pt
    put omg_fn_pe add mul cf 6 np tok
    put omg_fn_np cf add np 1
    omg_env_push pt 0 pk tok
    ret 0
  end
  ret -1
end

fn omg_step_decl_aux k ulong tok ulong to long
  if eq k OMG_EK_LET_TY
    omg_epop
    omg_epush OMG_EK_LET_PUSH tok 0
    omg_epush OMG_EK_EXPR tok 0
    ret 0
  end
  if eq k OMG_EK_SET_REF
    omg_epop
    rk = sub tok OMG_REF_BASE
    idx = sub sub get omg_st 2 1 rk
    ty = get omg_ev_ty idx
    omg_epush OMG_EK_EXPR ty 0
    ret 0
  end
  if eq k OMG_EK_CMP_TY
    omg_epop
    omg_epush OMG_EK_EXPR tok 0
    omg_epush OMG_EK_EXPR tok 0
    ret 0
  end
  if or eq k OMG_EK_CAST_SRC eq k OMG_EK_BITCAST_SRC
    omg_epop
    omg_epush OMG_EK_EXPR tok 0
    ret 0
  end
  if eq k OMG_EK_FOR_TY
    omg_epop
    omg_epush OMG_EK_FOR_PUSH tok 0
    omg_epush OMG_EK_EXPR tok 0
    ret 0
  end
  if eq k OMG_EK_NEW_TY
    omg_epop
    omg_epush OMG_EK_NEW_PUSH tok 0
    omg_epush OMG_EK_EXPR tok 0
    omg_epush OMG_EK_NEW_LEN 0 0
    ret 0
  end
  if eq k OMG_EK_NEW_LEN
    omg_epop
    put omg_st 15 sub tok OMG_LIT_BASE
    ret 0
  end
  if eq k OMG_EK_BOUND
    omg_epop
    if eq tok OMG_CONST_U8
      omg_push_nibs 2
    else
      if eq tok OMG_CONST_U16
        omg_push_nibs 4
      else
        if eq tok OMG_CONST_U32
          omg_push_nibs 8
        end
      end
    end
    ret 0
  end
  if eq k OMG_EK_TRAP_N
    omg_epop
    ret 0
  end
  ret -1
end

fn omg_step tok ulong to long
  sp = get omg_st 0
  if eq sp 0
    if eq tok OMG_EOF
      ret 0
    end
    ret 1
  end
  top = sub sp 1
  k = get omg_ek top
  t = get omg_et top
  if eq k OMG_EK_UNIT_HDR
    if ne tok OMG_BEGIN
      ret 2
    end
    omg_epop
    omg_epush OMG_EK_TOP 0 0
    ret 0
  end
  if eq k OMG_EK_TOP
    omg_epop
    if eq tok OMG_END_UNIT
      put omg_st 17 1
      ret 0
    end
    cf = get omg_st 3
    put omg_st 3 add cf 1
    put omg_st 4 cf
    put omg_st 2 0
    put omg_st 6 0
    put omg_st 8 0
    put omg_st 7 0
    put omg_fn_np cf 0
    put omg_fn_done cf 0
    if eq tok OMG_FN_MAIN
      put omg_fn_main cf 1
      put omg_fn_ret cf OMG_TY_I32
      put omg_st 5 OMG_TY_I32
      put omg_st 10 1
      omg_bpush OMG_BK_FN
      omg_epush OMG_EK_STMT 0 0
    else
      put omg_fn_main cf 0
      put omg_fn_ret cf OMG_TY_VOID
      put omg_st 5 OMG_TY_VOID
      omg_bpush OMG_BK_FN
      omg_epush OMG_EK_FN_RET 0 0
    end
    ret 0
  end
  if eq k OMG_EK_STMT
    omg_step_stmt tok
    omg_drain_hooks
    ret 0
  end
  if or or eq k OMG_EK_EXPR eq k OMG_EK_EXPR_NZ or eq k OMG_EK_EXPR_SH eq k OMG_EK_EXPR_IDX
    omg_epop
    omg_step_expr_op tok t
    omg_drain_hooks
    ret 0
  end
  if or or eq k OMG_EK_FN_RET eq k OMG_EK_FN_PARAM or eq k OMG_EK_PARAM_TY eq k OMG_EK_PARAM_EL
    rc = omg_step_fn_sig k tok
    omg_drain_hooks
    ret rc
  end
  if or eq k OMG_EK_CALL_FN eq k OMG_EK_CALL_VOID_FN
    omg_epop
    f = sub tok OMG_FN_BASE
    omg_push_call_args f
    omg_drain_hooks
    ret 0
  end
  if eq k OMG_EK_ARR_WRITE
    omg_epop
    rk = sub tok OMG_REF_BASE
    idx = sub sub get omg_st 2 1 rk
    el = get omg_ev_el idx
    alen = get omg_ev_len idx
    sp_now = get omg_st 0
    put omg_et sub sp_now 2 el
    if gt alen 0
      put omg_ek sub sp_now 1 OMG_EK_EXPR_IDX
      put omg_et sub sp_now 1 alen
    end
    omg_drain_hooks
    ret 0
  end
  if eq k OMG_EK_ARR_OF
    is_get = get omg_ea sub get omg_st 0 1
    omg_epop
    if eq is_get 1
      rk2 = sub tok OMG_REF_BASE
      idx2 = sub sub get omg_st 2 1 rk2
      alen2 = get omg_ev_len idx2
      if gt alen2 0
        sp_now2 = get omg_st 0
        put omg_ek sub sp_now2 1 OMG_EK_EXPR_IDX
        put omg_et sub sp_now2 1 alen2
      end
    end
    omg_drain_hooks
    ret 0
  end
  if or eq k OMG_EK_ARR_ANY eq k OMG_EK_ARR_WRITE_OF
    omg_epop
    omg_drain_hooks
    ret 0
  end
  if eq k OMG_EK_NIB
    omg_epop
    omg_drain_hooks
    ret 0
  end
  if eq k OMG_EK_MAC_SLOT
    omg_epop
    m = sub tok OMG_MAC_BASE
    nin = get omg_mac_nin m
    for mi ulong nin
      p = sub sub nin 1 mi
      it = get omg_mac_in add mul m 4 p
      omg_epush OMG_EK_EXPR it 0
    end
    omg_drain_hooks
    ret 0
  end
  rc2 = omg_step_decl_aux k tok
  omg_drain_hooks
  ret rc2
end

fn omg_validate to long
  n = get omg_ntok 0
  if eq n 0
    ret 10
  end
  omg_init
  for i ulong n
    tok = ulong get omg_toks i
    if ge tok OMG_VOCAB
      put omg_st 13 11
      put omg_st 14 i
      ret 11
    end
    omg_valid_mask sub n i
    if eq get omg_mask tok 0
      put omg_st 13 12
      put omg_st 14 i
      ret 12
    end
    rc = omg_step tok
    if ne rc 0
      put omg_st 13 13
      put omg_st 14 i
      ret 13
    end
    if ne get omg_st 13 0
      put omg_st 14 i
      ret long get omg_st 13
    end
  end
  if or ne get omg_st 0 0 ne get omg_st 1 0
    ret 14
  end
  if eq get omg_st 17 0
    ret 15
  end
  ret 0
end

note ---- Macro Dictionary & Expansion ----

fn omg_mac_hash kind ulong out_t ulong nin ulong mlen ulong to ulong
  h = ulong 14695981039346656037
  h = mul xor h kind 1099511628211
  h = mul xor h out_t 1099511628211
  h = mul xor h nin 1099511628211
  for i ulong nin
    h = mul xor h get omg_mac_tmp_in i 1099511628211
  end
  for j ulong mlen
    h = mul xor h ulong get omg_mac_tmp_tok j 1099511628211
  end
  ret h
end

fn omg_macro_lookup sem_id ulong to ulong
  mc = get omg_mac_cnt 0
  for m ulong mc
    if eq get omg_mac_id m sem_id
      ret m
    end
  end
  ret 65535
end

fn omg_macro_register kind ulong out_t ulong nin ulong to long
  mlen = get omg_mac_tmp_len 0
  if or gt nin 4 eq mlen 0
    ret -1
  end
  sid = omg_mac_hash kind out_t nin mlen
  ex = omg_macro_lookup sid
  if ne ex 65535
    ret long ex
  end
  mc = get omg_mac_cnt 0
  if ge mc OMG_MAX_MACS
    ret -2
  end
  pcur = get omg_mac_pcur 0
  if gt add pcur mlen 4096
    ret -3
  end
  put omg_mac_id mc sid
  put omg_mac_kind mc kind
  put omg_mac_out mc out_t
  put omg_mac_nin mc nin
  for i ulong nin
    put omg_mac_in add mul mc 4 i get omg_mac_tmp_in i
  end
  put omg_mac_off mc pcur
  put omg_mac_len mc mlen
  for j ulong mlen
    put omg_mac_pool add pcur j get omg_mac_tmp_tok j
  end
  put omg_mac_pcur 0 add pcur mlen
  put omg_mac_cnt 0 add mc 1
  ret long mc
end

note Measure token span of one complete expression starting at omg_toks[pos]
fn omg_expr_span pos ulong lim ulong to ulong
  need = ulong 1
  p = pos
  while and gt need 0 lt p lim bound 4096
    tk = ulong get omg_toks p
    p = add p 1
    need = sub need 1
    if or eq tk OMG_OP_NOT or eq tk OMG_OP_NEG or eq tk OMG_OP_FSQRT or eq tk OMG_OP_FABS eq tk OMG_OP_LEN
      need = add need 1
    else
      if or eq tk OMG_OP_CAST eq tk OMG_OP_BITCAST
        p = add p 1
        need = add need 1
      else
        if and ge tk OMG_OP_EQ le tk OMG_OP_GE
          p = add p 1
          need = add need 2
        else
          if eq tk OMG_OP_FMA
            need = add need 3
          else
            if eq tk OMG_OP_CALL
              if lt p lim
                fn_i = sub ulong get omg_toks p OMG_FN_BASE
                p = add p 1
                if lt fn_i OMG_MAX_FNS
                  need = add need get omg_fn_np fn_i
                end
              end
            else
              if and ge tk OMG_OP_ADD le tk OMG_OP_FMAX
                need = add need 2
              else
                if eq tk OMG_OP_GET
                  need = add need 2
                else
                  if or eq tk OMG_CONST_U8 eq tk OMG_CONST_NEG8
                    p = add p 2
                  else
                    if eq tk OMG_CONST_U16
                      p = add p 4
                    else
                      if or eq tk OMG_CONST_U32 eq tk OMG_CONST_F32
                        p = add p 8
                      else
                        if or or eq tk OMG_CONST_U64 eq tk OMG_CONST_I64 eq tk OMG_CONST_F64
                          p = add p 16
                        else
                          if eq tk OMG_MACRO
                            if lt p lim
                              mc = sub ulong get omg_toks p OMG_MAC_BASE
                              p = add p 1
                              if lt mc OMG_MAX_MACS
                                need = add need get omg_mac_nin mc
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  end
  ret sub p pos
end

fn omg_exp_emit tok ulong to void
  ne_ = get omg_nexp 0
  if lt ne_ OMG_MAX_TOKS
    put omg_exp_buf ne_ ushort tok
    put omg_nexp 0 add ne_ 1
  end
end

global omg_aoff ulong 4
global omg_alen ulong 4

fn omg_expand_stmt_args m ulong nin ulong to void
  for li ulong nin
    omg_exp_emit OMG_LET
    omg_exp_emit get omg_mac_in add mul m 4 li
    ao = get omg_aoff li
    al = get omg_alen li
    for k ulong al
      xt = ulong get omg_toks add ao k
      if and ge xt OMG_REF_BASE lt xt add OMG_REF_BASE 64
        xt = add xt li
      end
      omg_exp_emit xt
    end
  end
end

fn omg_expand_copy_arg idx ulong to void
  ao = get omg_aoff idx
  al = get omg_alen idx
  for k ulong al
    omg_exp_emit ulong get omg_toks add ao k
  end
end

fn omg_mac_expr_delta tk ulong to ulong
  if or eq tk OMG_OP_NOT or eq tk OMG_OP_NEG or eq tk OMG_OP_FSQRT or eq tk OMG_OP_FABS eq tk OMG_OP_LEN
    ret 1
  end
  if or eq tk OMG_OP_CAST eq tk OMG_OP_BITCAST
    ret 1
  end
  if eq tk OMG_OP_FMA
    ret 3
  end
  if or and ge tk OMG_OP_ADD le tk OMG_OP_FMAX or and ge tk OMG_OP_EQ le tk OMG_OP_GE eq tk OMG_OP_GET
    ret 2
  end
  ret 0
end

global omg_mac_lst ulong 3

fn omg_mac_let_step mt ulong to void
  st_ = get omg_mac_lst 1
  if eq st_ 1
    put omg_mac_lst 1 2
    put omg_mac_lst 2 1
    ret
  end
  if eq st_ 2
    if or eq mt OMG_OP_CAST eq mt OMG_OP_BITCAST
      put omg_mac_lst 1 3
    else
      if and ge mt OMG_OP_EQ le mt OMG_OP_GE
        put omg_mac_lst 1 3
      end
    end
    nd = add sub get omg_mac_lst 2 1 omg_mac_expr_delta mt
    put omg_mac_lst 2 nd
    if eq nd 0
      put omg_mac_lst 1 0
      put omg_mac_lst 0 add get omg_mac_lst 0 1
    end
    ret
  end
  if eq st_ 3
    put omg_mac_lst 1 2
    ret
  end
  if eq mt OMG_LET
    put omg_mac_lst 1 1
  end
end

fn omg_expand_body m ulong nin ulong to void
  moff = get omg_mac_off m
  mlen = get omg_mac_len m
  kind = get omg_mac_kind m
  put omg_mac_lst 0 0
  put omg_mac_lst 1 0
  put omg_mac_lst 2 0
  for mi ulong mlen
    mt = ulong get omg_mac_pool add moff mi
    if ge mt 256
      idx = sub mt 256
      if eq kind 0
        omg_expand_copy_arg idx
      else
        ld = get omg_mac_lst 0
        omg_exp_emit add OMG_REF_BASE add ld sub sub nin 1 idx
      end
    else
      omg_exp_emit mt
    end
    omg_mac_let_step mt
  end
end

fn omg_expand_one m ulong pos ulong n ulong to ulong
  p = pos
  nin = get omg_mac_nin m
  for ai ulong nin
    sp = omg_expr_span p n
    put omg_aoff ai p
    put omg_alen ai sp
    p = add p sp
  end
  if eq get omg_mac_kind m 1
    omg_exp_emit OMG_IF
    omg_exp_emit OMG_OP_TRUE
    omg_expand_stmt_args m nin
    omg_expand_body m nin
    omg_exp_emit OMG_END
  else
    omg_expand_body m nin
  end
  ret p
end

fn omg_macro_expand to long
  for pass_i ulong 8
    n = get omg_ntok 0
    has_mac = false
    for c ulong n
      if eq ulong get omg_toks c OMG_MACRO
        has_mac = true
        break
      end
    end
    if not has_mac
      ret 0
    end
    put omg_nexp 0 0
    p = ulong 0
    while lt p n bound 16384
      tk = ulong get omg_toks p
      if ne tk OMG_MACRO
        omg_exp_emit tk
        p = add p 1
        continue
      end
      if ge add p 1 n
        ret -1
      end
      m = sub ulong get omg_toks add p 1 OMG_MAC_BASE
      if ge m get omg_mac_cnt 0
        ret -2
      end
      p = omg_expand_one m add p 2 n
    end
    ne2 = get omg_nexp 0
    for z ulong ne2
      put omg_toks z get omg_exp_buf z
    end
    put omg_ntok 0 ne2
  end
  ret 0
end

note ---- Semantic ID (64-bit FNV-1a + 256-bit digest) & OMGC Corpus Packer ----

fn omg_semantic_id to ulong
  rc_exp = omg_macro_expand
  n = get omg_ntok 0
  h0 = ulong 14695981039346656037
  h1 = ulong 7309815423918472513
  h2 = ulong 11400714819323198485
  h3 = ulong 13787848793156543929
  for i ulong n
    t = ulong get omg_toks i
    lo = and t 255
    hi = shr t 8
    h0 = mul xor h0 lo 1099511628211
    h0 = mul xor h0 hi 1099511628211
    h1 = smx xor h1 add mul i 65537 t
    h2 = mul xor h2 add t mul i 131 10723151780598845931
    h3 = smx xor h3 xor mul t 2654435761 h0
  end
  put omg_sem_hash 0 h0
  put omg_sem_hash 1 h1
  put omg_sem_hash 2 h2
  put omg_sem_hash 3 h3
  ret h0
end

fn omg_encode_stream to ulong
  n = get omg_ntok 0
  for i ulong n
    t = ulong get omg_toks i
    o = mul i 2
    if lt add o 1 OMG_MAX_CORP
      put omg_corpus o uchar and t 255
      put omg_corpus add o 1 uchar and shr t 8 255
    end
  end
  put omg_ncorp 0 mul n 2
  ret mul n 2
end

fn omg_corp_reset to void
  put omg_ncorp 0 0
  put omg_corp_nrec 0 0
  put omg_corp_ntok 0 0
end

fn omg_corp_put4 pos ulong v ulong to void
  for k ulong 4
    put omg_corpus add pos k uchar and shr v mul k 8 255
  end
end

fn omg_corp_put8 pos ulong v ulong to void
  for k ulong 8
    put omg_corpus add pos k uchar and shr v mul k 8 255
  end
end

note Add current omg_toks to corpus with semantic deduplication; returns 1 added, 0 duplicate, -1 full
fn omg_corpus_add to long
  sid = omg_semantic_id
  nr = get omg_corp_nrec 0
  for r ulong nr
    if eq get omg_corp_ids r sid
      ret 0
    end
  end
  nt = get omg_ntok 0
  ct = get omg_corp_ntok 0
  if or ge nr 4096 gt add ct nt 262144
    ret -1
  end
  for i ulong nt
    put omg_corp_toks add ct i get omg_toks i
  end
  put omg_corp_ids nr sid
  put omg_corp_offs nr ct
  put omg_corp_lens nr nt
  put omg_corp_nrec 0 add nr 1
  put omg_corp_ntok 0 add ct nt
  ret 1
end

note Pack OMGC binary corpus header + directory + u16 records into omg_corpus
note Layout: [u32 "OMGC", u32 ver=1, u32 n_rec, u32 total_toks] (16 bytes)
note + n_rec * [u64 sem_id, u32 tok_off, u32 tok_len] (16 bytes each)
note + total_toks * u16 LE tokens
fn omg_pack_corpus to ulong
  nr = get omg_corp_nrec 0
  total_t = get omg_corp_ntok 0
  hdr_sz = add 16 mul nr 16
  if gt add hdr_sz mul total_t 2 OMG_MAX_CORP
    ret 0
  end
  note "OMGC" LE = 0x43474d4f
  omg_corp_put4 0 0x43474d4f
  omg_corp_put4 4 1
  omg_corp_put4 8 nr
  omg_corp_put4 12 total_t
  for r ulong nr
    ro = add 16 mul r 16
    omg_corp_put8 ro get omg_corp_ids r
    omg_corp_put4 add ro 8 get omg_corp_offs r
    omg_corp_put4 add ro 12 get omg_corp_lens r
  end
  for i ulong total_t
    tk = ulong get omg_corp_toks i
    bo = add hdr_sz mul i 2
    put omg_corpus bo uchar and tk 255
    put omg_corpus add bo 1 uchar and shr tk 8 255
  end
  put omg_ncorp 0 add hdr_sz mul total_t 2
  ret get omg_ncorp 0
end

note ---- .om Source Parser (omg_parse_om) ----

fn omg_emit tok ulong to void
  n = get omg_ntok 0
  if lt n OMG_MAX_TOKS
    put omg_toks n ushort tok
    put omg_ntok 0 add n 1
  end
end

fn omg_tok_eq off ulong tlen ulong s view uchar * to bool
  if ne tlen len s
    ret false
  end
  for i ulong tlen
    if ne get omg_src add off i get s i
      ret false
    end
  end
  ret true
end

fn omg_tok_eq2 aoff ulong alen ulong boff ulong blen ulong to bool
  if ne alen blen
    ret false
  end
  for i ulong alen
    if ne get omg_src add aoff i get omg_src add boff i
      ret false
    end
  end
  ret true
end

