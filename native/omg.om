fn omg_parse_type off ulong tlen ulong to ulong
  if omg_tok_eq off tlen omg_s_void
    ret OMG_TY_VOID
  end
  if omg_tok_eq off tlen omg_s_bool
    ret OMG_TY_BOOL
  end
  if or omg_tok_eq off tlen omg_s_uchar omg_tok_eq off tlen omg_s_u8
    ret OMG_TY_U8
  end
  if or omg_tok_eq off tlen omg_s_ushort omg_tok_eq off tlen omg_s_u16
    ret OMG_TY_U16
  end
  if or omg_tok_eq off tlen omg_s_uint omg_tok_eq off tlen omg_s_u32
    ret OMG_TY_U32
  end
  if or omg_tok_eq off tlen omg_s_ulong omg_tok_eq off tlen omg_s_u64
    ret OMG_TY_U64
  end
  if or omg_tok_eq off tlen omg_s_byte omg_tok_eq off tlen omg_s_i8
    ret OMG_TY_I8
  end
  if or omg_tok_eq off tlen omg_s_short omg_tok_eq off tlen omg_s_i16
    ret OMG_TY_I16
  end
  if or omg_tok_eq off tlen omg_s_int omg_tok_eq off tlen omg_s_i32
    ret OMG_TY_I32
  end
  if or omg_tok_eq off tlen omg_s_long omg_tok_eq off tlen omg_s_i64
    ret OMG_TY_I64
  end
  if omg_tok_eq off tlen omg_s_f32
    ret OMG_TY_F32
  end
  if omg_tok_eq off tlen omg_s_f64
    ret OMG_TY_F64
  end
  ret 0
end

fn omg_parse_op off ulong tlen ulong to ulong
  if omg_tok_eq off tlen omg_s_add
    ret OMG_OP_ADD
  end
  if omg_tok_eq off tlen omg_s_sub
    ret OMG_OP_SUB
  end
  if omg_tok_eq off tlen omg_s_mul
    ret OMG_OP_MUL
  end
  if omg_tok_eq off tlen omg_s_div
    ret OMG_OP_DIV
  end
  if omg_tok_eq off tlen omg_s_rem
    ret OMG_OP_REM
  end
  if omg_tok_eq off tlen omg_s_and
    ret OMG_OP_AND
  end
  if omg_tok_eq off tlen omg_s_or
    ret OMG_OP_OR
  end
  if omg_tok_eq off tlen omg_s_xor
    ret OMG_OP_XOR
  end
  if omg_tok_eq off tlen omg_s_shl
    ret OMG_OP_SHL
  end
  if omg_tok_eq off tlen omg_s_shr
    ret OMG_OP_SHR
  end
  if omg_tok_eq off tlen omg_s_rotr
    ret OMG_OP_ROTR
  end
  if omg_tok_eq off tlen omg_s_rotl
    ret OMG_OP_ROTL
  end
  if omg_tok_eq off tlen omg_s_fmin
    ret OMG_OP_FMIN
  end
  if omg_tok_eq off tlen omg_s_fmax
    ret OMG_OP_FMAX
  end
  if omg_tok_eq off tlen omg_s_eq
    ret OMG_OP_EQ
  end
  if omg_tok_eq off tlen omg_s_ne
    ret OMG_OP_NE
  end
  if omg_tok_eq off tlen omg_s_lt
    ret OMG_OP_LT
  end
  if omg_tok_eq off tlen omg_s_le
    ret OMG_OP_LE
  end
  if omg_tok_eq off tlen omg_s_gt
    ret OMG_OP_GT
  end
  if omg_tok_eq off tlen omg_s_ge
    ret OMG_OP_GE
  end
  if omg_tok_eq off tlen omg_s_neg
    ret OMG_OP_NEG
  end
  if omg_tok_eq off tlen omg_s_not
    ret OMG_OP_NOT
  end
  if omg_tok_eq off tlen omg_s_fsqrt
    ret OMG_OP_FSQRT
  end
  if omg_tok_eq off tlen omg_s_fabs
    ret OMG_OP_FABS
  end
  if omg_tok_eq off tlen omg_s_len
    ret OMG_OP_LEN
  end
  if omg_tok_eq off tlen omg_s_get
    ret OMG_OP_GET
  end
  if omg_tok_eq off tlen omg_s_fma
    ret OMG_OP_FMA
  end
  if omg_tok_eq off tlen omg_s_bitcast
    ret OMG_OP_BITCAST
  end
  ret 0
end

fn omg_find_var off ulong tlen ulong to long
  n = get omg_st 2
  for k ulong n
    idx = sub sub n 1 k
    if omg_tok_eq2 off tlen get omg_sym_off idx get omg_sym_len idx
      ret long idx
    end
  end
  ret -1
end

fn omg_find_fn off ulong tlen ulong to long
  nf = get omg_st 3
  for f ulong nf
    if omg_tok_eq2 off tlen get omg_fn_noff f get omg_fn_nlen f
      ret long f
    end
  end
  ret -1
end

fn omg_is_ws c ulong to bool
  ret or or eq c 32 eq c 9 eq c 13
end

fn omg_tok_line a ulong b ulong to ulong
  put omg_nltok 0 0
  p = a
  while lt p b bound 4096
    while lt p b bound 4096
      ch = ulong get omg_src p
      if and not omg_is_ws ch and ne ch 40 ne ch 41
        break
      end
      p = add p 1
    end
    if ge p b
      break
    end
    st = p
    while lt p b bound 4096
      ch2 = ulong get omg_src p
      if or omg_is_ws ch2 or eq ch2 40 eq ch2 41
        break
      end
      p = add p 1
    end
    nt = get omg_nltok 0
    if lt nt 64
      put omg_ltok_off nt st
      put omg_ltok_len nt sub p st
      put omg_nltok 0 add nt 1
    end
  end
  ret get omg_nltok 0
end

fn omg_next_line cur ulong to ulong
  n = get omg_nsrc 0
  p = cur
  while lt p n bound 65536
    if eq ulong get omg_src p 10
      ret add p 1
    end
    p = add p 1
  end
  ret n
end

fn omg_line_end cur ulong to ulong
  n = get omg_nsrc 0
  p = cur
  while lt p n bound 65536
    if eq ulong get omg_src p 10
      ret p
    end
    p = add p 1
  end
  ret n
end

fn omg_is_num_lit off ulong tlen ulong to bool
  if eq tlen 0
    ret false
  end
  c0 = ulong get omg_src off
  if eq c0 45
    if eq tlen 1
      ret false
    end
    c1 = ulong get omg_src add off 1
    ret and ge c1 48 le c1 57
  end
  ret and ge c0 48 le c0 57
end

fn omg_is_flt_lit off ulong tlen ulong to bool
  if not omg_is_num_lit off tlen
    ret false
  end
  if ge tlen 2
    if and eq ulong get omg_src off 48 eq ulong get omg_src add off 1 120
      ret false
    end
  end
  for i ulong tlen
    if eq ulong get omg_src add off i 46
      ret true
    end
  end
  ret false
end

fn omg_parse_u64 off ulong tlen ulong to ulong
  if ge tlen 3
    if and eq ulong get omg_src off 48 eq ulong get omg_src add off 1 120
      v = ulong 0
      for i ulong sub tlen 2
        ch = ulong get omg_src add add off 2 i
        d = ulong 0
        if and ge ch 48 le ch 57
          d = sub ch 48
        else
          d = add sub ch 97 10
        end
        v = or shl v 4 d
      end
      ret v
    end
  end
  v2 = ulong 0
  for j ulong tlen
    c = ulong get omg_src add off j
    if and ge c 48 le c 57
      v2 = add mul v2 10 sub c 48
    end
  end
  ret v2
end

fn omg_parse_i64 off ulong tlen ulong to long
  if eq ulong get omg_src off 45
    u = omg_parse_u64 add off 1 sub tlen 1
    if eq u 9223372036854775808
      ret -9223372036854775808
    end
    ret neg long u
  end
  ret long omg_parse_u64 off tlen
end

fn omg_parse_f64 off ulong tlen ulong to f64
  negf = false
  st = ulong 0
  if eq ulong get omg_src off 45
    negf = true
    st = 1
  end
  end_i = tlen
  if ge tlen 3
    if eq ulong get omg_src sub add off tlen 3 102
      end_i = sub tlen 3
    end
  end
  ip = 0.0f64
  fp = 0.0f64
  divp = 1.0f64
  dot = false
  i = st
  while lt i end_i bound 64
    ch = ulong get omg_src add off i
    if eq ch 46
      dot = true
    else
      if and ge ch 48 le ch 57
        dg = f64 sub ch 48
        if not dot
          ip = add mul ip 10.0f64 dg
        else
          divp = mul divp 10.0f64
          fp = add fp div dg divp
        end
      end
    end
    i = add i 1
  end
  res = add ip fp
  if negf
    res = neg res
  end
  ret res
end

fn omg_emit_nibs val ulong cnt ulong to void
  for i ulong cnt
    sh = mul sub sub cnt 1 i 4
    nib = and shr val sh 15
    omg_emit add OMG_NIB_BASE nib
  end
end

fn omg_emit_int_const v long ty ulong to void
  if and ge v 0 le v 31
    omg_emit add OMG_LIT_BASE ulong v
    ret
  end
  if and lt v 0 ge v -256
    omg_emit OMG_CONST_NEG8
    omg_emit_nibs ulong sub neg v 1 2
    ret
  end
  if omg_is_sint ty
    omg_emit OMG_CONST_I64
    omg_emit_nibs ulong v 16
    ret
  end
  u = ulong v
  if le u 255
    omg_emit OMG_CONST_U8
    omg_emit_nibs u 2
    ret
  end
  if le u 65535
    omg_emit OMG_CONST_U16
    omg_emit_nibs u 4
    ret
  end
  if le u 4294967295
    omg_emit OMG_CONST_U32
    omg_emit_nibs u 8
    ret
  end
  omg_emit OMG_CONST_U64
  omg_emit_nibs u 16
end

fn omg_emit_flt_const fv f64 ty ulong to void
  if eq ty OMG_TY_F32
    note Check exact small int 0..31
    iv = long fv
    if and eq fv f64 iv and ge iv 0 le iv 31
      omg_emit add OMG_LIT_BASE ulong iv
      ret
    end
    bits32 = ulong bitcast uint f32 fv
    omg_emit OMG_CONST_F32
    omg_emit_nibs bits32 8
    ret
  end
  iv2 = long fv
  if and eq fv f64 iv2 and ge iv2 0 le iv2 31
    omg_emit add OMG_LIT_BASE ulong iv2
    ret
  end
  bits64 = bitcast ulong fv
  omg_emit OMG_CONST_F64
  omg_emit_nibs bits64 16
end

fn omg_infer_call_args f ulong p0 ulong to ulong
  nt = get omg_nltok 0
  np = get omg_fn_np f
  p = p0
  for ai ulong np
    if lt p nt
      aoff = get omg_ltok_off p
      atl = get omg_ltok_len p
      if or omg_tok_eq aoff atl omg_s_view omg_tok_eq aoff atl omg_s_edit
        p = add p 2
        continue
      end
    end
    p = omg_infer_expr p
  end
  put omg_st 18 get omg_fn_ret f
  ret p
end

note Infer type and token end of expression starting at ltok[idx]; writes type to omg_st[18]
fn omg_infer_expr idx ulong to ulong
  nt = get omg_nltok 0
  if ge idx nt
    put omg_st 18 0
    ret idx
  end
  off = get omg_ltok_off idx
  tl = get omg_ltok_len idx
  if or omg_tok_eq off tl omg_s_true omg_tok_eq off tl omg_s_false
    put omg_st 18 OMG_TY_BOOL
    ret add idx 1
  end
  ty = omg_parse_type off tl
  if ne ty 0
    nx = omg_infer_expr add idx 1
    put omg_st 18 ty
    ret nx
  end
  op = omg_parse_op off tl
  if eq op OMG_OP_BITCAST
    if lt add idx 1 nt
      bty = omg_parse_type get omg_ltok_off add idx 1 get omg_ltok_len add idx 1
      nx = omg_infer_expr add idx 2
      put omg_st 18 bty
      ret nx
    end
  end
  if eq op OMG_OP_LEN
    put omg_st 18 OMG_TY_U64
    ret add idx 2
  end
  if eq op OMG_OP_GET
    if lt add idx 1 nt
      vi = omg_find_var get omg_ltok_off add idx 1 get omg_ltok_len add idx 1
      el = ulong 0
      if ge vi 0
        el = get omg_ev_el ulong vi
      end
      nx = omg_infer_expr add idx 2
      put omg_st 18 el
      ret nx
    end
  end
  if and ge op OMG_OP_EQ le op OMG_OP_GE
    nx1 = omg_infer_expr add idx 1
    nx2 = omg_infer_expr nx1
    put omg_st 18 OMG_TY_BOOL
    ret nx2
  end
  if eq op OMG_OP_NOT
    nx = omg_infer_expr add idx 1
    put omg_st 18 OMG_TY_BOOL
    ret nx
  end
  if or eq op OMG_OP_NEG or eq op OMG_OP_FSQRT eq op OMG_OP_FABS
    ret omg_infer_expr add idx 1
  end
  if eq op OMG_OP_FMA
    nx1 = omg_infer_expr add idx 1
    t1 = get omg_st 18
    nx2 = omg_infer_expr nx1
    t2 = get omg_st 18
    nx3 = omg_infer_expr nx2
    t3 = get omg_st 18
    if eq t1 0
      t1 = t2
    end
    if eq t1 0
      t1 = t3
    end
    put omg_st 18 t1
    ret nx3
  end
  if and ge op OMG_OP_ADD le op OMG_OP_FMAX
    nx1 = omg_infer_expr add idx 1
    t1 = get omg_st 18
    nx2 = omg_infer_expr nx1
    t2 = get omg_st 18
    if eq t1 0
      t1 = t2
    end
    put omg_st 18 t1
    ret nx2
  end
  vi2 = omg_find_var off tl
  if ge vi2 0
    put omg_st 18 get omg_ev_ty ulong vi2
    ret add idx 1
  end
  fi = omg_find_fn off tl
  if ge fi 0
    ret omg_infer_call_args ulong fi add idx 1
  end
  if omg_is_flt_lit off tl
    if and ge tl 3 eq ulong get omg_src sub add off tl 3 102
      if eq ulong get omg_src sub add off tl 2 51
        put omg_st 18 OMG_TY_F32
        ret add idx 1
      end
    end
    put omg_st 18 OMG_TY_F64
    ret add idx 1
  end
  put omg_st 18 0
  ret add idx 1
end

fn omg_parse_call_args f ulong p0 ulong to ulong
  nt = get omg_nltok 0
  np = get omg_fn_np f
  p = p0
  for ai ulong np
    pk = get omg_fn_pk add mul f 6 ai
    if ne pk 0
      if lt p nt
        poff = get omg_ltok_off p
        ptl = get omg_ltok_len p
        if or omg_tok_eq poff ptl omg_s_view omg_tok_eq poff ptl omg_s_edit
          p = add p 1
        end
      end
      avi = omg_find_var get omg_ltok_off p get omg_ltok_len p
      if ge avi 0
        omg_emit add OMG_REF_BASE sub sub get omg_st 2 1 ulong avi
      end
      p = add p 1
    else
      p = omg_parse_expr p get omg_fn_pt add mul f 6 ai
    end
  end
  ret p
end

fn omg_parse_expr idx ulong exp_ty ulong to ulong
  nt = get omg_nltok 0
  if ge idx nt
    ret idx
  end
  off = get omg_ltok_off idx
  tl = get omg_ltok_len idx
  if omg_tok_eq off tl omg_s_true
    omg_emit OMG_OP_TRUE
    ret add idx 1
  end
  if omg_tok_eq off tl omg_s_false
    omg_emit OMG_OP_FALSE
    ret add idx 1
  end
  ty = omg_parse_type off tl
  if ne ty 0
    nx_c = omg_infer_expr add idx 1
    src_t = get omg_st 18
    if or eq src_t 0 eq src_t ty
      ret omg_parse_expr add idx 1 ty
    end
    omg_emit OMG_OP_CAST
    omg_emit src_t
    ret omg_parse_expr add idx 1 src_t
  end
  op = omg_parse_op off tl
  if eq op OMG_OP_BITCAST
    if and eq exp_ty OMG_TY_F64 lt add idx 3 nt
      bo1 = get omg_ltok_off add idx 2
      bl1 = get omg_ltok_len add idx 2
      bo2 = get omg_ltok_off add idx 3
      bl2 = get omg_ltok_len add idx 3
      if and omg_tok_eq bo1 bl1 omg_s_ulong omg_is_num_lit bo2 bl2
        bits64 = omg_parse_u64 bo2 bl2
        omg_emit OMG_CONST_F64
        omg_emit_nibs bits64 16
        ret add idx 4
      end
    end
    if and eq exp_ty OMG_TY_F32 lt add idx 3 nt
      bo3 = get omg_ltok_off add idx 2
      bl3 = get omg_ltok_len add idx 2
      bo4 = get omg_ltok_off add idx 3
      bl4 = get omg_ltok_len add idx 3
      if and omg_tok_eq bo3 bl3 omg_s_uint omg_is_num_lit bo4 bl4
        bits32 = omg_parse_u64 bo4 bl4
        omg_emit OMG_CONST_F32
        omg_emit_nibs bits32 8
        ret add idx 4
      end
    end
    nx = omg_infer_expr add idx 2
    src_t2 = get omg_st 18
    omg_emit OMG_OP_BITCAST
    omg_emit src_t2
    ret omg_parse_expr add idx 2 src_t2
  end
  if eq op OMG_OP_LEN
    omg_emit OMG_OP_LEN
    aoff = get omg_ltok_off add idx 1
    atl = get omg_ltok_len add idx 1
    vi = omg_find_var aoff atl
    if ge vi 0
      rk = sub sub get omg_st 2 1 ulong vi
      omg_emit add OMG_REF_BASE rk
    end
    ret add idx 2
  end
  if eq op OMG_OP_GET
    omg_emit OMG_OP_GET
    aoff2 = get omg_ltok_off add idx 1
    atl2 = get omg_ltok_len add idx 1
    vi2 = omg_find_var aoff2 atl2
    if ge vi2 0
      rk2 = sub sub get omg_st 2 1 ulong vi2
      omg_emit add OMG_REF_BASE rk2
    end
    ret omg_parse_expr add idx 2 OMG_TY_U64
  end
  if and ge op OMG_OP_EQ le op OMG_OP_GE
    nx1 = omg_infer_expr add idx 1
    t1 = get omg_st 18
    if eq t1 0
      nx2_ = omg_infer_expr nx1
      t1 = get omg_st 18
    end
    if eq t1 0
      t1 = OMG_TY_U64
    end
    omg_emit op
    omg_emit t1
    p1 = omg_parse_expr add idx 1 t1
    ret omg_parse_expr p1 t1
  end
  if or eq op OMG_OP_NOT or eq op OMG_OP_NEG or eq op OMG_OP_FSQRT eq op OMG_OP_FABS
    omg_emit op
    ret omg_parse_expr add idx 1 exp_ty
  end
  if eq op OMG_OP_FMA
    omg_emit op
    p1 = omg_parse_expr add idx 1 exp_ty
    p2 = omg_parse_expr p1 exp_ty
    ret omg_parse_expr p2 exp_ty
  end
  if and ge op OMG_OP_ADD le op OMG_OP_FMAX
    omg_emit op
    p1 = omg_parse_expr add idx 1 exp_ty
    ret omg_parse_expr p1 exp_ty
  end
  vi3 = omg_find_var off tl
  if ge vi3 0
    rk3 = sub sub get omg_st 2 1 ulong vi3
    omg_emit add OMG_REF_BASE rk3
    ret add idx 1
  end
  fi = omg_find_fn off tl
  if ge fi 0
    f = ulong fi
    omg_emit OMG_OP_CALL
    omg_emit add OMG_FN_BASE f
    ret omg_parse_call_args f add idx 1
  end
  if omg_is_flt_lit off tl
    fv = omg_parse_f64 off tl
    omg_emit_flt_const fv exp_ty
    ret add idx 1
  end
  if omg_is_num_lit off tl
    if omg_is_flt exp_ty
      iv = omg_parse_i64 off tl
      omg_emit_flt_const f64 iv exp_ty
    else
      iv2 = omg_parse_i64 off tl
      omg_emit_int_const iv2 exp_ty
    end
    ret add idx 1
  end
  ret add idx 1
end

fn omg_scan_fn_param cf ulong p ulong to ulong
  np = get omg_fn_np cf
  p2o = get omg_ltok_off add p 1
  p2l = get omg_ltok_len add p 1
  if or omg_tok_eq p2o p2l omg_s_view omg_tok_eq p2o p2l omg_s_edit
    pk = ulong 1
    if omg_tok_eq p2o p2l omg_s_edit
      pk = 2
    end
    el = omg_parse_type get omg_ltok_off add p 2 get omg_ltok_len add p 2
    put omg_fn_pk add mul cf 6 np pk
    put omg_fn_pe add mul cf 6 np el
    pt = OMG_TY_VIEW
    if eq pk 2
      pt = OMG_TY_EDIT
    end
    put omg_fn_pt add mul cf 6 np pt
    put omg_fn_np cf add np 1
    ret add p 4
  end
  ty = omg_parse_type p2o p2l
  put omg_fn_pk add mul cf 6 np 0
  put omg_fn_pt add mul cf 6 np ty
  put omg_fn_pe add mul cf 6 np 0
  put omg_fn_np cf add np 1
  ret add p 2
end

fn omg_scan_fn_sig to void
  nt = get omg_nltok 0
  i = ulong 0
  if omg_tok_eq get omg_ltok_off 0 get omg_ltok_len 0 omg_s_export
    i = 1
  end
  if or ge add i 1 nt not omg_tok_eq get omg_ltok_off i get omg_ltok_len i omg_s_fn
    ret
  end
  cf = get omg_st 3
  if ge cf OMG_MAX_FNS
    ret
  end
  noff = get omg_ltok_off add i 1
  nlen = get omg_ltok_len add i 1
  put omg_fn_noff cf noff
  put omg_fn_nlen cf nlen
  put omg_fn_np cf 0
  put omg_fn_done cf 1
  put omg_fn_main cf 0
  p = add i 2
  while lt p nt bound 64
    po = get omg_ltok_off p
    pl = get omg_ltok_len p
    if omg_tok_eq po pl omg_s_to
      p = add p 1
      break
    end
    if lt add p 1 nt
      p = omg_scan_fn_param cf p
      continue
    end
    p = add p 1
  end
  rt = OMG_TY_VOID
  if lt p nt
    rt = omg_parse_type get omg_ltok_off p get omg_ltok_len p
  end
  put omg_fn_ret cf rt
  if and omg_tok_eq noff nlen omg_s_main and eq get omg_fn_np cf 0 eq rt OMG_TY_I32
    put omg_fn_main cf 1
  end
  put omg_st 3 add cf 1
end

fn omg_parse_fn_hdr f ulong to void
  put omg_st 2 0
  put omg_st 8 0
  put omg_st 7 0
  put omg_st 4 f
  put omg_st 5 get omg_fn_ret f
  if eq get omg_fn_main f 1
    omg_emit OMG_FN_MAIN
    put omg_st 19 1
    ret
  end
  put omg_st 19 0
  omg_emit OMG_FN
  omg_emit get omg_fn_ret f
  nt = get omg_nltok 0
  i = ulong 0
  if omg_tok_eq get omg_ltok_off 0 get omg_ltok_len 0 omg_s_export
    i = 1
  end
  p = add i 2
  pi = ulong 0
  while lt p nt bound 64
    po = get omg_ltok_off p
    pl = get omg_ltok_len p
    if omg_tok_eq po pl omg_s_to
      break
    end
    omg_emit OMG_PARAM
    pk = get omg_fn_pk add mul f 6 pi
    if eq pk 0
      pt = get omg_fn_pt add mul f 6 pi
      omg_emit pt
      nl = get omg_st 2
      put omg_sym_off nl po
      put omg_sym_len nl pl
      omg_env_push pt 1 0 0
      p = add p 2
    else
      if eq pk 1
        omg_emit OMG_TY_VIEW
      else
        omg_emit OMG_TY_EDIT
      end
      el = get omg_fn_pe add mul f 6 pi
      omg_emit el
      nl = get omg_st 2
      put omg_sym_off nl po
      put omg_sym_len nl pl
      pt2 = OMG_TY_VIEW
      if eq pk 2
        pt2 = OMG_TY_EDIT
      end
      omg_env_push pt2 0 pk el
      p = add p 4
    end
    pi = add pi 1
  end
  omg_emit OMG_BODY
end

fn omg_parse_assign o0 ulong l0 ulong to void
  if omg_tok_eq get omg_ltok_off 2 get omg_ltok_len 2 omg_s_new
    el2 = omg_parse_type get omg_ltok_off 3 get omg_ltok_len 3
    nval = omg_parse_u64 get omg_ltok_off 4 get omg_ltok_len 4
    omg_emit OMG_NEW
    omg_emit el2
    omg_emit add OMG_LIT_BASE nval
    nx_nw = omg_parse_expr 5 el2
    nl2 = get omg_st 2
    put omg_sym_off nl2 o0
    put omg_sym_len nl2 l0
    omg_env_push el2 0 2 el2
    ret
  end
  vi2 = omg_find_var o0 l0
  if ge vi2 0
    rk2 = sub sub get omg_st 2 1 ulong vi2
    vt = get omg_ev_ty ulong vi2
    omg_emit OMG_SET
    omg_emit add OMG_REF_BASE rk2
    nx_st = omg_parse_expr 2 vt
  else
    nx_in = omg_infer_expr 2
    rt = get omg_st 18
    if eq rt 0
      rt = OMG_TY_U64
    end
    omg_emit OMG_LET
    omg_emit rt
    nx_lt = omg_parse_expr 2 rt
    nl3 = get omg_st 2
    put omg_sym_off nl3 o0
    put omg_sym_len nl3 l0
    omg_env_push rt 1 0 0
  end
end

fn omg_parse_stmt to void
  nt = get omg_nltok 0
  if eq nt 0
    ret
  end
  o0 = get omg_ltok_off 0
  l0 = get omg_ltok_len 0
  if omg_tok_eq o0 l0 omg_s_end
    sd = get omg_st 8
    if gt sd 0
      omg_env_pop_to get omg_bs sd
      if or eq get omg_bk sd OMG_BK_WHILE eq get omg_bk sd OMG_BK_FOR
        if gt get omg_st 7 0
          put omg_st 7 sub get omg_st 7 1
        end
      end
      put omg_st 8 sub sd 1
      omg_emit OMG_END
    else
      omg_emit OMG_END
      put omg_st 13 0
      put omg_st 19 0
      put omg_st 1 0
    end
    ret
  end
  if omg_tok_eq o0 l0 omg_s_else
    sd = get omg_st 8
    omg_env_pop_to get omg_bs sd
    omg_emit OMG_ELSE
    ret
  end
  if omg_tok_eq o0 l0 omg_s_if
    omg_emit OMG_IF
    nx_if = omg_parse_expr 1 OMG_TY_BOOL
    sd = add get omg_st 8 1
    put omg_st 8 sd
    put omg_bk sd OMG_BK_IF
    put omg_bs sd get omg_st 2
    ret
  end
  if omg_tok_eq o0 l0 omg_s_while
    omg_emit OMG_WHILE
    p = omg_parse_expr 1 OMG_TY_BOOL
    bnd = ulong 1000000
    if lt add p 1 nt
      if omg_tok_eq get omg_ltok_off p get omg_ltok_len p omg_s_bound
        bnd = omg_parse_u64 get omg_ltok_off add p 1 get omg_ltok_len add p 1
      end
    end
    omg_emit_int_const long bnd OMG_TY_U64
    sd = add get omg_st 8 1
    put omg_st 8 sd
    put omg_bk sd OMG_BK_WHILE
    put omg_bs sd get omg_st 2
    put omg_st 7 add get omg_st 7 1
    ret
  end
  if omg_tok_eq o0 l0 omg_s_for
    vo = get omg_ltok_off 1
    vl = get omg_ltok_len 1
    ft = omg_parse_type get omg_ltok_off 2 get omg_ltok_len 2
    omg_emit OMG_FOR
    omg_emit ft
    nx_for = omg_parse_expr 3 ft
    sd = add get omg_st 8 1
    put omg_st 8 sd
    put omg_bk sd OMG_BK_FOR
    put omg_bs sd get omg_st 2
    put omg_st 7 add get omg_st 7 1
    nl = get omg_st 2
    put omg_sym_off nl vo
    put omg_sym_len nl vl
    omg_env_push ft 0 0 0
    ret
  end
  if omg_tok_eq o0 l0 omg_s_break
    omg_emit OMG_BREAK
    ret
  end
  if omg_tok_eq o0 l0 omg_s_continue
    omg_emit OMG_CONTINUE
    ret
  end
  if omg_tok_eq o0 l0 omg_s_ret
    omg_emit OMG_RET
    if ne get omg_st 5 OMG_TY_VOID
      nx_ret = omg_parse_expr 1 get omg_st 5
    end
    ret
  end
  if omg_tok_eq o0 l0 omg_s_trap
    omg_emit OMG_TRAP
    tv = omg_parse_u64 get omg_ltok_off 1 get omg_ltok_len 1
    omg_emit add OMG_LIT_BASE tv
    ret
  end
  if omg_tok_eq o0 l0 omg_s_exit
    omg_emit OMG_EXIT
    nx_ex = omg_parse_expr 1 OMG_TY_I32
    ret
  end
  if omg_tok_eq o0 l0 omg_s_put
    vi = omg_find_var get omg_ltok_off 1 get omg_ltok_len 1
    if ge vi 0
      rk = sub sub get omg_st 2 1 ulong vi
      el = get omg_ev_el ulong vi
      omg_emit OMG_PUT
      omg_emit add OMG_REF_BASE rk
      p = omg_parse_expr 2 OMG_TY_U64
      nx_put = omg_parse_expr p el
    end
    ret
  end
  if ge nt 3
    if omg_tok_eq get omg_ltok_off 1 get omg_ltok_len 1 omg_s_eq_sign
      omg_parse_assign o0 l0
      ret
    end
  end
  fi = omg_find_fn o0 l0
  if ge fi 0
    f = ulong fi
    omg_emit OMG_CALL_VOID
    omg_emit add OMG_FN_BASE f
    nx_cv = omg_parse_call_args f 1
  end
end

fn omg_parse_om to long
  omg_init_parse
  put omg_ntok 0 0
  n = get omg_nsrc 0
  note Pass 1: scan all fn signatures
  p = ulong 0
  while lt p n bound 65536
    le_ = omg_line_end p
    nt = omg_tok_line p le_
    if gt nt 0
      o0 = get omg_ltok_off 0
      l0 = get omg_ltok_len 0
      if or omg_tok_eq o0 l0 omg_s_fn omg_tok_eq o0 l0 omg_s_export
        omg_scan_fn_sig
      end
    end
    p = omg_next_line p
  end
  if eq get omg_st 3 0
    ret -1
  end
  note Pass 2: emit canonical OMG stream
  omg_emit OMG_BEGIN
  p = ulong 0
  in_fn = false
  fn_idx = ulong 0
  while lt p n bound 65536
    le2 = omg_line_end p
    nt2 = omg_tok_line p le2
    if gt nt2 0
      o0 = get omg_ltok_off 0
      l0 = get omg_ltok_len 0
      if or or omg_tok_eq o0 l0 omg_s_note omg_tok_eq o0 l0 omg_s_om2 omg_tok_eq o0 l0 omg_s_target
        p = omg_next_line p
        continue
      end
      if not in_fn
        if or omg_tok_eq o0 l0 omg_s_fn omg_tok_eq o0 l0 omg_s_export
          omg_parse_fn_hdr fn_idx
          fn_idx = add fn_idx 1
          in_fn = true
          put omg_st 1 1
        end
      else
        if and eq get omg_st 8 0 omg_tok_eq o0 l0 omg_s_end
          omg_emit OMG_END
          in_fn = false
        else
          omg_parse_stmt
        end
      end
    end
    p = omg_next_line p
  end
  omg_emit OMG_END_UNIT
  ret omg_validate
end

note ---- OMG -> .om Text Decoder (omg_decode_om) ----

fn omg_dc c ulong to void
  p = get omg_ndec 0
  if lt p 65536
    put omg_dec p uchar and c 255
    put omg_ndec 0 add p 1
  end
end

fn omg_ds s view uchar * to void
  for i ulong len s
    omg_dc ulong get s i
  end
end

fn omg_du v ulong to void
  d = new uchar 24 0
  n = ulong 0
  x = v
  while true bound 21
    put d n uchar add rem x 10 48
    n = add n 1
    x = div x 10
    if eq x 0
      break
    end
  end
  for i ulong n
    omg_dc ulong get d sub sub n 1 i
  end
end

fn omg_dl v long to void
  if lt v 0
    omg_dc 45
    if eq v -9223372036854775808
      omg_du 9223372036854775808
    else
      omg_du ulong neg v
    end
  else
    omg_du ulong v
  end
end

fn omg_d_indent d ulong to void
  for i ulong d
    omg_dc 32
    omg_dc 32
  end
end

fn omg_d_type ty ulong to void
  if eq ty OMG_TY_VOID
    omg_ds omg_s_void
    ret
  end
  if eq ty OMG_TY_BOOL
    omg_ds omg_s_bool
    ret
  end
  if eq ty OMG_TY_U8
    omg_ds omg_s_uchar
    ret
  end
  if eq ty OMG_TY_U16
    omg_ds omg_s_ushort
    ret
  end
  if eq ty OMG_TY_U32
    omg_ds omg_s_uint
    ret
  end
  if eq ty OMG_TY_U64
    omg_ds omg_s_ulong
    ret
  end
  if eq ty OMG_TY_I8
    omg_ds omg_s_byte
    ret
  end
  if eq ty OMG_TY_I16
    omg_ds omg_s_short
    ret
  end
  if eq ty OMG_TY_I32
    omg_ds omg_s_int
    ret
  end
  if eq ty OMG_TY_I64
    omg_ds omg_s_long
    ret
  end
  if eq ty OMG_TY_F32
    omg_ds omg_s_f32
    ret
  end
  if eq ty OMG_TY_F64
    omg_ds omg_s_f64
  end
end

fn omg_d_op op ulong to void
  if eq op OMG_OP_ADD
    omg_ds omg_s_add
  end
  if eq op OMG_OP_SUB
    omg_ds omg_s_sub
  end
  if eq op OMG_OP_MUL
    omg_ds omg_s_mul
  end
  if eq op OMG_OP_DIV
    omg_ds omg_s_div
  end
  if eq op OMG_OP_REM
    omg_ds omg_s_rem
  end
  if eq op OMG_OP_AND
    omg_ds omg_s_and
  end
  if eq op OMG_OP_OR
    omg_ds omg_s_or
  end
  if eq op OMG_OP_XOR
    omg_ds omg_s_xor
  end
  if eq op OMG_OP_SHL
    omg_ds omg_s_shl
  end
  if eq op OMG_OP_SHR
    omg_ds omg_s_shr
  end
  if eq op OMG_OP_ROTR
    omg_ds omg_s_rotr
  end
  if eq op OMG_OP_ROTL
    omg_ds omg_s_rotl
  end
  if eq op OMG_OP_FMIN
    omg_ds omg_s_fmin
  end
  if eq op OMG_OP_FMAX
    omg_ds omg_s_fmax
  end
  if eq op OMG_OP_EQ
    omg_ds omg_s_eq
  end
  if eq op OMG_OP_NE
    omg_ds omg_s_ne
  end
  if eq op OMG_OP_LT
    omg_ds omg_s_lt
  end
  if eq op OMG_OP_LE
    omg_ds omg_s_le
  end
  if eq op OMG_OP_GT
    omg_ds omg_s_gt
  end
  if eq op OMG_OP_GE
    omg_ds omg_s_ge
  end
  if eq op OMG_OP_NEG
    omg_ds omg_s_neg
  end
  if eq op OMG_OP_NOT
    omg_ds omg_s_not
  end
  if eq op OMG_OP_FSQRT
    omg_ds omg_s_fsqrt
  end
  if eq op OMG_OP_FABS
    omg_ds omg_s_fabs
  end
  if eq op OMG_OP_LEN
    omg_ds omg_s_len
  end
  if eq op OMG_OP_GET
    omg_ds omg_s_get
  end
  if eq op OMG_OP_FMA
    omg_ds omg_s_fma
  end
end

fn omg_d_next to ulong
  p = get omg_dec_cur 0
  if ge p get omg_ntok 0
    ret OMG_EOF
  end
  put omg_dec_cur 0 add p 1
  ret ulong get omg_toks p
end

fn omg_d_nibs cnt ulong to ulong
  v = ulong 0
  for i ulong cnt
    t = omg_d_next
    nib = sub t OMG_NIB_BASE
    v = or shl v 4 nib
  end
  ret v
end

fn omg_d_var slot ulong to void
  omg_dc 118
  omg_du get omg_dec_vid slot
end

fn omg_d_fn_name f ulong to void
  if eq get omg_fn_main f 1
    omg_ds omg_s_main
  else
    omg_dc 102
    omg_du f
  end
end

fn omg_d_expr exp_ty ulong need_ty ulong to void
  tk = omg_d_next
  if eq tk OMG_OP_TRUE
    omg_ds omg_s_true
    ret
  end
  if eq tk OMG_OP_FALSE
    omg_ds omg_s_false
    ret
  end
  if and ge tk OMG_REF_BASE lt tk add OMG_REF_BASE 64
    rk = sub tk OMG_REF_BASE
    nl = get omg_st 2
    slot = sub sub nl 1 rk
    omg_d_var slot
    ret
  end
  if and ge tk OMG_LIT_BASE lt tk add OMG_LIT_BASE 32
    lv = sub tk OMG_LIT_BASE
    if omg_is_flt exp_ty
      omg_du lv
      omg_dc 46
      omg_dc 48
      omg_d_type exp_ty
    else
      if ne need_ty 0
        omg_d_type exp_ty
        omg_dc 32
      end
      omg_du lv
    end
    ret
  end
  if eq tk OMG_CONST_NEG8
    v = omg_d_nibs 2
    if ne need_ty 0
      omg_d_type exp_ty
      omg_dc 32
    end
    omg_dc 45
    omg_du add v 1
    ret
  end
  if or eq tk OMG_CONST_U8 or eq tk OMG_CONST_U16 or eq tk OMG_CONST_U32 eq tk OMG_CONST_U64
    cnt = ulong 2
    if eq tk OMG_CONST_U16
      cnt = 4
    end
    if eq tk OMG_CONST_U32
      cnt = 8
    end
    if eq tk OMG_CONST_U64
      cnt = 16
    end
    v = omg_d_nibs cnt
    if ne need_ty 0
      omg_d_type exp_ty
      omg_dc 32
    end
    omg_du v
    ret
  end
  if eq tk OMG_CONST_I64
    v = omg_d_nibs 16
    if ne need_ty 0
      omg_d_type exp_ty
      omg_dc 32
    end
    omg_dl bitcast long v
    ret
  end
  if eq tk OMG_CONST_F32
    v = omg_d_nibs 8
    omg_ds omg_s_bitcast
    omg_dc 32
    omg_ds omg_s_f32
    omg_dc 32
    omg_ds omg_s_uint
    omg_dc 32
    omg_du v
    ret
  end
  if eq tk OMG_CONST_F64
    v = omg_d_nibs 16
    omg_ds omg_s_bitcast
    omg_dc 32
    omg_ds omg_s_f64
    omg_dc 32
    omg_ds omg_s_ulong
    omg_dc 32
    omg_du v
    ret
  end
  if eq tk OMG_OP_CAST
    st = omg_d_next
    omg_d_type exp_ty
    omg_dc 32
    omg_d_expr st 1
    ret
  end
  if eq tk OMG_OP_BITCAST
    st = omg_d_next
    omg_ds omg_s_bitcast
    omg_dc 32
    omg_d_type exp_ty
    omg_dc 32
    omg_d_expr st 1
    ret
  end
  if eq tk OMG_OP_CALL
    f = sub omg_d_next OMG_FN_BASE
    omg_d_fn_name f
    np = get omg_fn_np f
    for ai ulong np
      omg_dc 32
      pk = get omg_fn_pk add mul f 6 ai
      if eq pk 1
        omg_ds omg_s_view
        omg_dc 32
        omg_d_expr OMG_TY_VIEW 0
      else
        if eq pk 2
          omg_ds omg_s_edit
          omg_dc 32
          omg_d_expr OMG_TY_EDIT 0
        else
          omg_d_expr get omg_fn_pt add mul f 6 ai 1
        end
      end
    end
    ret
  end
  if or eq tk OMG_OP_NOT or eq tk OMG_OP_NEG or eq tk OMG_OP_FSQRT or eq tk OMG_OP_FABS eq tk OMG_OP_LEN
    omg_d_op tk
    omg_dc 32
    omg_d_expr exp_ty 1
    ret
  end
  if eq tk OMG_OP_GET
    omg_ds omg_s_get
    omg_dc 32
    omg_d_expr OMG_TY_VIEW 0
    omg_dc 32
    omg_d_expr OMG_TY_U64 0
    ret
  end
  if and ge tk OMG_OP_EQ le tk OMG_OP_GE
    ct = omg_d_next
    omg_d_op tk
    omg_dc 32
    omg_d_expr ct 1
    omg_dc 32
    omg_d_expr ct 1
    ret
  end
  if eq tk OMG_OP_FMA
    omg_ds omg_s_fma
    omg_dc 32
    omg_d_expr exp_ty 1
    omg_dc 32
    omg_d_expr exp_ty 1
    omg_dc 32
    omg_d_expr exp_ty 1
    ret
  end
  omg_d_op tk
  omg_dc 32
  omg_d_expr exp_ty 1
  omg_dc 32
  omg_d_expr exp_ty 1
end

fn omg_d_const_u64_val to ulong
  tk = omg_d_next
  if and ge tk OMG_LIT_BASE lt tk add OMG_LIT_BASE 32
    ret sub tk OMG_LIT_BASE
  end
  if eq tk OMG_CONST_U8
    ret omg_d_nibs 2
  end
  if eq tk OMG_CONST_U16
    ret omg_d_nibs 4
  end
  if eq tk OMG_CONST_U32
    ret omg_d_nibs 8
  end
  if eq tk OMG_CONST_U64
    ret omg_d_nibs 16
  end
  ret 1
end

fn omg_alloc_vid to ulong
  id = get omg_dec_nvid 0
  put omg_dec_nvid 0 add id 1
  ret id
end

fn omg_decode_fn_body f ulong to void
  ind = ulong 1
  done_fn = false
  while not done_fn bound 8192
    tk = omg_d_next
    if or eq tk OMG_EOF eq tk OMG_END_UNIT
      break
    end
    if eq tk OMG_END
      ind = sub ind 1
      omg_d_indent ind
      omg_ds omg_s_end
      omg_dc 10
      if eq ind 0
        done_fn = true
      else
        omg_env_pop_to get omg_bs ind
      end
      continue
    end
    if eq tk OMG_ELSE
      omg_env_pop_to get omg_bs sub ind 1
      omg_d_indent sub ind 1
      omg_ds omg_s_else
      omg_dc 10
      continue
    end
    omg_d_indent ind
    if eq tk OMG_RET
      omg_ds omg_s_ret
      rt = get omg_fn_ret f
      if ne rt OMG_TY_VOID
        omg_dc 32
        omg_d_expr rt 0
      end
      omg_dc 10
      continue
    end
    if eq tk OMG_BREAK
      omg_ds omg_s_break
      omg_dc 10
      continue
    end
    if eq tk OMG_CONTINUE
      omg_ds omg_s_continue
      omg_dc 10
      continue
    end
    if eq tk OMG_TRAP
      omg_ds omg_s_trap
      omg_dc 32
      tv = sub omg_d_next OMG_LIT_BASE
      omg_du tv
      omg_dc 10
      continue
    end
    if eq tk OMG_EXIT
      omg_ds omg_s_exit
      omg_dc 32
      omg_d_expr OMG_TY_I32 0
      omg_dc 10
      continue
    end
    if eq tk OMG_LET
      ty = omg_d_next
      nl = get omg_st 2
      vid = omg_alloc_vid
      put omg_dec_vid nl vid
      omg_dc 118
      omg_du vid
      omg_dc 32
      omg_dc 61
      omg_dc 32
      omg_d_expr ty 1
      omg_dc 10
      omg_env_push ty 1 0 0
      continue
    end
    if eq tk OMG_SET
      rk = sub omg_d_next OMG_REF_BASE
      nl2 = get omg_st 2
      slot = sub sub nl2 1 rk
      omg_d_var slot
      omg_dc 32
      omg_dc 61
      omg_dc 32
      omg_d_expr get omg_ev_ty slot 1
      omg_dc 10
      continue
    end
    if eq tk OMG_IF
      omg_ds omg_s_if
      omg_dc 32
      omg_d_expr OMG_TY_BOOL 0
      omg_dc 10
      put omg_bs ind get omg_st 2
      ind = add ind 1
      continue
    end
    if eq tk OMG_WHILE
      omg_ds omg_s_while
      omg_dc 32
      omg_d_expr OMG_TY_BOOL 0
      omg_dc 32
      omg_ds omg_s_bound
      omg_dc 32
      omg_du omg_d_const_u64_val
      omg_dc 10
      put omg_bs ind get omg_st 2
      ind = add ind 1
      continue
    end
    if eq tk OMG_FOR
      ft = omg_d_next
      nl3 = get omg_st 2
      vid2 = omg_alloc_vid
      put omg_dec_vid nl3 vid2
      omg_ds omg_s_for
      omg_dc 32
      omg_dc 118
      omg_du vid2
      omg_dc 32
      omg_d_type ft
      omg_dc 32
      omg_d_expr ft 0
      omg_dc 10
      put omg_bs ind get omg_st 2
      ind = add ind 1
      omg_env_push ft 0 0 0
      continue
    end
    if eq tk OMG_NEW
      el = omg_d_next
      nlen = sub omg_d_next OMG_LIT_BASE
      nl4 = get omg_st 2
      vid3 = omg_alloc_vid
      put omg_dec_vid nl4 vid3
      omg_dc 118
      omg_du vid3
      omg_dc 32
      omg_dc 61
      omg_dc 32
      omg_ds omg_s_new
      omg_dc 32
      omg_d_type el
      omg_dc 32
      omg_du nlen
      omg_dc 32
      omg_d_expr el 0
      omg_dc 10
      omg_env_push el 0 2 el
      continue
    end
    if eq tk OMG_PUT
      rk2 = sub omg_d_next OMG_REF_BASE
      slot2 = sub sub get omg_st 2 1 rk2
      omg_ds omg_s_put
      omg_dc 32
      omg_d_var slot2
      omg_dc 32
      omg_d_expr OMG_TY_U64 0
      omg_dc 32
      omg_d_expr get omg_ev_el slot2 0
      omg_dc 10
      continue
    end
    if eq tk OMG_CALL_VOID
      cf = sub omg_d_next OMG_FN_BASE
      omg_d_fn_name cf
      np = get omg_fn_np cf
      for ai ulong np
        omg_dc 32
        pk = get omg_fn_pk add mul cf 6 ai
        if eq pk 1
          omg_ds omg_s_view
          omg_dc 32
          omg_d_expr OMG_TY_VIEW 0
        else
          if eq pk 2
            omg_ds omg_s_edit
            omg_dc 32
            omg_d_expr OMG_TY_EDIT 0
          else
            omg_d_expr get omg_fn_pt add mul cf 6 ai 1
          end
        end
      end
      omg_dc 10
      continue
    end
  end
end

fn omg_decode_om to long
  rc = omg_macro_expand
  if ne rc 0
    ret rc
  end
  rc2 = omg_validate
  if ne rc2 0
    ret rc2
  end
  put omg_ndec 0 0
  put omg_dec_cur 0 0
  put omg_dec_nvid 0 0
  omg_ds omg_s_om2
  omg_dc 10
  tk0 = omg_d_next
  if ne tk0 OMG_BEGIN
    ret -1
  end
  f = ulong 0
  while true bound 64
    tk = omg_d_next
    if or eq tk OMG_EOF eq tk OMG_END_UNIT
      break
    end
    put omg_st 2 0
    put omg_dec_nvid 0 0
    omg_ds omg_s_fn
    omg_dc 32
    if eq tk OMG_FN_MAIN
      omg_ds omg_s_main
      omg_dc 32
      omg_ds omg_s_to
      omg_dc 32
      omg_ds omg_s_int
      omg_dc 10
      omg_decode_fn_body f
    else
      if eq tk OMG_FN
        rt = omg_d_next
        omg_d_fn_name f
        np = get omg_fn_np f
        for pi ulong np
          ptok = omg_d_next
          ty = omg_d_next
          vid = omg_alloc_vid
          put omg_dec_vid pi vid
          omg_dc 32
          omg_dc 118
          omg_du vid
          omg_dc 32
          if or eq ty OMG_TY_VIEW eq ty OMG_TY_EDIT
            el = omg_d_next
            if eq ty OMG_TY_VIEW
              omg_ds omg_s_view
            else
              omg_ds omg_s_edit
            end
            omg_dc 32
            omg_d_type el
            omg_dc 32
            omg_dc 42
            pk = ulong 1
            if eq ty OMG_TY_EDIT
              pk = 2
            end
            omg_env_push ty 0 pk el
          else
            omg_d_type ty
            omg_env_push ty 1 0 0
          end
        end
        body_tk = omg_d_next
        omg_dc 32
        omg_ds omg_s_to
        omg_dc 32
        omg_d_type rt
        omg_dc 10
        omg_decode_fn_body f
      end
    end
    f = add f 1
  end
  ret 0
end

note ---- Built-in Masked Random/Adversarial Sampler (gsamp-compatible) ----

fn omg_pick_allowed r ulong to ulong
  cnt = ulong 0
  for c ulong OMG_VOCAB
    if eq get omg_mask c 1
      cnt = add cnt 1
    end
  end
  if eq cnt 0
    ret OMG_EOF
  end
  pick = rem r cnt
  seen = ulong 0
  for c2 ulong OMG_VOCAB
    if eq get omg_mask c2 1
      if eq seen pick
        ret c2
      end
      seen = add seen 1
    end
  end
  ret OMG_EOF
end

fn omg_sample_masked seed ulong budget ulong to long
  if gt budget OMG_MAX_TOKS
    ret -1
  end
  omg_init_gen
  put omg_ntok 0 0
  s = seed
  for step ulong budget
    left = sub budget step
    omg_valid_mask left
    s = smx add s step
    tok = omg_pick_allowed s
    if eq tok OMG_EOF
      break
    end
    omg_emit tok
    rc = omg_step tok
    if ne rc 0
      ret -2
    end
    if and eq get omg_st 0 0 eq get omg_st 1 0
      break
    end
  end
  if or ne get omg_st 0 0 ne get omg_st 1 0
    ret -3
  end
  ret 0
end

note ---- Metrics & Built-in Selftest ----

fn omg_put_str s view uchar * to void
  for i ulong len s
    oputc ulong get s i
  end
end

text omg_m_hdr "OMG_METRICS V=256 V_BASE=4096 LOGIT_REDUCTION=16x CE_TABLE_BYTES_V256=2048 CE_TABLE_BYTES_V4096=32768\n"
text omg_st_p1 "OMG_SELFTEST PASS samples="
text omg_st_p2 " sem_id="
text omg_st_p3 " ntok="
text omg_st_p4 " src_bytes="
text omg_st_p5 "\n"

text omg_ex_a "om2\nnote alpha variant A\nfn scale x ulong k ulong to ulong\n  res = mul x k\n  res = add res 1\n  ret res\nend\nfn main to int\n  a = ulong 7\n  b = scale a 3\n  if gt b 10\n    ret int sub b 10\n  end\n  ret 0\nend\n"
text omg_ex_b "om2\nnote completely renamed & reformatted\nfn compute_val alpha ulong beta ulong to ulong\n  out_v = mul alpha beta\n  out_v = add out_v 1\n  ret out_v\nend\nfn main to int\n  p = ulong 7\n  q = compute_val p 3\n  if gt q 10\n    ret int sub q 10\n  end\n  ret 0\nend\n"

fn omg_load_text s view uchar * to void
  n = len s
  for i ulong n
    put omg_src i get s i
  end
  put omg_nsrc 0 n
end

fn omg_report_metrics to void
  omg_put_str omg_m_hdr
  oflush
end

fn omg_selftest to ulong
  omg_corp_reset
  put omg_mac_cnt 0 0
  put omg_mac_pcur 0 0
  note 1. Macro register + deduplication
  put omg_mac_tmp_in 0 OMG_TY_U64
  put omg_mac_tmp_tok 0 ushort OMG_OP_ADD
  put omg_mac_tmp_tok 1 ushort OMG_OP_MUL
  put omg_mac_tmp_tok 2 ushort 256
  put omg_mac_tmp_tok 3 ushort add OMG_LIT_BASE 2
  put omg_mac_tmp_tok 4 ushort add OMG_LIT_BASE 1
  put omg_mac_tmp_len 0 5
  m0 = omg_macro_register 0 OMG_TY_U64 1
  m1 = omg_macro_register 0 OMG_TY_U64 1
  if or lt m0 0 ne m0 m1
    ret 1
  end
  note 2. Alpha-equivalence parse + SEMANTIC_ID
  omg_load_text omg_ex_a
  if ne omg_parse_om 0
    ret 2
  end
  na = get omg_ntok 0
  sid_a = omg_semantic_id
  if ne omg_corpus_add 1
    ret 3
  end
  if ne omg_corpus_add 0
    ret 4
  end
  omg_load_text omg_ex_b
  if ne omg_parse_om 0
    ret 5
  end
  nb = get omg_ntok 0
  sid_b = omg_semantic_id
  if or ne na nb ne sid_a sid_b
    ret 6
  end
  note 3. Roundtrip OMG -> .om -> OMG
  if ne omg_decode_om 0
    ret 7
  end
  nd = get omg_ndec 0
  for i ulong nd
    put omg_src i get omg_dec i
  end
  put omg_nsrc 0 nd
  if ne omg_parse_om 0
    ret 8
  end
  if ne omg_semantic_id sid_a
    ret 9
  end
  note 4. 200 masked samples inside selftest + mutant rejection
  for sd ulong 200
    if ne omg_sample_masked add 1000 sd 96 0
      ret 10
    end
    if ne omg_validate 0
      ret 11
    end
  end
  note Mutant: inject invalid token at index 1
  put omg_toks 1 ushort 254
  if eq omg_validate 0
    ret 12
  end
  omg_report_metrics
  omg_put_str omg_st_p1
  oputu 200
  omg_put_str omg_st_p2
  oputx sid_a
  omg_put_str omg_st_p3
  oputu na
  omg_put_str omg_st_p4
  oputu len omg_ex_a
  omg_put_str omg_st_p5
  oflush
  ret 0
end

fn cmdomg to void
  r = omg_selftest
  if ne r 0
    exit int r
  end
end
