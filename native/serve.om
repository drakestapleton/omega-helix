fn svf_put4 dst ulong j ulong to void
if eq dst 0
put sv_q j get oq 0
put sv_q add j 1 get oq 1
put sv_q add j 2 get oq 2
put sv_q add j 3 get oq 3
ret
end
if eq dst 1
put sv_k j get oq 0
put sv_k add j 1 get oq 1
put sv_k add j 2 get oq 2
put sv_k add j 3 get oq 3
ret
end
if eq dst 2
put sv_v j get oq 0
put sv_v add j 1 get oq 1
put sv_v add j 2 get oq 2
put sv_v add j 3 get oq 3
ret
end
if eq dst 3
put sv_hm j get oq 0
put sv_hm add j 1 get oq 1
put sv_hm add j 2 get oq 2
put sv_hm add j 3 get oq 3
ret
end
if eq dst 4
put sv_fp j get oq 0
put sv_fp add j 1 get oq 1
put sv_fp add j 2 get oq 2
put sv_fp add j 3 get oq 3
ret
end
put sv_h j get oq 0
put sv_h add j 1 get oq 1
put sv_h add j 2 get oq 2
put sv_h add j 3 get oq 3
end

fn svf_put1 dst ulong j ulong v f64 to void
if eq dst 0
put sv_q j v
ret
end
if eq dst 1
put sv_k j v
ret
end
if eq dst 2
put sv_v j v
ret
end
if eq dst 3
put sv_hm j v
ret
end
if eq dst 4
put sv_fp j v
ret
end
put sv_h j v
end

fn svf_loadx src ulong r ulong to void
if eq src 0
for i ulong r
put sv_fp i get sv_a i
end
ret
end
if eq src 1
for i2 ulong r
put sv_fp i2 get sv_o i2
end
ret
end
if eq src 2
for i3 ulong r
v = get sv_fp i3
if le v 0.0
v = 0.0f64
end
put sv_fp i3 v
end
end
end

fn svf_vm src ulong dst ulong wv ulong r ulong c ulong to void
svf_loadx src r
if owinb wv
bo = sub wv get og 34
j = ulong 0
while le add j 4 c bound 999999
svf_mv4_b add bo j r c
svf_put4 dst j
j = add j 4
end
while lt j c bound 4
svf_put1 dst j svf_mv1_b add bo j r c
j = add j 1
end
ret
end
wo = opx wv
j2 = ulong 0
while le add j2 4 c bound 999999
svf_mv4_a add wo j2 r c
svf_put4 dst j2
j2 = add j2 4
end
while lt j2 c bound 4
svf_put1 dst j2 svf_mv1_a add wo j2 r c
j2 = add j2 1
end
end

fn svf_tr_base slot ulong bk ulong to ulong
b = get sv_sblks add mul slot SV_MAX_BLKS_SLOT bk
ret mul b get sv_kstat 10
end

fn svf_tr_hrow slot ulong t ulong to ulong
bo = svf_tr_base slot div t SV_BLK
r = mul 2 get sv_kstat 11
r = add mul r SV_BLK rem t SV_BLK
ret add bo mul r get og 2
end

fn svf_br_sbo slot ulong bi ulong to ulong
st = mul get sv_cfg 13 SV_MAX_BLKS_SLOT
s0 = mul slot st
ret add s0 mul bi SV_MAX_BLKS_SLOT
end

fn svf_write_tkv ko ulong vo ulong d ulong to void
for i ulong d
put sv_kv add ko i get sv_k i
put sv_kv add vo i get sv_v i
end
end

fn svf_kv_put_tr slot ulong l ulong t ulong to void
d = get og 2
bo = svf_tr_base slot div t SV_BLK
o = rem t SV_BLK
rk = add mul mul 2 l SV_BLK o
rv = add rk SV_BLK
svf_write_tkv add bo mul rk d add bo mul rv d d
end

fn svf_write_bkv ko ulong vo ulong d ulong to void
for i ulong d
put sv_bkv add ko i get sv_k i
put sv_bkv add vo i get sv_v i
end
