fn svf_kv_put_br slot ulong bi ulong t ulong to void
d = get og 2
sbo = svf_br_sbo slot bi
b = get sv_sbblk add sbo div t SV_BLK
bo = mul b get sv_cfg 15
o = rem t SV_BLK
svf_write_bkv add bo mul o d add bo mul add SV_BLK o d d
end

fn svf_h_put_tr slot ulong t ulong to void
d = get og 2
ho = svf_tr_hrow slot t
for i ulong d
put sv_kv add ho i get sv_h i
end
end

fn svf_h_get_tr slot ulong t ulong to void
d = get og 2
ho = svf_tr_hrow slot t
for i ulong d
put sv_h i get sv_kv add ho i
end
end

fn svf_dot_kv qo ulong ko ulong e ulong to f64
s = 0.0f64
for i ulong e
s = add s mul get sv_q add qo i get sv_kv add ko i
end
ret s
end

fn svf_dot_bkv qo ulong ko ulong e ulong to f64
s = 0.0f64
for i ulong e
s = add s mul get sv_q add qo i get sv_bkv add ko i
end
ret s
