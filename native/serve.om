qo = mul n get og 7
m = bitcast f64 ulong 18442240474082181120
nb = div t SV_BLK
j = ulong 0
bk = ulong 0
while le bk nb bound 4097
lim = svf_att_lim bk nb t
m = fmax m svf_att_sc_tr_blk svf_tr_kb slot l bk lim qo j
j = add j lim
bk = add bk 1
end
ret m
end

