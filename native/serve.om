fn svf_soft_att np ulong m f64 to void
sm = 0.0f64
j = ulong 0
while lt j np bound 32769
ev = fexp sub get sv_att j m
put sv_att j ev
sm = add sm ev
j = add j 1
end
k = ulong 0
while lt k np bound 32769
put sv_att k div get sv_att k sm
k = add k 1
end
end

fn svf_att_lim bk ulong nb ulong t ulong to ulong
if eq bk nb
ret add rem t SV_BLK 1
end
ret SV_BLK
end

