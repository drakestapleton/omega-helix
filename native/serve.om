note ======== small byte helpers over wb

note svmcat: copy text t into wb at p, at most up to e; the next p
fn svmcat wb edit uchar 1073664 p ulong e ulong t view uchar * to ulong
q = p
for i ulong len t
if ge q e
ret q
end
put wb q get t i
q = add q 1
end
ret q
end

note svmdec: v in decimal into wb at p (at most 20 digits, up to e); the next p
fn svmdec wb edit uchar 1073664 p ulong e ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for k ulong sub 20 i
if ge q e
ret q
end
put wb q get d add i k
q = add q 1
end
ret q
end

note svat: whether the content at p starts with the pattern wb[po, po + pl) (p + pl <= content)
fn svat wb edit uchar 1073664 p ulong po ulong pl ulong to bool
for i ulong pl
if ne get wb add 8192 add p i get wb add po i
ret false
end
end
ret true
end

note svfind: the first position >= s where the pattern wb[po, po + pl) lies wholly in the content
note [0, n), or jsnone
fn svfind wb edit uchar 1073664 s ulong n ulong po ulong pl ulong to ulong
p = s
while le add p pl n bound 65537
if svat wb p po pl
ret p
end
p = add p 1
end
ret jsnone
end

note svpsuf: the longest k < pl, k <= n - lo, with content [n - k, n) a prefix of the pattern
fn svpsuf wb edit uchar 1073664 lo ulong n ulong po ulong pl ulong to ulong
k = sub pl 1
if lt sub n lo k
k = sub n lo
end
m = k
for it ulong m
if svat wb sub n k po k
ret k
end
k = sub k 1
end
ret 0
end

fn svisws c ulong to bool
ret or or eq c 32 eq c 9 or eq c 10 eq c 13
end

note svtrim: h moved back over trailing whitespace of the content, not below lo
fn svtrim wb edit uchar 1073664 lo ulong h ulong to ulong
if le h lo
ret h
end
q = h
for it ulong sub h lo
if not svisws ulong get wb add 8191 q
break
end
q = sub q 1
end
ret q
end

note svskws: p moved over whitespace of the content, not past n
fn svskws wb edit uchar 1073664 p ulong n ulong to ulong
q = p
for it ulong sub n p
if not svisws ulong get wb add 8192 q
break
end
q = add q 1
end
ret q
end

note ======== UTF-8 (RFC 3629 section 4)

note svu8n: the sequence at a[p], with a[0 .. n) the bytes so far: 1 .. 4 its length when well
note formed; 0 when a[p .. n) is a proper prefix of a well-formed sequence; 8 + k when its maximal
note ill-formed subpart is k bytes (replaced by one U+FFFD)
fn svu8n a view uchar * p ulong n ulong to ulong
c = ulong get a p
if lt c 128
ret 1
end
k = svu8k c
if eq k 0
ret 9
end
for i ulong sub k 1
q = add p add i 1
if ge q n
ret 0
end
if not svu8ok c i ulong get a q
ret add 9 i
end
end
ret k
end

note svu8k: the sequence length a lead byte c >= 128 starts, 0 when it starts none
fn svu8k c ulong to ulong
if and ge c 194 le c 223
ret 2
end
if and ge c 224 le c 239
ret 3
end
if and ge c 240 le c 244
ret 4
end
ret 0
end

note svu8ok: whether b may be continuation byte i (0 the first) after lead byte c (RFC 3629 table)
fn svu8ok c ulong i ulong b ulong to bool
lo = ulong 128
hi = ulong 191
if eq i 0
if eq c 224
lo = 160
end
if eq c 237
hi = 159
end
if eq c 240
lo = 144
end
if eq c 244
hi = 143
end
end
ret and ge b lo le b hi
end

note svrepl: U+FFFD (EF BF BD) into the content at its end
fn svrepl wb edit uchar 1073664 sv edit ulong 64 to void
g = add 8192 get sv 13
put wb g 239
put wb add g 1 191
put wb add g 2 189
put sv 13 add get sv 13 3
end

note svclean: move the complete sequences of the raw bytes wb[0, sv12) to the content; fin 1 also
note replaces a cut tail. The rest moves to the front of the raw bytes.
fn svclean wb edit uchar 1073664 sv edit ulong 64 fin ulong to void
rn = get sv 12
p = ulong 0
for it ulong add rn 1
if ge p rn
break
end
r = svu8n wb p rn
if eq r 0
if eq fin 0
break
end
svrepl wb sv
p = rn
else
if gt r 8
svrepl wb sv
p = add p sub r 8
else
svmove wb add 8192 get sv 13 p r
put sv 13 add get sv 13 r
p = add p r
end
end
end
svmove wb 0 p sub rn p
put sv 12 sub rn p
end

note svmove: wb[d, d + n) = wb[s, s + n), copying forward (d <= s or the ranges apart)
fn svmove wb edit uchar 1073664 d ulong s ulong n ulong to void
for i ulong n
put wb add d i get wb add s i
end
end

note ======== responses

fn svstat cs edit ulong 320 io edit uchar 131072 code ulong t view uchar * to long
r = hrspst cs io code
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhend cs io 0 len t
r = hfe r hput cs io t
ret hfe r hwfin cs io
end

note svs503: the fixed server_busy error with Retry-After: 1
fn svs503 cs edit ulong 320 io edit uchar 131072 to long
r = hrspst cs io 503
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhname cs io svtra
r = hfe r hhval cs io svone
r = hfe r hhend cs io 0 len svt503
r = hfe r hput cs io svt503
ret hfe r hwfin cs io
end

note svsend: the writer's text ob[1040, 1040 + n) as a JSON response with status code
fn svsend cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 code ulong n ulong to long
r = hrspst cs io code
r = hfe r hhname cs io svtctyp
r = hfe r hhval cs io svtjson
r = hfe r hhend cs io 0 n
r = hfe r hput cs io view part ob 1040 n
ret hfe r hwfin cs io
end

fn svwt ob edit uchar 409600 t view uchar * to void
js_wsbuf ob t 0 len t
end

note svemsg: the message of error code sv16 into wb[81920 ..); its length
fn svemsg wb edit uchar 1073664 sv edit ulong 64 to ulong
e = get sv 16
b = ulong 81920
z = ulong 82176
p = b
if eq e 1
p = svmcat wb p z sem1
end
if eq e 2
p = svmcat wb p z sem2
end
if eq e 3
p = svmcat wb p z sem3
end
if eq e 4
p = svmcat wb p z sem4
end
if eq e 5
p = svmcat wb p z sem5
end
if eq e 6
p = svmcat wb p z sem6a
p = svmdec wb p z get sv 23
p = svmcat wb p z sem6b
end
if eq e 7
p = svmcat wb p z sem7
end
if eq e 8
p = svmcat wb p z sem8
end
if eq e 9
p = svmcat wb p z sem9
end
if eq e 10
p = svmcat wb p z sem10
end
if eq e 11
p = svmcat wb p z sem11a
p = svmdec wb p z get sv 6
p = svmcat wb p z sem11b
p = svmdec wb p z get sv 19
p = svmcat wb p z sem11c
end
if eq e 12
p = svmcat wb p z sem12
end
if eq e 13
p = svmcat wb p z sem13
end
if eq e 14
p = svmcat wb p z sem14
end
if eq e 15
p = svmcat wb p z sem15
end
if eq e 16
p = svmcat wb p z sem16
end
ret sub svemsg2 wb e p z b
end

note svemsg2: the messages of error codes 17 .. 25 at p; the end
fn svemsg2 wb edit uchar 1073664 e ulong p ulong z ulong to ulong
if eq e 17
ret svmcat wb p z sem17
end
if eq e 18
ret svmcat wb p z sem18
end
if eq e 19
ret svmcat wb p z sem19
end
if eq e 20
ret svmcat wb p z sem20
end
if eq e 21
ret svmcat wb p z sem21
end
if eq e 22
ret svmcat wb p z sem22
end
if eq e 23
ret svmcat wb p z sem23
end
if eq e 24
ret svmcat wb p z sem24
end
if eq e 25
ret svmcat wb p z sem25
end
if eq e 26
ret svmcat wb p z sem26
end
if eq e 27
ret svmcat wb p z sem27
end
if eq e 28
ret svmcat wb p z sem28
end
if eq e 29
ret svmcat wb p z sem29
end
if eq e 30
ret svmcat wb p z sem30
end
if eq e 31
ret svmcat wb p z sem31
end
if eq e 32
ret svmcat wb p z sem32
end
if eq e 33
ret svmcat wb p z sem33
end
if eq e 34
ret svmcat wb p z sem34
end
ret p
end

fn svecode ob edit uchar 409600 e ulong to void
if eq e 1
svwt ob secjson
ret
end
if eq e 11
svwt ob secctx
ret
end
if or eq e 13 eq e 25
svwt ob secbig
ret
end
if eq e 14
svwt ob secnf
ret
end
if eq e 15
svwt ob secmeth
ret
end
if eq e 16
svwt ob secint
ret
end
svwt ob secreq
end

note svfail: {"error":{"message","type","param":null,"code"}} for error code sv16 with status st
fn svfail cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 st ulong to long
ob = new uchar 409600 0
put sv 21 st
m = svemsg wb sv
x = js_winit ob
js_wobj ob
svwt ob skerr
js_wobj ob
svwt ob skmsg
js_wsbuf ob wb 81920 m
svwt ob sktype
if eq st 500
svwt ob svsrv
else
svwt ob svinv
end
svwt ob skparam
js_wnull ob
svwt ob skcode
svecode ob get sv 16
js_wobje ob
js_wobje ob
n = js_wdone ob
if lt n 0
put cs HKEEP 0
ret hrsperr cs io 500
end
ret svsend cs io ob st ulong n
end

note svhead: {"id", "object" t, "created", "model" opened; the caller adds the rest
fn svhead ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 t view uchar * to void
x = js_winit ob
js_wobj ob
svwt ob skid
js_wsbuf ob wb 82176 get sv 15
svwt ob skobj
svwt ob t
svwt ob skcrt
js_wulong ob get sv 10
svwt ob skmodel
svmidw ob
end

note svmidw: the model id as a JSON string value (the checkpoint id; OMUTMID 0: the fixed `ollm`)
fn svmidw ob edit uchar 409600 to void
if eq OMUTMID 0
svwt ob svollm
else
js_wsbeg ob
for i ulong get svml 0
js_wsb ob get svmi i
end
js_wsend ob
end
end

note svicat: copy text t into svmi at p, at most up to e; the next p
fn svicat p ulong e ulong t view uchar * to ulong
q = p
for i ulong len t
if ge q e
ret q
end
put svmi q get t i
q = add q 1
end
ret q
end

note svidec: v in decimal into svmi at p (at most 20 digits, up to e); the next p
fn svidec p ulong e ulong v ulong to ulong
d = new uchar 20 0
i = ulong 20
x = v
for it ulong 20
i = sub i 1
put d i uchar add rem x 10 48
x = div x 10
if eq x 0
break
end
end
q = p
for it ulong sub 20 i
if ge q e
ret q
end
put svmi q get d add i it
q = add q 1
end
ret q
end

note svihex: v as 16 lowercase hex digits into svmi at p, at most up to e; the next p
fn svihex p ulong e ulong v ulong to ulong
q = p
for i ulong 16
if ge q e
ret q
end
d = and shr v mul sub 15 i 4 15
c = add d 48
if gt d 9
c = add d 87
end
put svmi q uchar c
q = add q 1
end
ret q
end

note svmid: the model id of the checkpoint loaded from argv[3] (ockload has run and checked it)
note into svmi, its length into svml, then `MODEL id` on stdout. The header is read again for
note its payload FNV-1a field, which ockload keeps only while it loads.
fn svmid to void
hl = ulong 112
if eq get og 46 2
hl = 120
end
if eq get og 46 3
hl = 144
end
if eq get og 46 5
hl = 256
end
hn = oprd 3 0 0 hl
if lt hn hl
exit 10
end
e = ulong 192
p = svicat 0 e svmid1
p = svidec p e get og 46
p = svicat p e svmidv
p = svidec p e get og 0
p = svicat p e svmidt
p = svidec p e get og 1
p = svicat p e svmidd
p = svidec p e get og 2
p = svicat p e svmidh
p = svidec p e get og 3
p = svicat p e svmidl
p = svidec p e get og 5
p = svicat p e svmids
p = svidec p e get og 41
p = svicat p e svmidf
p = svihex p e opw8 sub hl 8
put svml 0 p
for i ulong len svmodl
oputc ulong get svmodl i
end
for i ulong p
oputc ulong get svmi i
end
oputc 10
end

note svmod_ent: append one model object with id text t (or checkpoint id when use_mid is 1)
fn svmod_ent ob edit uchar 409600 t view uchar * use_mid ulong to void
js_wobj ob
svwt ob skid
if eq use_mid 1
svmidw ob
else
svwt ob t
end
svwt ob skobj
svwt ob skmodel
svwt ob skcrt
js_wulong ob 0
svwt ob skowned
svwt ob svaien
js_wobje ob
end

note svmod_str: append model entry for strand index s
fn svmod_str ob edit uchar 409600 s ulong to void
if eq s 0
svmod_ent ob svst0 0
end
if eq s 1
svmod_ent ob svst1 0
end
if eq s 2
svmod_ent ob svst2 0
end
if eq s 3
svmod_ent ob svst3 0
end
end

note svmodw: the /v1/models answer (base model plus loaded strands and spclip when present)
fn svmodw cs edit ulong 320 io edit uchar 131072 to long
ob = new uchar 409600 0
x = js_winit ob
js_wobj ob
svwt ob skobj
svwt ob svtlist
svwt ob skdata
js_warr ob
svmod_ent ob svollm 1
ns = get sv_cfg 4
for s ulong ns
svmod_str ob s
end
if ge ns 2
svmod_ent ob svspclp 0
end
js_warre ob
js_wobje ob
m = js_wdone ob
if lt m 0
put cs HKEEP 0
ret hrsperr cs io 500
end
ret svsend cs io ob 200 ulong m
end

note svhealth: dynamic JSON /health reporting active slots, max_slots, max_ctx, strands, and kv_cache
fn svhealth cs edit ulong 320 io edit uchar 131072 sv edit ulong 64 to long
ob = new uchar 409600 0
x = js_winit ob
js_wobj ob
svwt ob skstatus
svwt ob svoktxt
svwt ob skinfl
nact = get sv_cfg 12
js_wulong ob nact
svwt ob skmxsl
msl = get sv_cfg 0
if eq msl 0
msl = ulong 1
end
js_wulong ob msl
svwt ob skbusy
js_wbool ob ge nact msl
svwt ob skmxctx
js_wulong ob get sv_cfg 1
svwt ob skstrnd
js_wulong ob get sv_cfg 4
svwt ob skkvc
js_wobj ob
svwt ob skentr
js_wulong ob get sv_kstat 2
svwt ob skcap
js_wulong ob get sv_kstat 3
svwt ob skhits
js_wulong ob get sv_kstat 5
svwt ob skmiss
js_wulong ob get sv_kstat 6
svwt ob sktksav
js_wulong ob get sv_kstat 7
svwt ob skcolrj
js_wulong ob get sv_kstat 8
svwt ob skevict
js_wulong ob get sv_kstat 9
js_wobje ob
js_wobje ob
m = js_wdone ob
if lt m 0
put cs HKEEP 0
ret hrsperr cs io 500
end
put sv 21 200
r = svsend cs io ob 200 ulong m
svlog sv
ret r
end

note svmods: GET /v1/models, logged
fn svmods cs edit ulong 320 io edit uchar 131072 sv edit ulong 64 to long
put sv 21 200
r = svmodw cs io
svlog sv
ret r
end

note svbig: the status for a body over the bound, 413 (OMUTBIG 0: 400, the 413 refusal removed)
fn svbig to ulong
if eq OMUTBIG 0
ret 400
end
ret 413
end

fn svfr ob edit uchar 409600 sv edit ulong 64 to void
f = get sv 8
if eq f 1
svwt ob svstop
ret
end
if eq f 2
svwt ob svlen
ret
end
if eq f 3
svwt ob sktcall
ret
end
js_wnull ob
end

fn svusage ob edit uchar 409600 sv edit ulong 64 to void
svwt ob skusage
js_wobj ob
svwt ob skpt
js_wulong ob get sv 6
svwt ob skct
js_wulong ob get sv 7
svwt ob sktt
js_wulong ob add get sv 6 get sv 7
svwt ob skptd
js_wobj ob
svwt ob skctok
js_wulong ob get sv 43
js_wobje ob
js_wobje ob
end

note svwcalls: the tool_calls array (idx 1 adds each call's index, as a stream delta does)
fn svwcalls ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 idx ulong to void
js_warr ob
for i ulong get sv 32
b = mul i 4
js_wobj ob
if eq idx 1
svwt ob skidx
js_wulong ob i
end
svwt ob skid
p = svmcat wb 82240 82432 svcallp
p = svmdec wb p 82432 get sv 9
p = svmcat wb p 82432 svus
p = svmdec wb p 82432 i
js_wsbuf ob wb 82240 sub p 82240
svwt ob sktype
svwt ob skfunc
svwt ob skfunc
js_wobj ob
svwt ob sknam
js_wsbuf ob bd get svtcx b get svtcx add b 1
svwt ob skargs
js_wsbuf ob bd get svtcx add b 2 get svtcx add b 3
js_wobje ob
js_wobje ob
end
js_warre ob
end

note svcfull: the text_completion object of /v1/completions
fn svcfull ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 to long
svhead ob wb sv svtcomp
svwt ob skchoi
js_warr ob
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob sktext
js_wsbuf ob wb 8192 get sv 13
svwt ob skfin
svfr ob sv
js_wobje ob
js_warre ob
svusage ob sv
js_wobje ob
ret js_wdone ob
end

note svfull: the chat.completion object (stream false), or svcfull on /v1/completions
fn svfull ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to long
if eq get sv 37 1
ret svcfull ob wb sv
end
svhead ob wb sv svcc
svwt ob skchoi
js_warr ob
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skmsg
js_wobj ob
svwt ob skrole
svwt ob svasst
svwt ob skcont
if gt get sv 32 0
h = svtrim wb 0 get sv 33
if eq h 0
js_wnull ob
else
js_wsbuf ob wb 8192 h
end
svwt ob sktcall
svwcalls ob wb sv bd 0
else
js_wsbuf ob wb 8192 get sv 13
end
js_wobje ob
svwt ob skfin
svfr ob sv
js_wobje ob
js_warre ob
svusage ob sv
js_wobje ob
ret js_wdone ob
end

note svchunk: one chat.completion.chunk; kind 0 the role, 1 the content wb[8192 + sv14, 8192 + sv17),
note 2 the finish reason, 3 usage (empty choices). Sends it as one SSE event.
fn svchunk cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 kind ulong to long
svhead ob wb sv svccc
svwt ob skchoi
js_warr ob
if ne kind 3
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skdelta
js_wobj ob
if eq kind 0
svwt ob skrole
svwt ob svasst
svwt ob skcont
note "" as zero bytes of a non-empty text: under omc e5b32567 an empty text passed as a view has a
note wrong length (omega-mv#775, fixed after this pin), and js_wsbuf then refuses it (jswearg)
js_wsbuf ob svasst 0 0
end
if eq kind 1
svwt ob skcont
g0 = get sv 14
js_wsbuf ob wb add 8192 g0 sub get sv 17 g0
end
js_wobje ob
svwt ob skfin
if eq kind 2
svfr ob sv
else
js_wnull ob
end
js_wobje ob
end
js_warre ob
if eq kind 3
svusage ob sv
end
js_wobje ob
ret svsse cs io ob js_wdone ob
end

note svsse: the writer's text ob[1040, 1040 + n) as one SSE event; -5 when n < 0
fn svsse cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 n long to long
if lt n 0
ret -5
end
r = hssedat cs io view part ob 1040 ulong n
ret hfe r hsseend cs io
end

note svtchunk: the tool_calls delta chunk (stream true)
fn svtchunk cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to long
svhead ob wb sv svccc
svwt ob skchoi
js_warr ob
js_wobj ob
svwt ob skidx
js_wulong ob 0
svwt ob skdelta
js_wobj ob
svwt ob sktcall
svwcalls ob wb sv bd 1
js_wobje ob
svwt ob skfin
js_wnull ob
js_wobje ob
js_warre ob
js_wobje ob
ret svsse cs io ob js_wdone ob
end

note ======== request parsing

note svtemp: the temperature token's lexeme at bd[o, o + n) as TEMPMILLI (digits, optional
note fraction, used to 0.001), or 999999 when it is not a number from 0 to 2
fn svtemp bd edit uchar 983040 o ulong n ulong to ulong
ip = ulong 0
fr = ulong 0
fd = ulong 0
dot = false
for i ulong n
c = ulong get bd add o i
if eq c 46
if dot
ret 999999
end
dot = true
else
if or lt c 48 gt c 57
ret 999999
end
if dot
if lt fd 3
fr = add mul fr 10 sub c 48
fd = add fd 1
end
else
if ge ip 100
ret 999999
end
ip = add mul ip 10 sub c 48
end
end
end
for k ulong 3
if lt fd 3
fr = mul fr 10
fd = add fd 1
end
end
m = add mul ip 1000 fr
if gt m 2000
ret 999999
end
ret m
end

note svtopp: the top_p token's lexeme at bd[o, o + n) in millionths (used to 0.000001), or jsnone
note when it is not a number from 0 to 1
fn svtopp bd edit uchar 983040 o ulong n ulong to ulong
ip = ulong 0
fr = ulong 0
fd = ulong 0
dot = false
for i ulong n
c = ulong get bd add o i
if eq c 46
if dot
ret jsnone
end
dot = true
else
if or lt c 48 gt c 57
ret jsnone
end
if dot
if lt fd 6
fr = add mul fr 10 sub c 48
fd = add fd 1
end
else
if ge ip 10
ret jsnone
end
ip = add mul ip 10 sub c 48
end
end
end
for k ulong 6
if lt fd 6
fr = mul fr 10
fd = add fd 1
end
end
m = add mul ip 1000000 fr
if gt m 1000000
ret jsnone
end
ret m
end

note svmem: the value token of member key in object o, or jsnone (the first when repeated)
fn svmem src view uchar * tp view uint 262144 o ulong key view uchar * to ulong
if ne js_type tp o 1
ret jsnone
end
k = js_first tp o
for it ulong js_nkids tp o
if eq k jsnone
break
end
if js_streq src js_off tp k key
ret add k 1
end
k = js_mnext tp k
end
ret jsnone
end

note svpcat: append text t to the template; false when it would pass tplmax (sv23)
fn svpcat wb edit uchar 1073664 sv edit ulong 64 t view uchar * to bool
pl = get sv 5
if gt add pl len t get sv 23
ret false
end
for i ulong len t
put wb add 90624 add pl i get t i
end
put sv 5 add pl len t
ret true
end

note svpstr: append the decoded string token t to the template
fn svpstr bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to bool
pl = get sv 5
cap = get sv 23
if ge pl cap
ret false
end
n = js_sget bd js_off tp t part wb add 90624 pl sub cap pl
if lt n 0
ret false
end
put sv 5 add pl ulong n
ret true
end

note svpraw: append token t's JSON text as sent (a container's whole span) to the template
fn svpraw bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to bool
ret svpcopy bd js_off tp t js_span tp t wb sv
end

note svpcopy: append bd[o, o + n) to the template; false when it would pass tplmax (sv23)
fn svpcopy bd edit uchar 983040 o ulong n ulong wb edit uchar 1073664 sv edit ulong 64 to bool
d = add 90624 get sv 5
if gt add get sv 5 n get sv 23
ret false
end
for i ulong n
put wb add d i get bd add o i
end
put sv 5 add get sv 5 n
ret true
end

note svparts: a content array of text parts into the template, joined with no separator
fn svparts bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
ty = svmem bd tp e sktype
tx = svmem bd tp e sktext
if or eq ty jsnone eq tx jsnone
ret 17
end
if or ne js_type tp ty 6 ne js_type tp tx 6
ret 17
end
if not js_streq bd js_off tp ty sktext
ret 17
end
if not svpstr bd tp tx wb sv
ret 6
end
e = js_enext tp e
end
ret 0
end

note svtc1r: one assistant tool call e as <tool_call>{"name":N,"arguments":A}</tool_call>
fn svtc1r bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
f = svmem bd tp e skfunc
if eq f jsnone
ret 23
end
nm = svmem bd tp f sknam
if eq nm jsnone
ret 23
end
if ne js_type tp nm 6
ret 23
end
ar = svmem bd tp f skargs
aty = ulong 0
if ne ar jsnone
aty = js_type tp ar
end
if and and ne aty 0 ne aty 6 ne aty 1
ret 23
end
if not svpcat wb sv svtcn
ret 6
end
if not svpraw bd tp nm wb sv
ret 6
end
if not svpcat wb sv svtca
ret 6
end
ok = true
if eq aty 6
ok = svpstr bd tp ar wb sv
end
if eq aty 1
ok = svpraw bd tp ar wb sv
end
if eq aty 0
ok = svpcat wb sv svempt
end
if not ok
ret 6
end
if not svpcat wb sv svtcz
ret 6
end
ret 0
end

note svtcs: an assistant message's tool_calls array a into the template
fn svtcs bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp a 3
ret 23
end
e = js_first tp a
for it ulong js_nkids tp a
if eq e jsnone
break
end
if not svpcat wb sv svtco
ret 6
end
r = svtc1r bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note svmsg1: one message object e into the template; 0 or an error code
fn svmsg1 bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp e 1
ret 3
end
ro = svmem bd tp e skrole
if eq ro jsnone
ret 5
end
if or ne js_type tp ro 6 gt js_slen tp ro 32
ret 5
end
co = svmem bd tp e skcont
tc = svmem bd tp e sktcall
if ne tc jsnone
if eq js_type tp tc 10
tc = jsnone
end
end
ct = ulong 10
if ne co jsnone
ct = js_type tp co
end
if and eq co jsnone eq tc jsnone
ret 4
end
if and and ne ct 6 ne ct 10 ne ct 3
ret 4
end
if not svpstr bd tp ro wb sv
ret 6
end
if not svpcat wb sv svsep
ret 6
end
if eq ct 6
if not svpstr bd tp co wb sv
ret 6
end
end
if eq ct 3
r = svparts bd tp co wb sv
if ne r 0
ret r
end
end
if ne tc jsnone
r = svtcs bd tp tc wb sv
if ne r 0
ret r
end
end
if not svpcat wb sv svnl
ret 6
end
ret 0
end

fn svmsgs bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp a 3
ret 3
end
n = js_nkids tp a
if eq n 0
ret 3
end
e = js_first tp a
for it ulong n
if eq e jsnone
break
end
r = svmsg1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
if not svpcat wb sv svaprm
ret 6
end
ret 0
end

note svtool1: one tools entry e; its name into wb[82432 + 64 i ..)
fn svtool1 bd edit uchar 983040 tp edit uint 262144 e ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
ty = svmem bd tp e sktype
f = svmem bd tp e skfunc
if or eq ty jsnone eq f jsnone
ret 21
end
if ne js_type tp ty 6
ret 21
end
if not js_streq bd js_off tp ty skfunc
ret 21
end
nm = svmem bd tp f sknam
if eq nm jsnone
ret 21
end
if ne js_type tp nm 6
ret 21
end
ret svtname bd js_off tp nm wb sv
end

note svtname: the tool name string at bd[o ..) into wb[82432 + 64 i ..), i = sv30
fn svtname bd edit uchar 983040 o ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
i = get sv 30
if ge i 128
ret 21
end
m = js_sget bd o part wb add 82432 mul i 64 64
if lt m 1
ret 21
end
put svtnl i ulong m
put sv 30 add i 1
ret 0
end

note svtools: the tools value a (jsnone when absent): checked, its names kept, its JSON text
note rendered as the template's first line
fn svtools bd edit uchar 983040 tp edit uint 262144 a ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq a jsnone
ret 0
end
ty = js_type tp a
if eq ty 10
ret 0
end
if ne ty 3
ret 21
end
n = js_nkids tp a
if gt n 128
ret 21
end
if eq n 0
ret 0
end
e = js_first tp a
for it ulong n
if eq e jsnone
break
end
r = svtool1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
if not svpcat wb sv svtlp
ret 6
end
if not svpraw bd tp a wb sv
ret 6
end
if not svpcat wb sv svnl
ret 6
end
ret 0
end

note svopts: stream_options value v: include_usage true sets sv4
fn svopts bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to void
if ne js_type tp v 1
ret
end
k = js_first tp v
for it ulong js_nkids tp v
if eq k jsnone
break
end
if js_streq bd js_off tp k skincl
if eq js_type tp add k 1 8
put sv 4 1
end
end
k = js_mnext tp k
end
end

note svscal: one scalar member (key token k, value k + 1); 0 or an error code
fn svscal bd edit uchar 983040 tp edit uint 262144 k ulong sv edit ulong 64 to ulong
o = js_off tp k
v = add k 1
ty = js_type tp v
vo = js_off tp v
if or js_streq bd o skmaxt js_streq bd o skmaxc
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 8
end
x = js_tou bd vo
if or eq x 0 gt x 999999
ret 8
end
put sv 1 x
ret 0
end
if js_streq bd o sktemp
if eq ty 10
ret 0
end
if ne ty 7
ret 7
end
if ne and js_nflags tp v 5 0
ret 7
end
m = svtemp bd vo js_span tp v
if gt m 2000
ret 7
end
put sv 2 m
ret 0
end
if js_streq bd o skseed
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 9
end
put sv 3 add js_tou bd vo sub 1 OMUTSEED
ret 0
end
if js_streq bd o skstrm
if eq ty 8
put sv 0 1
ret 0
end
if or eq ty 9 eq ty 10
ret 0
end
ret 10
end
if js_streq bd o skn
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd vo
ret 12
end
if ne js_tou bd vo 1
ret 12
end
ret 0
end
if js_streq bd o skopts
svopts bd tp v sv
end
ret 0
end

note svstop1: one stop string token t into wb[73728 + 128 i ..)
fn svstop1 bd edit uchar 983040 tp edit uint 262144 t ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if ne js_type tp t 6
ret 18
end
ret svstopn bd js_off tp t wb sv
end

note svstopn: the stop string at bd[o ..) into wb[73728 + 128 i ..), i = sv35
fn svstopn bd edit uchar 983040 o ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
i = get sv 35
if ge i 8
ret 18
end
m = js_sget bd o part wb add 73728 mul i 128 128
if lt m 1
ret 18
end
put svstl i ulong m
put sv 35 add i 1
ret 0
end

note svstopp: the stop value v (null, a string or an array of strings)
fn svstopp bd edit uchar 983040 tp edit uint 262144 v ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if eq ty 6
ret svstop1 bd tp v wb sv
end
if ne ty 3
ret 18
end
n = js_nkids tp v
if gt n 8
ret 18
end
e = js_first tp v
for it ulong n
if eq e jsnone
break
end
r = svstop1 bd tp e wb sv
if ne r 0
ret r
end
e = js_enext tp e
end
ret 0
end

note svtopk: the top_k value v; -1, 0 and null leave it off
fn svtopk bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if ne ty 7
ret 19
end
vo = js_off tp v
if js_isu bd vo
x = js_tou bd vo
if gt x 999999
ret 19
end
put sv 28 x
ret 0
end
if js_isl bd vo
if eq js_tol bd vo neg long 1
ret 0
end
end
ret 19
end

note svtchoi: the tool_choice value v; "none" turns tool-call detection off, "auto" keeps it.
note "required" and the {"type":"function"} object would have to force a call, which this server
note cannot do, so they are refused (22) rather than answered with free text.
fn svtchoi bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
if eq ty 6
o = js_off tp v
if js_streq bd o sknone
put sv 31 0
ret 0
end
if js_streq bd o svauto
ret 0
end
end
ret 22
end

note svnzero: whether the number lexeme bd[o, o + n) is zero (every digit before an exponent is 0)
fn svnzero bd edit uchar 983040 o ulong n ulong to bool
for i ulong n
c = ulong get bd add o i
if or eq c 101 eq c 69
ret true
end
if and ge c 49 le c 57
ret false
end
end
ret true
end

note svnoop: whether value v of an unimplemented member asks for nothing. null always does; md 1
note false; 2 true; 3 a number equal to 0; 4 an empty object; 5 an object whose "type" is "text"
fn svnoop bd edit uchar 983040 tp edit uint 262144 v ulong md ulong to bool
ty = js_type tp v
if eq ty 10
ret true
end
if eq md 1
ret eq ty 9
end
if eq md 2
ret eq ty 8
end
if eq md 3
if ne ty 7
ret false
end
ret svnzero bd js_off tp v js_span tp v
end
if ne ty 1
ret false
end
if eq md 4
ret eq js_nkids tp v 0
end
if ne md 5
ret false
end
t = svmem bd tp v sktype
if eq t jsnone
ret false
end
if ne js_type tp t 6
ret false
end
ret js_streq bd js_off tp t sktext
end

note svunsm: the svnoop mode of the unimplemented member whose key is at bd[o ..): 0 it is not
note one; 1 .. 5 as svnoop; 6 only null is accepted
fn svunsm bd edit uchar 983040 o ulong to ulong
if js_streq bd o sklogp
ret 1
end
if js_streq bd o skptc
ret 2
end
if or js_streq bd o skfpen js_streq bd o skppen
ret 3
end
if js_streq bd o sktlogp
ret 3
end
if js_streq bd o sklbias
ret 4
end
if js_streq bd o skrfmt
ret 5
end
if or js_streq bd o skfuncs js_streq bd o skfcall
ret 6
end
ret 0
end

note svscal3: a member that would change the output and is not implemented is refused (29)
note unless it carries its default, so a client never gets an answer that ignored its request
fn svscal3 bd edit uchar 983040 tp edit uint 262144 k ulong to ulong
md = svunsm bd js_off tp k
if eq md 0
ret 0
end
if svnoop bd tp add k 1 md
ret 0
end
ret 29
end

note svp_strand: parse "strand" value v; 0 or error code 30
fn svp_strand bd edit uchar 983040 tp edit uint 262144 v ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
put sv 45 1
ty = js_type tp v
if eq ty 10
put sv 38 0
ret 0
end
if eq ty 7
vo = js_off tp v
if not js_isu bd vo
ret 30
end
k = js_tou bd vo
if ge k get sv_cfg 4
ret 30
end
put sv 38 add k 1
ret 0
end
if ne ty 6
ret 30
end
ret svp_strand_s bd js_off tp v wb sv
end

fn svp_strand_s bd edit uchar 983040 o ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
ns = get sv_cfg 4
if js_streq bd o svbase
put sv 38 0
ret 0
end
if js_streq bd o svspclp
if lt ns 2
ret 30
end
put sv 38 5
ret 0
end
if js_streq bd o svst0
if ge 0 ns
ret 30
end
put sv 38 1
ret 0
end
if js_streq bd o svst1
if ge 1 ns
ret 30
end
put sv 38 2
ret 0
end
if js_streq bd o svst2
if ge 2 ns
ret 30
end
put sv 38 3
ret 0
end
if js_streq bd o svst3
if ge 3 ns
ret 30
end
put sv 38 4
ret 0
end
ml = js_sget bd o part wb 82176 8
if eq ml 1
c = ulong get wb 82176
if and ge c 48 le c 51
k = sub c 48
if lt k ns
put sv 38 add k 1
ret 0
end
end
end
ret 30
end

note svp_model: optional model name routing (strand:k / spclip) when strand is not explicitly set
fn svp_model bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to void
if ne get sv 45 0
ret
end
if ne js_type tp v 6
ret
end
o = js_off tp v
ns = get sv_cfg 4
if and js_streq bd o svspclp ge ns 2
put sv 38 5
ret
end
if and js_streq bd o svst0 gt ns 0
put sv 38 1
ret
end
if and js_streq bd o svst1 gt ns 1
put sv 38 2
ret
end
if and js_streq bd o svst2 gt ns 2
put sv 38 3
ret
end
if and js_streq bd o svst3 gt ns 3
put sv 38 4
end
end

note svp_spw_elem: read one element weight into sv_cur_spw[k]; returns positive contribution or -1 on error
fn svp_spw_elem bd edit uchar 983040 tp edit uint 262144 e ulong k ulong to long
if or eq e jsnone ne js_type tp e 7
ret -1
end
eo = js_off tp e
if not js_isl bd eo
ret -1
end
w = js_tol bd eo
if lt w -5000
ret -1
end
if gt w 5000
ret -1
end
put sv_cur_spw k w
if gt w 0
ret w
end
ret 0
end

note svp_spw: parse spclip_weights array of S ints in [-5000..5000] with positive weight sum; 0 or 32
fn svp_spw bd edit uchar 983040 tp edit uint 262144 v ulong sv edit ulong 64 to ulong
ty = js_type tp v
if eq ty 10
ret 0
end
ss = get sv_cfg 4
if or ne ty 3 lt ss 2
ret 32
end
if ne js_nkids tp v ss
ret 32
end
sw = long 0
e = js_first tp v
for k ulong ss
d = svp_spw_elem bd tp e k
if lt d 0
ret 32
end
sw = add sw d
e = js_enext tp e
end
if le sw 0
ret 32
end
put sv 41 1
ret 0
end

note svtest: a test-only member (key k), refused unless the server runs with test=1
fn svtest bd edit uchar 983040 tp edit uint 262144 k ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq get sv 22 0
ret 24
end
v = add k 1
ty = js_type tp v
vo = js_off tp v
if js_streq bd js_off tp k sktdel
if ne ty 7
ret 24
end
if not js_isu bd vo
ret 24
end
x = js_tou bd vo
if gt x 10000
ret 24
end
put sv 27 x
ret 0
end
if ne ty 6
ret 24
end
m = js_sget bd vo part wb 8192 16384
if lt m 0
ret 24
end
put sv 25 1
put sv 26 ulong m
ret 0
end

note svscal2: stop, top_k, top_p, tool_choice, routing, cache_prefix, and test-only fields; 0 or a code
fn svscal2 bd edit uchar 983040 tp edit uint 262144 k ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
o = js_off tp k
v = add k 1
if js_streq bd o svstop
ret svstopp bd tp v wb sv
end
if js_streq bd o sktopk
ret svtopk bd tp v sv
end
if js_streq bd o sktopp
ty = js_type tp v
if eq ty 10
ret 0
end
if ne ty 7
ret 20
end
if ne and js_nflags tp v 5 0
ret 20
end
m = svtopp bd js_off tp v js_span tp v
if eq m jsnone
ret 20
end
put sv 29 m
ret 0
end
if js_streq bd o sktchoi
ret svtchoi bd tp v sv
end
if js_streq bd o skstrand
ret svp_strand bd tp v wb sv
end
if js_streq bd o skspmod
ty = js_type tp v
if eq ty 10
ret 0
end
if or ne ty 7 not js_isu bd js_off tp v
ret 31
end
md = js_tou bd js_off tp v
if gt md 1
ret 31
end
put sv 39 md
put sv 40 1
ret 0
end
if js_streq bd o skspwts
ret svp_spw bd tp v sv
end
if js_streq bd o skcpref
ty = js_type tp v
if eq ty 8
put sv 42 1
ret 0
end
if eq ty 9
put sv 42 0
ret 0
end
if eq ty 10
ret 0
end
ret 33
end
if js_streq bd o sktcol
if eq get sv 22 0
ret 34
end
ty = js_type tp v
if eq ty 8
put sv 44 1
ret 0
end
if or eq ty 9 eq ty 10
put sv 44 0
ret 0
end
ret 34
end
if js_streq bd o skmodel
svp_model bd tp v sv
ret 0
end
if or js_streq bd o sktout js_streq bd o sktdel
ret svtest bd tp k wb sv
end
ret 0
end

note svseed: the seed state of a request that names none: the wall clock mixed with the request
note count, so two requests with the same body draw differently. A request's own seed replaces it
note (svscal), and only that is reproducible.
fn svseed sv edit ulong 64 to ulong
t = bitcast ulong realns
ret smx xor t mul add get sv_cfg 17 1 11400714819323198485
end

note svreset: a request's options to their defaults
fn svreset sv edit ulong 64 to void
put sv 0 0
put sv 1 999999
put sv 2 1000
put sv 3 svseed sv
put sv 4 0
put sv 5 0
for i ulong 12
put sv add 24 i 0
end
put sv 29 1000000
put sv 31 1
put sv 38 0
put sv 39 1
put sv 40 0
put sv 41 0
put sv 42 1
put sv 43 0
put sv 44 0
put sv 45 0
for j ulong 4
put sv_cur_spw j 1000
end
end

note svparse: the request body bd[0, n) into sv and the template; 0 or an error code
fn svparse bd edit uchar 983040 n ulong wb edit uchar 1073664 sv edit ulong 64 to ulong
tp = new uint 262144 0
x = js_init tp 983040 64
r = js_parse bd tp n
if lt r 0
if eq r neg long jsetok
ret 25
end
if eq OMUTJSON 0
svreset sv
put sv 1 1
ret 0
end
ret 1
end
if ne js_type tp 0 1
ret 2
end
svreset sv
k = js_first tp 0
for it ulong js_nkids tp 0
if eq k jsnone
break
end
e = svscal bd tp k sv
if eq e 0
e = svscal2 bd tp k wb sv
end
if eq e 0
e = svscal3 bd tp k
end
if ne e 0
ret e
end
k = js_mnext tp k
end
if and eq get sv 45 0 or ne get sv 40 0 ne get sv 41 0
if lt get sv_cfg 4 2
ret 30
end
if eq get sv 38 0
put sv 38 5
end
end
if and eq get sv 38 5 lt get sv_cfg 4 2
ret 30
end
if eq get sv 37 1
ret svcprm bd tp wb sv
end
ma = svmem bd tp 0 skmsgs
if eq ma jsnone
ret 3
end
e = svtools bd tp svmem bd tp 0 sktools wb sv
if ne e 0
ret e
end
if eq get sv 30 0
put sv 31 0
end
ret svmsgs bd tp ma wb sv
end

note svcprm: a /v1/completions body after its scalars: prompt (a non-empty string) is the whole
note template, with no role lines and no assistant prefix; stream true, messages, tools and
note tool_choice are refused; 0 or an error code
fn svcprm bd edit uchar 983040 tp edit uint 262144 wb edit uchar 1073664 sv edit ulong 64 to ulong
if eq get sv 0 1
ret 27
end
if ne svmem bd tp 0 skmsgs jsnone
ret 28
end
if ne svmem bd tp 0 sktools jsnone
ret 28
end
if ne svmem bd tp 0 sktchoi jsnone
ret 28
end
pr = svmem bd tp 0 skprompt
if eq pr jsnone
ret 26
end
if or ne js_type tp pr 6 eq js_slen tp pr 0
ret 26
end
put sv 30 0
put sv 31 0
if not svpstr bd tp pr wb sv
ret 6
end
ret 0
end

note ======== encoding

note svemit: token t, the m-th of an encoding: md 0 into active slot's sv_tok, md 1 into svft, md 2 into obx
fn svemit md ulong m ulong t ulong to void
if eq md 0
sl = get sv_cfg 10
mc = get sv_cfg 1
pos = add m 1
if lt pos mc
put sv_tok add mul sl mc pos t
end
ret
end
if eq md 2
if lt get og 9 get og 1
ocpush t
end
ret
end
if lt m 4096
put svft m t
end
end

note svenc1: the pre-token oarg[i, i + l) encoded and emitted after m tokens; the new count
fn svenc1 i ulong l ulong md ulong m ulong to ulong
for k ulong l
put bqtm k ushort get oarg add i k
end
c = bpenct l
for k ulong c
svemit md add m k ulong get bqtm k
end
ret add m c
end

note svenc: encode src[0, n) of any length as obpenc does, in windows of at most 4000 bytes copied
note to oarg; a window ends at a pre-token boundary at least 64 bytes before its end (a pre-token
note is at most 64 bytes, so the boundaries agree with one pass), the last one at n. Returns the
note token count.
fn svenc src view uchar * n ulong md ulong to ulong
s = ulong 0
m = ulong 0
while lt s n bound 999999
w = sub n s
if gt w 4000
w = 4000
end
for k ulong w
put oarg k get src add s k
end
la = eq add s w n
i = ulong 0
while lt i w bound 4097
if and not la gt add i 64 w
break
end
l = bpclena i w
m = svenc1 i l md m
i = add i l
end
s = add s i
end
ret m
end

note ======== strand loader, paged shared-trunk KV cache, and single-row streaming forward

note sv_open_arg: open path at argv[ai][skp..n); exit 60 if invalid or unreadable
fn sv_open_arg ai ulong skp ulong to int
n = oargp ai
if le n skp
exit 60
end
fd = int fopen oarg skp sub n skp 0 0
if lt fd 0
exit 60
end
ret fd
end

note sv_pread_fd: read exactly n bytes at pos from fd into opw[off .. off+n)
fn sv_pread_fd fd int pos ulong off ulong n ulong to ulong
p = ulong 0
dn = false
for o ulong 3
while and not dn lt p n bound 999999
r = pread fd opw add off p sub n p long add pos p
if lt r 0
exit 70
end
if eq r 0
dn = true
else
p = add p ulong r
end
end
end
ret p
end

note sv_rdhdr_pack: verify OLLMSP01 header of strand k against (bl, bh); store sl in sv_st_sl[k],
note ph in sv_st_wo[k], nspec in sv_st_wn[k] temporarily until pass 2 loads weights
fn sv_rdhdr_pack k ulong bl ulong bh ulong to ulong
fd = sv_open_arg get sv_st_arg k get sv_st_skp k
szs = fseek fd 0 2
if lt szs 0
exit 60
end
sz = ulong szs
if lt sz 48
y = fclose fd
exit 60
end
if ne sv_pread_fd fd 0 0 48 48
y = fclose fd
exit 60
end
y = fclose fd
if ne opw8 0 OSPMAG
exit 60
end
if ne opw8 8 bl
exit 62
end
sl = opw8 16
if or le sl bl gt sl 24
exit 62
end
if ne opw8 24 bh
exit 62
end
ns = opw8 32
if ne sz add 48 mul ns 8
exit 60
end
exp = add mul sub sl bl get og 32 get og 2
if ne ns exp
exit 62
end
put sv_st_sl k sl
put sv_st_wo k opw8 40
put sv_st_wn k ns
ret sl
end

note sv_rdpay_chunk: store cnt unpacked f64s from opw8 into ocs starting at base
fn sv_rdpay_chunk base ulong cnt ulong to void
for j ulong cnt
ocsp add base j bitcast f64 opw8 mul j 8
end
end

note sv_rdpay_ocs: stream nspec f64s from strand k into ocs[dst .. dst+nspec); exit 61 on FNV mismatch
fn sv_rdpay_ocs k ulong dst ulong nspec ulong want_ph ulong to void
fd = sv_open_arg get sv_st_arg k get sv_st_skp k
h = ulong 14695981039346656037
pos = ulong 48
done = ulong 0
while lt done nspec bound 65536
cnt = sub nspec done
if gt cnt OCKC
cnt = OCKC
end
if ne sv_pread_fd fd pos 0 mul cnt 8 mul cnt 8
y = fclose fd
exit 60
end
h = ocfnvw h mul cnt 8
sv_rdpay_chunk add dst done cnt
pos = add pos mul cnt 8
done = add done cnt
end
y2 = fclose fd
if ne h want_ph
exit 61
end
end

fn sv_init_base_gf to void
bl = get og 5
fz = get og 33
d = get og 2
put sv_cfg 5 bl
put sv_cfg 6 osp_app bl
put sv_cfg 7 fz
put sv_cfg 8 osp_basehash bl fz
put sv_cfg 9 SV_NONE
for g ulong d
put sv_base_gf g owg add fz g
end
end

fn sv_scan_strands ns ulong bl ulong bh ulong to ulong
max_l = bl
tot_brl = ulong 0
for k ulong ns
sl = sv_rdhdr_pack k bl bh
if gt sl max_l
max_l = sl
end
tot_brl = add tot_brl sub sl bl
end
if gt tot_brl SV_MAX_BRL
exit 12
end
put sv_cfg 16 max_l
put sv_cfg 13 tot_brl
ret max_l
end

fn sv_load_all_ocs ns ulong bl ulong to void
c = ocsinit
need = ulong 0
for k2 ulong ns
need = add need get sv_st_wn k2
end
if not ocsgrow need
exit 12
end
off = ulong 0
bio = ulong 0
for k3 ulong ns
nspec = get sv_st_wn k3
sv_rdpay_ocs k3 off nspec get sv_st_wo k3
put sv_st_wo k3 off
put sv_st_wn k3 mul sub get sv_st_sl k3 bl get og 32
put sv_st_bio k3 bio
bio = add bio sub get sv_st_sl k3 bl
off = add off nspec
end
end

note sv_init_strands: validate 0..4 OLLMSP01 packs, grow og[5] to max_L, store suffix weights in ocs
fn sv_init_strands to void
sv_init_base_gf
bl = get sv_cfg 5
ns = get sv_cfg 4
if eq ns 0
put sv_cfg 16 bl
put sv_cfg 13 0
ret
end
max_l = sv_scan_strands ns bl get sv_cfg 8
if gt max_l bl
ogrowsnap get og 8
put og 5 max_l
if not ogeom
exit 12
end
ogrowcopy get sv_cfg 7
end
sv_load_all_ocs ns bl
end

note sv_load_strand: copy strand k suffix weights into ow[base_fz..) when not already active
fn sv_load_strand k ulong to void
if eq get sv_cfg 9 k
ret
end
fz = get sv_cfg 7
wo = get sv_st_wo k
wn = get sv_st_wn k
for q ulong ocn wn
i = mul q OCH
ie = oce q wn
while lt i ie bound 999999
owp add fz i ocsg add wo i
i = add i 1
end
end
put og 48 get og 5
put sv_cfg 9 k
end

note ======== paged shared-trunk KV cache & branch KV pool

fn svk_pool_grow to bool
cur = get sv_kstat 0
mx = get sv_kstat 1
if ge cur mx
ret false
end
ncap = add cur 64
if gt ncap mx
ncap = mx
end
r = enlarge sv_kv mul ncap get sv_kstat 10
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_btok mul ncap SV_BLK
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bref ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bstate ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bpar ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bpos ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bhash ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_blru ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
r = enlarge sv_bnext ncap
if ne r 0
put sv_kstat 1 cur
ret false
end
put sv_kstat 0 ncap
ret true
end

fn svb_pool_grow to bool
cur = get sv_cfg 14
ncap = add cur 64
r = enlarge sv_bkv mul ncap get sv_cfg 15
if ne r 0
ret false
end
r = enlarge sv_bkv_used ncap
if ne r 0
ret false
end
put sv_cfg 14 ncap
ret true
end

fn svk_init to void
d = get og 2
tlv = get sv_cfg 6
msl = get sv_cfg 0
mc = get sv_cfg 1
bstr = mul SV_BLK mul add mul 2 tlv 1 d
put sv_kstat 10 bstr
put sv_kstat 11 tlv
put sv_kstat 12 mc
put sv_kstat 13 msl
put sv_kstat 14 get sv_cfg 4
max_mem = div SV_KV_MAX_F64 bstr
if gt max_mem SV_POOL_MAX_BLKS
max_mem = SV_POOL_MAX_BLKS
end
if lt max_mem 64
max_mem = 64
end
put sv_kstat 1 max_mem
cmax = mul get sv_cfg 2 512
if ne get sv_cfg 3 SV_NONE
cmax = get sv_cfg 3
end
if gt cmax max_mem
cmax = max_mem
end
if and gt cmax 0 gt add cmax mul msl 2 max_mem
if gt max_mem mul msl 4
cmax = sub max_mem mul msl 2
else
cmax = div max_mem 2
end
end
put sv_kstat 3 cmax
put sv_kstat 15 0
if gt cmax 0
put sv_kstat 15 1
end
r = enlarge sv_tok mul msl mc
if ne r 0
exit 12
end
r = enlarge sv_sblks mul msl SV_MAX_BLKS_SLOT
if ne r 0
exit 12
end
for h ulong SV_HT_SZ
put sv_ht h SV_NONE
end
if not svk_pool_grow
exit 12
end
if gt get sv_cfg 4 0
nb_slots = mul msl mul get sv_cfg 13 SV_MAX_BLKS_SLOT
r = enlarge sv_sbblk nb_slots
if ne r 0
exit 12
end
r = enlarge sv_shbr mul msl mul get sv_cfg 4 d
if ne r 0
exit 12
end
r = enlarge sv_clip_lp mul get sv_cfg 4 get og 0
if ne r 0
exit 12
end
r = enlarge sv_clip_dl get og 0
if ne r 0
exit 12
end
put sv_cfg 15 mul mul 2 SV_BLK d
if not svb_pool_grow
exit 12
end
end
end

fn svk_ht_rem b ulong to void
bk = and get sv_bhash b SV_HT_MASK
cur = get sv_ht bk
if eq cur b
put sv_ht bk get sv_bnext b
put sv_bnext b SV_NONE
ret
end
while ne cur SV_NONE bound 4096
nxt = get sv_bnext cur
if eq nxt b
put sv_bnext cur get sv_bnext b
put sv_bnext b SV_NONE
ret
end
cur = nxt
end
end

fn svk_evict_one to ulong
cap = get sv_kstat 0
best = SV_NONE
best_l = ulong 18446744073709551615
i = ulong 0
while lt i cap bound 65536
if eq get sv_bstate i 2
if eq get sv_bref i 0
lu = get sv_blru i
if lt lu best_l
best = i
best_l = lu
end
end
end
i = add i 1
end
if eq best SV_NONE
ret SV_NONE
end
svk_ht_rem best
put sv_kstat 2 sub get sv_kstat 2 1
put sv_kstat 9 add get sv_kstat 9 1
put sv_bstate best 0
par = get sv_bpar best
if ne par SV_NONE
put sv_bref par sub get sv_bref par 1
end
ret best
end

fn svk_alloc_blk to ulong
cap = get sv_kstat 0
i = ulong 0
while lt i cap bound 65536
if eq get sv_bstate i 0
put sv_bstate i 1
put sv_bref i 1
put sv_bpar i SV_NONE
put sv_bpos i 0
put sv_bhash i 0
put sv_bnext i SV_NONE
ret i
end
i = add i 1
end
if svk_pool_grow
put sv_bstate cap 1
put sv_bref cap 1
put sv_bpar cap SV_NONE
put sv_bpos cap 0
put sv_bhash cap 0
put sv_bnext cap SV_NONE
ret cap
end
b = svk_evict_one
if ne b SV_NONE
put sv_bstate b 1
put sv_bref b 1
put sv_bpar b SV_NONE
put sv_bpos b 0
put sv_bhash b 0
put sv_bnext b SV_NONE
end
ret b
end

fn svb_alloc_blk to ulong
cap = get sv_cfg 14
i = ulong 0
while lt i cap bound 262144
if eq get sv_bkv_used i 0
put sv_bkv_used i 1
ret i
end
i = add i 1
end
if svb_pool_grow
put sv_bkv_used cap 1
ret cap
end
ret SV_NONE
end

fn svk_hash ph ulong slot ulong bk ulong col ulong to ulong
if and eq col 1 eq bk 0
ret 1311768467463790320
end
h = ph
if eq bk 0
h = osp_mix64 14695981039346656037 get sv_cfg 8
end
h = osp_mix64 h bk
base = add mul slot get sv_cfg 1 mul bk SV_BLK
for j ulong SV_BLK
h = osp_mix64 h get sv_tok add base j
end
ret h
end

fn svk_tok_eq b ulong slot ulong bk ulong to bool
bo = mul b SV_BLK
tko = add mul slot get sv_cfg 1 mul bk SV_BLK
for j ulong SV_BLK
if ne get sv_btok add bo j get sv_tok add tko j
ret false
end
end
ret true
end

fn svk_lookup par ulong bk ulong h ulong slot ulong to ulong
cur = get sv_ht and h SV_HT_MASK
while ne cur SV_NONE bound 2048
if eq get sv_bstate cur 2
if eq get sv_bhash cur h
if eq get sv_bpar cur par
if eq get sv_bpos cur bk
if svk_tok_eq cur slot bk
clk = add get sv_kstat 4 1
put sv_kstat 4 clk
put sv_blru cur clk
ret cur
end
put sv_kstat 8 add get sv_kstat 8 1
end
end
end
end
cur = get sv_bnext cur
end
ret SV_NONE
end

fn svk_commit_sealed slot ulong bk ulong b ulong par ulong h ulong to void
bo = mul b SV_BLK
tko = add mul slot get sv_cfg 1 mul bk SV_BLK
for j ulong SV_BLK
put sv_btok add bo j get sv_tok add tko j
end
put sv_bpar b par
put sv_bpos b bk
put sv_bhash b h
clk = add get sv_kstat 4 1
put sv_kstat 4 clk
put sv_blru b clk
put sv_bstate b 2
if ne par SV_NONE
put sv_bref par add get sv_bref par 1
end
htk = and h SV_HT_MASK
put sv_bnext b get sv_ht htk
put sv_ht htk b
put sv_kstat 2 add get sv_kstat 2 1
end

fn svk_seal slot ulong bk ulong col ulong to void
if or eq get sv_kstat 15 0 eq get svs_cacheon slot 0
ret
end
so = mul slot SV_MAX_BLKS_SLOT
b = get sv_sblks add so bk
if or eq b SV_NONE ne get sv_bstate b 1
ret
end
par = SV_NONE
ph = ulong 0
if gt bk 0
par = get sv_sblks add so sub bk 1
if or eq par SV_NONE ne get sv_bstate par 2
ret
end
ph = get sv_bhash par
end
h = svk_hash ph slot bk col
ex = svk_lookup par bk h slot
if ne ex SV_NONE
put sv_sblks add so bk ex
put sv_bref ex add get sv_bref ex 1
put sv_bref b sub get sv_bref b 1
if eq get sv_bref b 0
put sv_bstate b 0
end
ret
end
if ge get sv_kstat 2 get sv_kstat 3
if eq svk_evict_one SV_NONE
ret
end
end
svk_commit_sealed slot bk b par h
end

fn svk_bind_cached slot ulong matched ulong b ulong to void
put sv_sblks add mul slot SV_MAX_BLKS_SLOT matched b
put sv_bref b add get sv_bref b 1
end

fn svk_match_prefix slot ulong to void
nfull = div get svs_ct slot SV_BLK
par = SV_NONE
ph = ulong 0
matched = ulong 0
while lt matched nfull bound 4097
h = svk_hash ph slot matched get svs_collide slot
b = svk_lookup par matched h slot
if eq b SV_NONE
break
end
svk_bind_cached slot matched b
par = b
ph = h
matched = add matched 1
end
hit_toks = mul matched SV_BLK
put svs_cached slot hit_toks
put svs_tpos slot hit_toks
if gt hit_toks 0
put sv_kstat 5 add get sv_kstat 5 1
put sv_kstat 7 add get sv_kstat 7 hit_toks
else
put sv_kstat 6 add get sv_kstat 6 1
end
end

fn svk_release slot ulong to void
so = mul slot SV_MAX_BLKS_SLOT
i = ulong 0
while lt i SV_MAX_BLKS_SLOT bound 4097
b = get sv_sblks add so i
if ne b SV_NONE
put sv_bref b sub get sv_bref b 1
if and eq get sv_bstate b 1 eq get sv_bref b 0
put sv_bstate b 0
end
put sv_sblks add so i SV_NONE
end
i = add i 1
end
if gt get sv_cfg 4 0
brl = get sv_cfg 13
sbo = mul slot mul brl SV_MAX_BLKS_SLOT
tot = mul brl SV_MAX_BLKS_SLOT
j = ulong 0
while lt j tot bound 65537
bb = get sv_sbblk add sbo j
if ne bb SV_NONE
put sv_bkv_used bb 0
put sv_sbblk add sbo j SV_NONE
end
j = add j 1
end
end
end

fn svk_clear_slot slot ulong to void
so = mul slot SV_MAX_BLKS_SLOT
i = ulong 0
while lt i SV_MAX_BLKS_SLOT bound 4097
put sv_sblks add so i SV_NONE
i = add i 1
end
if gt get sv_cfg 4 0
tot = mul get sv_cfg 13 SV_MAX_BLKS_SLOT
sbo = mul slot tot
j = ulong 0
while lt j tot bound 65537
put sv_sbblk add sbo j SV_NONE
j = add j 1
end
end
end

note ======== single-row streaming forward & spclip head (bit-exact with model.om & spec.om)

fn svf_emb tok ulong t ulong to void
d = get og 2
tt = get og 1
tw = t
if ge tw tt
tw = sub tt 1
end
wr = mul tok d
pr = add get og 30 mul tw d
for i ulong d
put sv_h i add owg add wr i owg add pr i
end
end

fn svf_rms_a go ulong mode ulong to void
d = get og 2
ss = 0.0f64
if eq mode 0
for i ulong d
v = get sv_h i
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j ulong d
put sv_a j mul div get sv_h j s get ow add go j
end
ret
end
if eq mode 1
for i2 ulong d
v = get sv_hm i2
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j2 ulong d
put sv_a j2 mul div get sv_hm j2 s get ow add go j2
end
ret
end
for i3 ulong d
v = get sv_h i3
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j3 ulong d
put sv_z j3 mul div get sv_h j3 s get ow add go j3
end
end

fn svf_rms_b bo ulong mode ulong to void
d = get og 2
ss = 0.0f64
if eq mode 0
for i ulong d
v = get sv_h i
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j ulong d
put sv_a j mul div get sv_h j s get oww add bo j
end
ret
end
if eq mode 1
for i2 ulong d
v = get sv_hm i2
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j2 ulong d
put sv_a j2 mul div get sv_hm j2 s get oww add bo j2
end
ret
end
for i3 ulong d
v = get sv_h i3
ss = add ss mul v v
end
s = fsqrt add div ss f64 d 0.00001
for j3 ulong d
put sv_z j3 mul div get sv_h j3 s get oww add bo j3
end
end

fn svf_rms gv ulong mode ulong to void
if owinb gv
svf_rms_b sub gv get og 34 mode
ret
end
svf_rms_a opx gv mode
end

fn svf_rms_bgf to void
d = get og 2
ss = 0.0f64
for i ulong d
v = get sv_h i
ss = add ss mul v v
end
