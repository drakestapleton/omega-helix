fn svf_br_kb slot ulong bi ulong bk ulong to ulong
b = get sv_sbblk add svf_br_sbo slot bi bk
ret mul b get sv_cfg 15
end

fn svf_br_vb slot ulong bi ulong bk ulong to ulong
b = get sv_sbblk add svf_br_sbo slot bi bk
ret add mul b get sv_cfg 15 mul SV_BLK get og 2
end

