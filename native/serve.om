fn svf_att_sc_br slot ulong bi ulong t ulong n ulong to f64
qo = mul n get og 7
m = bitcast f64 ulong 18442240474082181120
nb = div t SV_BLK
j = ulong 0
bk = ulong 0
while le bk nb bound 4097
lim = svf_att_lim bk nb t
m = fmax m svf_att_sc_br_blk svf_br_kb slot bi bk lim qo j
j = add j lim
bk = add bk 1
end
ret m
end

fn svf_axpy_bkv qo ulong vo ulong p f64 e ulong to void
for i ulong e
q = add qo i
put sv_o q add get sv_o q mul p get sv_bkv add vo i
end
end

fn svf_att_val_br_blk vb ulong lim ulong qo ulong j ulong to void
d = get og 2
e = get og 7
for o ulong lim
p = get sv_att add j o
vo = add vb add mul o d qo
svf_axpy_bkv qo vo p e
end
end

fn svf_att_val_br slot ulong bi ulong t ulong n ulong to void
e = get og 7
qo = mul n e
for i0 ulong e
put sv_o add qo i0 0.0f64
end
nb = div t SV_BLK
j = ulong 0
bk = ulong 0
while le bk nb bound 4097
lim = svf_att_lim bk nb t
svf_att_val_br_blk svf_br_vb slot bi bk lim qo j
j = add j lim
bk = add bk 1
end
end

fn svf_ffn l ulong to void
d = get og 2
f = get og 4
svf_vm 1 3 ovwo l d d
for i ulong d
put sv_hm i add get sv_h i get sv_hm i
end
svf_rms ovg2 l 1
svf_vm 0 4 ovw1 l d f
svf_vm 2 5 ovw2 l f d
for j ulong d
put sv_h j add get sv_hm j get sv_h j
end
end

fn svf_layer_tr slot ulong l ulong t ulong to void
ostw olp l
d = get og 2
svf_rms ovg1 l 0
svf_vm 0 0 ovwq l d d
svf_vm 0 1 ovwk l d d
svf_vm 0 2 ovwv l d d
svf_kv_put_tr slot l t
for n ulong get og 3
m = svf_att_sc_tr slot l t n
svf_soft_att add t 1 m
svf_att_val_tr slot l t n
end
svf_ffn l
end

fn svf_layer_br slot ulong l ulong bi ulong t ulong to void
ostw olp l
d = get og 2
svf_rms ovg1 l 0
svf_vm 0 0 ovwq l d d
svf_vm 0 1 ovwk l d d
svf_vm 0 2 ovwv l d d
svf_kv_put_br slot bi t
for n ulong get og 3
m = svf_att_sc_br slot bi t n
svf_soft_att add t 1 m
svf_att_val_br slot bi t n
end
svf_ffn l
end

fn svf_ensure_tr slot ulong t ulong to bool
bk = div t SV_BLK
so = add mul slot SV_MAX_BLKS_SLOT bk
if ne get sv_sblks so SV_NONE
ret true
end
b = svk_alloc_blk
if eq b SV_NONE
ret false
end
put sv_sblks so b
ret true
end

fn svf_ensure_br slot ulong bi ulong t ulong to bool
bk = div t SV_BLK
sbo = svf_br_sbo slot bi
if ne get sv_sbblk add sbo bk SV_NONE
ret true
end
b = svb_alloc_blk
if eq b SV_NONE
ret false
end
put sv_sbblk add sbo bk b
ret true
end

fn svf_trunk_row slot ulong t ulong to bool
if not svf_ensure_tr slot t
ret false
end
tok = get sv_tok add mul slot get sv_cfg 1 t
svf_emb tok t
tlv = get sv_cfg 6
for l ulong tlv
svf_layer_tr slot l t
end
svf_h_put_tr slot t
if eq rem t SV_BLK sub SV_BLK 1
svk_seal slot div t SV_BLK get svs_collide slot
end
ret true
end

fn svf_branch_save slot ulong k ulong to void
d = get og 2
off = add mul slot mul get sv_cfg 4 d mul k d
for i ulong d
put sv_shbr add off i get sv_h i
end
end

fn svf_branch_row slot ulong k ulong t ulong to bool
sv_load_strand k
svf_h_get_tr slot t
bl = get sv_cfg 5
sl = get sv_st_sl k
ta = get sv_cfg 6
bi0 = get sv_st_bio k
ns = sub sl bl
for j ulong ns
bi = add bi0 j
if not svf_ensure_br slot bi t
ret false
end
svf_layer_br slot add ta j bi t
end
svf_branch_save slot k
ret true
end

fn svf_kdot wi ulong d ulong to f64
s = 0.0f64
for i ulong d
s = add s mul get sv_z i get ow add wi i
end
ret s
end

fn svf_klogit to void
d = get og 2
v = get og 0
tm = get og 27
c = ulong 0
while lt c v bound 999999
put oa add tm c svf_kdot mul c d d
c = add c 1
end
end

fn svf_clip_lsm s ulong to void
pr = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for j ulong v
x = get oa add pr j
m = fmax m x
put sv_clip_dl j x
end
sm = osoft pr v m
lsm = flog sm
dst = mul s v
ent = 0.0f64
for j2 ulong v
lp = sub sub get sv_clip_dl j2 m lsm
put sv_clip_lp add dst j2 lp
pj = get oa add pr j2
if gt pj 0.0
ent = sub ent mul pj lp
end
end
if lt ent 0.0
ent = 0.0f64
end
put sv_clip_ent s ent
end

fn svf_clip_fuse_v j ulong ss ulong v ulong to f64
acc = 0.0f64
for s3 ulong ss
al = get sv_clip_al s3
lp = get sv_clip_lp add mul s3 v j
acc = add acc mul al lp
end
ret acc
end

fn svf_clip_fuse slot ulong md ulong to void
ss = get sv_cfg 4
so = mul slot 4
su = 0.0f64
for s ulong ss
u = get svs_spw add so s
if and eq md 1 gt u 0.0
u = div u add get sv_clip_ent s 0.001
end
put sv_clip_al s u
if gt u 0.0
su = add su u
end
end
for s2 ulong ss
put sv_clip_al s2 div get sv_clip_al s2 su
end
pr = get og 27
v = get og 0
for j ulong v
put oa add pr j svf_clip_fuse_v j ss v
end
end

fn svf_head_gpu slot ulong to void
ct = get svs_ct slot
tb = mul slot get sv_cfg 1
for i ulong ct
put obx i get sv_tok add tb i
end
put og 9 ct
oglast
end

fn svf_head_strand slot ulong k ulong to void
d = get og 2
off = add mul slot mul get sv_cfg 4 d mul k d
for i ulong d
put sv_h i get sv_shbr add off i
end
svf_rms_ogf add get sv_st_wo k get sv_st_wn k
svf_klogit
end

fn svf_head slot ulong to void
if eq get svs_usekv slot 0
svf_head_gpu slot
ret
end
rt = get svs_route slot
if eq rt 0
svf_h_get_tr slot sub get svs_ct slot 1
svf_rms_bgf
svf_klogit
ret
end
if le rt 4
svf_head_strand slot sub rt 1
ret
end
ns = get sv_cfg 4
for s ulong ns
svf_head_strand slot s
svf_clip_lsm s
end
svf_clip_fuse slot get svs_spmode slot
end

note svtake: one sampled token into the context and the content; false when it ends the output
note (sv8: 1 token 0 or a stop string, 2 the content would pass its 65536 bytes)
fn svtake wb edit uchar 1073664 sv edit ulong 64 to bool
c = svdraw sv
if eq c 0
put sv 8 1
ret false
end
if not svfits sv c
put sv 8 2
ret false
end
svcap wb sv c
p = get sv 13
svclean wb sv 0
if svstopc wb sv p
ret false
end
ret true
end

note svstopc: the earliest stop string match that ends past the content's old length p cuts the
note content there (finish stop); whether one did
fn svstopc wb edit uchar 1073664 sv edit ulong 64 p ulong to bool
n = get sv 13
b = jsnone
for i ulong get sv 35
l = get svstl i
s = ulong 0
if gt add p 1 l
s = sub add p 1 l
end
q = svfind wb s n add 73728 mul i 128 l
if lt q b
b = q
end
end
if eq b jsnone
ret false
end
put sv 13 b
put sv 12 0
put sv 8 1
ret true
end

note svhold: how far a streamed chunk may send: not into the tail a stop string or the tool-call
note marker could still claim, nor (detection on) past the marker or into trailing whitespace
fn svhold wb edit uchar 1073664 sv edit ulong 64 to ulong
n = get sv 13
lo = get sv 14
h = n
for i ulong get sv 35
k = svpsuf wb lo n add 73728 mul i 128 get svstl i
if lt sub n k h
h = sub n k
end
end
if eq get sv 31 1
q = svfind wb lo n 74752 11
if lt q h
h = q
end
k2 = svpsuf wb lo n 74752 11
if lt sub n k2 h
h = sub n k2
end
h = svtrim wb lo h
end
ret h
end

note svdraw: the next token (svf_head logits, or svdrawf with top_k/top_p on, or forced test tokens)
fn svdraw sv edit ulong 64 to ulong
if eq get sv 25 1
g = get sv 7
if lt g get sv 24
ret get svft g
end
ret 0
end
svf_head get sv_cfg 10
st = get sv 3
tm = get sv 2
c = ulong 0
if or eq tm 0 not svfon sv
if eq tm 0
c = oargmax
else
c = odraw st div f64 tm 1000.0
end
else
c = svdrawf st div f64 tm 1000.0 get sv 28 get sv 29
end
if ne tm 0
put sv 3 add st 11400714819323198485
end
ret c
end

note svfon: whether top_k (0 < K < V) or top_p (< 1) filters
fn svfon sv edit ulong 64 to bool
k = get sv 28
if and gt k 0 lt k get og 0
ret true
end
ret lt get sv 29 1000000
end

note svdrawf: odraw over the kept tokens (svkeep), the uniform scaled to their mass
fn svdrawf st ulong tau f64 k ulong p6 ulong to ulong
svlogit tau
o = get og 27
v = get og 0
cm = svkeep o v k p6
u = mul f64 shr smx st 11 1.1102230246251565e-16
r = svpick o v mul u cm
for j ulong v
put svmk j 0
end
ret r
end

note svlogit: the logits in oa[TMP..TMP+V) divided by tau, then made probabilities
fn svlogit tau f64 to void
o = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for c ulong v
x = div get oa add o c tau
put oa add o c x
m = fmax m x
end
sm = osoft o v m
end

note svkeep: mark the most probable tokens (ties to the lower id), at most K (0 < K < V), until
note their mass reaches top_p (p6 < 1000000); their mass
fn svkeep o ulong v ulong k ulong p6 ulong to f64
lim = v
if and gt k 0 lt k v
lim = k
end
pf = div f64 p6 1000000.0
cm = 0.0f64
for j ulong lim
b = svmax o v
put svmk b 1
cm = add cm get oa add o b
if and lt p6 1000000 ge cm pf
break
end
end
ret cm
end

note svmax: the unmarked token of highest probability, the lower id on ties
fn svmax o ulong v ulong to ulong
b = ulong 0
bv = 0.0f64
fd = false
for c ulong v
if eq get svmk c 0
x = get oa add o c
if or not fd gt x bv
b = c
bv = x
fd = true
end
end
end
ret b
end

note svpick: the first kept token (id order) whose running kept mass passes t; else the last kept
fn svpick o ulong v ulong t f64 to ulong
acc = 0.0f64
la = ulong 0
for c ulong v
if eq get svmk c 1
acc = add acc get oa add o c
la = c
if lt t acc
ret c
end
end
end
ret la
end

note svfits: whether token c's bytes fit the raw buffer (8192) and, as up to three content bytes
note each, the content (65536)
fn svfits sv edit ulong 64 c ulong to bool
tl = obtlen c
rn = add get sv 12 tl
gn = add get sv 13 mul rn 3
ret not or or gt rn 8192 gt tl 4096 gt gn 65536
end

note svcap: token c's bytes onto the raw buffer, c onto the context
fn svcap wb edit uchar 1073664 sv edit ulong 64 c ulong to void
obtcap c
rn = get sv 12
for i ulong get obon 0
put wb add rn i get obo i
end
put sv 12 add rn get obon 0
ocpush c
put sv 7 add get sv 7 1
end

note svpend: when streaming, the content not yet sent (up to svhold; fin 1 all of it, or the text
note before the tool calls) as one chunk; 0 or the send error
fn svpend cs edit ulong 320 io edit uchar 131072 ob edit uchar 409600 wb edit uchar 1073664 sv edit ulong 64 fin ulong to long
if ne get sv 0 1
ret 0
end
h = get sv 13
if eq fin 0
h = svhold wb sv
else
if gt get sv 32 0
h = svtrim wb get sv 14 get sv 33
end
end
if le h get sv 14
ret 0
end
put sv 17 h
r = svchunk cs io ob wb sv 1
put sv 14 h
ret r
end

note ======== tool calls in the output

note svtdecl: whether bd[f, f + q) is a declared tool name
fn svtdecl wb edit uchar 1073664 bd edit uchar 983040 f ulong q ulong sv edit ulong 64 to bool
for i ulong get sv 30
if eq get svtnl i q
if svteq wb bd f q add 82432 mul i 64
ret true
end
end
end
ret false
end

note svteq: whether bd[f, f + q) equals wb[b, b + q)
fn svteq wb edit uchar 1073664 bd edit uchar 983040 f ulong q ulong b ulong to bool
for j ulong q
if ne get bd add f j get wb add b j
ret false
end
end
ret true
end

note svtargs: the arguments token ar of a block at wb[b ..) into bd at f (object: its JSON text;
note string: decoded; absent: {}); its length, or negative
fn svtargs wb edit uchar 1073664 bd edit uchar 983040 tp view uint 262144 ar ulong f ulong b ulong to long
if eq ar jsnone
put bd f 123
put bd add f 1 125
ret 2
end
ty = js_type tp ar
if eq ty 6
ret js_sget view part wb b 65536 js_off tp ar part bd f 65536
end
if ne ty 1
ret -1
end
o = add b js_off tp ar
n = js_span tp ar
for i ulong n
put bd add f i get wb add o i
end
ret long n
end

note svtc1: the block JSON at content [s, s + l) as tool call sv32; false when it is not one
fn svtc1 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 s ulong l ulong to bool
if or eq l 0 gt l 65536
ret false
end
tp = new uint 262144 0
x = js_init tp 65536 64
b = add 8192 s
r = js_parse view part wb b l tp l
if lt r 0
ret false
end
if ne js_type tp 0 1
ret false
end
ret svtc2 wb sv bd tp b
end

note svtc2: the parsed block at wb[b ..) (tape tp) recorded as tool call sv32; whether it is one
fn svtc2 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 tp view uint 262144 b ulong to bool
nm = svmem view part wb b 65536 tp 0 sknam
if eq nm jsnone
ret false
end
if ne js_type tp nm 6
ret false
end
q = svtnam wb sv bd js_off tp nm b
if lt q 1
ret false
end
f = get sv 34
g = add f ulong q
a = svtargs wb bd tp svmem view part wb b 65536 tp 0 skargs g b
if lt a 0
ret false
end
svtrec sv f ulong q g ulong a
ret true
end

note svtnam: the name string at wb[b + o ..) decoded to bd[sv34 ..); its length when it is a
note declared tool name, else -1
fn svtnam wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 o ulong b ulong to long
f = get sv 34
q = js_sget view part wb b 65536 o part bd f 64
if lt q 1
ret -1
end
if not svtdecl wb bd f ulong q sv
ret -1
end
ret q
end

note svtrec: record tool call sv32's name bd[f, f + q) and arguments bd[g, g + a)
fn svtrec sv edit ulong 64 f ulong q ulong g ulong a ulong to void
m = mul get sv 32 4
put svtcx m f
put svtcx add m 1 q
put svtcx add m 2 g
put svtcx add m 3 a
put sv 34 add g a
put sv 32 add get sv 32 1
end

note svtblk: the block <tool_call>JSON</tool_call> at content p; the position after it, or jsnone
fn svtblk wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 p ulong n ulong to ulong
if gt add p 11 n
ret jsnone
end
if not svat wb p 74752 11
ret jsnone
end
s = add p 11
z = svfind wb s n 74763 12
if eq z jsnone
ret jsnone
end
if not svtc1 wb sv bd s sub z s
ret jsnone
end
ret add z 12
end

note svtcall: with detection on, whether the content from the first marker on is 1 .. 8 tool-call
note blocks with only whitespace around: sv32 calls, sv33 the marker, finish tool_calls
fn svtcall wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to void
put sv 32 0
put sv 34 0
if eq get sv 31 0
ret
end
n = get sv 13
q = svfind wb 0 n 74752 11
if eq q jsnone
ret
end
p = q
for it ulong 9
p = svskws wb p n
if ge p n
break
end
z = jsnone
if lt get sv 32 8
z = svtblk wb sv bd p n
end
if eq z jsnone
put sv 32 0
ret
end
p = z
end
if lt p n
put sv 32 0
ret
end
put sv 33 q
put sv 8 3
end

note ======== continuous-batching scheduler & concurrent slot lifecycle

fn svwait_min_iv now ulong tmo long to long
iv = tmo
for i ulong 32
f = get svpfd i
if ne f 0
age = sub now get svpat i
if ge age 10000000000
y = fclose int sub f 1
put svpfd i 0
else
rm = long sub 10000000000 age
if or lt iv 0 lt rm iv
iv = rm
end
end
end
end
ret iv
end

fn svwait_pack to ulong
n = ulong 0
for i ulong 32
f = get svpfd i
if ne f 0
svprec n sub f 1
put svpix n i
n = add n 1
end
end
ret n
end

fn svwait_accept sv edit ulong 64 to long
c = haccept int get sv 36 0
if lt c 0
ret -1
end
if ne waitio int c 1 long 20000000 0
ret c
end
for k ulong 32
if eq get svpfd k 0
put svpfd k ulong add c 1
put svpat k ulong monons
ret -1
end
end
y = fclose int c
ret -1
end

note svwait: wait up to tmo ns for the listener or one of 32 pending connections (svpfd)
fn svwait sv edit ulong 64 tmo long to long
iv = svwait_min_iv ulong monons tmo
n = svwait_pack
fr = lt n 32
m = n
if fr
svprec n get sv 36
m = add n 1
end
if le pollfds svpl 0 mul m 8 iv 0
ret -1
end
for j ulong n
if ne get svpl add mul j 8 6 0
s = get svpix j
cp = long sub get svpfd s 1
put svpfd s 0
ret cp
end
end
if not fr
ret -1
end
ret svwait_accept sv
end

note svprec: pollfd record j for descriptor fd, events POLLIN
fn svprec j ulong fd ulong to void
b = mul j 8
put svpl b uchar and fd 255
put svpl add b 1 uchar and shr fd 8 255
put svpl add b 2 uchar and shr fd 16 255
put svpl add b 3 uchar and shr fd 24 255
put svpl add b 4 1
put svpl add b 5 0
put svpl add b 6 0
put svpl add b 7 0
end

note svgone: whether the client of an active slot left (non-blocking MSG_PEEK | MSG_DONTWAIT)
fn svgone cs edit ulong 320 to bool
r = recv int get cs HFD svpk 0 1 66
if eq r 0
ret true
end
ret and lt r 0 and ne r -11 ne r -4
end

fn svlogs st ulong to void
oputc 67
oputc 32
oputu st
for i ulong 4
oputc 32
oputc 48
end
oputc 10
oflush
end

note ======== slot context switching & serving

fn svid wb edit uchar 1073664 sv edit ulong 64 to void
put sv_cfg 17 add get sv_cfg 17 1
put sv 9 get sv_cfg 17
p = ulong 82176
if eq get sv 37 1
p = svmcat wb p 82240 svcidp
else
p = svmcat wb p 82240 svidp
end
p = svmdec wb p 82240 get sv 9
put sv 15 sub p 82176
end

fn svlog sv edit ulong 64 to void
oputc 67
oputc 32
oputu get sv 21
oputc 32
oputu get sv 6
oputc 32
oputu get sv 7
oputc 32
oputu get sv 8
oputc 32
oputu div sub ulong monons get sv 11 1000000
oputc 10
oflush
end

fn svprep wb edit uchar 1073664 sv edit ulong 64 to ulong
sl = get sv_cfg 10
mc = get sv_cfg 1
put sv_tok mul sl mc 0
np = svenc view part wb 90624 get sv 5 get sv 5 0
put sv 6 add np 1
if ge get sv 6 mc
ret 11
end
if eq get sv 25 1
c = ulong 0
if gt get sv 26 0
c = svenc view part wb 8192 get sv 26 get sv 26 1
end
if gt c 4096
c = 4096
end
put sv 24 c
end
ret 0
end

fn svslot_cap wb edit uchar 1073664 sv edit ulong 64 c ulong to void
obtcap c
rn = get sv 12
for i ulong get obon 0
put wb add rn i get obo i
end
put sv 12 add rn get obon 0
put sv 7 add get sv 7 1
end

fn svslot_find_free to ulong
msl = get sv_cfg 0
for s ulong msl
if eq get svs_active s 0
ret s
end
end
ret SV_NONE
end

fn sv_stp_save dst ulong src ulong wb view uchar 1073664 to void
for sb ulong 128
put svs_stp add dst sb get wb add src sb
end
end

fn svslot_save_stops slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
stpo = mul slot 1024
stlo = mul slot 8
for si ulong get sv 35
put svs_stl add stlo si get svstl si
b1 = mul si 128
sv_stp_save add stpo b1 add 73728 b1 wb
end
end

fn sv_tnm_save dst ulong src ulong wb view uchar 1073664 to void
for tb ulong 64
put svs_tnm add dst tb get wb add src tb
end
end

fn svslot_save_tools slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
tmo = mul slot 8192
tlo = mul slot 128
for ti ulong get sv 30
put svs_tnl add tlo ti get svtnl ti
b2 = mul ti 64
sv_tnm_save add tmo b2 add 82432 b2 wb
end
end

fn svslot_save_meta slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
svslot_save_stops slot wb sv
svslot_save_tools slot wb sv
io = mul slot 64
for ii ulong get sv 15
put svs_id add io ii get wb add 82176 ii
end
if eq get sv 25 1
fo = mul slot 4096
for fi ulong get sv 24
put svs_ft add fo fi get svft fi
end
end
end

fn svslot_save_bufs slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
ro = mul slot 8192
for r ulong get sv 12
put svs_raw add ro r get wb r
end
no = mul slot 65536
for c ulong get sv 13
put svs_cnt add no c get wb add 8192 c
end
end

fn svslot_save slot ulong cs edit ulong 320 wb edit uchar 1073664 sv edit ulong 64 to void
so = mul slot 64
for i ulong 64
put svs_sv add so i get sv i
end
co = mul slot 320
for j ulong 320
put svs_cs add co j get cs j
end
svslot_save_bufs slot wb sv
svslot_save_meta slot wb sv
end

fn sv_stp_load dst ulong src ulong wb edit uchar 1073664 to void
for sb ulong 128
put wb add dst sb get svs_stp add src sb
end
end

fn svslot_load_stops slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
stpo = mul slot 1024
stlo = mul slot 8
for si ulong get sv 35
put svstl si get svs_stl add stlo si
b1 = mul si 128
sv_stp_load add 73728 b1 add stpo b1 wb
end
end

fn sv_tnm_load dst ulong src ulong wb edit uchar 1073664 to void
for tb ulong 64
put wb add dst tb get svs_tnm add src tb
end
end

fn svslot_load_tools slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
tmo = mul slot 8192
tlo = mul slot 128
for ti ulong get sv 30
put svtnl ti get svs_tnl add tlo ti
b2 = mul ti 64
sv_tnm_load add 82432 b2 add tmo b2 wb
end
end

fn svslot_load_meta slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
svslot_load_stops slot wb sv
svslot_load_tools slot wb sv
io = mul slot 64
for ii ulong get sv 15
put wb add 82176 ii get svs_id add io ii
end
if eq get sv 25 1
fo = mul slot 4096
for fi ulong get sv 24
put svft fi get svs_ft add fo fi
end
end
end

fn svslot_load_bufs slot ulong wb edit uchar 1073664 sv edit ulong 64 to void
ro = mul slot 8192
for r ulong get sv 12
put wb r get svs_raw add ro r
end
no = mul slot 65536
for c ulong get sv 13
put wb add 8192 c get svs_cnt add no c
end
end

fn svslot_load slot ulong cs edit ulong 320 wb edit uchar 1073664 sv edit ulong 64 to void
put sv_cfg 10 slot
so = mul slot 64
for i ulong 64
put sv i get svs_sv add so i
end
co = mul slot 320
for j ulong 320
put cs j get svs_cs add co j
end
svslot_load_bufs slot wb sv
svslot_load_meta slot wb sv
end

fn svslot_close slot ulong cs edit ulong 320 sv edit ulong 64 to void
svlog sv
x = hclose cs
svk_release slot
put svs_active slot 0
if gt get sv_cfg 12 0
put sv_cfg 12 sub get sv_cfg 12 1
end
end

fn svslot_pend cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 to long
ob = new uchar 409600 0
ret svpend cs io ob wb sv 0
end

fn svslot_fin_send cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 bd edit uchar 983040 to void
ob = new uchar 409600 0
if eq get sv 0 1
r = svpend cs io ob wb sv 1
if and ge r 0 gt get sv 32 0
r = svtchunk cs io ob wb sv bd
end
if ge r 0
r = hfe r svchunk cs io ob wb sv 2
if eq get sv 4 1
r = hfe r svchunk cs io ob wb sv 3
end
r = hfe r hssedat cs io svdone
r = hfe r hsseend cs io
r = hfe r hwfin cs io
end
ret
end
m = svfull ob wb sv bd
if lt m 0
put sv 16 16
r2 = svfail cs io wb sv 500
ret
end
r3 = svsend cs io ob 200 ulong m
end

fn svslot_finish slot ulong cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
p = get sv 13
svclean wb sv 1
x = svstopc wb sv p
svtcall wb sv bd
svslot_fin_send cs io wb sv bd
svslot_close slot cs sv
end

fn svslot_stream_hdr cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 to long
ob = new uchar 409600 0
r = hrspsse cs io
ret hfe r svchunk cs io ob wb sv 0
end

fn svslot_admit_err cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 e ulong to long
put sv 16 e
st = ulong 400
if eq e 25
st = ulong 413
end
r = svfail cs io wb sv st
svlog sv
ret r
end

fn svchat_init_kv slot ulong sv edit ulong 64 to void
ct0 = get sv 6
mc = get sv_cfg 1
lim = sub mc ct0
if lt get sv 1 lim
lim = get sv 1
end
put svs_ct slot ct0
put svs_lim slot lim
put svs_route slot get sv 38
put svs_spmode slot get sv 39
put svs_cacheon slot get sv 42
put svs_collide slot get sv 44
put svs_cached slot 0
spw = mul slot 4
for wi ulong 4
put svs_spw add spw wi div f64 get sv_cur_spw wi 1000.0
end
ukv = ulong 1
if ne get ogpu 0 0
if eq get sv_cfg 4 0
if le ct0 get og 1
ukv = 0
end
end
end
put svs_usekv slot ukv
if eq ukv 1
put svs_tpos slot 0
put svs_bpos slot 0
if and ne get sv_kstat 15 0 eq get sv 42 1
svk_match_prefix slot
put sv 43 get svs_cached slot
end
else
put svs_tpos slot ct0
put svs_bpos slot ct0
end
end

fn svchat_arm slot ulong cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 to long
svchat_init_kv slot sv
svid wb sv
put sv 10 ulong div realns 1000000000
put sv 7 0
put sv 8 0
put sv 12 0
put sv 13 0
put sv 14 0
put sv 17 0
put sv 21 200
if eq get sv 0 1
rh = svslot_stream_hdr cs io wb sv
if lt rh 0
svlog sv
svk_release slot
ret rh
end
end
due = add ulong monons mul get sv 27 1000000
put svs_due slot due
svslot_save slot cs wb sv
put svs_active slot 1
put sv_cfg 12 add get sv_cfg 12 1
ret 1
end

fn svchat cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to long
slot = svslot_find_free
if eq slot SV_NONE
n0 = hbodyall cs io bd
x0 = svs503 cs io
put sv 21 503
svlogs 503
ret 0
end
n = hbodyall cs io bd
if lt n 0
put cs HKEEP 0
if eq n HEBIG
put sv 16 13
r = svfail cs io wb sv svbig
svlog sv
ret r
end
put sv 21 400
svlog sv
ret hrsperr cs io 400
end
hsetdl cs 0
put sv_cfg 10 slot
e = svparse bd ulong n wb sv
if eq e 0
svk_clear_slot slot
e = svprep wb sv
end
if ne e 0
ret svslot_admit_err cs io wb sv e
end
ret svchat_arm slot cs io wb sv
end

fn svslot_prefill slot ulong to bool
ct = get svs_ct slot
tpos = get svs_tpos slot
if lt tpos ct
cnt = ulong 0
while and lt tpos ct lt cnt SV_PREFILL_CHUNK bound 33
if not svf_trunk_row slot tpos
ret false
end
tpos = add tpos 1
cnt = add cnt 1
end
put svs_tpos slot tpos
ret true
end
rt = get svs_route slot
bpos = get svs_bpos slot
if and ne rt 0 lt bpos ct
cnt2 = ulong 0
while and lt bpos ct lt cnt2 SV_PREFILL_CHUNK bound 33
if le rt 4
if not svf_branch_row slot sub rt 1 bpos
ret false
end
else
for k ulong get sv_cfg 4
if not svf_branch_row slot k bpos
ret false
end
end
end
bpos = add bpos 1
cnt2 = add cnt2 1
end
put svs_bpos slot bpos
end
ret true
end

fn svslot_ready slot ulong to bool
if eq get svs_active slot 0
ret false
end
if lt get svs_tpos slot get svs_ct slot
ret true
end
if and ne get svs_route slot 0 lt get svs_bpos slot get svs_ct slot
ret true
end
due = get svs_due slot
if eq due 0
ret true
end
ret ge ulong monons due
end

fn svslot_adv slot ulong sv edit ulong 64 c ulong to void
ct2 = get svs_ct slot
put sv_tok add mul slot get sv_cfg 1 ct2 c
put svs_ct slot add ct2 1
if eq get svs_usekv slot 0
if gt add ct2 1 get og 1
put svs_usekv slot 1
put svs_tpos slot 0
put svs_bpos slot 0
end
end
if gt get sv 27 0
put svs_due slot add ulong monons mul get sv 27 1000000
else
put svs_due slot 0
end
end

fn svslot_step slot ulong cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
svslot_load slot cs wb sv
if svgone cs
put sv 8 4
put sv 21 499
svslot_close slot cs sv
ret
end
if eq get sv 25 0
if not svslot_prefill slot
put sv 8 0
put sv 21 500
svslot_close slot cs sv
ret
end
ct = get svs_ct slot
if lt get svs_tpos slot ct
svslot_save slot cs wb sv
ret
end
if and ne get svs_route slot 0 lt get svs_bpos slot ct
svslot_save slot cs wb sv
ret
end
end
due = get svs_due slot
if and gt due 0 lt ulong monons due
ret
end
c = svdraw sv
if eq c 0
put sv 8 1
svslot_finish slot cs io bd wb sv
ret
end
if not svfits sv c
put sv 8 2
svslot_finish slot cs io bd wb sv
ret
end
svslot_cap wb sv c
p = get sv 13
svclean wb sv 0
stopped = svstopc wb sv p
if eq get sv 0 1
rp = svslot_pend cs io wb sv
if lt rp 0
svslot_close slot cs sv
ret
end
end
if or stopped ge get sv 7 get svs_lim slot
if and not stopped eq get sv 8 0
put sv 8 2
end
svslot_finish slot cs io bd wb sv
ret
end
svslot_adv slot sv c
svslot_save slot cs wb sv
end

fn svroute cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to long
svbeg sv
if hispath cs io svpchat
if or hismeth cs io svmpost eq OMUTMETH 0
put sv 37 0
ret svchat cs io bd wb sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svpcomp
if or hismeth cs io svmpost eq OMUTMETH 0
put sv 37 1
ret svchat cs io bd wb sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svphlth
if or hismeth cs io svmget eq OMUTMETH 0
ret svhealth cs io sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svpmods
if or hismeth cs io svmget eq OMUTMETH 0
ret svmods cs io sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svpnlinfo
if or hismeth cs io svmget eq OMUTMETH 0
ret svnlinfo cs io sv
end
ret svend cs io wb sv 15 405
end
if hispath cs io svpnltrc
if or hismeth cs io svmpost eq OMUTMETH 0
if gt get sv_cfg 12 0
n0 = hbodyall cs io bd
x0 = svs503 cs io
svlogs 503
ret 0
end
ret svnltrace cs io bd wb sv
end
ret svend cs io wb sv 15 405
end
if eq OMUTPATH 0
ret svhealth cs io sv
end
ret svend cs io wb sv 14 404
end

note ======== Neuralese Phase 1 endpoints (/v1/neuralese/info, /v1/neuralese/trace)

fn svnlinfo cs edit ulong 320 io edit uchar 131072 sv edit ulong 64 to long
ob = new uchar 409600 0
put sv 21 200
x = js_winit ob
js_wobj ob
svwt ob sknlmid
svmidw ob
svwt ob sknlscm
svwt ob svnlscm
svwt ob sknlmag
js_wulong ob get og 46
svwt ob sknlv
js_wulong ob get og 0
svwt ob sknlt
js_wulong ob get og 1
svwt ob sknld
js_wulong ob get og 2
svwt ob sknlh
js_wulong ob get og 3
svwt ob sknlf
js_wulong ob get og 4
svwt ob sknll
js_wulong ob get og 5
svwt ob sknllp
js_wulong ob get og 57
svwt ob sknllc
js_wulong ob get og 58
svwt ob sknlnp
js_wulong ob get og 59
svwt ob sknllv
js_wulong ob get og 56
svwt ob sknlxal
js_wulong ob 1
js_wobje ob
m = js_wdone ob
if lt m 0
put cs HKEEP 0
ret hrsperr cs io 500
end
r = svsend cs io ob 200 ulong m
svlog sv
ret r
end

note FNV-1a-64 over svnl_vec[0..d) as little-endian u64 words (deterministic LTP0 vector checksum)
fn svnlfnv d ulong to ulong
h = ulong 14695981039346656037
for i ulong d
w = bitcast ulong get svnl_vec i
for b ulong 8
h = xor h and shr w mul b 8 255
h = mul h 1099511628211
end
end
ret h
end

note Write 16-char lowercase hex of u64 v as a JSON string
fn svnlwhex ob edit uchar 409600 v ulong to void
js_wsbeg ob
for i ulong 16
d = and shr v mul sub 15 i 4 15
c = add d 48
if gt d 9
c = add d 87
end
js_wsb ob uchar c
end
js_wsend ob
end

note Parse 16-char lowercase hex from bd[o..o+16) into u64; returns 1 in svnl_cfg[15] on error
fn svnlhex bd view uchar 983040 o ulong to ulong
put svnl_cfg 15 0
v = ulong 0
for i ulong 16
c = ulong get bd add o i
d = ulong 0
if and ge c 48 le c 57
d = sub c 48
else
if and ge c 97 le c 102
d = sub c 87
else
put svnl_cfg 15 1
ret 0
end
end
v = or shl v 4 d
end
ret v
end

note Read optional unsigned int member k; returns def if absent or wrong type
fn svnloptu bd view uchar 983040 tp view uint 262144 k view uchar * def ulong to ulong
v = svmem bd tp 0 k
if eq v jsnone
ret def
end
if ne js_type tp v 7
ret def
end
o = js_off tp v
if js_isu bd o
ret js_tou bd o
end
ret def
end

note Read optional signed int member k; returns def if absent or wrong type
fn svnloptl bd view uchar 983040 tp view uint 262144 k view uchar * def long to long
v = svmem bd tp 0 k
if eq v jsnone
ret def
end
if ne js_type tp v 7
ret def
end
o = js_off tp v
if js_isl bd o
ret js_tol bd o
end
ret def
end

fn svnl_copy_vec d ulong to void
for k ulong d
xv = div f64 get svnl_vec k 10000.0
put onlv k xv
end
put onlc 6 1
end

fn svnl_chk_fnv bd edit uchar 983040 tp view uint 262144 wb edit uchar 1073664 d ulong to ulong
fh = svmem bd tp 0 sknllfn
if or eq fh jsnone ne js_type tp fh 6
ret 3
end
fl = js_sget bd js_off tp fh part wb 82176 32
if ne fl 16
ret 3
end
want = svnlhex_wb wb 82176
if ne get svnl_cfg 15 0
ret 3
end
if ne want svnlfnv d
ret 3
end
svnl_copy_vec d
ret 0
end

note Validate fail-closed LTP0 input if ltp_vec is present: 0=none/ok, 1=id mismatch, 2=dim mismatch, 3=checksum mismatch
fn svnlcheckltp bd edit uchar 983040 tp view uint 262144 wb edit uchar 1073664 to ulong
va = svmem bd tp 0 sknllvc
if eq va jsnone
ret 0
end
if ne js_type tp va 3
ret 2
end
d = get og 2
if ne js_nkids tp va d
ret 2
end
mi = svmem bd tp 0 sknllmi
if or eq mi jsnone ne js_type tp mi 6
ret 1
end
ml = js_sget bd js_off tp mi part wb 82176 192
if or lt ml 0 ne ulong ml get svml 0
ret 1
end
for i ulong ulong ml
if ne get wb add 82176 i get svmi i
ret 1
end
end
e = js_first tp va
for j ulong d
if or eq e jsnone ne js_type tp e 7
ret 2
end
o = js_off tp e
if not js_isl bd o
ret 2
end
put svnl_vec j js_tol bd o
e = js_enext tp e
end
ret svnl_chk_fnv bd tp wb d
end

fn svnlhex_wb wb view uchar 1073664 o ulong to ulong
put svnl_cfg 15 0
v = ulong 0
for i ulong 16
c = ulong get wb add o i
d = ulong 0
if and ge c 48 le c 57
d = sub c 48
else
if and ge c 97 le c 102
d = sub c 87
else
put svnl_cfg 15 1
ret 0
end
end
v = or shl v 4 d
end
ret v
end

note Compute probability and surprisal of chosen token c from current TMP[0..V) logits
fn svnlprob c ulong to void
o = get og 27
v = get og 0
m = bitcast f64 ulong 18442240474082181120
for i ulong v
x = get oa add o i
if gt x m
m = x
end
end
sm = 0.0f64
for j ulong v
sm = add sm fexp sub get oa add o j m
end
lp = sub sub get oa add o c m flog sm
p = fexp lp
put onlf 3 neg lp
put onlf 4 p
end

fn svnlclamp_milli x f64 to ulong
if le x 0.0f64
ret 0
end
v = mul x 1000.0
if gt v 1000000000.0
ret 1000000000
end
ret ulong v
end

fn svnl_emit_toks ob edit uchar 409600 n ulong to void
svwt ob sknltks
js_warr ob
for i ulong n
tk = get svnl_tok i
js_wobj ob
svwt ob skid
js_wulong ob tk
svwt ob sktext
obtcap tk
js_wsbeg ob
for j ulong get obon 0
js_wsb ob get obo j
end
js_wsend ob
svwt ob sknlpm
js_wulong ob get svnl_prob i
svwt ob sknlem
js_wulong ob get svnl_ent i
svwt ob sknlsm
js_wulong ob get svnl_surp i
svwt ob sknlex
js_wulong ob get svnl_ex i
svwt ob sknlxp
js_wulong ob get svnl_xp i
svwt ob sknlxmn
js_wulong ob get svnl_mn i
js_wobje ob
end
js_warre ob
end

fn svnl_emit_diag ob edit uchar 409600 to void
svwt ob sknllnm
js_warr ob
lv = get og 56
if gt lv 32
lv = 32
end
for l ulong lv
js_wulong ob svnlclamp_milli get onln l
end
js_warre ob
svwt ob sknlhmx
js_warr ob
h = get og 3
for hi ulong h
js_wulong ob svnlclamp_milli get onla hi
end
js_warre ob
svwt ob sknltn
js_warr ob
for k ulong 16
js_wobj ob
svwt ob sknlidx
js_wulong ob get onltn_i k
svwt ob sknlam
js_wulong ob svnlclamp_milli get onltn_v k
js_wobje ob
end
js_warre ob
end

fn svnl_emit_ltp0 ob edit uchar 409600 to void
d = get og 2
for i ulong d
put svnl_vec i long mul get onlh i 10000.0
end
fh = svnlfnv d
svwt ob sknllo
js_wobj ob
svwt ob sknlshm
svwt ob svnlscm
svwt ob sknlmid
svmidw ob
svwt ob sknldim
js_wulong ob d
svwt ob sknlhfn
js_wulong ob svnlclamp_milli get onlf 5
svwt ob sknlfnv
svnlwhex ob fh
svwt ob sknlv14
js_warr ob
for j ulong d
js_wlong ob get svnl_vec j
end
js_warre ob
js_wobje ob
end

fn svnl_load_cfg bd view uchar 983040 tp view uint 262144 to void
mx = svnloptu bd tp skmaxt 32
if or eq mx 0 gt mx 128
mx = 32
end
put svnl_cfg 0 mx
tm = svnloptu bd tp sknltm 0
if gt tm 2000
tm = 0
end
put svnl_cfg 1 tm
put svnl_cfg 2 svnloptu bd tp skseed 42
aex = svnloptu bd tp sknlaex 0
if gt aex 4
aex = 4
end
put onlc 4 aex
put onlc 5 svnloptu bd tp sknlath 1500
lal = svnloptu bd tp sknllal 150
lly = svnloptu bd tp sknllly 0
if ge lly get og 56
lly = 0
end
put onlc 7 lly
put onlf 1 div f64 lal 1000.0
sk = svnloptu bd tp sknlsk 0
if and gt sk 0 le sk 3
put onlc 0 1
put onlc 1 svnloptu bd tp sknlsl 999
put onlc 2 sk
put onlc 3 svnloptu bd tp sknlsi 0
svl = svnloptl bd tp sknlsv 0
put onlf 0 div f64 svl 1000.0
end
end

fn svnl_run wb edit uchar 1073664 sv edit ulong 64 lim ulong to ulong
sd = get svnl_cfg 2
tm = get svnl_cfg 1
put sv 7 0
put sv 12 0
put sv 13 0
totex = ulong 0
for g ulong lim
c = osstep sd tm
if ne tm 0
sd = add sd 11400714819323198485
end
svnlprob c
put svnl_tok g c
put svnl_ent g svnlclamp_milli get onlf 2
put svnl_surp g svnlclamp_milli get onlf 3
put svnl_prob g svnlclamp_milli get onlf 4
exu = get onlc 8
put svnl_ex g exu
svnl_rec_x g
totex = add totex exu
if eq c 0
break
end
if not svfits sv c
break
end
svcap wb sv c
svclean wb sv 0
end
svclean wb sv 1
ret totex
end

fn svnl_reply cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 totex ulong to long
ng = get sv 7
ob = new uchar 409600 0
x2 = js_winit ob
js_wobj ob
svwt ob sknlmid
svmidw ob
svwt ob skpt
js_wulong ob get sv 6
svwt ob skct
js_wulong ob ng
svwt ob sknlms
js_wulong ob div sub ulong monons get sv 11 1000000
svwt ob sknltel
js_wulong ob totex
svwt ob sktext
js_wsbuf ob wb 8192 get sv 13
svnl_emit_toks ob ng
svnl_emit_diag ob
svnl_emit_ltp0 ob
svnl_emit_loop ob
svnl_emit_msg ob
js_wobje ob
m = js_wdone ob
if lt m 0
put cs HKEEP 0
ret hrsperr cs io 500
end
put sv 21 200
r = svsend cs io ob 200 ulong m
svlog sv
ret r
end

fn svnl_parse_req bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 n ulong to ulong
tp = new uint 262144 0
x = js_init tp 65536 64
pr = js_parse bd tp n
if or lt pr 0 ne js_type tp 0 1
ret 4
end
pm = svmem bd tp 0 skprompt
if or eq pm jsnone ne js_type tp pm 6
ret 4
end
pl = js_sget bd js_off tp pm part wb 90624 get sv 23
if le pl 0
ret 4
end
put svnl_cfg 14 ulong pl
onlreset
lrc = svnlcheckltp bd tp wb
if ne lrc 0
onlreset
ret lrc
end
svnl_load_cfg bd tp
svnl_load_x bd tp
ret 0
end

note ======== Adaptive loop fields of /v1/neuralese/trace (model.om onlx, docs/LOOP.md)
note Request: exit_thresh_micro (a row leaves the looped core once its normalized pass delta is
note below it, times 1e6; 0 off), msg_gain_micro (inter-pass message gain times 1e6; 0 off),
note ltp_msg (1: a verified ltp_vec becomes every row's pass-0 message instead of the ltp_layer
note injection). The hooks always run for telemetry and change no value with both 0. Reply: per
note token exit_pass and msg_norm_milli, loop_exit (np, controls, rows, exited, exit_passes and
note msg_norms_milli of the last forward's rows) and ltp0_msg, the last row's message as an LTP0
note vector that a later request can hand back as ltp_vec with ltp_msg 1.
fn svnl_load_x bd view uchar 983040 tp view uint 262144 to void
put svnl_cfg 13 0
put onlx 0 svnloptu bd tp sknlxth 0
put onlx 1 svnloptu bd tp sknlxgn 0
put onlx 6 1
lm = svnloptu bd tp sknlxlm 0
if and ne lm 0 ne get onlc 6 0
put onlx 2 1
put onlc 6 0
end
end

note the core passes row t ran in the last forward (1 without a loop; NP on the chip path, which
note runs every pass: the hooks are CPU-only)
fn svnlxp t ulong to ulong
if le get og 59 1
ret 1
end
if ne get ogpu 0 0
ret get og 59
end
ret get onlxp t
end

note token g came from row CT - 1 of the forward just run: its passes and message norm, and the
note rows of that forward in svnl_cfg[13]
fn svnl_rec_x g ulong to void
ct = get og 9
put svnl_cfg 13 ct
t = sub ct 1
put svnl_xp g svnlxp t
put svnl_mn g svnlclamp_milli get onlmn t
end

fn svnl_emit_loop ob edit uchar 409600 to void
ct = get svnl_cfg 13
svwt ob sknlxlo
js_wobj ob
svwt ob sknlnp
js_wulong ob get og 59
svwt ob sknlxth
js_wulong ob get onlx 0
svwt ob sknlxgn
js_wulong ob get onlx 1
svwt ob sknlxlm
js_wulong ob get onlx 2
svwt ob sknlxrw
js_wulong ob ct
svwt ob sknlxex
js_wulong ob svnl_nexit ct
svnl_emit_xarr ob ct
js_wobje ob
end

fn svnl_nexit ct ulong to ulong
n = ulong 0
for t ulong ct
if lt svnlxp t get og 59
n = add n 1
end
end
ret n
end

fn svnl_emit_xarr ob edit uchar 409600 ct ulong to void
svwt ob sknlxps
js_warr ob
for t ulong ct
js_wulong ob svnlxp t
end
js_warre ob
svwt ob sknlxms
js_warr ob
for t2 ulong ct
js_wulong ob svnlclamp_milli get onlmn t2
end
js_warre ob
end

note the last row's inter-pass message as an LTP0 vector (values times 1e4, FNV-1a 64 as ltp_fnv64)
fn svnl_emit_msg ob edit uchar 409600 to void
d = get og 2
ct = get svnl_cfg 13
if eq ct 0
ret
end
r = mul sub ct 1 d
for i ulong d
put svnl_vec i long mul get onlmsg add r i 10000.0
end
fh = svnlfnv d
svwt ob sknlxmo
js_wobj ob
svwt ob sknlshm
svwt ob svnlscm
svwt ob sknlmid
svmidw ob
svwt ob sknldim
js_wulong ob d
svwt ob sknlxmn
js_wulong ob svnlclamp_milli get onlmn sub ct 1
svwt ob sknlfnv
svnlwhex ob fh
svwt ob sknlv14
js_warr ob
for j ulong d
js_wlong ob get svnl_vec j
end
js_warre ob
js_wobje ob
end

fn svnltrace cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to long
n = hbodyall cs io bd
if lt n 0
put cs HKEEP 0
ret svstat cs io 400 senl_js
end
hsetdl cs 0
rc = svnl_parse_req bd wb sv ulong n
if eq rc 1
ret svstat cs io 400 senl_id
end
if eq rc 2
ret svstat cs io 400 senl_dm
end
if eq rc 3
ret svstat cs io 400 senl_ck
end
if ne rc 0
ret svstat cs io 400 senl_js
end
put onlc 10 1
put okv 0 0
put og 9 0
ocpush 0
pl = get svnl_cfg 14
np = svenc view part wb 90624 pl pl 2
put sv 6 add np 1
if ge get sv 6 get sv 19
onlreset
ret svstat cs io 400 senl_ct
end
lim = sub get sv 19 get sv 6
if lt get svnl_cfg 0 lim
lim = get svnl_cfg 0
end
totex = svnl_run wb sv lim
r = svnl_reply cs io wb sv totex
onlreset
put okv 0 0
ret r
end

note svbeg: a request's log fields cleared, its clock started
fn svbeg sv edit ulong 64 to void
put sv 11 ulong monons
put sv 6 0
put sv 7 0
put sv 8 0
put sv 43 0
end

note svend: error code e with status st, logged
fn svend cs edit ulong 320 io edit uchar 131072 wb edit uchar 1073664 sv edit ulong 64 e ulong st ulong to long
put sv 16 e
r = svfail cs io wb sv st
svlog sv
ret r
end

note svok: the fixed JSON text t with status 200, logged
fn svok cs edit ulong 320 io edit uchar 131072 sv edit ulong 64 t view uchar * to long
put sv 21 200
r = svstat cs io 200 t
svlog sv
ret r
end

note svconn: accept & dispatch one connection (returns 1 if admitted to a concurrent slot, else 0)
fn svconn c long cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to ulong
r = hinit cs io int c 1
if lt r 0
x = hclose cs
ret 0
end
if gt get sv_cfg 12 0
hsettmo cs 500000000 500000000
hsetbdl cs 5000000000
else
hsettmo cs 10000000000 10000000000
hsetbdl cs 60000000000
end
note the JSON parser takes at most 983040 bytes (jsmaxn); larger Content-Length is 413 at the head
put cs HBCAP 983040
r = hreqrd cs io
if eq r HEBIG
put cs HKEEP 0
svbeg sv
x = svend cs io wb sv 13 svbig
x2 = hclose cs
ret 0
end
if and lt r 0 ne r HEBIG
x3 = hreject cs io r
x4 = hclose cs
ret 0
end
if gt r 0
put cs HKEEP 0
rr = svroute cs io bd wb sv
if eq rr 1
ret 1
end
end
x5 = hclose cs
ret 0
end

note svpre: whether the argument in oarg (length n) starts with t
fn svpre n ulong t view uchar * to bool
if lt n len t
ret false
end
for i ulong len t
if ne get oarg i get t i
ret false
end
end
ret true
end

note svdig: the decimal oarg[a, n) (1 .. 7 digits), or 0
fn svdig a ulong n ulong to ulong
if or le n a gt sub n a 7
ret 0
end
v = ulong 0
for i ulong sub n a
c = ulong get oarg add a i
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub c 48
end
ret v
end

note svdig_zero: like svdig, but distinguishes invalid from valid "0" (returns SV_NONE on invalid)
fn svdig_zero a ulong n ulong to ulong
if or le n a gt sub n a 7
ret SV_NONE
end
v = ulong 0
for i ulong sub n a
c = ulong get oarg add a i
if or lt c 48 gt c 57
ret SV_NONE
end
v = add mul v 10 sub c 48
end
ret v
end

note svcli: parse options after MERGES ([MAXCONN] first, tplmax=N, test=1, slots=N, ctx=N,
note kvcache=N, kvblks=N, strand=PATH); returns MAXCONN (or 2^64-1 when absent)
fn svcli sv edit ulong 64 na ulong to ulong
mx = ulong 18446744073709551615
for j ulong sub na 5
i = add j 5
n = oargp i
if svpre n svoptt
v = svdig 7 n
if or lt v 256 gt v 983040
exit 2
end
put sv 23 v
else
if and eq n len svopte svpre n svopte
put sv 22 1
else
if svpre n svoptsl
sl = svdig 6 n
if or eq sl 0 gt sl SV_MAX_SLOTS
exit 2
end
put sv_cfg 0 sl
else
if svpre n svoptcx
cx = svdig 4 n
if or eq cx 0 gt cx SV_MAX_CTX
exit 2
end
put sv_cfg 1 cx
else
if svpre n svoptkv
kv = svdig_zero 8 n
if or eq kv SV_NONE gt kv 64
exit 2
end
put sv_cfg 2 kv
else
if svpre n svoptkb
kb = svdig_zero 7 n
if or eq kb SV_NONE gt kb SV_POOL_MAX_BLKS
exit 2
end
put sv_cfg 3 kb
else
if svpre n svoptst
ns = get sv_cfg 4
if or ge ns SV_MAX_STRANDS le n 7
exit 2
end
put sv_st_arg ns i
put sv_st_skp ns 7
put sv_cfg 4 add ns 1
else
if ne i 5
exit 2
end
mx = oargu 5
if eq mx 0
exit 2
end
end
end
end
end
end
end
end
end
ret mx
end

fn sv_poll_tmo to long
nact = get sv_cfg 12
if eq nact 0
ret 60000000000
end
msl = get sv_cfg 0
for s ulong msl
if svslot_ready s
ret 0
end
end
now = ulong monons
best = long 20000000
for s2 ulong msl
if eq get svs_active s2 1
due = get svs_due s2
if gt due now
rm = long sub due now
if lt rm best
best = rm
end
else
ret 0
end
end
end
ret best
end

fn sv_step_rr cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 to void
msl = get sv_cfg 0
rr = get sv_cfg 11
for k ulong msl
s = rem add rr k msl
if eq get svs_active s 1
svslot_step s cs io bd wb sv
end
end
put sv_cfg 11 rem add rr 1 msl
end

fn svserve_init sv edit ulong 64 na ulong port ulong wb edit uchar 1073664 to ulong
put sv 23 524288
put sv_cfg 0 SV_MAX_SLOTS
put sv_cfg 1 0
put sv_cfg 2 8
put sv_cfg 3 SV_NONE
put sv_cfg 4 0
mx = svcli sv na
ockloop 3
obload 4 get og 0
tck = get og 1
mc = get sv_cfg 1
if eq mc 0
mc = ulong 8192
if gt tck mc
mc = tck
end
put sv_cfg 1 mc
else
if lt mc tck
exit 2
end
end
sv_init_strands
if and ne get ogpu 0 0 eq get sv_cfg 4 0
ochipup
end
svk_init
put sv 19 get sv_cfg 1
x = svmcat wb 74752 74763 svtco
x = svmcat wb 74763 74775 svtcc
svmid
a = new uchar 16 0
r = haddr4 a uint mul 2130706433 OMUTLOOP port
lf = hlisten a 64
if lt lf 0
exit 71
end
put sv 36 ulong lf
for i ulong len svport
oputc ulong get svport i
end
oputu port
oputc 10
oflush
ret mx
end

fn svserve_loop cs edit ulong 320 io edit uchar 131072 bd edit uchar 983040 wb edit uchar 1073664 sv edit ulong 64 mx ulong to void
nc = ulong 0
while or lt nc mx gt get sv_cfg 12 0 bound 9223372036854775807
t = sv_poll_tmo
for k ulong 16
if ge nc mx
break
end
c = svwait sv t
if lt c 0
break
end
adm = svconn c cs io bd wb sv
nc = add nc 1
t = long 0
end
if gt get sv_cfg 12 0
sv_step_rr cs io bd wb sv
end
end
end

note serve PORT CK MERGES [MAXCONN] [tplmax=N] [test=1] [slots=N] [ctx=N] [kvcache=N] [kvblks=N] [strand=PATH ...]
fn cmdserve to void
na = oargc
if or lt na 5 gt na 24
exit 2
end
port = oargu 2
if or eq port 0 gt port 65535
exit 2
end
sv = new ulong 64 0
wb = new uchar 1073664 0
mx = svserve_init sv na port wb
cs = new ulong 320 0
io = new uchar 131072 0
bd = new uchar 983040 0
svserve_loop cs io bd wb sv mx
y = fclose int get sv 36
end
