fn svf_mv4_a wi ulong r ulong c ulong to void
s0 = 0.0f64
s1 = 0.0f64
s2 = 0.0f64
s3 = 0.0f64
for i ulong r
a = get sv_fp i
s0 = add s0 mul a get ow wi
s1 = add s1 mul a get ow add wi 1
s2 = add s2 mul a get ow add wi 2
s3 = add s3 mul a get ow add wi 3
wi = add wi c
end
put oq 0 s0
put oq 1 s1
put oq 2 s2
put oq 3 s3
end

fn svf_mv1_a wi ulong r ulong c ulong to f64
s = 0.0f64
for i ulong r
a = get sv_fp i
s = add s mul a get ow wi
wi = add wi c
end
ret s
