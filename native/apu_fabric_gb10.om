note SPDX-License-Identifier: AGPL-3.0-only
note native/apu_fabric_gb10.om: Blackwell 48-SM121 Producer Backend for Full-APU Co-Execution (gb10 target).
note Concatenated AFTER native/gpu/*.om on TARGET=gb10 (ZERO edits to native/gpu/{gk,gr,gb,gg,gt}.om!).

global apu_nvring long 1
global apu_gbf uint 1

fn apu_be_can_bf16 to uint
if ne rem get og 0 64 0
  ret 0
end
if ne rem get og 1 64 0
  ret 0
end
if ne rem get og 2 64 0
  ret 0
end
if ne rem get og 4 64 0
  ret 0
end
ret 1
end

fn apu_pack_w_chunk base ulong cnt ulong to void
for j ulong cnt bound 16384
  u = bitcast uint f32 owg add base j
  o = mul j 4
  put apu_xbuf o uchar and u 255
  put apu_xbuf add o 1 uchar and shr u 8 255
  put apu_xbuf add o 2 uchar and shr u 16 255
  put apu_xbuf add o 3 uchar and shr u 24 255
end
end

fn apu_fast_ggupw to void
h = get gbmem 5
wo = get gga 0
p = get og 8
i = ulong 0
while lt i p bound 1048576
  cnt = sub p i
  if gt cnt 16384
    cnt = ulong 16384
  end
  apu_pack_w_chunk i cnt
  r = mapwrite h add wo mul i 4 apu_xbuf 0 mul cnt 4
  i = add i cnt
end
put gkinv 0 1
end

fn apu_be_open to ulong
put apu_nvring 0 0
if not ggok
  ret 0
end
ggopen
apu_fast_ggupw
bf = apu_be_can_bf16
put apu_gbf 0 bf
rm = nvalloc 65536 false
if gt rm 0
  put apu_nvring 0 rm
  r0 = mapset rm 0 8 0x4f4d52475f563031
  r1 = mapset rm 8 8 mapaddr rm
  cpufence
end
if eq bf 1
  ret 1
end
ret 2
end

fn apu_be_close to void
if gt get apu_cfg 7 0
  r = nvstop
end
put apu_nvring 0 0
end

fn apu_gpu_to_shm src ulong dst ulong nb ulong to void
gh = get gbmem 5
sh = get apu_shmh 0
done = ulong 0
while lt done nb bound 65536
  cnt = sub nb done
  if gt cnt 65536
    cnt = ulong 65536
  end
  r1 = mapread gh add src done apu_xbuf 0 cnt
  r2 = mapwrite sh add dst done apu_xbuf 0 cnt
  done = add done cnt
end
end

fn apu_gpu_copy_surp r0 ulong nt ulong dst ulong to void
sh = get apu_shmh 0
for i ulong nt bound 32768
  sp = ggrl add r0 i
  r = mapset sh add dst mul i 4 4 ulong bitcast uint f32 sp
end
end

fn apu_copy_y r0 ulong nt ulong dst ulong to void
sh = get apu_shmh 0
for i ulong nt bound 32768
  r = mapset sh add dst mul i 4 4 get oby add r0 i
end
end

fn apu_load_pref_win1 pbase ulong wi ulong dst_b ulong to void
sh = get apu_shmh 0
tt = get og 1
src_w = mul wi mul tt 8
for t ulong tt bound 512
  o = add pbase add src_w mul t 8
  put obx add dst_b t mapget sh o 4
  put oby add dst_b t mapget sh add o 4 4
end
end

fn apu_load_pref_windows ps ulong w_start ulong nw ulong b0 ulong to void
tt = get og 1
pbase = add apu_pref_base ps APU_SLOT_HDR
for w ulong nw bound 32
  apu_load_pref_win1 pbase add w_start w mul add b0 w tt
end
end

fn apu_cpu_store_zr wb ulong row ulong zo ulong to void
sh = get apu_shmh 0
d = get og 2
r = long 0
for j ulong d bound 2048
  off = mul add mul row d j 4
  dst = add add wb get apu_shm 4 off
  val = ulong bitcast uint f32 get oa add zo j
  r = mapset sh dst 4 val
  dst = add add wb get apu_shm 5 off
  val = ulong bitcast uint f32 get sp2_rvec j
  r = mapset sh dst 4 val
end
end

fn apu_cpu_train_tok wb ulong row ulong t ulong to void
zo = add get og 17 mul t get og 2
yt = get oby t
surp = sp2_tok_grad zo yt
apu_cpu_store_zr wb row zo
sh = get apu_shmh 0
dst = add add wb get apu_shm 6 mul row 4
val = ulong bitcast uint f32 surp
r = mapset sh dst 4 val
dst = add add wb get apu_shm 7 mul row 4
r = mapset sh dst 4 yt
end

fn apu_cpu_train_win ps ulong w ulong wb ulong to void
tt = get og 1
apu_load_pref_windows ps w 1 0
dl = ofwd 0
for t ulong tt bound 512
  apu_cpu_train_tok wb add mul w tt t t
end
end

fn apu_cpu_held_copy base ulong zo2 ulong d ulong to void
sh = get apu_shmh 0
r = long 0
for j2 ulong d bound 2048
  val = ulong bitcast uint f32 get oa add zo2 j2
  r = mapset sh add base mul j2 4 4 val
end
end

fn apu_cpu_held_tok wb ulong row2 ulong t2 ulong to void
d = get og 2
base = add add wb get apu_shm 8 mul mul row2 d 4
apu_cpu_held_copy base add get og 17 mul t2 d d
sh = get apu_shmh 0
yb = add add wb get apu_shm 9 mul row2 4
yt = get oby t2
r = mapset sh yb 4 yt
end

fn apu_cpu_held_win ps ulong nw ulong wh ulong wb ulong to void
tt = get og 1
apu_load_pref_windows ps add nw wh 1 0
dl2 = ofwd 0
for t2 ulong tt bound 512
  apu_cpu_held_tok wb add mul wh tt t2 t2
end
end

fn apu_cpu_run_one idx ulong to void
shrd = get apu_bsh idx
ps = get apu_bps idx
wb = apu_work_base get apu_bws idx
nw = get apu_bnw idx
nh = get apu_bnh idx
for w ulong nw bound 32
  apu_cpu_train_win ps w wb
end
for wh ulong nh bound 4
  apu_cpu_held_win ps nw wh wb
end
sh = get apu_shmh 0
tt = get og 1
r7 = mapset sh wb 8 shrd
r8 = mapset sh add wb 8 8 get apu_sids shrd
r9 = mapset sh add wb 16 8 mul nw tt
r10 = mapset sh add wb 24 8 mul nh tt
r11 = mapset sh add wb 32 8 bitcast ulong 1.0f64
cpufence
end

fn apu_gpu_fire_pass to void
ggupt
put gkinv 0 1
put gkbf 0 get apu_gbf 0
put ggnoce 0 0
ggfwd
ggxw gga1 11 ggw 0 gga1 14 get og 2 get og 0 false
put gkbf 0 0
if gt get apu_nvring 0 0
  r0 = mapset get apu_nvring 0 128 8 add get apu_cfg 20 1
  cpufence
end
end

fn apu_gpu_copy_win_zr wb ulong r_gpu ulong r_dst ulong to void
d = get og 2
nb = mul mul get og 1 d 4
s_off = mul mul r_gpu d 4
d_off = mul mul r_dst d 4
apu_gpu_to_shm add get gga 10 s_off add add wb get apu_shm 4 d_off nb
apu_gpu_to_shm add get gga 14 s_off add add wb get apu_shm 5 d_off nb
end

fn apu_gpu_copy_win_tr wb ulong gw ulong wi ulong to void
tt = get og 1
r_gpu = mul wi tt
r_dst = mul gw tt
apu_gpu_copy_win_zr wb r_gpu r_dst
apu_gpu_copy_surp r_gpu tt add add wb get apu_shm 6 mul r_dst 4
apu_copy_y r_gpu tt add add wb get apu_shm 7 mul r_dst 4
end

fn apu_gpu_copy_win_he wb ulong hi ulong wi ulong to void
tt = get og 1
d = get og 2
r_gpu = mul wi tt
r_hdst = mul hi tt
src = add get gga 10 mul mul r_gpu d 4
dst = add add wb get apu_shm 8 mul mul r_hdst d 4
apu_gpu_to_shm src dst mul mul tt d 4
dst = add add wb get apu_shm 9 mul r_hdst 4
apu_copy_y r_gpu tt dst
end

fn apu_gpu_copy_win wb ulong nw ulong gw ulong wi ulong to void
if lt gw nw
  apu_gpu_copy_win_tr wb gw wi
  ret
end
apu_gpu_copy_win_he wb sub gw nw wi
end

fn apu_gpu_finish_hdr wb ulong shrd ulong nw ulong nh ulong to void
sh = get apu_shmh 0
tt = get og 1
r = mapset sh wb 8 shrd
r = mapset sh add wb 8 8 get apu_sids shrd
r = mapset sh add wb 16 8 mul nw tt
r = mapset sh add wb 24 8 mul nh tt
r = mapset sh add wb 32 8 bitcast ulong neg f64 ggr
end

fn apu_gpu_large_step w0 ulong cnt ulong to void
bb = get og 6
ps = get apu_bps 0
wb = apu_work_base get apu_bws 0
apu_load_pref_windows ps w0 cnt 0
for pad ulong sub bb cnt bound 64
  apu_load_pref_windows ps 0 1 add cnt pad
end
apu_gpu_fire_pass
for wi ulong cnt bound 64
  apu_gpu_copy_win wb get apu_bnw 0 add w0 wi wi
end
end

fn apu_gpu_run_large to void
bb = get og 6
totw = add get apu_bnw 0 get apu_bnh 0
w0 = ulong 0
while lt w0 totw bound 32
  cnt = sub totw w0
  if gt cnt bb
    cnt = bb
  end
  apu_gpu_large_step w0 cnt
  w0 = add w0 cnt
end
apu_gpu_finish_hdr apu_work_base get apu_bws 0 get apu_bsh 0 get apu_bnw 0 get apu_bnh 0
cpufence
end

fn apu_gpu_copy_tr wb ulong r_tr ulong ntrain ulong to void
d = get og 2
nb = mul mul ntrain d 4
s_off = mul mul r_tr d 4
src = add get gga 10 s_off
dst = add wb get apu_shm 4
apu_gpu_to_shm src dst nb
src = add get gga 14 s_off
dst = add wb get apu_shm 5
apu_gpu_to_shm src dst nb
apu_gpu_copy_surp r_tr ntrain add wb get apu_shm 6
apu_copy_y r_tr ntrain add wb get apu_shm 7
end

fn apu_gpu_copy_he wb ulong r_he ulong nheld ulong to void
d = get og 2
nb = mul mul nheld d 4
src = add get gga 10 mul mul r_he d 4
dst = add wb get apu_shm 8
apu_gpu_to_shm src dst nb
apu_copy_y r_he nheld add wb get apu_shm 9
end

fn apu_gpu_copy_shard i2 ulong bcur2 ulong to void
tt = get og 1
nw = get apu_bnw i2
nh = get apu_bnh i2
wb = apu_work_base get apu_bws i2
apu_gpu_copy_tr wb mul bcur2 tt mul nw tt
if gt nh 0
  apu_gpu_copy_he wb mul add bcur2 nw tt mul nh tt
end
apu_gpu_finish_hdr wb get apu_bsh i2 nw nh
end

fn apu_be_run_batch k ulong to void
if eq get apu_cfg 7 0
  for i ulong k bound 16
    apu_cpu_run_one i
  end
  ret
end
bb = get og 6
if and eq k 1 gt add get apu_bnw 0 get apu_bnh 0 bb
  apu_gpu_run_large
  ret
end
bcur = ulong 0
for i ulong k bound 16
  tw = add get apu_bnw i get apu_bnh i
  apu_load_pref_windows get apu_bps i 0 tw bcur
  bcur = add bcur tw
end
while lt bcur bb bound 64
  apu_load_pref_windows get apu_bps 0 0 1 bcur
  bcur = add bcur 1
end
apu_gpu_fire_pass
bcur2 = ulong 0
for i2 ulong k bound 16
  apu_gpu_copy_shard i2 bcur2
  bcur2 = add bcur2 add get apu_bnw i2 get apu_bnh i2
end
cpufence
end
